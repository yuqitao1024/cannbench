cmake_minimum_required(VERSION 3.20)

set(CMAKE_ASC_ARCHITECTURES "@ASC_OCCUPANCY_PROBE_ARCHITECTURES@" CACHE STRING "")
set(CMAKE_ASC_ENABLE_SIMT ON CACHE BOOL "")
set(CMAKE_AR "/usr/bin/ar" CACHE FILEPATH "")
set(CMAKE_RANLIB "/usr/bin/ranlib" CACHE FILEPATH "")
set(CMAKE_ASC_COMPILER_AR "/usr/bin/ar" CACHE FILEPATH "")

find_package(ASC REQUIRED)
project(asc_occupancy_@ASC_OCCUPANCY_PROBE_NAME@ LANGUAGES ASC)

add_library(@ASC_OCCUPANCY_PROBE_TARGET@ STATIC "@ASC_OCCUPANCY_PROBE_SOURCE@")
target_include_directories(@ASC_OCCUPANCY_PROBE_TARGET@ PRIVATE
  "@ASC_OCCUPANCY_PROBE_INCLUDE_DIRECTORIES@")
target_compile_definitions(@ASC_OCCUPANCY_PROBE_TARGET@ PRIVATE
  @ASC_OCCUPANCY_PROBE_COMPILE_DEFINITIONS@
  ASC_OCCUPANCY_LAUNCH_BOUNDS=@ASC_OCCUPANCY_PROBE_LAUNCH_BOUNDS@)
target_compile_options(@ASC_OCCUPANCY_PROBE_TARGET@ PRIVATE
  @ASC_OCCUPANCY_PROBE_COMPILE_OPTIONS@
  $<$<COMPILE_LANGUAGE:ASC>:--cce-res-usage>)
