/**
 * Lane-owned invariant reuse comparison for Ascend 950.
 *
 * SCENARIO_NUM=0 reloads and recomputes invariant metadata in every pass.
 * SCENARIO_NUM=1 publishes invariants to shared UB and reloads them per pass.
 * SCENARIO_NUM=2 keeps each lane's invariants live across all passes.
 */

#include <stdint.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>

#include "acl/acl.h"
#include "simt_api/asc_simt.h"
#include "simt_api/device_sync_functions.h"

static_assert(SCENARIO_NUM >= 0 && SCENARIO_NUM <= 2, "SCENARIO_NUM must be 0, 1, or 2");

#define DEVICE_ID 0
#define THREAD_COUNT 512U
#define BLOCK_COUNT 64U
#define LANE_ELEMENT_COUNT 4U
#define TILE_ELEMENT_COUNT (THREAD_COUNT * LANE_ELEMENT_COUNT)
#define ELEMENT_CAPACITY (BLOCK_COUNT * TILE_ELEMENT_COUNT)
#define PASS_COUNT 8U
#define RANDOM_SEED 20260812U
#define OUTPUT_SENTINEL 0xa5a5a5a5U
#define SHARED_ARRAY_COUNT 3U
#define SHARED_UB_BYTES (SHARED_ARRAY_COUNT * TILE_ELEMENT_COUNT * sizeof(uint32_t))

static const uint32_t BOUNDARY_CASE_COUNTS[] = {
    1U,
    TILE_ELEMENT_COUNT - 1U,
    TILE_ELEMENT_COUNT,
    TILE_ELEMENT_COUNT + 1U,
    ELEMENT_CAPACITY - 13U,
    ELEMENT_CAPACITY,
};

static const char *SCENARIO_NAME =
    SCENARIO_NUM == 0 ? "repeated GM load and recompute" :
    (SCENARIO_NUM == 1 ? "shared UB cache and block barrier" : "lane-local invariant reuse");

typedef struct DeviceBuffers {
    uint32_t *input;
    uint32_t *raw_metadata;
    uint32_t *output;
} DeviceBuffers;

#define CHECK_ACL(expr)                                                                              \
    do {                                                                                             \
        aclError check_acl_result = (expr);                                                          \
        if (check_acl_result != ACL_SUCCESS) {                                                       \
            fprintf(stderr, "ACL call failed: %s, ret=%d\n", #expr, (int)check_acl_result);         \
            exit(1);                                                                                 \
        }                                                                                            \
    } while (0)

__simt_callee__ inline uint32_t compact_metadata_device(uint32_t raw_metadata, uint32_t index)
{
    return ((raw_metadata ^ (index * 0x9e3779b9U)) & 0x0000ffffU) + 1U;
}

__simt_callee__ inline uint32_t prepare_value_device(uint32_t input, uint32_t metadata)
{
    return (input ^ (metadata * 0x85ebca6bU)) + 0xc2b2ae35U;
}

__simt_callee__ inline uint32_t pass_value_device(uint32_t value, uint32_t metadata, uint32_t pass)
{
    uint32_t shift = pass + 1U;
    uint32_t rotated = (value << shift) | (value >> (32U - shift));
    return rotated ^ (metadata + pass * 0x27d4eb2dU);
}

#if SCENARIO_NUM == 0
__simt_vf__ __launch_bounds__(THREAD_COUNT) inline void recompute_lane_metadata_vf(
    __gm__ const uint32_t *input,
    __gm__ const uint32_t *raw_metadata,
    __gm__ uint32_t *output,
    uint32_t element_count)
{
    uint32_t thread_index = (uint32_t)threadIdx.x;
    uint32_t tile_begin = (uint32_t)blockIdx.x * TILE_ELEMENT_COUNT;
    uint32_t accumulators[LANE_ELEMENT_COUNT] = {0U, 0U, 0U, 0U};

    for (uint32_t pass = 0; pass < PASS_COUNT; ++pass) {
        for (uint32_t lane_element = 0; lane_element < LANE_ELEMENT_COUNT; ++lane_element) {
            uint32_t index = tile_begin + thread_index + lane_element * THREAD_COUNT;
            if (index < element_count) {
                uint32_t input_value = *((__gm__ volatile const uint32_t *)(input + index));
                uint32_t raw = *((__gm__ volatile const uint32_t *)(raw_metadata + index));
                uint32_t metadata = compact_metadata_device(raw, index);
                uint32_t value = prepare_value_device(input_value, metadata);
                accumulators[lane_element] += pass_value_device(value, metadata, pass);
            }
        }
    }

    for (uint32_t lane_element = 0; lane_element < LANE_ELEMENT_COUNT; ++lane_element) {
        uint32_t index = tile_begin + thread_index + lane_element * THREAD_COUNT;
        if (index < element_count) {
            output[index] = accumulators[lane_element];
        }
    }
}
#elif SCENARIO_NUM == 1
__simt_vf__ __launch_bounds__(THREAD_COUNT) inline void shared_ub_metadata_vf(
    __gm__ const uint32_t *input,
    __gm__ const uint32_t *raw_metadata,
    __gm__ uint32_t *output,
    uint32_t element_count,
    __ubuf__ uint32_t *shared_values,
    __ubuf__ uint32_t *shared_metadata,
    __ubuf__ uint32_t *shared_validity)
{
    uint32_t thread_index = (uint32_t)threadIdx.x;
    uint32_t tile_begin = (uint32_t)blockIdx.x * TILE_ELEMENT_COUNT;
    uint32_t accumulators[LANE_ELEMENT_COUNT] = {0U, 0U, 0U, 0U};

    for (uint32_t lane_element = 0; lane_element < LANE_ELEMENT_COUNT; ++lane_element) {
        uint32_t local_index = thread_index + lane_element * THREAD_COUNT;
        uint32_t index = tile_begin + local_index;
        uint32_t valid = index < element_count ? 1U : 0U;
        uint32_t metadata = 0U;
        uint32_t value = 0U;
        if (valid != 0U) {
            metadata = compact_metadata_device(raw_metadata[index], index);
            value = prepare_value_device(input[index], metadata);
        }
        shared_values[local_index] = value;
        shared_metadata[local_index] = metadata;
        shared_validity[local_index] = valid;
    }
    asc_syncthreads();

    for (uint32_t pass = 0; pass < PASS_COUNT; ++pass) {
        for (uint32_t lane_element = 0; lane_element < LANE_ELEMENT_COUNT; ++lane_element) {
            uint32_t local_index = thread_index + lane_element * THREAD_COUNT;
            uint32_t valid = *((__ubuf__ volatile uint32_t *)(shared_validity + local_index));
            if (valid != 0U) {
                uint32_t value = *((__ubuf__ volatile uint32_t *)(shared_values + local_index));
                uint32_t metadata = *((__ubuf__ volatile uint32_t *)(shared_metadata + local_index));
                accumulators[lane_element] += pass_value_device(value, metadata, pass);
            }
        }
    }

    for (uint32_t lane_element = 0; lane_element < LANE_ELEMENT_COUNT; ++lane_element) {
        uint32_t index = tile_begin + thread_index + lane_element * THREAD_COUNT;
        if (index < element_count) {
            output[index] = accumulators[lane_element];
        }
    }
}
#else
__simt_vf__ __launch_bounds__(THREAD_COUNT) inline void lane_local_reuse_vf(
    __gm__ const uint32_t *input,
    __gm__ const uint32_t *raw_metadata,
    __gm__ uint32_t *output,
    uint32_t element_count)
{
    uint32_t thread_index = (uint32_t)threadIdx.x;
    uint32_t tile_begin = (uint32_t)blockIdx.x * TILE_ELEMENT_COUNT;
    uint32_t lane_values[LANE_ELEMENT_COUNT] = {0U, 0U, 0U, 0U};
    uint32_t lane_metadata[LANE_ELEMENT_COUNT] = {0U, 0U, 0U, 0U};
    uint32_t accumulators[LANE_ELEMENT_COUNT] = {0U, 0U, 0U, 0U};
    uint32_t lane_validity_mask = 0U;

    for (uint32_t lane_element = 0; lane_element < LANE_ELEMENT_COUNT; ++lane_element) {
        uint32_t index = tile_begin + thread_index + lane_element * THREAD_COUNT;
        if (index < element_count) {
            lane_metadata[lane_element] = compact_metadata_device(raw_metadata[index], index);
            lane_values[lane_element] = prepare_value_device(input[index], lane_metadata[lane_element]);
            lane_validity_mask |= 1U << lane_element;
        }
    }

    for (uint32_t pass = 0; pass < PASS_COUNT; ++pass) {
        for (uint32_t lane_element = 0; lane_element < LANE_ELEMENT_COUNT; ++lane_element) {
            if ((lane_validity_mask & (1U << lane_element)) != 0U) {
                accumulators[lane_element] +=
                    pass_value_device(lane_values[lane_element], lane_metadata[lane_element], pass);
            }
        }
    }

    for (uint32_t lane_element = 0; lane_element < LANE_ELEMENT_COUNT; ++lane_element) {
        uint32_t index = tile_begin + thread_index + lane_element * THREAD_COUNT;
        if ((lane_validity_mask & (1U << lane_element)) != 0U) {
            output[index] = accumulators[lane_element];
        }
    }
}
#endif

#if SCENARIO_NUM == 0
__global__ __vector__ void recompute_lane_metadata_kernel(
    __gm__ const uint32_t *input,
    __gm__ const uint32_t *raw_metadata,
    __gm__ uint32_t *output,
    uint32_t element_count)
{
    asc_vf_call<recompute_lane_metadata_vf>(
        dim3(THREAD_COUNT, 1, 1), input, raw_metadata, output, element_count);
}
#elif SCENARIO_NUM == 1
__global__ __vector__ void shared_ub_metadata_kernel(
    __gm__ const uint32_t *input,
    __gm__ const uint32_t *raw_metadata,
    __gm__ uint32_t *output,
    uint32_t element_count)
{
    extern __ubuf__ uint32_t dynamic_start_ub[];
    __ubuf__ uint32_t *shared_values = dynamic_start_ub;
    __ubuf__ uint32_t *shared_metadata = shared_values + TILE_ELEMENT_COUNT;
    __ubuf__ uint32_t *shared_validity = shared_metadata + TILE_ELEMENT_COUNT;
    asc_vf_call<shared_ub_metadata_vf>(dim3(THREAD_COUNT, 1, 1), input, raw_metadata,
        output, element_count, shared_values, shared_metadata, shared_validity);
}
#else
__global__ __vector__ void lane_local_reuse_kernel(
    __gm__ const uint32_t *input,
    __gm__ const uint32_t *raw_metadata,
    __gm__ uint32_t *output,
    uint32_t element_count)
{
    asc_vf_call<lane_local_reuse_vf>(
        dim3(THREAD_COUNT, 1, 1), input, raw_metadata, output, element_count);
}
#endif

static uint32_t next_random(uint32_t *state)
{
    uint32_t value = *state;
    value ^= value << 13;
    value ^= value >> 17;
    value ^= value << 5;
    *state = value;
    return value;
}

static uint32_t compact_metadata_host(uint32_t raw_metadata, uint32_t index)
{
    return ((raw_metadata ^ (index * 0x9e3779b9U)) & 0x0000ffffU) + 1U;
}

static uint32_t prepare_value_host(uint32_t input, uint32_t metadata)
{
    return (input ^ (metadata * 0x85ebca6bU)) + 0xc2b2ae35U;
}

static uint32_t pass_value_host(uint32_t value, uint32_t metadata, uint32_t pass)
{
    uint32_t shift = pass + 1U;
    uint32_t rotated = (value << shift) | (value >> (32U - shift));
    return rotated ^ (metadata + pass * 0x27d4eb2dU);
}

static void fill_input_fixed_seed(uint32_t *input, uint32_t *raw_metadata)
{
    uint32_t random_state = RANDOM_SEED;
    for (uint32_t index = 0; index < ELEMENT_CAPACITY; ++index) {
        input[index] = next_random(&random_state) ^ index;
        raw_metadata[index] = next_random(&random_state) + index * 17U;
    }
}

static void build_host_oracle(
    const uint32_t *input,
    const uint32_t *raw_metadata,
    uint32_t *expected,
    uint32_t element_count)
{
    for (uint32_t index = 0; index < element_count; ++index) {
        uint32_t metadata = compact_metadata_host(raw_metadata[index], index);
        uint32_t value = prepare_value_host(input[index], metadata);
        uint32_t accumulator = 0U;
        for (uint32_t pass = 0; pass < PASS_COUNT; ++pass) {
            accumulator += pass_value_host(value, metadata, pass);
        }
        expected[index] = accumulator;
    }
}

static int verify_output(const uint32_t *actual, const uint32_t *expected, uint32_t element_count)
{
    uint32_t mismatch_count = 0U;
    for (uint32_t index = 0; index < element_count; ++index) {
        if (actual[index] != expected[index]) {
            if (mismatch_count < 8U) {
                fprintf(stderr, "output mismatch: index=%u actual=%u expected=%u\n",
                    index, actual[index], expected[index]);
            }
            ++mismatch_count;
        }
    }
    if (mismatch_count != 0U) {
        fprintf(stderr, "output mismatch count=%u\n", mismatch_count);
        return 0;
    }
    return 1;
}

static int verify_untouched_tail(const uint32_t *actual, uint32_t element_count)
{
    uint32_t mismatch_count = 0U;
    for (uint32_t index = element_count; index < ELEMENT_CAPACITY; ++index) {
        if (actual[index] != OUTPUT_SENTINEL) {
            if (mismatch_count < 8U) {
                fprintf(stderr, "tail overwrite: index=%u actual=%u expected=%u\n",
                    index, actual[index], OUTPUT_SENTINEL);
            }
            ++mismatch_count;
        }
    }
    if (mismatch_count != 0U) {
        fprintf(stderr, "tail overwrite count=%u\n", mismatch_count);
        return 0;
    }
    return 1;
}

static void allocate_device_buffers(DeviceBuffers *buffers)
{
    size_t bytes = (size_t)ELEMENT_CAPACITY * sizeof(uint32_t);
    CHECK_ACL(aclrtMalloc((void **)&buffers->input, bytes, ACL_MEM_MALLOC_HUGE_FIRST));
    CHECK_ACL(aclrtMalloc((void **)&buffers->raw_metadata, bytes, ACL_MEM_MALLOC_HUGE_FIRST));
    CHECK_ACL(aclrtMalloc((void **)&buffers->output, bytes, ACL_MEM_MALLOC_HUGE_FIRST));
}

static void free_device_buffers(DeviceBuffers *buffers)
{
    CHECK_ACL(aclrtFree(buffers->output));
    CHECK_ACL(aclrtFree(buffers->raw_metadata));
    CHECK_ACL(aclrtFree(buffers->input));
}

static void launch_selected_scenario(const DeviceBuffers *buffers, uint32_t element_count, aclrtStream stream)
{
#if SCENARIO_NUM == 0
    recompute_lane_metadata_kernel<<<BLOCK_COUNT, 0, stream>>>(
        buffers->input, buffers->raw_metadata, buffers->output, element_count);
#elif SCENARIO_NUM == 1
    shared_ub_metadata_kernel<<<BLOCK_COUNT, SHARED_UB_BYTES, stream>>>(
        buffers->input, buffers->raw_metadata, buffers->output, element_count);
#else
    lane_local_reuse_kernel<<<BLOCK_COUNT, 0, stream>>>(
        buffers->input, buffers->raw_metadata, buffers->output, element_count);
#endif
}

static int run_one_count(
    const DeviceBuffers *buffers,
    const uint32_t *host_input,
    const uint32_t *host_metadata,
    uint32_t *actual,
    uint32_t *expected,
    uint32_t element_count,
    aclrtStream stream)
{
    size_t capacity_bytes = (size_t)ELEMENT_CAPACITY * sizeof(uint32_t);
    build_host_oracle(host_input, host_metadata, expected, element_count);
    memset(actual, 0xa5, capacity_bytes);
    CHECK_ACL(aclrtMemcpy(buffers->output, capacity_bytes, actual,
        capacity_bytes, ACL_MEMCPY_HOST_TO_DEVICE));
    launch_selected_scenario(buffers, element_count, stream);
    CHECK_ACL(aclrtSynchronizeStream(stream));
    CHECK_ACL(aclrtMemcpy(actual, capacity_bytes, buffers->output,
        capacity_bytes, ACL_MEMCPY_DEVICE_TO_HOST));
    if (!verify_output(actual, expected, element_count) ||
        !verify_untouched_tail(actual, element_count)) {
        fprintf(stderr, "case failed: element_count=%u\n", element_count);
        return 0;
    }
    printf("element_count=%u verify=PASS\n", element_count);
    return 1;
}

static int parse_element_count(const char *text, uint32_t *element_count)
{
    char *end = NULL;
    unsigned long parsed = strtoul(text, &end, 10);
    if (end == text || *end != '\0' || parsed == 0UL || parsed > ELEMENT_CAPACITY) {
        return 0;
    }
    *element_count = (uint32_t)parsed;
    return 1;
}

int main(int argc, char **argv)
{
    size_t bytes = (size_t)ELEMENT_CAPACITY * sizeof(uint32_t);
    uint32_t *host_input = (uint32_t *)malloc(bytes);
    uint32_t *host_metadata = (uint32_t *)malloc(bytes);
    uint32_t *actual = (uint32_t *)malloc(bytes);
    uint32_t *expected = (uint32_t *)malloc(bytes);
    DeviceBuffers buffers = {0};
    aclrtStream stream = NULL;
    int all_valid = 1;

    if (argc > 2 || host_input == NULL || host_metadata == NULL || actual == NULL || expected == NULL) {
        fprintf(stderr, "usage: %s [element_count: 1..%u]\n", argv[0], ELEMENT_CAPACITY);
        free(expected);
        free(actual);
        free(host_metadata);
        free(host_input);
        return 2;
    }
    fill_input_fixed_seed(host_input, host_metadata);

    CHECK_ACL(aclInit(NULL));
    CHECK_ACL(aclrtSetDevice(DEVICE_ID));
    CHECK_ACL(aclrtCreateStream(&stream));
    allocate_device_buffers(&buffers);
    CHECK_ACL(aclrtMemcpy(buffers.input, bytes, host_input, bytes, ACL_MEMCPY_HOST_TO_DEVICE));
    CHECK_ACL(aclrtMemcpy(buffers.raw_metadata, bytes, host_metadata, bytes, ACL_MEMCPY_HOST_TO_DEVICE));

    printf("scenario=%d implementation=%s blocks=%u threads=%u passes=%u\n",
        SCENARIO_NUM, SCENARIO_NAME, BLOCK_COUNT, THREAD_COUNT, PASS_COUNT);
    if (argc == 2) {
        uint32_t element_count = 0U;
        if (!parse_element_count(argv[1], &element_count)) {
            fprintf(stderr, "invalid element_count: %s\n", argv[1]);
            all_valid = 0;
        } else {
            all_valid = run_one_count(&buffers, host_input, host_metadata, actual,
                expected, element_count, stream);
        }
    } else {
        uint32_t case_count = (uint32_t)(sizeof(BOUNDARY_CASE_COUNTS) / sizeof(BOUNDARY_CASE_COUNTS[0]));
        for (uint32_t case_index = 0; case_index < case_count; ++case_index) {
            int valid = run_one_count(&buffers, host_input, host_metadata, actual,
                expected, BOUNDARY_CASE_COUNTS[case_index], stream);
            all_valid = all_valid && valid;
        }
    }

    printf("%s\n", all_valid ? "Verification PASSED" : "Verification FAILED");
    free_device_buffers(&buffers);
    CHECK_ACL(aclrtDestroyStream(stream));
    CHECK_ACL(aclrtResetDevice(DEVICE_ID));
    CHECK_ACL(aclFinalize());
    free(expected);
    free(actual);
    free(host_metadata);
    free(host_input);
    return all_valid ? 0 : 1;
}
