#include <math.h>
#include <stdint.h>
#include <stdio.h>
#include <stdlib.h>

#include "acl/acl.h"
#include "basic_api/kernel_operator_block_sync_intf.h"
#include "c_api/asc_simd.h"
#include "simt_api/asc_bf16.h"
#include "simt_api/asc_simt.h"

#define MATRIX_M 8U
#define MATRIX_N 16U
#define MATRIX_K 16U
#define CUBE_M 16U
#define KEY_TABLE_ROWS 32U
#define MATRIX_ELEMENTS (MATRIX_M * MATRIX_N)
#define KEY_TABLE_ELEMENTS (KEY_TABLE_ROWS * MATRIX_K)
#define V1_SCRATCH_ELEMENTS (2U * MATRIX_ELEMENTS)
#define ABS_TOLERANCE 2.0e-5F
#define REL_TOLERANCE 2.0e-4F

static constexpr uint8_t kCrossCoreSyncMode = 4;
static constexpr uint16_t kGatherReadyFlag = 0;
static constexpr uint16_t kScoreReadyFlag = 1;
static constexpr uint16_t kV1FlagOffset = 16;

typedef struct {
    uint16_t* query;
    uint16_t* key_table;
    int32_t* indices;
    float* output;
} DeviceBuffers;

__simt_vf__ __launch_bounds__(MATRIX_M) inline void v1_small_softmax_vf(
    __ubuf__ const float* v1_logits_row_major,
    __ubuf__ float* v1_softmax_scratch,
    __gm__ float* output)
{
    uint32_t row = (uint32_t)threadIdx.x;
    if (row >= MATRIX_M) {
        return;
    }

    uint32_t row_offset = row * MATRIX_N;
    float row_max = v1_logits_row_major[row_offset];
    for (uint32_t column = 1U; column < MATRIX_N; ++column) {
        float value = v1_logits_row_major[row_offset + column];
        row_max = value > row_max ? value : row_max;
    }

    float row_sum = 0.0F;
    for (uint32_t column = 0U; column < MATRIX_N; ++column) {
        float exponent = __expf(v1_logits_row_major[row_offset + column] - row_max);
        v1_softmax_scratch[row_offset + column] = exponent;
        row_sum += exponent;
    }
    v1_softmax_scratch[MATRIX_ELEMENTS + row * 2U] = row_max;
    v1_softmax_scratch[MATRIX_ELEMENTS + row * 2U + 1U] = row_sum;

    for (uint32_t column = 0U; column < MATRIX_N; ++column) {
        output[row_offset + column] =
            v1_softmax_scratch[row_offset + column] / row_sum;
    }
}

__aicore__ inline void v0_gather_key_to_l1(
    __gm__ const bfloat16_t* key_table,
    __gm__ const int32_t* indices,
    __cbuf__ bfloat16_t* l1_gathered_key)
{
    __ubuf__ bfloat16_t v0_gather_zn[MATRIX_K * MATRIX_N];

    AscendC::CrossCoreWaitFlag<kCrossCoreSyncMode, PIPE_MTE3>(
        kGatherReadyFlag);
    for (uint32_t selected = 0U; selected < MATRIX_N; ++selected) {
        int32_t source_row = indices[selected];
        for (uint32_t dimension = 0U; dimension < MATRIX_K; ++dimension) {
            uint32_t zn_offset = selected * MATRIX_K + dimension;
            v0_gather_zn[zn_offset] =
                key_table[(uint32_t)source_row * MATRIX_K + dimension];
        }
    }
    asc_copy_ub2l1_sync(
        l1_gathered_key,
        v0_gather_zn,
        (uint32_t)sizeof(v0_gather_zn));
    AscendC::CrossCoreSetFlag<kCrossCoreSyncMode, PIPE_MTE3>(
        kGatherReadyFlag);
}

__aicore__ inline void v1_wait_and_softmax(__gm__ float* output)
{
    __ubuf__ float v1_logits_row_major[MATRIX_ELEMENTS];
    __ubuf__ float v1_softmax_scratch[V1_SCRATCH_ELEMENTS];
    const uint16_t v1_score_flag = kScoreReadyFlag + kV1FlagOffset;

    AscendC::CrossCoreSetFlag<kCrossCoreSyncMode, PIPE_V>(v1_score_flag);
    AscendC::CrossCoreWaitFlag<kCrossCoreSyncMode, PIPE_V>(v1_score_flag);
    asc_vf_call<v1_small_softmax_vf>(
        dim3(MATRIX_M, 1U, 1U),
        v1_logits_row_major,
        v1_softmax_scratch,
        output);
    asc_sync();
}

__aicore__ inline void cube_qk_to_v1(
    __gm__ const bfloat16_t* query,
    __cbuf__ bfloat16_t* l1_gathered_key)
{
    __cbuf__ bfloat16_t l1_query[CUBE_M * MATRIX_K];
    __ca__ bfloat16_t l0_query[CUBE_M * MATRIX_K];
    __cb__ bfloat16_t l0_key[MATRIX_K * MATRIX_N];
    __cc__ float l0_logits[CUBE_M * MATRIX_N];
    __ubuf__ float* v1_logits_row_major =
        reinterpret_cast<__ubuf__ float*>(0);
    const uint16_t v1_score_flag = kScoreReadyFlag + kV1FlagOffset;

    AscendC::CrossCoreSetFlag<kCrossCoreSyncMode, PIPE_MTE1>(
        kGatherReadyFlag);
    asc_copy_gm2l1_sync(
        l1_query,
        const_cast<__gm__ bfloat16_t*>(query),
        0U,
        0U,
        MATRIX_K,
        MATRIX_M,
        MATRIX_K,
        0U,
        0U);
    asc_copy_gm2l1_sync(
        l1_query + MATRIX_M * MATRIX_K,
        const_cast<__gm__ bfloat16_t*>(query),
        0U,
        0U,
        MATRIX_K,
        MATRIX_M,
        MATRIX_K,
        0U,
        0U);
    asc_copy_l12l0a_sync(
        l0_query, l1_query, 0U, 0U, CUBE_M, MATRIX_K, MATRIX_K, 1U);

    AscendC::CrossCoreWaitFlag<kCrossCoreSyncMode, PIPE_MTE1>(
        kGatherReadyFlag);
    asc_copy_l12l0b_sync(
        l0_key, l1_gathered_key, 0U, 0U, MATRIX_N, MATRIX_K, MATRIX_N, 1U);
    asc_mmad_sync(
        l0_logits,
        l0_query,
        l0_key,
        CUBE_M,
        MATRIX_K,
        MATRIX_N,
        0U,
        true,
        false,
        true);

    AscendC::CrossCoreWaitFlag<kCrossCoreSyncMode, PIPE_FIX>(v1_score_flag);
    asc_copy_l0c2ub_sync(
        v1_logits_row_major,
        l0_logits,
        MATRIX_N,
        CUBE_M,
        MATRIX_N,
        CUBE_M,
        0U,
        true,
        0U,
        0U,
        0U,
        0U,
        false,
        true,
        0U,
        0U,
        false,
        0U,
        false,
        false,
        false,
        false);
    AscendC::CrossCoreSetFlag<kCrossCoreSyncMode, PIPE_FIX>(v1_score_flag);
}

__global__ __aicore__ void vcv_per_aiv_ub_layout_kernel(
    __gm__ const uint16_t* query_bits,
    __gm__ const uint16_t* key_table_bits,
    __gm__ const int32_t* indices,
    __gm__ float* output)
{
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_MIX_AIC_1_2);
    asc_init();
    __gm__ const bfloat16_t* query =
        reinterpret_cast<__gm__ const bfloat16_t*>(query_bits);
    __gm__ const bfloat16_t* key_table =
        reinterpret_cast<__gm__ const bfloat16_t*>(key_table_bits);

    __cbuf__ bfloat16_t l1_gathered_key[MATRIX_K * MATRIX_N];
    if ASCEND_IS_AIC {
        cube_qk_to_v1(query, l1_gathered_key);
    } else if ASCEND_IS_AIV {
        uint32_t sub_block_idx = (uint32_t)get_subblockid();
        if (sub_block_idx == 0U) {
            v0_gather_key_to_l1(
                key_table, indices, l1_gathered_key);
        } else if (sub_block_idx == 1U) {
            v1_wait_and_softmax(output);
        }
    }
    asc_sync();
}

static int check_acl(aclError result, const char* operation)
{
    if (result == ACL_SUCCESS) {
        return 1;
    }
    fprintf(stderr, "ACL call failed: %s, error=%d\n", operation, (int)result);
    return 0;
}

static uint16_t float_to_bfloat16_bits(float value)
{
    uint32_t bits;
    __builtin_memcpy(&bits, &value, sizeof(bits));
    uint32_t lsb = (bits >> 16U) & 1U;
    bits += 0x7fffU + lsb;
    return (uint16_t)(bits >> 16U);
}

static float bfloat16_bits_to_float(uint16_t value)
{
    uint32_t bits = (uint32_t)value << 16U;
    float result;
    __builtin_memcpy(&result, &bits, sizeof(result));
    return result;
}

static void fill_fixed_inputs(
    uint16_t* query, uint16_t* key_table, int32_t* indices)
{
    for (uint32_t row = 0U; row < MATRIX_M; ++row) {
        for (uint32_t dimension = 0U; dimension < MATRIX_K; ++dimension) {
            int32_t value = (int32_t)((row * 3U + dimension * 5U) % 17U) - 8;
            query[row * MATRIX_K + dimension] =
                float_to_bfloat16_bits((float)value * 0.125F);
        }
    }
    for (uint32_t row = 0U; row < KEY_TABLE_ROWS; ++row) {
        for (uint32_t dimension = 0U; dimension < MATRIX_K; ++dimension) {
            int32_t value = (int32_t)((row * 7U + dimension * 2U) % 19U) - 9;
            key_table[row * MATRIX_K + dimension] =
                float_to_bfloat16_bits((float)value * 0.125F);
        }
    }
    for (uint32_t selected = 0U; selected < MATRIX_N; ++selected) {
        indices[selected] = (int32_t)((selected * 11U + 3U) % KEY_TABLE_ROWS);
    }
}

static void build_host_softmax_oracle(
    const uint16_t* query,
    const uint16_t* key_table,
    const int32_t* indices,
    float* expected)
{
    for (uint32_t row = 0U; row < MATRIX_M; ++row) {
        double logits[MATRIX_N];
        double row_max = -INFINITY;
        for (uint32_t selected = 0U; selected < MATRIX_N; ++selected) {
            double dot = 0.0;
            uint32_t key_row = (uint32_t)indices[selected];
            for (uint32_t dimension = 0U; dimension < MATRIX_K; ++dimension) {
                float query_value = bfloat16_bits_to_float(
                    query[row * MATRIX_K + dimension]);
                float key_value = bfloat16_bits_to_float(
                    key_table[key_row * MATRIX_K + dimension]);
                dot += (double)query_value * (double)key_value;
            }
            logits[selected] = dot;
            row_max = dot > row_max ? dot : row_max;
        }

        double row_sum = 0.0;
        for (uint32_t selected = 0U; selected < MATRIX_N; ++selected) {
            row_sum += exp(logits[selected] - row_max);
        }
        for (uint32_t selected = 0U; selected < MATRIX_N; ++selected) {
            expected[row * MATRIX_N + selected] =
                (float)(exp(logits[selected] - row_max) / row_sum);
        }
    }
}

static int verify_softmax_output(const float* actual, const float* expected)
{
    for (uint32_t index = 0U; index < MATRIX_ELEMENTS; ++index) {
        float difference = fabsf(actual[index] - expected[index]);
        float tolerance = ABS_TOLERANCE + REL_TOLERANCE * fabsf(expected[index]);
        if (!isfinite(actual[index]) || difference > tolerance) {
            fprintf(
                stderr,
                "softmax mismatch index=%u expected=%.9f actual=%.9f tolerance=%.9f\n",
                index,
                expected[index],
                actual[index],
                tolerance);
            fprintf(stderr, "expected row:");
            for (uint32_t column = 0U; column < MATRIX_N; ++column) {
                fprintf(stderr, " %.6f", expected[(index / MATRIX_N) * MATRIX_N + column]);
            }
            fprintf(stderr, "\nactual row:");
            for (uint32_t column = 0U; column < MATRIX_N; ++column) {
                fprintf(stderr, " %.6f", actual[(index / MATRIX_N) * MATRIX_N + column]);
            }
            fprintf(stderr, "\n");
            return 0;
        }
    }
    for (uint32_t row = 0U; row < MATRIX_M; ++row) {
        double row_sum = 0.0;
        for (uint32_t column = 0U; column < MATRIX_N; ++column) {
            row_sum += actual[row * MATRIX_N + column];
        }
        if (fabs(row_sum - 1.0) > 1.0e-4) {
            fprintf(stderr, "softmax row sum mismatch row=%u sum=%.9f\n", row, row_sum);
            return 0;
        }
    }
    return 1;
}

static void release_device_buffers(DeviceBuffers* buffers)
{
    if (buffers->output != NULL) (void)aclrtFree(buffers->output);
    if (buffers->indices != NULL) (void)aclrtFree(buffers->indices);
    if (buffers->key_table != NULL) (void)aclrtFree(buffers->key_table);
    if (buffers->query != NULL) (void)aclrtFree(buffers->query);
    buffers->query = NULL;
    buffers->key_table = NULL;
    buffers->indices = NULL;
    buffers->output = NULL;
}

static int allocate_device_buffers(DeviceBuffers* buffers)
{
    if (!check_acl(aclrtMalloc(
            (void**)&buffers->query,
            MATRIX_M * MATRIX_K * sizeof(bfloat16_t),
            ACL_MEM_MALLOC_HUGE_FIRST), "aclrtMalloc(query)")) return 0;
    if (!check_acl(aclrtMalloc(
            (void**)&buffers->key_table,
            KEY_TABLE_ELEMENTS * sizeof(bfloat16_t),
            ACL_MEM_MALLOC_HUGE_FIRST), "aclrtMalloc(key_table)")) return 0;
    if (!check_acl(aclrtMalloc(
            (void**)&buffers->indices,
            MATRIX_N * sizeof(int32_t),
            ACL_MEM_MALLOC_HUGE_FIRST), "aclrtMalloc(indices)")) return 0;
    if (!check_acl(aclrtMalloc(
            (void**)&buffers->output,
            MATRIX_ELEMENTS * sizeof(float),
            ACL_MEM_MALLOC_HUGE_FIRST), "aclrtMalloc(output)")) return 0;
    return 1;
}

static void launch_vcv_per_aiv_ub_layout(
    const DeviceBuffers* buffers, aclrtStream stream)
{
    vcv_per_aiv_ub_layout_kernel<<<1, 0, stream>>>(
        buffers->query,
        buffers->key_table,
        buffers->indices,
        buffers->output);
}

int main(void)
{
    uint16_t query[MATRIX_M * MATRIX_K];
    uint16_t key_table[KEY_TABLE_ELEMENTS];
    int32_t indices[MATRIX_N];
    float actual[MATRIX_ELEMENTS] = {};
    float expected[MATRIX_ELEMENTS] = {};
    DeviceBuffers buffers = {NULL, NULL, NULL, NULL};
    aclrtStream stream = NULL;
    int initialized = 0;
    int device_selected = 0;
    int success = 0;

    fill_fixed_inputs(query, key_table, indices);
    build_host_softmax_oracle(query, key_table, indices, expected);

    if (!check_acl(aclInit(NULL), "aclInit")) goto cleanup;
    initialized = 1;
    if (!check_acl(aclrtSetDevice(0), "aclrtSetDevice")) goto cleanup;
    device_selected = 1;
    if (!check_acl(aclrtCreateStream(&stream), "aclrtCreateStream")) goto cleanup;
    if (!allocate_device_buffers(&buffers)) goto cleanup;
    if (!check_acl(aclrtMemcpy(
            buffers.query,
            sizeof(query),
            query,
            sizeof(query),
            ACL_MEMCPY_HOST_TO_DEVICE), "copy query H2D")) goto cleanup;
    if (!check_acl(aclrtMemcpy(
            buffers.key_table,
            sizeof(key_table),
            key_table,
            sizeof(key_table),
            ACL_MEMCPY_HOST_TO_DEVICE), "copy key table H2D")) goto cleanup;
    if (!check_acl(aclrtMemcpy(
            buffers.indices,
            sizeof(indices),
            indices,
            sizeof(indices),
            ACL_MEMCPY_HOST_TO_DEVICE), "copy indices H2D")) goto cleanup;

    launch_vcv_per_aiv_ub_layout(&buffers, stream);
    if (!check_acl(aclrtSynchronizeStream(stream), "kernel synchronize")) goto cleanup;
    if (!check_acl(aclrtMemcpy(
            actual,
            sizeof(actual),
            buffers.output,
            sizeof(actual),
            ACL_MEMCPY_DEVICE_TO_HOST), "copy output D2H")) goto cleanup;
    success = verify_softmax_output(actual, expected);

cleanup:
    release_device_buffers(&buffers);
    if (stream != NULL) (void)aclrtDestroyStream(stream);
    if (device_selected) (void)aclrtResetDevice(0);
    if (initialized) (void)aclFinalize();

    printf("Fixed Q[8,16] x gathered K[16,16]^T -> softmax[8,16]\n");
    printf("Launch: one MIX_AIC_1_2 logical AICore; V0 gather, Cube MMAD, V1 softmax\n");
    printf("Synchronization: CrossCoreSet/WaitFlag mode 4\n");
    printf("%s\n", success ? "Verification PASSED" : "Verification FAILED");
    return success ? 0 : 1;
}
