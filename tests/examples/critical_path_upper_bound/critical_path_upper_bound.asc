#include <stdint.h>
#include <stdio.h>
#include <stdlib.h>
#include <time.h>

#include "acl/acl.h"
#include "c_api/asc_simd.h"
#include "simt_api/asc_simt.h"

#ifndef SCENARIO_NUM
#define SCENARIO_NUM 0
#endif

#define ELEMENT_COUNT 262144U
#define OUTPUT_GUARD_ELEMENTS 64U
#define OUTPUT_SENTINEL (-1234567.0F)
#define BLOCK_DIM 32U
#define THREAD_COUNT 512U
#define LANE_A_STAGE_REPEATS 64U
#define CANDIDATE_BASELINE_REPEATS 32U
#define CANDIDATE_COUNTERFACTUAL_REPEATS 8U
#define DECLARED_IDEAL_SPEEDUP 4.0
#define RETENTION_GATE_PERCENT 5.0

static_assert(SCENARIO_NUM == 0 || SCENARIO_NUM == 1, "SCENARIO_NUM must be 0 or 1");

typedef struct {
    uint64_t scenario;
    uint64_t lane_id;
    uint64_t launch_count;
    uint64_t physical_loop_iterations;
    uint64_t equivalent_increment;
    uint64_t element_count;
} LaneCounters;

typedef struct {
    float* input;
    float* lane_a_temp0;
    float* lane_a_temp1;
    float* lane_a_output;
    float* lane_b_output;
    LaneCounters* lane_a_counters;
    LaneCounters* lane_b_counters;
} DeviceBuffers;

typedef struct {
    aclrtEvent lane_a_start;
    aclrtEvent lane_a_end;
    aclrtEvent lane_b_start;
    aclrtEvent lane_b_end;
} TimingEvents;

typedef struct {
    float lane_a_event_ms;
    float lane_b_event_ms;
    double join_wall_ms;
} TimingResult;

__simt_callee__ inline void write_lane_counters(
    __gm__ LaneCounters* counters, uint64_t lane_id, uint64_t launch_count,
    uint64_t physical_loop_iterations, uint64_t equivalent_increment)
{
    counters->scenario = SCENARIO_NUM;
    counters->lane_id = lane_id;
    counters->launch_count = launch_count;
    counters->physical_loop_iterations = physical_loop_iterations;
    counters->equivalent_increment = equivalent_increment;
    counters->element_count = ELEMENT_COUNT;
}

__simt_vf__ inline void lane_a_stage_vf(
    __gm__ const float* input, __gm__ float* output, __gm__ LaneCounters* counters,
    uint32_t record_counters, uint32_t block_index, uint32_t block_count)
{
    uint32_t global_thread = block_index * (uint32_t)blockDim.x + (uint32_t)threadIdx.x;
    uint32_t global_stride = block_count * (uint32_t)blockDim.x;
    for (uint32_t index = global_thread; index < ELEMENT_COUNT; index += global_stride) {
        volatile float accumulator = input[index];
        for (uint32_t repeat = 0U; repeat < LANE_A_STAGE_REPEATS; ++repeat) {
            accumulator += 1.0F;
        }
        output[index] = accumulator;
    }
    if (record_counters != 0U && block_index == 0U && threadIdx.x == 0U) {
        write_lane_counters(
            counters, 0U, 3U,
            (uint64_t)ELEMENT_COUNT * LANE_A_STAGE_REPEATS * 3U,
            LANE_A_STAGE_REPEATS * 3U);
    }
}

__global__ __vector__ void lane_a_stage0_kernel(
    __gm__ const float* input, __gm__ float* output, __gm__ LaneCounters* counters)
{
    asc_vf_call<lane_a_stage_vf>(
        dim3(THREAD_COUNT), input, output, counters, 0U, block_idx, BLOCK_DIM);
}

__global__ __vector__ void lane_a_stage1_kernel(
    __gm__ const float* input, __gm__ float* output, __gm__ LaneCounters* counters)
{
    asc_vf_call<lane_a_stage_vf>(
        dim3(THREAD_COUNT), input, output, counters, 0U, block_idx, BLOCK_DIM);
}

__global__ __vector__ void lane_a_stage2_kernel(
    __gm__ const float* input, __gm__ float* output, __gm__ LaneCounters* counters)
{
    asc_vf_call<lane_a_stage_vf>(
        dim3(THREAD_COUNT), input, output, counters, 1U, block_idx, BLOCK_DIM);
}

__simt_vf__ inline void lane_b_candidate_baseline_vf(
    __gm__ const float* input, __gm__ float* output, __gm__ LaneCounters* counters,
    uint32_t block_index, uint32_t block_count)
{
    uint32_t global_thread = block_index * (uint32_t)blockDim.x + (uint32_t)threadIdx.x;
    uint32_t global_stride = block_count * (uint32_t)blockDim.x;
    for (uint32_t index = global_thread; index < ELEMENT_COUNT; index += global_stride) {
        volatile float accumulator = input[index];
        for (uint32_t repeat = 0U; repeat < CANDIDATE_BASELINE_REPEATS; ++repeat) {
            accumulator += 1.0F;
        }
        output[index] = accumulator;
    }
    if (block_index == 0U && threadIdx.x == 0U) {
        write_lane_counters(
            counters, 1U, 1U,
            (uint64_t)ELEMENT_COUNT * CANDIDATE_BASELINE_REPEATS,
            CANDIDATE_BASELINE_REPEATS);
    }
}

__global__ __vector__ void lane_b_candidate_baseline_kernel(
    __gm__ const float* input, __gm__ float* output, __gm__ LaneCounters* counters)
{
    asc_vf_call<lane_b_candidate_baseline_vf>(
        dim3(THREAD_COUNT), input, output, counters, block_idx, BLOCK_DIM);
}

__simt_vf__ inline void lane_b_candidate_counterfactual_vf(
    __gm__ const float* input, __gm__ float* output, __gm__ LaneCounters* counters,
    uint32_t block_index, uint32_t block_count)
{
    uint32_t global_thread = block_index * (uint32_t)blockDim.x + (uint32_t)threadIdx.x;
    uint32_t global_stride = block_count * (uint32_t)blockDim.x;
    for (uint32_t index = global_thread; index < ELEMENT_COUNT; index += global_stride) {
        volatile float accumulator = input[index];
        for (uint32_t repeat = 0U; repeat < CANDIDATE_COUNTERFACTUAL_REPEATS; ++repeat) {
            accumulator += 4.0F;
        }
        output[index] = accumulator;
    }
    if (block_index == 0U && threadIdx.x == 0U) {
        write_lane_counters(
            counters, 1U, 1U,
            (uint64_t)ELEMENT_COUNT * CANDIDATE_COUNTERFACTUAL_REPEATS,
            CANDIDATE_COUNTERFACTUAL_REPEATS * 4U);
    }
}

__global__ __vector__ void lane_b_candidate_counterfactual_kernel(
    __gm__ const float* input, __gm__ float* output, __gm__ LaneCounters* counters)
{
    asc_vf_call<lane_b_candidate_counterfactual_vf>(
        dim3(THREAD_COUNT), input, output, counters, block_idx, BLOCK_DIM);
}

static int check_acl(aclError result, const char* expression, const char* file, int line)
{
    if (result == ACL_SUCCESS) {
        return 1;
    }
    fprintf(stderr, "ACL call failed: %s, ret=%d, at %s:%d\n", expression, (int)result, file, line);
    return 0;
}

static void reset_device_buffers(DeviceBuffers* buffers)
{
    buffers->input = NULL;
    buffers->lane_a_temp0 = NULL;
    buffers->lane_a_temp1 = NULL;
    buffers->lane_a_output = NULL;
    buffers->lane_b_output = NULL;
    buffers->lane_a_counters = NULL;
    buffers->lane_b_counters = NULL;
}

static void free_device_buffers(DeviceBuffers* buffers)
{
    if (buffers->lane_b_counters != NULL) {
        (void)aclrtFree(buffers->lane_b_counters);
        buffers->lane_b_counters = NULL;
    }
    if (buffers->lane_a_counters != NULL) {
        (void)aclrtFree(buffers->lane_a_counters);
        buffers->lane_a_counters = NULL;
    }
    if (buffers->lane_b_output != NULL) {
        (void)aclrtFree(buffers->lane_b_output);
        buffers->lane_b_output = NULL;
    }
    if (buffers->lane_a_output != NULL) {
        (void)aclrtFree(buffers->lane_a_output);
        buffers->lane_a_output = NULL;
    }
    if (buffers->lane_a_temp1 != NULL) {
        (void)aclrtFree(buffers->lane_a_temp1);
        buffers->lane_a_temp1 = NULL;
    }
    if (buffers->lane_a_temp0 != NULL) {
        (void)aclrtFree(buffers->lane_a_temp0);
        buffers->lane_a_temp0 = NULL;
    }
    if (buffers->input != NULL) {
        (void)aclrtFree(buffers->input);
        buffers->input = NULL;
    }
}

static int allocate_one(void** pointer, size_t bytes, const char* name)
{
    return check_acl(aclrtMalloc(pointer, bytes, ACL_MEM_MALLOC_HUGE_FIRST), name, __FILE__, __LINE__);
}

static int allocate_device_buffers(DeviceBuffers* buffers)
{
    size_t data_bytes = (size_t)ELEMENT_COUNT * sizeof(float);
    size_t output_bytes = ((size_t)ELEMENT_COUNT + OUTPUT_GUARD_ELEMENTS) * sizeof(float);
    reset_device_buffers(buffers);
    if (!allocate_one((void**)&buffers->input, data_bytes, "aclrtMalloc(input)")) goto failed;
    if (!allocate_one((void**)&buffers->lane_a_temp0, data_bytes, "aclrtMalloc(lane_a_temp0)")) goto failed;
    if (!allocate_one((void**)&buffers->lane_a_temp1, data_bytes, "aclrtMalloc(lane_a_temp1)")) goto failed;
    if (!allocate_one((void**)&buffers->lane_a_output, output_bytes, "aclrtMalloc(lane_a_output)")) goto failed;
    if (!allocate_one((void**)&buffers->lane_b_output, output_bytes, "aclrtMalloc(lane_b_output)")) goto failed;
    if (!allocate_one((void**)&buffers->lane_a_counters, sizeof(LaneCounters), "aclrtMalloc(lane_a_counters)")) goto failed;
    if (!allocate_one((void**)&buffers->lane_b_counters, sizeof(LaneCounters), "aclrtMalloc(lane_b_counters)")) goto failed;
    return 1;

failed:
    free_device_buffers(buffers);
    return 0;
}

static void reset_timing_events(TimingEvents* events)
{
    events->lane_a_start = NULL;
    events->lane_a_end = NULL;
    events->lane_b_start = NULL;
    events->lane_b_end = NULL;
}

static void destroy_timing_events(TimingEvents* events)
{
    if (events->lane_b_end != NULL) (void)aclrtDestroyEvent(events->lane_b_end);
    if (events->lane_b_start != NULL) (void)aclrtDestroyEvent(events->lane_b_start);
    if (events->lane_a_end != NULL) (void)aclrtDestroyEvent(events->lane_a_end);
    if (events->lane_a_start != NULL) (void)aclrtDestroyEvent(events->lane_a_start);
    reset_timing_events(events);
}

static int create_timing_events(TimingEvents* events)
{
    reset_timing_events(events);
    if (!check_acl(aclrtCreateEvent(&events->lane_a_start), "aclrtCreateEvent(lane_a_start)", __FILE__, __LINE__)) goto failed;
    if (!check_acl(aclrtCreateEvent(&events->lane_a_end), "aclrtCreateEvent(lane_a_end)", __FILE__, __LINE__)) goto failed;
    if (!check_acl(aclrtCreateEvent(&events->lane_b_start), "aclrtCreateEvent(lane_b_start)", __FILE__, __LINE__)) goto failed;
    if (!check_acl(aclrtCreateEvent(&events->lane_b_end), "aclrtCreateEvent(lane_b_end)", __FILE__, __LINE__)) goto failed;
    return 1;

failed:
    destroy_timing_events(events);
    return 0;
}

static double wall_elapsed_ms(const struct timespec* start, const struct timespec* end)
{
    double seconds = (double)(end->tv_sec - start->tv_sec);
    double nanoseconds = (double)(end->tv_nsec - start->tv_nsec);
    return seconds * 1000.0 + nanoseconds * 1.0e-6;
}

static void launch_lane_a(const DeviceBuffers* buffers, aclrtStream stream)
{
    lane_a_stage0_kernel<<<BLOCK_DIM, 0, stream>>>(buffers->input, buffers->lane_a_temp0, buffers->lane_a_counters);
    lane_a_stage1_kernel<<<BLOCK_DIM, 0, stream>>>(buffers->lane_a_temp0, buffers->lane_a_temp1, buffers->lane_a_counters);
    lane_a_stage2_kernel<<<BLOCK_DIM, 0, stream>>>(buffers->lane_a_temp1, buffers->lane_a_output, buffers->lane_a_counters);
}

static void launch_lane_b(const DeviceBuffers* buffers, aclrtStream stream)
{
#if SCENARIO_NUM == 0
    lane_b_candidate_baseline_kernel<<<BLOCK_DIM, 0, stream>>>(
        buffers->input, buffers->lane_b_output, buffers->lane_b_counters);
#else
    lane_b_candidate_counterfactual_kernel<<<BLOCK_DIM, 0, stream>>>(
        buffers->input, buffers->lane_b_output, buffers->lane_b_counters);
#endif
}

static int launch_and_time(
    const DeviceBuffers* buffers, const TimingEvents* events, aclrtStream stream_a,
    aclrtStream stream_b, TimingResult* timing)
{
    struct timespec wall_start = {};
    struct timespec wall_end = {};
    if (clock_gettime(CLOCK_MONOTONIC, &wall_start) != 0) {
        fprintf(stderr, "clock_gettime(start) failed\n");
        return 0;
    }
    if (!check_acl(aclrtRecordEvent(events->lane_a_start, stream_a), "aclrtRecordEvent(lane_a_start)", __FILE__, __LINE__)) return 0;
    launch_lane_a(buffers, stream_a);
    if (!check_acl(aclrtRecordEvent(events->lane_a_end, stream_a), "aclrtRecordEvent(lane_a_end)", __FILE__, __LINE__)) return 0;
    if (!check_acl(aclrtRecordEvent(events->lane_b_start, stream_b), "aclrtRecordEvent(lane_b_start)", __FILE__, __LINE__)) return 0;
    launch_lane_b(buffers, stream_b);
    if (!check_acl(aclrtRecordEvent(events->lane_b_end, stream_b), "aclrtRecordEvent(lane_b_end)", __FILE__, __LINE__)) return 0;

    if (!check_acl(aclrtSynchronizeEvent(events->lane_a_end), "aclrtSynchronizeEvent(lane_a_end)", __FILE__, __LINE__)) return 0;
    if (!check_acl(aclrtSynchronizeEvent(events->lane_b_end), "aclrtSynchronizeEvent(lane_b_end)", __FILE__, __LINE__)) return 0;
    if (clock_gettime(CLOCK_MONOTONIC, &wall_end) != 0) {
        fprintf(stderr, "clock_gettime(end) failed\n");
        return 0;
    }
    if (!check_acl(
            aclrtEventElapsedTime(&timing->lane_a_event_ms, events->lane_a_start, events->lane_a_end),
            "aclrtEventElapsedTime(lane_a)", __FILE__, __LINE__)) return 0;
    if (!check_acl(
            aclrtEventElapsedTime(&timing->lane_b_event_ms, events->lane_b_start, events->lane_b_end),
            "aclrtEventElapsedTime(lane_b)", __FILE__, __LINE__)) return 0;
    timing->join_wall_ms = wall_elapsed_ms(&wall_start, &wall_end);
    return 1;
}

static void fill_fixed_input(float* input)
{
    for (uint32_t index = 0U; index < ELEMENT_COUNT; ++index) {
        input[index] = (float)((int32_t)((index * 13U + 7U) % 101U) - 50);
    }
}

static void build_host_oracles(const float* input, float* lane_a_expected, float* lane_b_expected)
{
    for (uint32_t index = 0U; index < ELEMENT_COUNT; ++index) {
        lane_a_expected[index] = input[index] + 192.0F;
        lane_b_expected[index] = input[index] + 32.0F;
    }
}

static int verify_lane_a_output(const float* output, const float* expected)
{
    for (uint32_t index = 0U; index < ELEMENT_COUNT; ++index) {
        if (output[index] != expected[index]) {
            fprintf(stderr, "lane A output mismatch: index=%u expected=%f actual=%f\n", index, expected[index], output[index]);
            return 0;
        }
    }
    return 1;
}

static int verify_lane_b_output(const float* output, const float* expected)
{
    for (uint32_t index = 0U; index < ELEMENT_COUNT; ++index) {
        if (output[index] != expected[index]) {
            fprintf(stderr, "lane B output mismatch: index=%u expected=%f actual=%f\n", index, expected[index], output[index]);
            return 0;
        }
    }
    return 1;
}

static int verify_output_guards(const float* lane_a_output, const float* lane_b_output)
{
    for (uint32_t index = ELEMENT_COUNT; index < ELEMENT_COUNT + OUTPUT_GUARD_ELEMENTS; ++index) {
        if (lane_a_output[index] != OUTPUT_SENTINEL || lane_b_output[index] != OUTPUT_SENTINEL) {
            fprintf(stderr, "output guard mismatch: index=%u\n", index);
            return 0;
        }
    }
    return 1;
}

static int counter_equal(const char* name, uint64_t actual, uint64_t expected)
{
    if (actual == expected) return 1;
    fprintf(
        stderr, "counter mismatch: %s expected=%llu actual=%llu\n", name,
        (unsigned long long)expected, (unsigned long long)actual);
    return 0;
}

static int verify_lane_counters(const LaneCounters* lane_a, const LaneCounters* lane_b)
{
    uint64_t lane_a_launch_count = 3U;
    uint64_t lane_b_launch_count = 1U;
    uint64_t lane_b_physical_iterations = (SCENARIO_NUM == 0) ?
        (uint64_t)ELEMENT_COUNT * CANDIDATE_BASELINE_REPEATS :
        (uint64_t)ELEMENT_COUNT * CANDIDATE_COUNTERFACTUAL_REPEATS;
    return counter_equal("lane_a.scenario", lane_a->scenario, SCENARIO_NUM) &&
        counter_equal("lane_a.lane_id", lane_a->lane_id, 0U) &&
        counter_equal("lane_a.launch_count", lane_a->launch_count, lane_a_launch_count) &&
        counter_equal(
            "lane_a.physical_loop_iterations", lane_a->physical_loop_iterations,
            (uint64_t)ELEMENT_COUNT * LANE_A_STAGE_REPEATS * 3U) &&
        counter_equal("lane_a.equivalent_increment", lane_a->equivalent_increment, 192U) &&
        counter_equal("lane_b.scenario", lane_b->scenario, SCENARIO_NUM) &&
        counter_equal("lane_b.lane_id", lane_b->lane_id, 1U) &&
        counter_equal("lane_b.launch_count", lane_b->launch_count, lane_b_launch_count) &&
        counter_equal("lane_b.physical_loop_iterations", lane_b->physical_loop_iterations, lane_b_physical_iterations) &&
        counter_equal("lane_b.equivalent_increment", lane_b->equivalent_increment, 32U);
}

static void print_timing_and_bound(const TimingResult* timing)
{
    double lane_a_event_ms = (double)timing->lane_a_event_ms;
    double lane_b_event_ms = (double)timing->lane_b_event_ms;
    double max_lane_ms = (lane_a_event_ms > lane_b_event_ms) ? lane_a_event_ms : lane_b_event_ms;
    double additive_lane_sum_ms_forbidden = lane_a_event_ms + lane_b_event_ms;
    double ideal_lane_b_ms = lane_b_event_ms / DECLARED_IDEAL_SPEEDUP;
    double ideal_critical_ms = (lane_a_event_ms > ideal_lane_b_ms) ? lane_a_event_ms : ideal_lane_b_ms;
    double theoretical_upper_bound_percent = (max_lane_ms > 0.0) ?
        (max_lane_ms - ideal_critical_ms) * 100.0 / max_lane_ms : 0.0;
    const char* gate_decision =
        (theoretical_upper_bound_percent >= RETENTION_GATE_PERCENT) ? "eligible" : "reject_before_coding";
    printf(
        "TIMING lane_a_event_ms=%.6f lane_b_event_ms=%.6f join_wall_ms=%.6f "
        "max_lane_ms=%.6f additive_lane_sum_ms_forbidden=%.6f\n",
        lane_a_event_ms, lane_b_event_ms, timing->join_wall_ms,
        max_lane_ms, additive_lane_sum_ms_forbidden);
    printf(
        "BOUND declared_ideal_speedup=%.1f retention_gate_percent=%.1f "
        "theoretical_upper_bound_percent=%.6f gate_decision=%s\n",
        DECLARED_IDEAL_SPEEDUP, RETENTION_GATE_PERCENT,
        theoretical_upper_bound_percent, gate_decision);
}

static int run_case(aclrtStream stream_a, aclrtStream stream_b, const TimingEvents* events)
{
    DeviceBuffers buffers;
    TimingResult timing = {};
    LaneCounters lane_a_counters = {};
    LaneCounters lane_b_counters = {};
    float* input = NULL;
    float* lane_a_expected = NULL;
    float* lane_b_expected = NULL;
    float* lane_a_output = NULL;
    float* lane_b_output = NULL;
    size_t data_bytes = (size_t)ELEMENT_COUNT * sizeof(float);
    size_t output_count = (size_t)ELEMENT_COUNT + OUTPUT_GUARD_ELEMENTS;
    size_t output_bytes = output_count * sizeof(float);
    int ok = 0;

    reset_device_buffers(&buffers);
    input = (float*)malloc(data_bytes);
    lane_a_expected = (float*)malloc(data_bytes);
    lane_b_expected = (float*)malloc(data_bytes);
    lane_a_output = (float*)malloc(output_bytes);
    lane_b_output = (float*)malloc(output_bytes);
    if (input == NULL || lane_a_expected == NULL || lane_b_expected == NULL ||
        lane_a_output == NULL || lane_b_output == NULL) {
        fprintf(stderr, "host allocation failed\n");
        goto cleanup;
    }
    fill_fixed_input(input);
    build_host_oracles(input, lane_a_expected, lane_b_expected);
    for (size_t index = 0U; index < output_count; ++index) {
        lane_a_output[index] = OUTPUT_SENTINEL;
        lane_b_output[index] = OUTPUT_SENTINEL;
    }
    if (!allocate_device_buffers(&buffers)) goto cleanup;
    if (!check_acl(
            aclrtMemcpy(buffers.input, data_bytes, input, data_bytes, ACL_MEMCPY_HOST_TO_DEVICE),
            "aclrtMemcpy(input H2D)", __FILE__, __LINE__)) goto cleanup;
    if (!check_acl(
            aclrtMemcpy(buffers.lane_a_output, output_bytes, lane_a_output, output_bytes, ACL_MEMCPY_HOST_TO_DEVICE),
            "aclrtMemcpy(lane_a_output H2D)", __FILE__, __LINE__)) goto cleanup;
    if (!check_acl(
            aclrtMemcpy(buffers.lane_b_output, output_bytes, lane_b_output, output_bytes, ACL_MEMCPY_HOST_TO_DEVICE),
            "aclrtMemcpy(lane_b_output H2D)", __FILE__, __LINE__)) goto cleanup;
    if (!check_acl(aclrtMemset(buffers.lane_a_counters, sizeof(LaneCounters), 0, sizeof(LaneCounters)),
                   "aclrtMemset(lane_a_counters)", __FILE__, __LINE__)) goto cleanup;
    if (!check_acl(aclrtMemset(buffers.lane_b_counters, sizeof(LaneCounters), 0, sizeof(LaneCounters)),
                   "aclrtMemset(lane_b_counters)", __FILE__, __LINE__)) goto cleanup;
    if (!launch_and_time(&buffers, events, stream_a, stream_b, &timing)) goto cleanup;
    if (!check_acl(
            aclrtMemcpy(lane_a_output, output_bytes, buffers.lane_a_output, output_bytes, ACL_MEMCPY_DEVICE_TO_HOST),
            "aclrtMemcpy(lane_a_output D2H)", __FILE__, __LINE__)) goto cleanup;
    if (!check_acl(
            aclrtMemcpy(lane_b_output, output_bytes, buffers.lane_b_output, output_bytes, ACL_MEMCPY_DEVICE_TO_HOST),
            "aclrtMemcpy(lane_b_output D2H)", __FILE__, __LINE__)) goto cleanup;
    if (!check_acl(
            aclrtMemcpy(&lane_a_counters, sizeof(LaneCounters), buffers.lane_a_counters, sizeof(LaneCounters), ACL_MEMCPY_DEVICE_TO_HOST),
            "aclrtMemcpy(lane_a_counters D2H)", __FILE__, __LINE__)) goto cleanup;
    if (!check_acl(
            aclrtMemcpy(&lane_b_counters, sizeof(LaneCounters), buffers.lane_b_counters, sizeof(LaneCounters), ACL_MEMCPY_DEVICE_TO_HOST),
            "aclrtMemcpy(lane_b_counters D2H)", __FILE__, __LINE__)) goto cleanup;

    ok = verify_lane_a_output(lane_a_output, lane_a_expected) &&
        verify_lane_b_output(lane_b_output, lane_b_expected) &&
        verify_output_guards(lane_a_output, lane_b_output) &&
        verify_lane_counters(&lane_a_counters, &lane_b_counters);
    print_timing_and_bound(&timing);
    printf("scenario=%d output_oracle=PASS counter_oracle=PASS result=%s\n", SCENARIO_NUM, ok ? "PASS" : "FAIL");

cleanup:
    free_device_buffers(&buffers);
    free(lane_b_output);
    free(lane_a_output);
    free(lane_b_expected);
    free(lane_a_expected);
    free(input);
    return ok;
}

int main(void)
{
    int initialized = 0;
    int device_set = 0;
    int ok = 0;
    aclrtStream stream_a = NULL;
    aclrtStream stream_b = NULL;
    TimingEvents events;
    reset_timing_events(&events);

    if (!check_acl(aclInit(NULL), "aclInit", __FILE__, __LINE__)) goto cleanup;
    initialized = 1;
    if (!check_acl(aclrtSetDevice(0), "aclrtSetDevice", __FILE__, __LINE__)) goto cleanup;
    device_set = 1;
    if (!check_acl(aclrtCreateStream(&stream_a), "aclrtCreateStream(stream_a)", __FILE__, __LINE__)) goto cleanup;
    if (!check_acl(aclrtCreateStream(&stream_b), "aclrtCreateStream(stream_b)", __FILE__, __LINE__)) goto cleanup;
    if (!create_timing_events(&events)) goto cleanup;

    ok = run_case(stream_a, stream_b, &events);

cleanup:
    destroy_timing_events(&events);
    if (stream_b != NULL) (void)aclrtDestroyStream(stream_b);
    if (stream_a != NULL) (void)aclrtDestroyStream(stream_a);
    if (device_set) (void)aclrtResetDevice(0);
    if (initialized) (void)aclFinalize();
    printf("%s\n", ok ? "Verification PASSED" : "Verification FAILED");
    return ok ? 0 : 1;
}
