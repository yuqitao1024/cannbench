#include <cstdint>

#include "basic_api/kernel_operator_block_sync_intf.h"
#include "c_api/asc_simd.h"
#include "host_common.h"
#include "kernel_operator.h"

using namespace AscendC;

namespace {

constexpr int32_t kCanonicalContextShardCount = 16;
constexpr int32_t kRadixBins = 256;
constexpr int32_t kHistogramWords = kRadixBins;
constexpr int32_t kScoreShardElements =
    kContextCount / kCanonicalContextShardCount;
constexpr int32_t kScoreShardUbufBytes =
    kScoreShardElements * static_cast<int32_t>(sizeof(uint16_t));
constexpr int32_t kHistogramUbufBytes =
    kHistogramWords * static_cast<int32_t>(sizeof(uint32_t));
constexpr int32_t kHistogramShardWords =
    kCanonicalContextShardCount * kRadixBins;
constexpr int32_t kHistogramShardUbufBytes =
    kHistogramShardWords * static_cast<int32_t>(sizeof(uint32_t));
constexpr int32_t kCompactUbufBytes =
    2 * kScoreShardElements * static_cast<int32_t>(sizeof(uint16_t));
constexpr int32_t kTotalUbufBytes =
    kScoreShardUbufBytes + 2 * kHistogramShardUbufBytes + kCompactUbufBytes;
static_assert(kTotalUbufBytes == 45056);

constexpr int32_t kStateSelectedHigh = 0;
constexpr int32_t kStateRemainingRank = 1;
constexpr int32_t kStateThresholdKey = 2;
constexpr int32_t kStateTotalGreater = 3;
constexpr int32_t kOffsetGreater = 0;
constexpr int32_t kOffsetEqual = 1;

template <typename T>
__aicore__ inline __gm__ T* mutable_gm_ptr(__gm__ const T* pointer) {
  return const_cast<__gm__ T*>(pointer);
}

__aicore__ inline void publish_gm_for_next_stage() {
  __builtin_cce_dcci(nullptr, 1, 0);
}

__simd_vf__ void distributed_high_histogram_simd_vf(
    __ubuf__ uint16_t* score_shard,
    __ubuf__ uint16_t* key_scratch,
    __ubuf__ uint32_t* local_histogram) {
  MicroAPI::MaskReg all_u16 =
      MicroAPI::CreateMask<uint16_t, MicroAPI::MaskPattern::ALL>();
  MicroAPI::MaskReg all_u8 =
      MicroAPI::CreateMask<uint8_t, MicroAPI::MaskPattern::ALL>();
  MicroAPI::MaskReg all_u32 =
      MicroAPI::CreateMask<uint32_t, MicroAPI::MaskPattern::ALL>();
  MicroAPI::RegTensor<uint16_t> values;
  MicroAPI::RegTensor<uint16_t> sign;
  MicroAPI::RegTensor<uint16_t> zero;
  MicroAPI::RegTensor<uint16_t> sign_mask;
  MicroAPI::RegTensor<uint16_t> all_one;
  MicroAPI::RegTensor<uint16_t> xor_mask;
  MicroAPI::MaskReg negative;
  MicroAPI::Duplicate(zero, static_cast<uint16_t>(0), all_u16);
  MicroAPI::Duplicate(sign_mask, static_cast<uint16_t>(0x8000), all_u16);
  MicroAPI::Duplicate(all_one, static_cast<uint16_t>(0xffff), all_u16);
  for (uint16_t repeat = 0; repeat < 16; ++repeat) {
    MicroAPI::LoadAlign<uint16_t>(values, score_shard + repeat * 128);
    MicroAPI::And(sign, values, sign_mask, all_u16);
    MicroAPI::Compare<uint16_t, CMPMODE::GT>(
        negative, sign, zero, all_u16);
    MicroAPI::Select(xor_mask, all_one, sign_mask, negative);
    MicroAPI::Xor(values, values, xor_mask, all_u16);
    MicroAPI::StoreAlign<uint16_t>(key_scratch + repeat * 128, values, all_u16);
  }
  MicroAPI::LocalMemBar<
      MicroAPI::MemType::VEC_STORE, MicroAPI::MemType::VEC_LOAD>();

  MicroAPI::RegTensor<uint16_t> histogram_low;
  MicroAPI::RegTensor<uint16_t> histogram_high;
  MicroAPI::RegTensor<uint16_t> low_bytes;
  MicroAPI::RegTensor<uint16_t> high_bytes;
  MicroAPI::Duplicate(histogram_low, static_cast<uint16_t>(0));
  MicroAPI::Duplicate(histogram_high, static_cast<uint16_t>(0));
  for (uint16_t repeat = 0; repeat < 8; ++repeat) {
    MicroAPI::LoadAlign<uint16_t, MicroAPI::LoadDist::DIST_DINTLV_B8>(
        low_bytes, high_bytes, key_scratch + repeat * 256);
    MicroAPI::Histograms<
        uint8_t, uint16_t, MicroAPI::HistogramsBinType::BIN0,
        MicroAPI::HistogramsType::FREQUENCY>(
            histogram_low,
            reinterpret_cast<MicroAPI::RegTensor<uint8_t>&>(high_bytes),
            all_u8);
    MicroAPI::Histograms<
        uint8_t, uint16_t, MicroAPI::HistogramsBinType::BIN1,
        MicroAPI::HistogramsType::FREQUENCY>(
            histogram_high,
            reinterpret_cast<MicroAPI::RegTensor<uint8_t>&>(high_bytes),
            all_u8);
  }

  static constexpr MicroAPI::CastTrait even = {
      MicroAPI::RegLayout::ZERO, MicroAPI::SatMode::UNKNOWN,
      MicroAPI::MaskMergeMode::ZEROING, RoundMode::UNKNOWN};
  static constexpr MicroAPI::CastTrait odd = {
      MicroAPI::RegLayout::ONE, MicroAPI::SatMode::UNKNOWN,
      MicroAPI::MaskMergeMode::ZEROING, RoundMode::UNKNOWN};
  MicroAPI::RegTensor<uint32_t> low_even;
  MicroAPI::RegTensor<uint32_t> low_odd;
  MicroAPI::RegTensor<uint32_t> high_even;
  MicroAPI::RegTensor<uint32_t> high_odd;
  MicroAPI::Cast<uint32_t, uint16_t, even>(low_even, histogram_low, all_u16);
  MicroAPI::Cast<uint32_t, uint16_t, odd>(low_odd, histogram_low, all_u16);
  MicroAPI::Cast<uint32_t, uint16_t, even>(high_even, histogram_high, all_u16);
  MicroAPI::Cast<uint32_t, uint16_t, odd>(high_odd, histogram_high, all_u16);
  MicroAPI::StoreAlign<uint32_t, MicroAPI::StoreDist::DIST_INTLV_B32>(
      local_histogram, low_even, low_odd, all_u32);
  MicroAPI::StoreAlign<uint32_t, MicroAPI::StoreDist::DIST_INTLV_B32>(
      local_histogram + 128, high_even, high_odd, all_u32);
}

__simd_vf__ void distributed_select_high_simd_vf(
    __ubuf__ uint32_t* high_histogram_shards,
    __ubuf__ uint32_t* combined_histogram) {
  MicroAPI::MaskReg all =
      MicroAPI::CreateMask<uint32_t, MicroAPI::MaskPattern::ALL>();
  MicroAPI::RegTensor<uint32_t> sum;
  MicroAPI::RegTensor<uint32_t> shard;
  for (uint16_t chunk = 0; chunk < 4; ++chunk) {
    MicroAPI::LoadAlign<uint32_t>(sum, high_histogram_shards + chunk * 64);
    for (uint16_t shard_index = 1;
         shard_index < kCanonicalContextShardCount;
         ++shard_index) {
      MicroAPI::LoadAlign<uint32_t>(
          shard,
          high_histogram_shards + shard_index * kRadixBins + chunk * 64);
      MicroAPI::Add(sum, sum, shard, all);
    }
    MicroAPI::StoreAlign<uint32_t>(combined_histogram + chunk * 64, sum, all);
  }
}

__simd_vf__ void distributed_low_histogram_simd_vf(
    __ubuf__ uint16_t* score_shard,
    __ubuf__ uint16_t* key_scratch,
    __ubuf__ uint32_t* local_histogram,
    uint16_t selected_high) {
  MicroAPI::MaskReg all_u16 =
      MicroAPI::CreateMask<uint16_t, MicroAPI::MaskPattern::ALL>();
  MicroAPI::MaskReg all_u8 =
      MicroAPI::CreateMask<uint8_t, MicroAPI::MaskPattern::ALL>();
  MicroAPI::MaskReg all_u32 =
      MicroAPI::CreateMask<uint32_t, MicroAPI::MaskPattern::ALL>();
  MicroAPI::RegTensor<uint16_t> values;
  MicroAPI::RegTensor<uint16_t> sign;
  MicroAPI::RegTensor<uint16_t> zero;
  MicroAPI::RegTensor<uint16_t> sign_mask;
  MicroAPI::RegTensor<uint16_t> all_one;
  MicroAPI::RegTensor<uint16_t> xor_mask;
  MicroAPI::MaskReg negative;
  MicroAPI::Duplicate(zero, static_cast<uint16_t>(0), all_u16);
  MicroAPI::Duplicate(sign_mask, static_cast<uint16_t>(0x8000), all_u16);
  MicroAPI::Duplicate(all_one, static_cast<uint16_t>(0xffff), all_u16);
  for (uint16_t repeat = 0; repeat < 16; ++repeat) {
    MicroAPI::LoadAlign<uint16_t>(values, score_shard + repeat * 128);
    MicroAPI::And(sign, values, sign_mask, all_u16);
    MicroAPI::Compare<uint16_t, CMPMODE::GT>(
        negative, sign, zero, all_u16);
    MicroAPI::Select(xor_mask, all_one, sign_mask, negative);
    MicroAPI::Xor(values, values, xor_mask, all_u16);
    MicroAPI::StoreAlign<uint16_t>(key_scratch + repeat * 128, values, all_u16);
  }
  MicroAPI::LocalMemBar<
      MicroAPI::MemType::VEC_STORE, MicroAPI::MemType::VEC_LOAD>();

  MicroAPI::RegTensor<uint8_t> selected_high_values;
  MicroAPI::RegTensor<uint16_t> histogram_low;
  MicroAPI::RegTensor<uint16_t> histogram_high;
  MicroAPI::RegTensor<uint16_t> low_bytes;
  MicroAPI::RegTensor<uint16_t> high_bytes;
  MicroAPI::Duplicate(selected_high_values, static_cast<uint8_t>(selected_high));
  MicroAPI::Duplicate(histogram_low, static_cast<uint16_t>(0));
  MicroAPI::Duplicate(histogram_high, static_cast<uint16_t>(0));
  for (uint16_t repeat = 0; repeat < 8; ++repeat) {
    MicroAPI::MaskReg selected;
    MicroAPI::LoadAlign<uint16_t, MicroAPI::LoadDist::DIST_DINTLV_B8>(
        low_bytes, high_bytes, key_scratch + repeat * 256);
    MicroAPI::Compare<uint8_t, CMPMODE::EQ>(
        selected,
        reinterpret_cast<MicroAPI::RegTensor<uint8_t>&>(high_bytes),
        selected_high_values,
        all_u8);
    MicroAPI::Histograms<
        uint8_t, uint16_t, MicroAPI::HistogramsBinType::BIN0,
        MicroAPI::HistogramsType::FREQUENCY>(
            histogram_low,
            reinterpret_cast<MicroAPI::RegTensor<uint8_t>&>(low_bytes),
            selected);
    MicroAPI::Histograms<
        uint8_t, uint16_t, MicroAPI::HistogramsBinType::BIN1,
        MicroAPI::HistogramsType::FREQUENCY>(
            histogram_high,
            reinterpret_cast<MicroAPI::RegTensor<uint8_t>&>(low_bytes),
            selected);
  }

  static constexpr MicroAPI::CastTrait even = {
      MicroAPI::RegLayout::ZERO, MicroAPI::SatMode::UNKNOWN,
      MicroAPI::MaskMergeMode::ZEROING, RoundMode::UNKNOWN};
  static constexpr MicroAPI::CastTrait odd = {
      MicroAPI::RegLayout::ONE, MicroAPI::SatMode::UNKNOWN,
      MicroAPI::MaskMergeMode::ZEROING, RoundMode::UNKNOWN};
  MicroAPI::RegTensor<uint32_t> low_even;
  MicroAPI::RegTensor<uint32_t> low_odd;
  MicroAPI::RegTensor<uint32_t> high_even;
  MicroAPI::RegTensor<uint32_t> high_odd;
  MicroAPI::Cast<uint32_t, uint16_t, even>(low_even, histogram_low, all_u16);
  MicroAPI::Cast<uint32_t, uint16_t, odd>(low_odd, histogram_low, all_u16);
  MicroAPI::Cast<uint32_t, uint16_t, even>(high_even, histogram_high, all_u16);
  MicroAPI::Cast<uint32_t, uint16_t, odd>(high_odd, histogram_high, all_u16);
  MicroAPI::StoreAlign<uint32_t, MicroAPI::StoreDist::DIST_INTLV_B32>(
      local_histogram, low_even, low_odd, all_u32);
  MicroAPI::StoreAlign<uint32_t, MicroAPI::StoreDist::DIST_INTLV_B32>(
      local_histogram + 128, high_even, high_odd, all_u32);
}

__simd_vf__ void distributed_select_low_offsets_simd_vf(
    __ubuf__ uint32_t* low_histogram_shards,
    __ubuf__ uint32_t* combined_histogram) {
  MicroAPI::MaskReg all =
      MicroAPI::CreateMask<uint32_t, MicroAPI::MaskPattern::ALL>();
  MicroAPI::RegTensor<uint32_t> sum;
  MicroAPI::RegTensor<uint32_t> shard;
  for (uint16_t chunk = 0; chunk < 4; ++chunk) {
    MicroAPI::LoadAlign<uint32_t>(sum, low_histogram_shards + chunk * 64);
    for (uint16_t shard_index = 1;
         shard_index < kCanonicalContextShardCount;
         ++shard_index) {
      MicroAPI::LoadAlign<uint32_t>(
          shard,
          low_histogram_shards + shard_index * kRadixBins + chunk * 64);
      MicroAPI::Add(sum, sum, shard, all);
    }
    MicroAPI::StoreAlign<uint32_t>(combined_histogram + chunk * 64, sum, all);
  }
}

__simd_vf__ void distributed_compact_simd_vf(
    __ubuf__ uint16_t* score_shard,
    __ubuf__ uint16_t* key_scratch,
    __ubuf__ uint16_t* greater_indices,
    __ubuf__ uint16_t* equal_indices,
    __ubuf__ uint32_t* greater_indices_u32,
    __ubuf__ uint32_t* equal_indices_u32,
    uint16_t threshold_key,
    int16_t context_start) {
  MicroAPI::MaskReg all_u16 =
      MicroAPI::CreateMask<uint16_t, MicroAPI::MaskPattern::ALL>();
  MicroAPI::MaskReg all_u32 =
      MicroAPI::CreateMask<uint32_t, MicroAPI::MaskPattern::ALL>();
  MicroAPI::RegTensor<uint16_t> values;
  MicroAPI::RegTensor<uint16_t> sign;
  MicroAPI::RegTensor<uint16_t> zero;
  MicroAPI::RegTensor<uint16_t> sign_mask;
  MicroAPI::RegTensor<uint16_t> all_one;
  MicroAPI::RegTensor<uint16_t> xor_mask;
  MicroAPI::MaskReg negative;
  MicroAPI::Duplicate(zero, static_cast<uint16_t>(0), all_u16);
  MicroAPI::Duplicate(sign_mask, static_cast<uint16_t>(0x8000), all_u16);
  MicroAPI::Duplicate(all_one, static_cast<uint16_t>(0xffff), all_u16);
  for (uint16_t repeat = 0; repeat < 16; ++repeat) {
    MicroAPI::LoadAlign<uint16_t>(values, score_shard + repeat * 128);
    MicroAPI::And(sign, values, sign_mask, all_u16);
    MicroAPI::Compare<uint16_t, CMPMODE::GT>(
        negative, sign, zero, all_u16);
    MicroAPI::Select(xor_mask, all_one, sign_mask, negative);
    MicroAPI::Xor(values, values, xor_mask, all_u16);
    MicroAPI::StoreAlign<uint16_t>(key_scratch + repeat * 128, values, all_u16);
  }
  MicroAPI::LocalMemBar<
      MicroAPI::MemType::VEC_STORE, MicroAPI::MemType::VEC_LOAD>();

  MicroAPI::RegTensor<uint16_t> threshold;
  MicroAPI::RegTensor<int16_t> indices;
  MicroAPI::RegTensor<uint16_t> selected_indices;
  MicroAPI::Duplicate(threshold, threshold_key, all_u16);
  MicroAPI::ClearSpr<AscendC::SpecialPurposeReg::AR>();
  MicroAPI::UnalignRegForStore greater_store;
  for (uint16_t repeat = 0; repeat < 16; ++repeat) {
    MicroAPI::MaskReg selected;
    MicroAPI::LoadAlign<uint16_t>(values, key_scratch + repeat * 128);
    MicroAPI::Arange(indices, context_start + repeat * 128);
    MicroAPI::Compare<uint16_t, CMPMODE::GT>(
        selected, values, threshold, all_u16);
    MicroAPI::Squeeze<uint16_t, MicroAPI::GatherMaskMode::STORE_REG>(
        selected_indices,
        reinterpret_cast<MicroAPI::RegTensor<uint16_t>&>(indices),
        selected);
    MicroAPI::StoreUnAlign<
        uint16_t, MicroAPI::PostLiteral::POST_MODE_UPDATE>(
            greater_indices, selected_indices, greater_store);
  }
  MicroAPI::StoreUnAlignPost(greater_indices, greater_store);

  MicroAPI::ClearSpr<AscendC::SpecialPurposeReg::AR>();
  MicroAPI::UnalignRegForStore equal_store;
  for (uint16_t repeat = 0; repeat < 16; ++repeat) {
    MicroAPI::MaskReg selected;
    MicroAPI::LoadAlign<uint16_t>(values, key_scratch + repeat * 128);
    MicroAPI::Arange(indices, context_start + repeat * 128);
    MicroAPI::Compare<uint16_t, CMPMODE::EQ>(
        selected, values, threshold, all_u16);
    MicroAPI::Squeeze<uint16_t, MicroAPI::GatherMaskMode::STORE_REG>(
        selected_indices,
        reinterpret_cast<MicroAPI::RegTensor<uint16_t>&>(indices),
        selected);
    MicroAPI::StoreUnAlign<
        uint16_t, MicroAPI::PostLiteral::POST_MODE_UPDATE>(
            equal_indices, selected_indices, equal_store);
  }
  MicroAPI::StoreUnAlignPost(equal_indices, equal_store);
  MicroAPI::LocalMemBar<
      MicroAPI::MemType::VEC_STORE, MicroAPI::MemType::VEC_LOAD>();

  static constexpr MicroAPI::CastTrait even = {
      MicroAPI::RegLayout::ZERO, MicroAPI::SatMode::UNKNOWN,
      MicroAPI::MaskMergeMode::ZEROING, RoundMode::UNKNOWN};
  static constexpr MicroAPI::CastTrait odd = {
      MicroAPI::RegLayout::ONE, MicroAPI::SatMode::UNKNOWN,
      MicroAPI::MaskMergeMode::ZEROING, RoundMode::UNKNOWN};
  MicroAPI::RegTensor<uint16_t> packed_indices;
  MicroAPI::RegTensor<uint32_t> even_indices;
  MicroAPI::RegTensor<uint32_t> odd_indices;
  for (uint16_t repeat = 0; repeat < 16; ++repeat) {
    MicroAPI::LoadAlign<uint16_t>(packed_indices, greater_indices + repeat * 128);
    MicroAPI::Cast<uint32_t, uint16_t, even>(
        even_indices, packed_indices, all_u16);
    MicroAPI::Cast<uint32_t, uint16_t, odd>(
        odd_indices, packed_indices, all_u16);
    MicroAPI::StoreAlign<uint32_t, MicroAPI::StoreDist::DIST_INTLV_B32>(
        greater_indices_u32 + repeat * 128,
        even_indices,
        odd_indices,
        all_u32);
    MicroAPI::LoadAlign<uint16_t>(packed_indices, equal_indices + repeat * 128);
    MicroAPI::Cast<uint32_t, uint16_t, even>(
        even_indices, packed_indices, all_u16);
    MicroAPI::Cast<uint32_t, uint16_t, odd>(
        odd_indices, packed_indices, all_u16);
    MicroAPI::StoreAlign<uint32_t, MicroAPI::StoreDist::DIST_INTLV_B32>(
        equal_indices_u32 + repeat * 128,
        even_indices,
        odd_indices,
        all_u32);
  }
}

}  // namespace

__global__ __vector__ void dsa_decode_topk_simd_micro_kernel(
    __gm__ const uint16_t* reduced_scores,
    __gm__ uint32_t* high_histogram,
    __gm__ uint32_t* low_histogram,
    __gm__ uint32_t* state,
    __gm__ uint32_t* shard_offsets,
    __gm__ int32_t* output,
    int32_t row_count,
    int32_t context_shard_count) {
  extern __ubuf__ uint32_t dynamicStartUB[];
  asc_init();
  const int32_t block_index = static_cast<int32_t>(get_block_idx());
  if (block_index >= row_count * context_shard_count ||
      context_shard_count != kCanonicalContextShardCount) {
    return;
  }
  const int32_t row_index = block_index / context_shard_count;
  const int32_t shard_index = block_index % context_shard_count;
  const int32_t context_start = shard_index * kScoreShardElements;
  const int64_t score_base =
      static_cast<int64_t>(row_index) * kContextCount + context_start;
  const int64_t histogram_base =
      static_cast<int64_t>(block_index) * kRadixBins;
  const int64_t state_base =
      static_cast<int64_t>(row_index) * kStateWordsPerRow;
  const int64_t reducer_state_base =
      static_cast<int64_t>(block_index) * kStateWordsPerRow;
  const int64_t offset_base =
      static_cast<int64_t>(block_index) * kOffsetWordsPerShard;

  __ubuf__ uint16_t* score_shard =
      reinterpret_cast<__ubuf__ uint16_t*>(dynamicStartUB);
  __ubuf__ uint32_t* high_histogram_shards =
      dynamicStartUB + kScoreShardUbufBytes / sizeof(uint32_t);
  __ubuf__ uint32_t* low_histogram_shards =
      high_histogram_shards + kHistogramShardWords;
  __ubuf__ uint32_t* stage_scratch =
      low_histogram_shards + kHistogramShardWords;
  __ubuf__ uint16_t* key_scratch =
      reinterpret_cast<__ubuf__ uint16_t*>(stage_scratch);
  __ubuf__ uint32_t* local_histogram =
      stage_scratch + kScoreShardUbufBytes / sizeof(uint32_t);

  asc_copy_gm2ub_align(
      score_shard,
      mutable_gm_ptr(reduced_scores + score_base),
      static_cast<uint32_t>(kScoreShardUbufBytes));
  asc_sync_notify(PIPE_MTE2, PIPE_V, EVENT_ID0);
  asc_sync_wait(PIPE_MTE2, PIPE_V, EVENT_ID0);

  __VEC_SCOPE__ {
    distributed_high_histogram_simd_vf(
        score_shard, key_scratch, local_histogram);
  }
  AscendC::PipeBarrier<PIPE_ALL>();
  asc_sync_notify(PIPE_V, PIPE_S, EVENT_ID0);
  asc_sync_wait(PIPE_V, PIPE_S, EVENT_ID0);
  uint32_t suffix = 0;
  for (int32_t bucket = kRadixBins - 1; bucket >= 0; --bucket) {
    suffix += local_histogram[bucket];
    local_histogram[bucket] = suffix;
  }
  asc_sync_notify(PIPE_S, PIPE_MTE3, EVENT_ID0);
  asc_sync_wait(PIPE_S, PIPE_MTE3, EVENT_ID0);
  asc_copy_ub2gm_align(
      high_histogram + histogram_base,
      local_histogram,
      static_cast<uint32_t>(kHistogramUbufBytes));
  asc_sync_notify(PIPE_MTE3, PIPE_V, EVENT_ID1);
  asc_sync_wait(PIPE_MTE3, PIPE_V, EVENT_ID1);
  publish_gm_for_next_stage();
  AscendC::SyncAll();

  if (block_index < row_count) {
    const int64_t row_histogram_base =
        static_cast<int64_t>(block_index) * kHistogramShardWords;
    asc_copy_gm2ub_align(
        high_histogram_shards,
        high_histogram + row_histogram_base,
        static_cast<uint32_t>(kHistogramShardUbufBytes));
    asc_sync_notify(PIPE_MTE2, PIPE_V, EVENT_ID0);
    asc_sync_wait(PIPE_MTE2, PIPE_V, EVENT_ID0);
  }
  __VEC_SCOPE__ {
    if (block_index < row_count) {
      distributed_select_high_simd_vf(
          high_histogram_shards, stage_scratch);
    }
  }
  AscendC::PipeBarrier<PIPE_ALL>();
  asc_sync_notify(PIPE_V, PIPE_S, EVENT_ID0);
  asc_sync_wait(PIPE_V, PIPE_S, EVENT_ID0);
  if (block_index < row_count) {
    for (int32_t bucket = kRadixBins - 1; bucket >= 0; --bucket) {
      const uint32_t inclusive_count = stage_scratch[bucket];
      const uint32_t greater_count =
          bucket + 1 < kRadixBins ? stage_scratch[bucket + 1] : 0U;
      if (inclusive_count >= static_cast<uint32_t>(kTopK) &&
          greater_count < static_cast<uint32_t>(kTopK)) {
        asc_store_dev(
            state + reducer_state_base + kStateSelectedHigh,
            static_cast<uint32_t>(bucket));
        asc_store_dev(
            state + reducer_state_base + kStateRemainingRank,
            static_cast<uint32_t>(kTopK) - greater_count);
      }
    }
    publish_gm_for_next_stage();
  }
  AscendC::SyncAll();

  const uint16_t selected_high = static_cast<uint16_t>(
      state[state_base + kStateSelectedHigh]);
  __VEC_SCOPE__ {
    distributed_low_histogram_simd_vf(
        score_shard, key_scratch, local_histogram, selected_high);
  }
  AscendC::PipeBarrier<PIPE_ALL>();
  asc_sync_notify(PIPE_V, PIPE_S, EVENT_ID0);
  asc_sync_wait(PIPE_V, PIPE_S, EVENT_ID0);
  suffix = 0;
  for (int32_t bucket = kRadixBins - 1; bucket >= 0; --bucket) {
    suffix += local_histogram[bucket];
    local_histogram[bucket] = suffix;
  }
  asc_sync_notify(PIPE_S, PIPE_MTE3, EVENT_ID0);
  asc_sync_wait(PIPE_S, PIPE_MTE3, EVENT_ID0);
  asc_copy_ub2gm_align(
      low_histogram + histogram_base,
      local_histogram,
      static_cast<uint32_t>(kHistogramUbufBytes));
  asc_sync_notify(PIPE_MTE3, PIPE_V, EVENT_ID1);
  asc_sync_wait(PIPE_MTE3, PIPE_V, EVENT_ID1);
  publish_gm_for_next_stage();
  AscendC::SyncAll();

  if (block_index < row_count) {
    const int64_t row_histogram_base =
        static_cast<int64_t>(block_index) * kHistogramShardWords;
    asc_copy_gm2ub_align(
        low_histogram_shards,
        low_histogram + row_histogram_base,
        static_cast<uint32_t>(kHistogramShardUbufBytes));
    asc_sync_notify(PIPE_MTE2, PIPE_V, EVENT_ID0);
    asc_sync_wait(PIPE_MTE2, PIPE_V, EVENT_ID0);
  }
  __VEC_SCOPE__ {
    if (block_index < row_count) {
      distributed_select_low_offsets_simd_vf(
          low_histogram_shards, stage_scratch);
    }
  }
  AscendC::PipeBarrier<PIPE_ALL>();
  asc_sync_notify(PIPE_V, PIPE_S, EVENT_ID0);
  asc_sync_wait(PIPE_V, PIPE_S, EVENT_ID0);
  if (block_index < row_count) {
    const uint32_t remaining_rank =
        state[reducer_state_base + kStateRemainingRank];
    const uint32_t reducer_selected_high =
        state[reducer_state_base + kStateSelectedHigh];
    uint32_t selected_low = 0;
    for (int32_t bucket = kRadixBins - 1; bucket >= 0; --bucket) {
      const uint32_t inclusive_count = stage_scratch[bucket];
      const uint32_t greater_count =
          bucket + 1 < kRadixBins ? stage_scratch[bucket + 1] : 0U;
      if (inclusive_count >= remaining_rank && greater_count < remaining_rank) {
        selected_low = static_cast<uint32_t>(bucket);
      }
    }
    asc_store_dev(
        state + reducer_state_base + kStateThresholdKey,
        (reducer_selected_high << 8) | selected_low);

    uint32_t greater_prefix = 0;
    uint32_t equal_prefix = 0;
    for (int32_t shard = 0;
         shard < kCanonicalContextShardCount;
         ++shard) {
      const int32_t shard_histogram_base = shard * kRadixBins;
      const uint32_t high_greater =
          reducer_selected_high + 1 < kRadixBins
              ? high_histogram_shards[
                    shard_histogram_base + reducer_selected_high + 1]
              : 0U;
      const uint32_t low_greater =
          selected_low + 1 < kRadixBins
              ? low_histogram_shards[
                    shard_histogram_base + selected_low + 1]
              : 0U;
      const uint32_t inclusive_low =
          low_histogram_shards[shard_histogram_base + selected_low];
      const int64_t shard_offset_base =
          (static_cast<int64_t>(block_index) * context_shard_count + shard) *
          kOffsetWordsPerShard;
      asc_store_dev(
          shard_offsets + shard_offset_base + kOffsetGreater,
          greater_prefix);
      asc_store_dev(
          shard_offsets + shard_offset_base + kOffsetEqual,
          equal_prefix);
      greater_prefix += high_greater + low_greater;
      equal_prefix += inclusive_low - low_greater;
    }
    asc_store_dev(
        state + reducer_state_base + kStateTotalGreater,
        greater_prefix);
    publish_gm_for_next_stage();
  }
  AscendC::SyncAll();

  const uint16_t threshold_key = static_cast<uint16_t>(
      state[state_base + kStateThresholdKey]);
  __ubuf__ uint16_t* greater_indices =
      reinterpret_cast<__ubuf__ uint16_t*>(stage_scratch);
  __ubuf__ uint16_t* equal_indices =
      greater_indices + kScoreShardElements;
  __VEC_SCOPE__ {
    distributed_compact_simd_vf(
        score_shard,
        reinterpret_cast<__ubuf__ uint16_t*>(high_histogram_shards),
        greater_indices,
        equal_indices,
        high_histogram_shards,
        low_histogram_shards,
        threshold_key,
        static_cast<int16_t>(context_start));
  }
  AscendC::PipeBarrier<PIPE_ALL>();
  asc_sync_notify(PIPE_V, PIPE_S, EVENT_ID0);
  asc_sync_wait(PIPE_V, PIPE_S, EVENT_ID0);

  const uint32_t selected_low =
      static_cast<uint32_t>(threshold_key & 0xffU);
  const uint32_t high_greater_count =
      selected_high + 1 < kRadixBins
          ? high_histogram[histogram_base + selected_high + 1]
          : 0U;
  const uint32_t low_greater_count =
      selected_low + 1 < kRadixBins
          ? low_histogram[histogram_base + selected_low + 1]
          : 0U;
  const uint32_t inclusive_low_count =
      low_histogram[histogram_base + selected_low];
  const uint32_t shard_greater_count =
      high_greater_count + low_greater_count;
  const uint32_t shard_equal_count =
      inclusive_low_count - low_greater_count;
  const uint32_t shard_greater_offset =
      shard_offsets[offset_base + kOffsetGreater];
  const uint32_t shard_equal_offset =
      shard_offsets[offset_base + kOffsetEqual];
  const uint32_t total_greater_count =
      state[state_base + kStateTotalGreater];
  const uint32_t equal_count_needed =
      static_cast<uint32_t>(kTopK) - total_greater_count;
  const uint32_t equal_count_to_write =
      shard_equal_offset < equal_count_needed
          ? (shard_equal_count < equal_count_needed - shard_equal_offset
                 ? shard_equal_count
                 : equal_count_needed - shard_equal_offset)
          : 0U;
  const int64_t row_output_base =
      static_cast<int64_t>(row_index) * kTopK;
  asc_sync_notify(PIPE_S, PIPE_MTE3, EVENT_ID0);
  asc_sync_wait(PIPE_S, PIPE_MTE3, EVENT_ID0);
  if (shard_greater_count != 0U) {
    asc_copy_ub2gm_align(
        output + row_output_base + shard_greater_offset,
        reinterpret_cast<__ubuf__ int32_t*>(high_histogram_shards),
        shard_greater_count * static_cast<uint32_t>(sizeof(int32_t)));
  }
  if (equal_count_to_write != 0U) {
    asc_copy_ub2gm_align(
        output + row_output_base + total_greater_count + shard_equal_offset,
        reinterpret_cast<__ubuf__ int32_t*>(low_histogram_shards),
        equal_count_to_write * static_cast<uint32_t>(sizeof(int32_t)));
  }
  asc_sync();
}

static void launch_topk(
    const bfloat16_t* reduced_scores,
    uint32_t* high_histogram,
    uint32_t* low_histogram,
    uint32_t* state,
    uint32_t* shard_offsets,
    int32_t* output,
    aclrtStream stream) {
  dsa_decode_topk_simd_micro_kernel
      <<<kRowCount * kCanonicalContextShardCount,
         kTotalUbufBytes, stream>>>(
          reinterpret_cast<const uint16_t*>(reduced_scores),
          high_histogram,
          low_histogram,
          state,
          shard_offsets,
          output,
          kRowCount,
          kCanonicalContextShardCount);
}

int main(void) { return run_topk_example(launch_topk); }
