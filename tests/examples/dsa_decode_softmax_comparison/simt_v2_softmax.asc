#include <stdint.h>
#include <limits>

#include "host_common.h"
#include "kernel_operator.h"
#include "c_api/asc_simd.h"
#include "simt_api/asc_bf16.h"
#include "simt_api/asc_simt.h"

// Fixed-shape extraction of the V3.2 rolling-decode Softmax path in:
// src/cannbench/operators/builtin/sparse_attention/simt/v2/
// aten_dsa_sparse_attention_v2/csrc/simt/sparse_attention_head64_fused_hd576.asc
// SHA-256: 5817bea44cfb8c86837b8f5cbf561725cf6b37f5a9a05f4784cd02690b2ea4eb
// The VF bodies and their one-call-per-128-token-tile boundary are retained.

using namespace AscendC;

constexpr uint32_t kHead64FusedLaunchThreads = 1024;
constexpr uint32_t kHead64FusedActiveThreads = 1024;
constexpr uint32_t kHead64FusedActiveWarps = 32;
constexpr uint32_t kHead64FusedVllmSelectedTile = 128;
constexpr uint32_t kHead64FusedVllmUbRunningMaxOffset = 0;
constexpr uint32_t kHead64FusedVllmUbRunningSumOffset = 128;
constexpr uint32_t kHead64FusedVllmUbOldScaleOffset = 256;
constexpr uint32_t kHead64FusedVllmUbScoresOffset = 103040;
constexpr uint32_t kHead64FusedVllmUbProbabilitiesOffset = 119424;
constexpr uint32_t kHead64FusedDynamicUbBytes = 211584;

__simt_callee__ inline float head64_warp_max(float value)
{
    for (uint32_t offset = 16U; offset > 0U; offset >>= 1U) {
        const float peer = asc_shfl_xor(value, static_cast<int32_t>(offset), 32);
        value = value < peer ? peer : value;
    }
    return value;
}

__simt_callee__ inline float head64_warp_sum(float value)
{
    for (uint32_t offset = 16U; offset > 0U; offset >>= 1U) {
        value += asc_shfl_xor(value, static_cast<int32_t>(offset), 32);
    }
    return value;
}

__simt_callee__ inline uint32_t head64_fused_nz_offset(
    uint32_t row, uint32_t column, uint32_t row_count)
{
    return (column / 16U) * 16U * row_count +
        (row / 16U) * 16U * 16U + (row % 16U) * 16U + column % 16U;
}

__simt_vf__ __launch_bounds__(1024) inline void head64_fused_softmax_init_vf(
    __ubuf__ float* running_max_values,
    __ubuf__ float* running_sum_values,
    __ubuf__ float* old_scale_values)
{
    if (threadIdx.x >= kHead64FusedActiveThreads) {
        return;
    }
    const uint32_t warp = threadIdx.x / 32U;
    const uint32_t lane = threadIdx.x % 32U;
    if (lane == 0U) {
        for (uint32_t local_head = warp;
             local_head < 32U;
             local_head += kHead64FusedActiveWarps) {
            running_max_values[local_head] =
                -std::numeric_limits<float>::infinity();
            running_sum_values[local_head] = 0.0F;
            old_scale_values[local_head] = 0.0F;
        }
    }
}

__simt_vf__ __launch_bounds__(1024) inline void head64_fused_vllm_softmax_vf(
    __ubuf__ const float* scores,
    __ubuf__ bfloat16_t* probabilities,
    __ubuf__ float* running_max_values,
    __ubuf__ float* running_sum_values,
    __ubuf__ float* old_scale_values,
    __gm__ const int32_t* indices,
    int32_t batch_index,
    int32_t query_token,
    int32_t selected_start,
    int32_t current_selected,
    int32_t query_tokens,
    int32_t context_tokens,
    int32_t selected_tokens,
    float score_scale,
    int32_t causal)
{
    if (threadIdx.x >= kHead64FusedActiveThreads) {
        return;
    }
    const uint32_t warp = threadIdx.x / 32U;
    const uint32_t lane = threadIdx.x % 32U;
    const int64_t indices_row =
        (static_cast<int64_t>(batch_index) * query_tokens + query_token) *
        selected_tokens;
    const int32_t causal_limit = context_tokens - query_tokens + query_token;
    for (uint32_t local_head = warp;
         local_head < 32U;
         local_head += kHead64FusedActiveWarps) {
        float lane_max = -std::numeric_limits<float>::infinity();
        float lane_scores[4] = {0.0F, 0.0F, 0.0F, 0.0F};
        uint32_t lane_valid_mask = 0U;
#pragma unroll
        for (uint32_t lane_entry = 0U; lane_entry < 4U; ++lane_entry) {
            const int32_t selected = static_cast<int32_t>(
                lane + lane_entry * 32U);
            if (selected < current_selected) {
                const int32_t context_index =
                    indices[indices_row + selected_start + selected];
                const bool valid =
                    context_index >= 0 && context_index < context_tokens &&
                    (!causal || context_index <= causal_limit);
                if (!valid) {
                    continue;
                }
                const float score =
                    scores[local_head * kHead64FusedVllmSelectedTile + selected] *
                    score_scale;
                lane_scores[lane_entry] = score;
                lane_valid_mask |= 1U << lane_entry;
                lane_max = lane_max < score ? score : lane_max;
            }
        }
        const float tile_max = head64_warp_max(lane_max);
        const float lane_valid = lane_valid_mask != 0U ? 1.0F : 0.0F;
        const float tile_valid = head64_warp_sum(lane_valid);
        const float running_max = running_max_values[local_head];
        const float running_sum = running_sum_values[local_head];
        const float new_max = tile_valid > 0.0F
            ? (running_sum > 0.0F && running_max > tile_max
                   ? running_max
                   : tile_max)
            : running_max;
        const float old_scale = running_sum > 0.0F
            ? __expf(running_max - new_max)
            : 0.0F;
        float lane_sum = 0.0F;
#pragma unroll
        for (uint32_t lane_entry = 0U; lane_entry < 4U; ++lane_entry) {
            const int32_t selected = static_cast<int32_t>(
                lane + lane_entry * 32U);
            float probability = 0.0F;
            if (lane_valid_mask & (1U << lane_entry)) {
                probability = __expf(lane_scores[lane_entry] - new_max);
                lane_sum += probability;
            }
            probabilities[head64_fused_nz_offset(
                local_head, static_cast<uint32_t>(selected), 32U)] =
                static_cast<bfloat16_t>(probability);
        }
        const float tile_sum = head64_warp_sum(lane_sum);
        if (lane == 0U) {
            old_scale_values[local_head] = old_scale;
            running_max_values[local_head] = new_max;
            running_sum_values[local_head] = old_scale * running_sum + tile_sum;
        }
    }
}

__global__ __vector__ void dsa_decode_softmax_simt_v2_kernel(
    __gm__ const float* scores, __gm__ const int32_t* indices,
    __gm__ bfloat16_t* numerators, __gm__ float* running_max,
    __gm__ float* running_sum, __gm__ float* old_scale)
{
    TPipe ub_pipe;
    TBuf<> ub_buffer;
    ub_pipe.InitBuffer(ub_buffer, kHead64FusedDynamicUbBytes);
    auto ub_storage = ub_buffer.Get<uint8_t>();
    auto max_ub = ub_storage[kHead64FusedVllmUbRunningMaxOffset].ReinterpretCast<float>();
    auto sum_ub = ub_storage[kHead64FusedVllmUbRunningSumOffset].ReinterpretCast<float>();
    auto scale_ub = ub_storage[kHead64FusedVllmUbOldScaleOffset].ReinterpretCast<float>();
    auto score_ub = ub_storage[kHead64FusedVllmUbScoresOffset].ReinterpretCast<float>();
    auto probability_ub =
        ub_storage[kHead64FusedVllmUbProbabilitiesOffset].ReinterpretCast<bfloat16_t>();
    auto ub_workspace = reinterpret_cast<__ubuf__ uint8_t*>(0);
    GlobalTensor<float> scores_gm;
    GlobalTensor<bfloat16_t> numerators_gm;
    GlobalTensor<float> max_gm, sum_gm, scale_gm;
    scores_gm.SetGlobalBuffer(const_cast<__gm__ float*>(scores));
    numerators_gm.SetGlobalBuffer(numerators);
    max_gm.SetGlobalBuffer(running_max);
    sum_gm.SetGlobalBuffer(running_sum);
    scale_gm.SetGlobalBuffer(old_scale);
    const uint32_t block = static_cast<uint32_t>(GetBlockIdx());
    const uint32_t first_row = block * ROWS_PER_BLOCK;
    const uint32_t batch = first_row / 256U;
    const uint32_t query = (first_row / 128U) % QUERY_TOKENS;

    asc_vf_call<head64_fused_softmax_init_vf>(
        dim3(kHead64FusedLaunchThreads),
        reinterpret_cast<__ubuf__ float*>(
            ub_workspace + kHead64FusedVllmUbRunningMaxOffset),
        reinterpret_cast<__ubuf__ float*>(
            ub_workspace + kHead64FusedVllmUbRunningSumOffset),
        reinterpret_cast<__ubuf__ float*>(
            ub_workspace + kHead64FusedVllmUbOldScaleOffset));
    for (uint32_t tile = 0U; tile < TILE_COUNT; ++tile) {
        DataCopyExtParams copy = {
            static_cast<uint16_t>(ROWS_PER_BLOCK),
            TILE_TOKENS * sizeof(float),
            (SELECTED_TOKENS - TILE_TOKENS) * sizeof(float), 0, 0};
        DataCopyPadExtParams<float> pad = {false, 0, 0, 0};
        DataCopyPad(
            score_ub,
            scores_gm[static_cast<uint64_t>(first_row) * SELECTED_TOKENS +
                      tile * TILE_TOKENS],
            copy,
            pad);
        SetFlag<HardEvent::MTE2_V>(EVENT_ID0);
        WaitFlag<HardEvent::MTE2_V>(EVENT_ID0);
        asc_vf_call<head64_fused_vllm_softmax_vf>(
            dim3(kHead64FusedLaunchThreads),
            reinterpret_cast<__ubuf__ const float*>(
                ub_workspace + kHead64FusedVllmUbScoresOffset),
            reinterpret_cast<__ubuf__ bfloat16_t*>(
                ub_workspace + kHead64FusedVllmUbProbabilitiesOffset),
            reinterpret_cast<__ubuf__ float*>(
                ub_workspace + kHead64FusedVllmUbRunningMaxOffset),
            reinterpret_cast<__ubuf__ float*>(
                ub_workspace + kHead64FusedVllmUbRunningSumOffset),
            reinterpret_cast<__ubuf__ float*>(
                ub_workspace + kHead64FusedVllmUbOldScaleOffset),
            indices,
            static_cast<int32_t>(batch),
            static_cast<int32_t>(query),
            static_cast<int32_t>(tile * TILE_TOKENS),
            TILE_TOKENS,
            QUERY_TOKENS,
            CONTEXT_TOKENS,
            SELECTED_TOKENS,
            SOFTMAX_SCALE,
            1);
        asc_sync_notify(PIPE_V, PIPE_MTE3, EVENT_ID1);
        asc_sync_wait(PIPE_V, PIPE_MTE3, EVENT_ID1);
        const uint64_t output_offset =
            static_cast<uint64_t>(block / 2U) * TILE_COUNT * OUTPUT_TILE_ELEMENTS +
            static_cast<uint64_t>(tile) * OUTPUT_TILE_ELEMENTS +
            (block % 2U) * ROWS_PER_BLOCK * 16U;
        DataCopyParams stage_copy = {
            static_cast<uint16_t>(TILE_TOKENS / 16U),
            static_cast<uint16_t>(ROWS_PER_BLOCK), 0,
            static_cast<uint16_t>(S1_TEMPLATE_ROWS - ROWS_PER_BLOCK)};
        DataCopy(numerators_gm[output_offset], probability_ub, stage_copy);
        DataCopy(
            scale_gm[static_cast<uint64_t>(tile) * SOFTMAX_ROWS + first_row],
            scale_ub,
            ROWS_PER_BLOCK);
        PipeBarrier<PIPE_ALL>();
    }
    DataCopy(max_gm[first_row], max_ub, ROWS_PER_BLOCK);
    DataCopy(sum_gm[first_row], sum_ub, ROWS_PER_BLOCK);
}

static void launch_stage(DeviceBuffers* buffers, aclrtStream stream)
{
    dsa_decode_softmax_simt_v2_kernel
        <<<BLOCK_DIM, kHead64FusedDynamicUbBytes, stream>>>(
        buffers->scores, buffers->indices, buffers->numerators,
        buffers->running_max, buffers->running_sum, buffers->old_scale);
}

int main(void)
{
    return run_program(launch_stage, "simt_v2");
}
