#include <stdint.h>
#include <limits>

#include "host_common.h"
#include "kernel_operator.h"
#include "c_api/asc_simd.h"
#include "simt_api/asc_bf16.h"
#include "simt_api/asc_simt.h"

using namespace AscendC;

constexpr uint32_t kHead64FusedLaunchThreads = 1024;
constexpr uint32_t kHead64FusedActiveThreads = 1024;
constexpr uint32_t kHead64FusedActiveWarps = 32;
constexpr uint32_t kHead64FusedVllmSelectedTile = 128;

// v8 UB 布局：running_max / running_sum 是跨 tile 的持久状态，仍然单份；
// 其余四块（old_scale / selected_indices / scores / probabilities）都要
// 参与 MTE2 -> V -> MTE3 的流水，所以各开两份做 ping-pong。
// 单份的偏移与 v4 完全一致，pong 份紧跟其后，动态 UB 总量不变。
constexpr uint32_t kHead64FusedVllmUbRunningMaxOffset = 0;        // 128 B
constexpr uint32_t kHead64FusedVllmUbRunningSumOffset = 128;      // 128 B

constexpr uint32_t kHead64FusedVllmUbOldScaleOffset = 256;        // 2 * 128 B
constexpr uint32_t kHead64FusedVllmUbOldScaleStride = 128;

constexpr uint32_t kHead64FusedVllmUbSelectedIndicesOffset = 1024;  // 2 * 512 B
constexpr uint32_t kHead64FusedVllmUbSelectedIndicesStride = 512;

constexpr uint32_t kHead64FusedVllmUbScoresOffset = 103040;       // 2 * 16384 B
constexpr uint32_t kHead64FusedVllmUbScoresStride = 16384;

constexpr uint32_t kHead64FusedVllmUbProbabilitiesOffset = 135808;  // 2 * 8192 B
constexpr uint32_t kHead64FusedVllmUbProbabilitiesStride = 8192;

// 末端 135808 + 2 * 8192 = 152192 < 211584，动态 UB 申请量与 v4 保持一致。
constexpr uint32_t kHead64FusedDynamicUbBytes = 211584;

__simt_callee__ inline float head64_warp_max(float value)
{
    for (uint32_t offset = 16U; offset > 0U; offset >>= 1U) {
        const float peer = asc_shfl_xor(value, static_cast<int32_t>(offset), 32);
        value = value < peer ? peer : value;
    }
    return value;
}


__simt_callee__ inline float head64_warp_sum(float value)
{
    for (uint32_t offset = 16U; offset > 0U; offset >>= 1U) {
        value += asc_shfl_xor(value, static_cast<int32_t>(offset), 32);
    }
    return value;
}

__simt_callee__ inline uint32_t head64_fused_nz_offset(
    uint32_t row, uint32_t column, uint32_t row_count)
{
    return (column / 16U) * 16U * row_count +
        (row / 16U) * 16U * 16U + (row % 16U) * 16U + column % 16U;
}

__simt_vf__ __launch_bounds__(1024) inline void head64_fused_softmax_init_vf(
    __ubuf__ float* running_max_values,
    __ubuf__ float* running_sum_values,
    __ubuf__ float* old_scale_values)
{
    if (threadIdx.x >= kHead64FusedActiveThreads) {
        return;
    }
    const uint32_t warp = threadIdx.x / 32U;
    const uint32_t lane = threadIdx.x % 32U;
    if (lane == 0U) {
        for (uint32_t local_head = warp;
             local_head < 32U;
             local_head += kHead64FusedActiveWarps) {
            running_max_values[local_head] =
                -std::numeric_limits<float>::infinity();
            running_sum_values[local_head] = 0.0F;
            old_scale_values[local_head] = 0.0F;
        }
    }
}


__simt_vf__ __launch_bounds__(1024) inline void head64_fused_vllm_softmax_vf(
    __ubuf__ const float* scores,
    __ubuf__ bfloat16_t* probabilities,
    __ubuf__ float* running_max_values,
    __ubuf__ float* running_sum_values,
    __ubuf__ float* old_scale_values,
    __ubuf__ const int32_t* selected_indices,
    int32_t query_token,
    int32_t current_selected,
    int32_t query_tokens,
    int32_t context_tokens,
    float score_scale,
    int32_t causal)
{
    if (threadIdx.x >= kHead64FusedActiveThreads) {
        return;
    }
    const uint32_t warp = threadIdx.x / 32U;
    const uint32_t lane = threadIdx.x % 32U;
    const int32_t causal_limit = context_tokens - query_tokens + query_token;


    for (uint32_t local_head = warp;
         local_head < 32U;
         local_head += kHead64FusedActiveWarps) {



        float lane_max = -std::numeric_limits<float>::infinity();
        float lane_scores[4] = {0.0F, 0.0F, 0.0F, 0.0F};
        uint32_t lane_valid_mask = 0U;
#pragma unroll

        for (uint32_t lane_entry = 0U; lane_entry < 4U; ++lane_entry) {
            const int32_t selected = static_cast<int32_t>(lane + lane_entry * 32U);
            if (selected < current_selected) {
                const int32_t context_index = selected_indices[selected];

                const bool valid = context_index >= 0 && context_index < context_tokens && (!causal || context_index <= causal_limit);
                if (!valid) continue;
                const float score = scores[local_head * kHead64FusedVllmSelectedTile + selected] * score_scale;
                lane_scores[lane_entry] = score;
                lane_valid_mask |= 1U << lane_entry;
                lane_max = lane_max < score ? score : lane_max;
            }
        }


        const float tile_max = head64_warp_max(lane_max);
        const bool tile_has_valid = tile_max > -std::numeric_limits<float>::infinity();
        const float running_max = running_max_values[local_head];
        const float running_sum = running_sum_values[local_head];

        const float new_max = tile_has_valid
            ? (running_sum > 0.0F && running_max > tile_max
                   ? running_max
                   : tile_max)
            : running_max;

        const float old_scale = running_sum > 0.0F
            ? __expf(running_max - new_max)
            : 0.0F;

        float lane_sum = 0.0F;
#pragma unroll
        for (uint32_t lane_entry = 0U; lane_entry < 4U; ++lane_entry) {
            const int32_t selected = static_cast<int32_t>(lane + lane_entry * 32U);
            float probability = 0.0F;
            if (lane_valid_mask & (1U << lane_entry)) {
                probability = __expf(lane_scores[lane_entry] - new_max);
                lane_sum += probability;
            }
            probabilities[head64_fused_nz_offset(local_head, static_cast<uint32_t>(selected), 32U)] = static_cast<bfloat16_t>(probability);
        }

        const float tile_sum = head64_warp_sum(lane_sum);

        if (lane == 0U) {
            old_scale_values[local_head] = old_scale;
            running_max_values[local_head] = new_max;

            running_sum_values[local_head] = old_scale * running_sum + tile_sum;
        }
    }
}

__global__ __vector__ void dsa_decode_softmax_simt_v8_kernel(


    __gm__ const float* scores, __gm__ const int32_t* indices,
    __gm__ bfloat16_t* numerators, __gm__ float* running_max,
    __gm__ float* running_sum, __gm__ float* old_scale)
{
    TPipe ub_pipe;
    TBuf<> ub_buffer;
    ub_pipe.InitBuffer(ub_buffer, kHead64FusedDynamicUbBytes);
    auto ub_storage = ub_buffer.Get<uint8_t>();
    auto max_ub = ub_storage[kHead64FusedVllmUbRunningMaxOffset].ReinterpretCast<float>();
    auto sum_ub = ub_storage[kHead64FusedVllmUbRunningSumOffset].ReinterpretCast<float>();

    auto ub_workspace = reinterpret_cast<__ubuf__ uint8_t*>(0);
    GlobalTensor<float> scores_gm;
    GlobalTensor<int32_t> indices_gm;
    GlobalTensor<bfloat16_t> numerators_gm;
    GlobalTensor<float> max_gm, sum_gm, scale_gm;
    scores_gm.SetGlobalBuffer(const_cast<__gm__ float*>(scores));
    indices_gm.SetGlobalBuffer(const_cast<__gm__ int32_t*>(indices));
    numerators_gm.SetGlobalBuffer(numerators);
    max_gm.SetGlobalBuffer(running_max);
    sum_gm.SetGlobalBuffer(running_sum);
    scale_gm.SetGlobalBuffer(old_scale);
    const uint32_t block = static_cast<uint32_t>(GetBlockIdx());
    const uint32_t first_row = block * ROWS_PER_BLOCK;
    const uint32_t batch = first_row / 256U;
    const uint32_t query = (first_row / 128U) % QUERY_TOKENS;
    const uint64_t indices_row_base =
        (static_cast<uint64_t>(batch) * QUERY_TOKENS + query) * SELECTED_TOKENS;

    // init 只写 ping 份的 old_scale。每次 VF 调用都会由 lane 0 无条件写满
    // 全部 32 个 head 的 old_scale，所以 pong 份在被 MTE3 读到之前必然已被写过。
    asc_vf_call<head64_fused_softmax_init_vf>(
        dim3(kHead64FusedLaunchThreads),
        reinterpret_cast<__ubuf__ float*>(
            ub_workspace + kHead64FusedVllmUbRunningMaxOffset),
        reinterpret_cast<__ubuf__ float*>(
            ub_workspace + kHead64FusedVllmUbRunningSumOffset),
        reinterpret_cast<__ubuf__ float*>(
            ub_workspace + kHead64FusedVllmUbOldScaleOffset));

    const DataCopyExtParams score_copy = {
        static_cast<uint16_t>(ROWS_PER_BLOCK),
        TILE_TOKENS * sizeof(float),
        (SELECTED_TOKENS - TILE_TOKENS) * sizeof(float), 0, 0};
    const DataCopyPadExtParams<float> score_pad = {false, 0, 0, 0};
    const DataCopyParams stage_copy = {
        static_cast<uint16_t>(TILE_TOKENS / 16U),
        static_cast<uint16_t>(ROWS_PER_BLOCK), 0,
        static_cast<uint16_t>(S1_TEMPLATE_ROWS - ROWS_PER_BLOCK)};

    // 反向边（WAR）初始 flag：
    //   V_MTE2(ID1)  —— pong 的 score/index 缓冲一开始就是空的，MTE2 可直接写。
    //                   ping 份由序言的 MTE2 首发占用，不需要预置。
    //   MTE3_V(ID0/ID1) —— 两份 probability/old_scale 输出缓冲一开始都没人在读。
    SetFlag<HardEvent::V_MTE2>(EVENT_ID1);
    SetFlag<HardEvent::MTE3_V>(EVENT_ID0);
    SetFlag<HardEvent::MTE3_V>(EVENT_ID1);

    // 序言：把 tile 0 搬进 ping 缓冲，让流水在进入循环前就已经有一拍在手。
    DataCopyPad(
        ub_storage[kHead64FusedVllmUbScoresOffset].ReinterpretCast<float>(),
        scores_gm[static_cast<uint64_t>(first_row) * SELECTED_TOKENS],
        score_copy,
        score_pad);
    DataCopy(
        ub_storage[kHead64FusedVllmUbSelectedIndicesOffset]
            .ReinterpretCast<int32_t>(),
        indices_gm[indices_row_base],
        TILE_TOKENS);
    SetFlag<HardEvent::MTE2_V>(EVENT_ID0);

    for (uint32_t tile = 0U; tile < TILE_COUNT; ++tile) {
        const uint32_t cur = tile & 1U;
        const uint32_t nxt = cur ^ 1U;
        const event_t cur_event = cur == 0U ? EVENT_ID0 : EVENT_ID1;
        const event_t nxt_event = nxt == 0U ? EVENT_ID0 : EVENT_ID1;

        const uint32_t cur_score_offset =
            kHead64FusedVllmUbScoresOffset + cur * kHead64FusedVllmUbScoresStride;
        const uint32_t cur_index_offset =
            kHead64FusedVllmUbSelectedIndicesOffset +
            cur * kHead64FusedVllmUbSelectedIndicesStride;
        const uint32_t cur_probability_offset =
            kHead64FusedVllmUbProbabilitiesOffset +
            cur * kHead64FusedVllmUbProbabilitiesStride;
        const uint32_t cur_scale_offset =
            kHead64FusedVllmUbOldScaleOffset + cur * kHead64FusedVllmUbOldScaleStride;

        // 先把下一个 tile 的 MTE2 发射出去。它落在 MTE2 队列里，只依赖
        // "两拍之前的 VF 已经读完 nxt 缓冲"，因此可以和本拍的 VF 并行跑。
        if (tile + 1U < TILE_COUNT) {
            const uint32_t nxt_score_offset =
                kHead64FusedVllmUbScoresOffset +
                nxt * kHead64FusedVllmUbScoresStride;
            const uint32_t nxt_index_offset =
                kHead64FusedVllmUbSelectedIndicesOffset +
                nxt * kHead64FusedVllmUbSelectedIndicesStride;

            WaitFlag<HardEvent::V_MTE2>(nxt_event);
            DataCopyPad(
                ub_storage[nxt_score_offset].ReinterpretCast<float>(),
                scores_gm[static_cast<uint64_t>(first_row) * SELECTED_TOKENS +
                          (tile + 1U) * TILE_TOKENS],
                score_copy,
                score_pad);
            DataCopy(
                ub_storage[nxt_index_offset].ReinterpretCast<int32_t>(),
                indices_gm[indices_row_base + (tile + 1U) * TILE_TOKENS],
                TILE_TOKENS);
            SetFlag<HardEvent::MTE2_V>(nxt_event);
        }

        // 本拍的输入已就绪，且上一次使用同一份输出缓冲的 MTE3 已经读完。
        WaitFlag<HardEvent::MTE2_V>(cur_event);
        WaitFlag<HardEvent::MTE3_V>(cur_event);

        asc_vf_call<head64_fused_vllm_softmax_vf>(
            dim3(kHead64FusedLaunchThreads),
            reinterpret_cast<__ubuf__ const float*>(
                ub_workspace + cur_score_offset),
            reinterpret_cast<__ubuf__ bfloat16_t*>(
                ub_workspace + cur_probability_offset),
            reinterpret_cast<__ubuf__ float*>(
                ub_workspace + kHead64FusedVllmUbRunningMaxOffset),
            reinterpret_cast<__ubuf__ float*>(
                ub_workspace + kHead64FusedVllmUbRunningSumOffset),
            reinterpret_cast<__ubuf__ float*>(
                ub_workspace + cur_scale_offset),
            reinterpret_cast<__ubuf__ const int32_t*>(
                ub_workspace + cur_index_offset),
            static_cast<int32_t>(query),
            TILE_TOKENS,
            QUERY_TOKENS,
            CONTEXT_TOKENS,
            SOFTMAX_SCALE,
            1);

        // VF 读完 cur 输入缓冲，放给两拍之后的 MTE2；同时把输出交给 MTE3。
        SetFlag<HardEvent::V_MTE2>(cur_event);
        SetFlag<HardEvent::V_MTE3>(cur_event);

        WaitFlag<HardEvent::V_MTE3>(cur_event);

        const uint64_t output_offset =
            static_cast<uint64_t>(block / 2U) * TILE_COUNT * OUTPUT_TILE_ELEMENTS +
            static_cast<uint64_t>(tile) * OUTPUT_TILE_ELEMENTS +
            (block % 2U) * ROWS_PER_BLOCK * 16U;
        DataCopy(
            numerators_gm[output_offset],
            ub_storage[cur_probability_offset].ReinterpretCast<bfloat16_t>(),
            stage_copy);
        DataCopy(
            scale_gm[static_cast<uint64_t>(tile) * SOFTMAX_ROWS + first_row],
            ub_storage[cur_scale_offset].ReinterpretCast<float>(),
            ROWS_PER_BLOCK);
        // MTE3 读完 cur 输出缓冲，放给下一拍复用同一份的 VF。
        SetFlag<HardEvent::MTE3_V>(cur_event);
    }

    // 排空两条反向边上多出来的 flag。序言/初始预置的 3 次 set 都在前两拍被消费掉，
    // 真正的剩余来自最后两拍：tile 14 / tile 15 各自在迭代末尾 set 了
    // V_MTE2 与 MTE3_V，而后面已经没有 MTE2 / VF 去等它们，两份各剩 1 次。
    WaitFlag<HardEvent::V_MTE2>(EVENT_ID0);
    WaitFlag<HardEvent::V_MTE2>(EVENT_ID1);
    WaitFlag<HardEvent::MTE3_V>(EVENT_ID0);
    WaitFlag<HardEvent::MTE3_V>(EVENT_ID1);

    // 最后一拍的 V_MTE3 握手已经排在 VF(15) 对 running_max/running_sum 的写之后，
    // 所以这里的搬出无需额外同步。
    DataCopy(max_gm[first_row], max_ub, ROWS_PER_BLOCK);
    DataCopy(sum_gm[first_row], sum_ub, ROWS_PER_BLOCK);
}

static void launch_stage(DeviceBuffers* buffers, aclrtStream stream)
{

    dsa_decode_softmax_simt_v8_kernel
        <<<BLOCK_DIM, kHead64FusedDynamicUbBytes, stream>>>(
        buffers->scores, buffers->indices, buffers->numerators,
        buffers->running_max, buffers->running_sum, buffers->old_scale);
}

int main(void)
{
    return run_program(launch_stage, "simt_v8");
}
