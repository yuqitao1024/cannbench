// Fixed-shape extraction of the Arch35 EQ_128 BF16 ProcessVec1 path rooted at:
// csrc/attention/sparse_flash_attention/op_kernel/arch35/sparse_flash_attention_service_vector_mla.h
// SHA-256: 332679ebb84a571582d7f3fd3f5cd086415ff24188b3c4ef0370187ec3de02b3
// csrc/attention/common/op_kernel/arch35/vf/vf_mul_sel_softmaxflashv2_cast_nz_sfa.h
// SHA-256: 8ddafeda9671ac77f9fe1bc86bad512c1a821bd4229b19a825a43525e6e63d10
// csrc/attention/common/op_kernel/arch35/vf/vf_basic_block_aligned128_no_update_sfa.h
// SHA-256: 7ec0f45a92cbfde57e4a50f859eb14372fe3ab95d80eed7c4b5f3a6473aea66b
// csrc/attention/common/op_kernel/arch35/vf/vf_basic_block_aligned128_update_sfa.h
// SHA-256: cf4b5c9b941b8c7634380a9524cdea52934694860bf950ca5eeb2fc36fcbf8cf
// The user-authorized Basic API exception applies only to this comparison file.

using namespace AscendC;

constexpr uint32_t floatRepSize = 64;

// Verbatim upstream VF body specialized to float, BF16, s1=64, s2=128.
__simd_vf__ void ProcessVec1NoUpdateImpl128VF(
    __ubuf__ bfloat16_t* expUb, __ubuf__ float* expSumUb,
    __ubuf__ float* maxUb, __ubuf__ float* maxUbStart,
    __ubuf__ float* srcUb, const uint32_t blockStride,
    const uint32_t repeatStride, const uint16_t m,
    const float scale, const float minValue)
{
    static constexpr MicroAPI::CastTrait castTraitZero = {
        MicroAPI::RegLayout::ZERO, MicroAPI::SatMode::SAT,
        MicroAPI::MaskMergeMode::ZEROING, RoundMode::CAST_ROUND};
    static constexpr MicroAPI::CastTrait castTraitOne = {
        MicroAPI::RegLayout::ONE, MicroAPI::SatMode::SAT,
        MicroAPI::MaskMergeMode::ZEROING, RoundMode::CAST_ROUND};
    MicroAPI::RegTensor<float> vreg_input_x;
    MicroAPI::RegTensor<float> vreg_input_x_unroll;
    MicroAPI::RegTensor<float> vreg_max_tmp;
    MicroAPI::RegTensor<float> vreg_input_max;
    MicroAPI::RegTensor<float> vreg_max_brc;
    MicroAPI::RegTensor<float> vreg_exp_sum;
    MicroAPI::RegTensor<float> vreg_exp_even;
    MicroAPI::RegTensor<float> vreg_exp_odd;
    MicroAPI::RegTensor<bfloat16_t> vreg_exp_even_bf16;
    MicroAPI::RegTensor<bfloat16_t> vreg_exp_odd_bf16;
    MicroAPI::RegTensor<bfloat16_t> vreg_exp_bf16;
    MicroAPI::UnalignRegForStore ureg_max;
    MicroAPI::UnalignRegForStore ureg_exp_sum;
    MicroAPI::MaskReg preg_all =
        MicroAPI::CreateMask<float, MicroAPI::MaskPattern::ALL>();
    MicroAPI::MaskReg preg_all_b16 =
        MicroAPI::CreateMask<uint16_t, MicroAPI::MaskPattern::ALL>();

    for (uint16_t i = 0; i < m; ++i) {
        MicroAPI::LoadAlign(vreg_input_x, srcUb + i * TILE_TOKENS);
        MicroAPI::LoadAlign(
            vreg_input_x_unroll, srcUb + floatRepSize + i * TILE_TOKENS);
        MicroAPI::Muls(vreg_input_x, vreg_input_x, scale, preg_all);
        MicroAPI::Muls(
            vreg_input_x_unroll, vreg_input_x_unroll, scale, preg_all);
        MicroAPI::StoreAlign<float, MicroAPI::StoreDist::DIST_NORM_B32>(
            srcUb + i * TILE_TOKENS, vreg_input_x, preg_all);
        MicroAPI::StoreAlign<float, MicroAPI::StoreDist::DIST_NORM_B32>(
            srcUb + floatRepSize + i * TILE_TOKENS,
            vreg_input_x_unroll,
            preg_all);
        MicroAPI::Max(
            vreg_max_tmp, vreg_input_x, vreg_input_x_unroll, preg_all);
        MicroAPI::Reduce<MicroAPI::ReduceType::MAX, float, float,
            MicroAPI::MaskMergeMode::ZEROING>(
            vreg_input_max, vreg_max_tmp, preg_all);
        MicroAPI::StoreUnAlign<float, MicroAPI::PostLiteral::POST_MODE_UPDATE>(
            maxUb, vreg_input_max, ureg_max, 1);
    }
    MicroAPI::StoreUnAlignPost<float, MicroAPI::PostLiteral::POST_MODE_UPDATE>(
        maxUb, ureg_max, 0);
    MicroAPI::LocalMemBar<
        MicroAPI::MemType::VEC_STORE, MicroAPI::MemType::VEC_LOAD>();
    for (uint16_t i = 0; i < m; ++i) {
        MicroAPI::LoadAlign<float, MicroAPI::LoadDist::DIST_BRC_B32>(
            vreg_max_brc, maxUbStart + i);
        MicroAPI::LoadAlign<float, MicroAPI::LoadDist::DIST_DINTLV_B32>(
            vreg_input_x,
            vreg_input_x_unroll,
            srcUb + i * TILE_TOKENS);
        MicroAPI::ExpSub(
            vreg_exp_even, vreg_input_x, vreg_max_brc, preg_all);
        MicroAPI::ExpSub(
            vreg_exp_odd, vreg_input_x_unroll, vreg_max_brc, preg_all);
        MicroAPI::Add(
            vreg_exp_sum, vreg_exp_even, vreg_exp_odd, preg_all);
        MicroAPI::Reduce<MicroAPI::ReduceType::SUM, float, float,
            MicroAPI::MaskMergeMode::ZEROING>(
            vreg_exp_sum, vreg_exp_sum, preg_all);
        MicroAPI::StoreUnAlign<float, MicroAPI::PostLiteral::POST_MODE_UPDATE>(
            expSumUb, vreg_exp_sum, ureg_exp_sum, 1);
        MicroAPI::Cast<bfloat16_t, float, castTraitZero>(
            vreg_exp_even_bf16, vreg_exp_even, preg_all);
        MicroAPI::Cast<bfloat16_t, float, castTraitOne>(
            vreg_exp_odd_bf16, vreg_exp_odd, preg_all);
        MicroAPI::Or(
            (MicroAPI::RegTensor<uint16_t>&)vreg_exp_bf16,
            (MicroAPI::RegTensor<uint16_t>&)vreg_exp_even_bf16,
            (MicroAPI::RegTensor<uint16_t>&)vreg_exp_odd_bf16,
            preg_all_b16);
        MicroAPI::StoreAlign<bfloat16_t, MicroAPI::DataCopyMode::DATA_BLOCK_COPY,
            MicroAPI::PostLiteral::POST_MODE_UPDATE>(
            expUb, vreg_exp_bf16, blockStride, repeatStride, preg_all_b16);
    }
    MicroAPI::StoreUnAlignPost<float, MicroAPI::PostLiteral::POST_MODE_UPDATE>(
        expSumUb, ureg_exp_sum, 0);
}

// Verbatim upstream VF body specialized to float, BF16, s1=64, s2=128.
__simd_vf__ void ProcessVec1UpdateImpl128VF(
    __ubuf__ bfloat16_t* expUb, __ubuf__ float* srcUb,
    __ubuf__ float* inMaxUb, __ubuf__ float* tmpExpSumUb,
    __ubuf__ float* tmpMaxUb, __ubuf__ float* tmpMaxUb2,
    const uint32_t blockStride, const uint32_t repeatStride,
    const uint16_t m, const float scale, const float minValue)
{
    static constexpr MicroAPI::CastTrait castTraitZero = {
        MicroAPI::RegLayout::ZERO, MicroAPI::SatMode::SAT,
        MicroAPI::MaskMergeMode::ZEROING, RoundMode::CAST_ROUND};
    static constexpr MicroAPI::CastTrait castTraitOne = {
        MicroAPI::RegLayout::ONE, MicroAPI::SatMode::SAT,
        MicroAPI::MaskMergeMode::ZEROING, RoundMode::CAST_ROUND};
    MicroAPI::RegTensor<float> vreg_input_x;
    MicroAPI::RegTensor<float> vreg_input_x_unroll;
    MicroAPI::RegTensor<float> vreg_max_tmp;
    MicroAPI::RegTensor<float> vreg_in_max;
    MicroAPI::RegTensor<float> vreg_max_new;
    MicroAPI::RegTensor<float> vreg_max_brc;
    MicroAPI::RegTensor<float> vreg_cur_max;
    MicroAPI::RegTensor<float> vreg_exp_sum;
    MicroAPI::RegTensor<float> vreg_exp_even;
    MicroAPI::RegTensor<float> vreg_exp_odd;
    MicroAPI::RegTensor<bfloat16_t> vreg_exp_even_bf16;
    MicroAPI::RegTensor<bfloat16_t> vreg_exp_odd_bf16;
    MicroAPI::RegTensor<bfloat16_t> vreg_exp_bf16;
    MicroAPI::UnalignRegForStore ureg_max;
    MicroAPI::UnalignRegForStore ureg_exp_sum;
    MicroAPI::MaskReg preg_all =
        MicroAPI::CreateMask<float, MicroAPI::MaskPattern::ALL>();
    MicroAPI::MaskReg preg_all_b16 =
        MicroAPI::CreateMask<uint16_t, MicroAPI::MaskPattern::ALL>();

    for (uint16_t i = 0; i < m; ++i) {
        MicroAPI::LoadAlign(vreg_input_x, srcUb + i * TILE_TOKENS);
        MicroAPI::LoadAlign(
            vreg_input_x_unroll, srcUb + floatRepSize + i * TILE_TOKENS);
        MicroAPI::Muls(vreg_input_x, vreg_input_x, scale, preg_all);
        MicroAPI::Muls(
            vreg_input_x_unroll, vreg_input_x_unroll, scale, preg_all);
        MicroAPI::StoreAlign<float, MicroAPI::StoreDist::DIST_NORM_B32>(
            srcUb + i * TILE_TOKENS, vreg_input_x, preg_all);
        MicroAPI::StoreAlign<float, MicroAPI::StoreDist::DIST_NORM_B32>(
            srcUb + floatRepSize + i * TILE_TOKENS,
            vreg_input_x_unroll,
            preg_all);
        MicroAPI::Max(
            vreg_max_tmp, vreg_input_x, vreg_input_x_unroll, preg_all);
        MicroAPI::Reduce<MicroAPI::ReduceType::MAX, float, float,
            MicroAPI::MaskMergeMode::ZEROING>(
            vreg_max_tmp, vreg_max_tmp, preg_all);
        MicroAPI::StoreUnAlign<float, MicroAPI::PostLiteral::POST_MODE_UPDATE>(
            tmpMaxUb, vreg_max_tmp, ureg_max, 1);
    }
    MicroAPI::StoreUnAlignPost<float, MicroAPI::PostLiteral::POST_MODE_UPDATE>(
        tmpMaxUb, ureg_max, 0);
    MicroAPI::LoadAlign(vreg_in_max, inMaxUb);
    MicroAPI::LocalMemBar<
        MicroAPI::MemType::VEC_STORE, MicroAPI::MemType::VEC_LOAD>();
    MicroAPI::LoadAlign(vreg_cur_max, tmpMaxUb2);
    MicroAPI::Max(vreg_max_new, vreg_cur_max, vreg_in_max, preg_all);
    MicroAPI::StoreAlign<float, MicroAPI::StoreDist::DIST_NORM_B32>(
        tmpMaxUb2, vreg_max_new, preg_all);
    MicroAPI::LocalMemBar<
        MicroAPI::MemType::VEC_STORE, MicroAPI::MemType::VEC_LOAD>();
    for (uint16_t i = 0; i < m; ++i) {
        MicroAPI::LoadAlign<float, MicroAPI::LoadDist::DIST_BRC_B32>(
            vreg_max_brc, tmpMaxUb2 + i);
        MicroAPI::LoadAlign<float, MicroAPI::LoadDist::DIST_DINTLV_B32>(
            vreg_input_x,
            vreg_input_x_unroll,
            srcUb + i * TILE_TOKENS);
        MicroAPI::ExpSub(
            vreg_exp_even, vreg_input_x, vreg_max_brc, preg_all);
        MicroAPI::ExpSub(
            vreg_exp_odd, vreg_input_x_unroll, vreg_max_brc, preg_all);
        MicroAPI::Add(
            vreg_exp_sum, vreg_exp_even, vreg_exp_odd, preg_all);
        MicroAPI::Reduce<MicroAPI::ReduceType::SUM, float, float,
            MicroAPI::MaskMergeMode::ZEROING>(
            vreg_exp_sum, vreg_exp_sum, preg_all);
        MicroAPI::StoreUnAlign<float, MicroAPI::PostLiteral::POST_MODE_UPDATE>(
            tmpExpSumUb, vreg_exp_sum, ureg_exp_sum, 1);
        MicroAPI::Cast<bfloat16_t, float, castTraitZero>(
            vreg_exp_even_bf16, vreg_exp_even, preg_all);
        MicroAPI::Cast<bfloat16_t, float, castTraitOne>(
            vreg_exp_odd_bf16, vreg_exp_odd, preg_all);
        MicroAPI::Or(
            (MicroAPI::RegTensor<uint16_t>&)vreg_exp_bf16,
            (MicroAPI::RegTensor<uint16_t>&)vreg_exp_even_bf16,
            (MicroAPI::RegTensor<uint16_t>&)vreg_exp_odd_bf16,
            preg_all_b16);
        MicroAPI::StoreAlign<bfloat16_t, MicroAPI::DataCopyMode::DATA_BLOCK_COPY,
            MicroAPI::PostLiteral::POST_MODE_UPDATE>(
            expUb, vreg_exp_bf16, blockStride, repeatStride, preg_all_b16);
    }
    MicroAPI::StoreUnAlignPost<float, MicroAPI::PostLiteral::POST_MODE_UPDATE>(
        tmpExpSumUb, ureg_exp_sum, 0);
}

// Upstream UpdateExpSumAndExpMaxVF, called by SFAUpdateExpSumAndExpMax.
__simd_vf__ inline void UpdateExpSumAndExpMaxVF(
    __ubuf__ float* maxUb, __ubuf__ float* inMaxUb,
    __ubuf__ float* expMaxUb, __ubuf__ float* expSumUb,
    __ubuf__ float* inExpSumUb, __ubuf__ float* tmpExpSumUb,
    __ubuf__ float* tmpMaxUb, const uint32_t m)
{
    MicroAPI::RegTensor<float> vreg_max;
    MicroAPI::RegTensor<float> vreg_in_max;
    MicroAPI::RegTensor<float> vreg_in_exp_sum;
    MicroAPI::RegTensor<float> vreg_exp_max;
    MicroAPI::RegTensor<float> vreg_exp_sum_brc;
    MicroAPI::RegTensor<float> vreg_exp_sum_update;
    MicroAPI::MaskReg preg_all =
        MicroAPI::CreateMask<float, MicroAPI::MaskPattern::ALL>();
    MicroAPI::LoadAlign(vreg_max, tmpMaxUb);
    MicroAPI::LoadAlign(vreg_in_max, inMaxUb);
    MicroAPI::FusedExpSub(vreg_exp_max, vreg_in_max, vreg_max, preg_all);
    MicroAPI::StoreAlign<float, MicroAPI::StoreDist::DIST_NORM_B32>(
        expMaxUb, vreg_exp_max, preg_all);
    MicroAPI::StoreAlign<float, MicroAPI::StoreDist::DIST_NORM_B32>(
        maxUb, vreg_max, preg_all);
    MicroAPI::LoadAlign(vreg_in_exp_sum, inExpSumUb);
    MicroAPI::LoadAlign(vreg_exp_sum_brc, tmpExpSumUb);
    MicroAPI::Mul(
        vreg_exp_sum_update, vreg_exp_max, vreg_in_exp_sum, preg_all);
    MicroAPI::Add(
        vreg_exp_sum_update,
        vreg_exp_sum_update,
        vreg_exp_sum_brc,
        preg_all);
    MicroAPI::StoreAlign<float, MicroAPI::StoreDist::DIST_NORM_B32>(
        expSumUb, vreg_exp_sum_update, preg_all);
}

__global__ __vector__ void dsa_decode_softmax_vllm_ascend_kernel(
    __gm__ const float* scores, __gm__ const int32_t* indices,
    __gm__ bfloat16_t* numerators, __gm__ float* running_max,
    __gm__ float* running_sum, __gm__ float* old_scale)
{
    TPipe pipe;
    GlobalTensor<float> scores_gm;
    GlobalTensor<bfloat16_t> numerators_gm;
    GlobalTensor<float> max_gm, sum_gm, scale_gm;
    scores_gm.SetGlobalBuffer(const_cast<__gm__ float*>(scores));
    numerators_gm.SetGlobalBuffer(numerators);
    max_gm.SetGlobalBuffer(running_max);
    sum_gm.SetGlobalBuffer(running_sum);
    scale_gm.SetGlobalBuffer(old_scale);
    TBuf<TPosition::VECCALC> scores_buf, probabilities_buf, max_buf, sum_buf,
        scale_buf, temp_buf;
    pipe.InitBuffer(scores_buf, ROWS_PER_BLOCK * TILE_TOKENS * sizeof(float));
    pipe.InitBuffer(probabilities_buf, STAGE_TILE_ELEMENTS * sizeof(bfloat16_t));
    pipe.InitBuffer(max_buf, 64 * sizeof(float));
    pipe.InitBuffer(sum_buf, 64 * sizeof(float));
    pipe.InitBuffer(scale_buf, 64 * sizeof(float));
    pipe.InitBuffer(temp_buf, 128 * sizeof(float));
    LocalTensor<float> score_ub = scores_buf.Get<float>();
    LocalTensor<bfloat16_t> probability_ub = probabilities_buf.Get<bfloat16_t>();
    LocalTensor<float> max_ub = max_buf.Get<float>();
    LocalTensor<float> sum_ub = sum_buf.Get<float>();
    LocalTensor<float> scale_ub = scale_buf.Get<float>();
    LocalTensor<float> temp_ub = temp_buf.Get<float>();
    const uint32_t block = static_cast<uint32_t>(GetBlockIdx());
    const uint32_t first_row = block * ROWS_PER_BLOCK;
    (void)indices;
    for (uint32_t tile = 0U; tile < TILE_COUNT; ++tile) {
        DataCopyExtParams copy = {
            static_cast<uint16_t>(ROWS_PER_BLOCK),
            TILE_TOKENS * sizeof(float),
            (SELECTED_TOKENS - TILE_TOKENS) * sizeof(float), 0, 0};
        DataCopyPadExtParams<float> pad = {false, 0, 0, 0};
        DataCopyPad(
            score_ub,
            scores_gm[static_cast<uint64_t>(first_row) * SELECTED_TOKENS +
                      tile * TILE_TOKENS],
            copy,
            pad);
        SetFlag<HardEvent::MTE2_V>(EVENT_ID0);
        WaitFlag<HardEvent::MTE2_V>(EVENT_ID0);
        __VEC_SCOPE__ {
            if (tile == 0U) {
                const uint32_t blockStride = VEC1_SRC_STRIDE;
                ProcessVec1NoUpdateImpl128VF(
                    (__ubuf__ bfloat16_t*)probability_ub.GetPhyAddr(),
                    (__ubuf__ float*)sum_ub.GetPhyAddr(),
                    (__ubuf__ float*)max_ub.GetPhyAddr(),
                    (__ubuf__ float*)max_ub.GetPhyAddr(),
                    (__ubuf__ float*)score_ub.GetPhyAddr(),
                    blockStride,
                    1,
                    ROWS_PER_BLOCK,
                    SOFTMAX_SCALE,
                    -INFINITY);
            } else {
                const uint32_t blockStride = VEC1_SRC_STRIDE;
                ProcessVec1UpdateImpl128VF(
                    (__ubuf__ bfloat16_t*)probability_ub.GetPhyAddr(),
                    (__ubuf__ float*)score_ub.GetPhyAddr(),
                    (__ubuf__ float*)max_ub.GetPhyAddr(),
                    (__ubuf__ float*)temp_ub.GetPhyAddr(),
                    (__ubuf__ float*)temp_ub.GetPhyAddr() + 64,
                    (__ubuf__ float*)temp_ub.GetPhyAddr() + 64,
                    blockStride,
                    1,
                    ROWS_PER_BLOCK,
                    SOFTMAX_SCALE,
                    -INFINITY);
                MicroAPI::LocalMemBar<
                    MicroAPI::MemType::VEC_STORE,
                    MicroAPI::MemType::VEC_LOAD>();
                // This is the VF invoked by production SFAUpdateExpSumAndExpMax.
                UpdateExpSumAndExpMaxVF(
                    (__ubuf__ float*)max_ub.GetPhyAddr(),
                    (__ubuf__ float*)max_ub.GetPhyAddr(),
                    (__ubuf__ float*)scale_ub.GetPhyAddr(),
                    (__ubuf__ float*)sum_ub.GetPhyAddr(),
                    (__ubuf__ float*)sum_ub.GetPhyAddr(),
                    (__ubuf__ float*)temp_ub.GetPhyAddr(),
                    (__ubuf__ float*)temp_ub.GetPhyAddr() + 64,
                    ROWS_PER_BLOCK);
            }
        }
        PipeBarrier<PIPE_V>();
        SetFlag<HardEvent::V_MTE3>(EVENT_ID1);
        WaitFlag<HardEvent::V_MTE3>(EVENT_ID1);
        const uint64_t output_offset =
            static_cast<uint64_t>(block / 2U) * TILE_COUNT * OUTPUT_TILE_ELEMENTS +
            static_cast<uint64_t>(tile) * OUTPUT_TILE_ELEMENTS +
            (block % 2U) * ROWS_PER_BLOCK * 16U;
        DataCopyParams stage_copy = {
            static_cast<uint16_t>(TILE_TOKENS / 16U),
            static_cast<uint16_t>(ROWS_PER_BLOCK),
            static_cast<uint16_t>(VEC1_SRC_STRIDE - ROWS_PER_BLOCK),
            static_cast<uint16_t>(S1_TEMPLATE_ROWS - ROWS_PER_BLOCK)};
        DataCopy(numerators_gm[output_offset], probability_ub, stage_copy);
        if (tile != 0U) {
            DataCopy(
                scale_gm[static_cast<uint64_t>(tile) * SOFTMAX_ROWS + first_row],
                scale_ub,
                ROWS_PER_BLOCK);
        }
        PipeBarrier<PIPE_ALL>();
    }
    DataCopy(max_gm[first_row], max_ub, ROWS_PER_BLOCK);
    DataCopy(sum_gm[first_row], sum_ub, ROWS_PER_BLOCK);
}

static void launch_stage(DeviceBuffers* buffers, aclrtStream stream)
{
    dsa_decode_softmax_vllm_ascend_kernel<<<BLOCK_DIM, 0, stream>>>(
        buffers->scores, buffers->indices, buffers->numerators,
        buffers->running_max, buffers->running_sum, buffers->old_scale);
}

int main(void)
{
    return run_program(launch_stage, "vllm_ascend");
}
