/**
 * Runtime row-width dispatch comparison for Ascend 950.
 *
 * SCENARIO_NUM=0 uses one fixed-geometry generic kernel.
 * SCENARIO_NUM=1 dispatches small, medium, and wide behavior buckets.
 * SCENARIO_NUM=2 specializes exact width 1024 and penalizes every neighbor
 * with an intentionally padded fallback.
 */

#include <stdint.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>

#include "acl/acl.h"
#include "simt_api/asc_simt.h"
#include "simt_api/device_sync_functions.h"

static_assert(SCENARIO_NUM >= 0 && SCENARIO_NUM <= 2, "SCENARIO_NUM must be 0, 1, or 2");

#define DEVICE_ID 0
#define ROW_COUNT 64U
#define MAX_WIDTH 8192U
#define SMALL_WIDTH_LIMIT 256U
#define MEDIUM_WIDTH_LIMIT 4096U
#define EXACT_WIDTH 1024U
#define GENERIC_THREAD_COUNT 512U
#define SMALL_THREAD_COUNT 256U
#define MEDIUM_THREAD_COUNT 512U
#define WIDE_THREAD_COUNT 1024U
#define EXACT_THREAD_COUNT 256U
#define FALLBACK_THREAD_COUNT 1024U
#define NORMALIZE_SCALE 1000000U
#define RANDOM_SEED 20260812U
#define OUTPUT_SENTINEL 0xa5a5a5a5U
#define ROW_SUM_SENTINEL 0x5a5a5a5aU

typedef struct DeviceBuffers {
    uint32_t *input;
    uint32_t *normalized;
    uint32_t *row_sums;
} DeviceBuffers;

#define CHECK_ACL(expr)                                                                              \
    do {                                                                                             \
        aclError check_acl_result = (expr);                                                          \
        if (check_acl_result != ACL_SUCCESS) {                                                       \
            fprintf(stderr, "ACL call failed: %s, ret=%d\n", #expr, (int)check_acl_result);         \
            exit(1);                                                                                 \
        }                                                                                            \
    } while (0)

__simt_callee__ inline void row_normalize_runtime_body(
    __gm__ const uint32_t *input,
    __gm__ uint32_t *normalized,
    __gm__ uint32_t *row_sums,
    uint32_t width,
    uint32_t scan_width,
    __ubuf__ uint32_t *thread_sums)
{
    uint32_t thread_index = (uint32_t)threadIdx.x;
    uint32_t thread_count = (uint32_t)blockDim.x;
    uint32_t row = (uint32_t)blockIdx.x;
    uint32_t row_base = row * MAX_WIDTH;
    uint32_t local_sum = 0U;

    for (uint32_t column = thread_index; column < scan_width; column += thread_count) {
        if (column < width) {
            local_sum += input[row_base + column];
        }
    }
    thread_sums[thread_index] = local_sum;
    asc_syncthreads();

    for (uint32_t stride = thread_count / 2U; stride > 0U; stride /= 2U) {
        if (thread_index < stride) {
            thread_sums[thread_index] += thread_sums[thread_index + stride];
        }
        asc_syncthreads();
    }

    uint32_t row_sum = thread_sums[0];
    if (thread_index == 0U) {
        row_sums[row] = row_sum;
    }
    for (uint32_t column = thread_index; column < width; column += thread_count) {
        normalized[row_base + column] = (input[row_base + column] * NORMALIZE_SCALE) / row_sum;
    }
}

__simt_callee__ inline void row_normalize_exact_1024_body(
    __gm__ const uint32_t *input,
    __gm__ uint32_t *normalized,
    __gm__ uint32_t *row_sums,
    __ubuf__ uint32_t *thread_sums)
{
    uint32_t thread_index = (uint32_t)threadIdx.x;
    uint32_t row = (uint32_t)blockIdx.x;
    uint32_t row_base = row * MAX_WIDTH;
    uint32_t local_sum = 0U;

    for (uint32_t column = thread_index; column < EXACT_WIDTH; column += EXACT_THREAD_COUNT) {
        local_sum += input[row_base + column];
    }
    thread_sums[thread_index] = local_sum;
    asc_syncthreads();

    for (uint32_t stride = EXACT_THREAD_COUNT / 2U; stride > 0U; stride /= 2U) {
        if (thread_index < stride) {
            thread_sums[thread_index] += thread_sums[thread_index + stride];
        }
        asc_syncthreads();
    }

    uint32_t row_sum = thread_sums[0];
    if (thread_index == 0U) {
        row_sums[row] = row_sum;
    }
    for (uint32_t column = thread_index; column < EXACT_WIDTH; column += EXACT_THREAD_COUNT) {
        normalized[row_base + column] = (input[row_base + column] * NORMALIZE_SCALE) / row_sum;
    }
}

#if SCENARIO_NUM == 0
__simt_vf__ __launch_bounds__(GENERIC_THREAD_COUNT) inline void generic_row_normalize_vf(
    __gm__ const uint32_t *input,
    __gm__ uint32_t *normalized,
    __gm__ uint32_t *row_sums,
    uint32_t width,
    __ubuf__ uint32_t *thread_sums)
{
    row_normalize_runtime_body(input, normalized, row_sums, width, width, thread_sums);
}

__global__ __vector__ void generic_row_normalize_kernel(
    __gm__ const uint32_t *input,
    __gm__ uint32_t *normalized,
    __gm__ uint32_t *row_sums,
    uint32_t width)
{
    extern __ubuf__ uint32_t dynamic_start_ub[];
    asc_vf_call<generic_row_normalize_vf>(dim3(GENERIC_THREAD_COUNT, 1, 1),
        input, normalized, row_sums, width, dynamic_start_ub);
}
#elif SCENARIO_NUM == 1
__simt_vf__ __launch_bounds__(SMALL_THREAD_COUNT) inline void small_row_normalize_vf(
    __gm__ const uint32_t *input,
    __gm__ uint32_t *normalized,
    __gm__ uint32_t *row_sums,
    uint32_t width,
    __ubuf__ uint32_t *thread_sums)
{
    row_normalize_runtime_body(input, normalized, row_sums, width, width, thread_sums);
}

__simt_vf__ __launch_bounds__(MEDIUM_THREAD_COUNT) inline void medium_row_normalize_vf(
    __gm__ const uint32_t *input,
    __gm__ uint32_t *normalized,
    __gm__ uint32_t *row_sums,
    uint32_t width,
    __ubuf__ uint32_t *thread_sums)
{
    row_normalize_runtime_body(input, normalized, row_sums, width, width, thread_sums);
}

__simt_vf__ __launch_bounds__(WIDE_THREAD_COUNT) inline void wide_row_normalize_vf(
    __gm__ const uint32_t *input,
    __gm__ uint32_t *normalized,
    __gm__ uint32_t *row_sums,
    uint32_t width,
    __ubuf__ uint32_t *thread_sums)
{
    row_normalize_runtime_body(input, normalized, row_sums, width, width, thread_sums);
}

__global__ __vector__ void small_row_normalize_kernel(
    __gm__ const uint32_t *input,
    __gm__ uint32_t *normalized,
    __gm__ uint32_t *row_sums,
    uint32_t width)
{
    extern __ubuf__ uint32_t dynamic_start_ub[];
    asc_vf_call<small_row_normalize_vf>(dim3(SMALL_THREAD_COUNT, 1, 1),
        input, normalized, row_sums, width, dynamic_start_ub);
}

__global__ __vector__ void medium_row_normalize_kernel(
    __gm__ const uint32_t *input,
    __gm__ uint32_t *normalized,
    __gm__ uint32_t *row_sums,
    uint32_t width)
{
    extern __ubuf__ uint32_t dynamic_start_ub[];
    asc_vf_call<medium_row_normalize_vf>(dim3(MEDIUM_THREAD_COUNT, 1, 1),
        input, normalized, row_sums, width, dynamic_start_ub);
}

__global__ __vector__ void wide_row_normalize_kernel(
    __gm__ const uint32_t *input,
    __gm__ uint32_t *normalized,
    __gm__ uint32_t *row_sums,
    uint32_t width)
{
    extern __ubuf__ uint32_t dynamic_start_ub[];
    asc_vf_call<wide_row_normalize_vf>(dim3(WIDE_THREAD_COUNT, 1, 1),
        input, normalized, row_sums, width, dynamic_start_ub);
}
#else
__simt_vf__ __launch_bounds__(EXACT_THREAD_COUNT) inline void exact_1024_row_normalize_vf(
    __gm__ const uint32_t *input,
    __gm__ uint32_t *normalized,
    __gm__ uint32_t *row_sums,
    __ubuf__ uint32_t *thread_sums)
{
    row_normalize_exact_1024_body(input, normalized, row_sums, thread_sums);
}

__simt_vf__ __launch_bounds__(FALLBACK_THREAD_COUNT) inline void exact_overfit_fallback_vf(
    __gm__ const uint32_t *input,
    __gm__ uint32_t *normalized,
    __gm__ uint32_t *row_sums,
    uint32_t width,
    __ubuf__ uint32_t *thread_sums)
{
    uint32_t scan_width = MAX_WIDTH;
    row_normalize_runtime_body(input, normalized, row_sums, width, scan_width, thread_sums);
}

__global__ __vector__ void exact_1024_row_normalize_kernel(
    __gm__ const uint32_t *input,
    __gm__ uint32_t *normalized,
    __gm__ uint32_t *row_sums)
{
    extern __ubuf__ uint32_t dynamic_start_ub[];
    asc_vf_call<exact_1024_row_normalize_vf>(dim3(EXACT_THREAD_COUNT, 1, 1),
        input, normalized, row_sums, dynamic_start_ub);
}

__global__ __vector__ void exact_overfit_fallback_kernel(
    __gm__ const uint32_t *input,
    __gm__ uint32_t *normalized,
    __gm__ uint32_t *row_sums,
    uint32_t width)
{
    extern __ubuf__ uint32_t dynamic_start_ub[];
    asc_vf_call<exact_overfit_fallback_vf>(dim3(FALLBACK_THREAD_COUNT, 1, 1),
        input, normalized, row_sums, width, dynamic_start_ub);
}
#endif

static uint32_t next_random(uint32_t *state)
{
    uint32_t value = *state;
    value ^= value << 13;
    value ^= value >> 17;
    value ^= value << 5;
    *state = value;
    return value;
}

static void fill_input_fixed_seed(uint32_t *input)
{
    uint32_t random_state = RANDOM_SEED;
    uint32_t element_count = ROW_COUNT * MAX_WIDTH;
    for (uint32_t index = 0; index < element_count; ++index) {
        input[index] = (next_random(&random_state) % 31U) + 1U;
    }
}

static void build_host_oracle(
    const uint32_t *input,
    uint32_t *expected_normalized,
    uint32_t *expected_row_sums,
    uint32_t width)
{
    for (uint32_t row = 0; row < ROW_COUNT; ++row) {
        uint32_t row_base = row * MAX_WIDTH;
        uint32_t row_sum = 0U;
        for (uint32_t column = 0; column < width; ++column) {
            row_sum += input[row_base + column];
        }
        expected_row_sums[row] = row_sum;
        for (uint32_t column = 0; column < width; ++column) {
            expected_normalized[row_base + column] =
                (input[row_base + column] * NORMALIZE_SCALE) / row_sum;
        }
    }
}

static int verify_row_sums(const uint32_t *actual, const uint32_t *expected)
{
    uint32_t mismatches = 0U;
    for (uint32_t row = 0; row < ROW_COUNT; ++row) {
        if (actual[row] != expected[row]) {
            if (mismatches < 8U) {
                fprintf(stderr, "row sum mismatch: row=%u actual=%u expected=%u\n",
                    row, actual[row], expected[row]);
            }
            ++mismatches;
        }
    }
    return mismatches == 0U;
}

static int verify_normalized_output(
    const uint32_t *actual,
    const uint32_t *expected,
    uint32_t width)
{
    uint32_t mismatches = 0U;
    for (uint32_t row = 0; row < ROW_COUNT; ++row) {
        uint32_t row_base = row * MAX_WIDTH;
        for (uint32_t column = 0; column < width; ++column) {
            uint32_t index = row_base + column;
            if (actual[index] != expected[index]) {
                if (mismatches < 8U) {
                    fprintf(stderr, "normalized output mismatch: row=%u column=%u actual=%u expected=%u\n",
                        row, column, actual[index], expected[index]);
                }
                ++mismatches;
            }
        }
    }
    return mismatches == 0U;
}

static int verify_row_tail_sentinel(const uint32_t *actual, uint32_t width)
{
    uint32_t mismatches = 0U;
    for (uint32_t row = 0; row < ROW_COUNT; ++row) {
        uint32_t row_base = row * MAX_WIDTH;
        for (uint32_t column = width; column < MAX_WIDTH; ++column) {
            uint32_t index = row_base + column;
            if (actual[index] != OUTPUT_SENTINEL) {
                if (mismatches < 8U) {
                    fprintf(stderr, "row tail overwrite: row=%u column=%u actual=%u\n",
                        row, column, actual[index]);
                }
                ++mismatches;
            }
        }
    }
    return mismatches == 0U;
}

static const char *selected_kernel_name(uint32_t width)
{
#if SCENARIO_NUM == 0
    (void)width;
    return "generic_row_normalize_kernel";
#elif SCENARIO_NUM == 1
    if (width <= SMALL_WIDTH_LIMIT) {
        return "small_row_normalize_kernel";
    } else if (width <= MEDIUM_WIDTH_LIMIT) {
        return "medium_row_normalize_kernel";
    }
    return "wide_row_normalize_kernel";
#else
    if (width == EXACT_WIDTH) {
        return "exact_1024_row_normalize_kernel";
    }
    return "exact_overfit_fallback_kernel";
#endif
}

static void allocate_device_buffers(DeviceBuffers *buffers)
{
    size_t matrix_bytes = (size_t)ROW_COUNT * MAX_WIDTH * sizeof(uint32_t);
    size_t sums_bytes = (size_t)ROW_COUNT * sizeof(uint32_t);
    CHECK_ACL(aclrtMalloc((void **)&buffers->input, matrix_bytes, ACL_MEM_MALLOC_HUGE_FIRST));
    CHECK_ACL(aclrtMalloc((void **)&buffers->normalized, matrix_bytes, ACL_MEM_MALLOC_HUGE_FIRST));
    CHECK_ACL(aclrtMalloc((void **)&buffers->row_sums, sums_bytes, ACL_MEM_MALLOC_HUGE_FIRST));
}

static void free_device_buffers(DeviceBuffers *buffers)
{
    CHECK_ACL(aclrtFree(buffers->row_sums));
    CHECK_ACL(aclrtFree(buffers->normalized));
    CHECK_ACL(aclrtFree(buffers->input));
}

static void launch_selected_kernel(const DeviceBuffers *buffers, uint32_t width, aclrtStream stream)
{
#if SCENARIO_NUM == 0
    generic_row_normalize_kernel<<<ROW_COUNT, GENERIC_THREAD_COUNT * sizeof(uint32_t), stream>>>(
        buffers->input, buffers->normalized, buffers->row_sums, width);
#elif SCENARIO_NUM == 1
    if (width <= SMALL_WIDTH_LIMIT) {
        small_row_normalize_kernel<<<ROW_COUNT, SMALL_THREAD_COUNT * sizeof(uint32_t), stream>>>(
            buffers->input, buffers->normalized, buffers->row_sums, width);
    } else if (width <= MEDIUM_WIDTH_LIMIT) {
        medium_row_normalize_kernel<<<ROW_COUNT, MEDIUM_THREAD_COUNT * sizeof(uint32_t), stream>>>(
            buffers->input, buffers->normalized, buffers->row_sums, width);
    } else {
        wide_row_normalize_kernel<<<ROW_COUNT, WIDE_THREAD_COUNT * sizeof(uint32_t), stream>>>(
            buffers->input, buffers->normalized, buffers->row_sums, width);
    }
#else
    if (width == EXACT_WIDTH) {
        exact_1024_row_normalize_kernel<<<ROW_COUNT, EXACT_THREAD_COUNT * sizeof(uint32_t), stream>>>(
            buffers->input, buffers->normalized, buffers->row_sums);
    } else {
        exact_overfit_fallback_kernel<<<ROW_COUNT, FALLBACK_THREAD_COUNT * sizeof(uint32_t), stream>>>(
            buffers->input, buffers->normalized, buffers->row_sums, width);
    }
#endif
}

static int parse_width(const char *text, uint32_t *width)
{
    char *end = NULL;
    unsigned long parsed = strtoul(text, &end, 10);
    if (end == text || *end != '\0' || parsed == 0UL || parsed > MAX_WIDTH) {
        return 0;
    }
    *width = (uint32_t)parsed;
    return 1;
}

int main(int argc, char **argv)
{
    uint32_t width = 0U;
    size_t matrix_bytes = (size_t)ROW_COUNT * MAX_WIDTH * sizeof(uint32_t);
    size_t sums_bytes = (size_t)ROW_COUNT * sizeof(uint32_t);
    uint32_t *host_input = NULL;
    uint32_t *actual_normalized = NULL;
    uint32_t *expected_normalized = NULL;
    uint32_t *actual_row_sums = NULL;
    uint32_t *expected_row_sums = NULL;
    DeviceBuffers buffers = {0};
    aclrtStream stream = NULL;
    int valid = 0;

    if (argc != 2 || !parse_width(argv[1], &width) || width == 0U || width > MAX_WIDTH) {
        fprintf(stderr, "usage: %s <width: 1..%u>\n", argv[0], MAX_WIDTH);
        return 2;
    }

    host_input = (uint32_t *)malloc(matrix_bytes);
    actual_normalized = (uint32_t *)malloc(matrix_bytes);
    expected_normalized = (uint32_t *)malloc(matrix_bytes);
    actual_row_sums = (uint32_t *)malloc(sums_bytes);
    expected_row_sums = (uint32_t *)malloc(sums_bytes);
    if (host_input == NULL || actual_normalized == NULL || expected_normalized == NULL ||
        actual_row_sums == NULL || expected_row_sums == NULL) {
        fprintf(stderr, "host allocation failed\n");
        free(expected_row_sums);
        free(actual_row_sums);
        free(expected_normalized);
        free(actual_normalized);
        free(host_input);
        return 1;
    }

    fill_input_fixed_seed(host_input);
    memset(actual_normalized, 0xa5, matrix_bytes);
    memset(expected_normalized, 0xa5, matrix_bytes);
    for (uint32_t row = 0; row < ROW_COUNT; ++row) {
        actual_row_sums[row] = ROW_SUM_SENTINEL;
        expected_row_sums[row] = ROW_SUM_SENTINEL;
    }
    build_host_oracle(host_input, expected_normalized, expected_row_sums, width);

    CHECK_ACL(aclInit(NULL));
    CHECK_ACL(aclrtSetDevice(DEVICE_ID));
    CHECK_ACL(aclrtCreateStream(&stream));
    allocate_device_buffers(&buffers);
    CHECK_ACL(aclrtMemcpy(buffers.input, matrix_bytes, host_input,
        matrix_bytes, ACL_MEMCPY_HOST_TO_DEVICE));
    CHECK_ACL(aclrtMemcpy(buffers.normalized, matrix_bytes, actual_normalized,
        matrix_bytes, ACL_MEMCPY_HOST_TO_DEVICE));
    CHECK_ACL(aclrtMemcpy(buffers.row_sums, sums_bytes, actual_row_sums,
        sums_bytes, ACL_MEMCPY_HOST_TO_DEVICE));

    launch_selected_kernel(&buffers, width, stream);
    CHECK_ACL(aclrtSynchronizeStream(stream));
    CHECK_ACL(aclrtMemcpy(actual_normalized, matrix_bytes, buffers.normalized,
        matrix_bytes, ACL_MEMCPY_DEVICE_TO_HOST));
    CHECK_ACL(aclrtMemcpy(actual_row_sums, sums_bytes, buffers.row_sums,
        sums_bytes, ACL_MEMCPY_DEVICE_TO_HOST));

    valid = verify_row_sums(actual_row_sums, expected_row_sums) &&
        verify_normalized_output(actual_normalized, expected_normalized, width) &&
        verify_row_tail_sentinel(actual_normalized, width);
    printf("scenario=%d width=%u rows=%u launch_count=1 kernel=%s\n",
        SCENARIO_NUM, width, ROW_COUNT, selected_kernel_name(width));
    printf("%s\n", valid ? "Verification PASSED" : "Verification FAILED");

    free_device_buffers(&buffers);
    CHECK_ACL(aclrtDestroyStream(stream));
    CHECK_ACL(aclrtResetDevice(DEVICE_ID));
    CHECK_ACL(aclFinalize());
    free(expected_row_sums);
    free(actual_row_sums);
    free(expected_normalized);
    free(actual_normalized);
    free(host_input);
    return valid ? 0 : 1;
}
