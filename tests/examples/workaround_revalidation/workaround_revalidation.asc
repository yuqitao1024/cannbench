#include <stdint.h>
#include <stdio.h>
#include <stdlib.h>

#include "acl/acl.h"
#include "c_api/asc_simd.h"
#include "simt_api/asc_simt.h"

#ifndef SCENARIO_NUM
#define SCENARIO_NUM 0
#endif

#define ROW_COUNT 4099U
#define ROW_WIDTH 257U
#define THREAD_COUNT 512U
#define WORKAROUND_BLOCK_DIM 1U
#define FIXED_BLOCK_DIM 64U
#define REPEAT_COUNT 3U
#define RANDOM_SEED 20260812U

typedef struct {
    float* input;
    float* scratch;
    float* output;
} DeviceBuffers;

__simt_callee__ inline float compute_row_sum(__gm__ const float* input, uint32_t row)
{
    float sum = 0.0F;
    uint32_t base = row * ROW_WIDTH;
    for (uint32_t col = 0U; col < ROW_WIDTH; ++col) {
        sum += input[base + col];
    }
    return sum;
}

__simt_vf__ inline void row_sum_single_block_workaround_vf(
    __gm__ const float* input, __gm__ float* scratch, __gm__ float* output,
    uint32_t block_index, uint32_t block_count)
{
    uint32_t thread_id = block_index * (uint32_t)blockDim.x + (uint32_t)threadIdx.x;
    uint32_t thread_count = block_count * (uint32_t)blockDim.x;
    uint32_t scratch_slot = (uint32_t)threadIdx.x;
    for (uint32_t row = thread_id; row < ROW_COUNT; row += thread_count) {
        scratch[scratch_slot] = compute_row_sum(input, row);
        output[row] = scratch[scratch_slot];
    }
}

__simt_vf__ inline void row_sum_unique_scratch_multiblock_vf(
    __gm__ const float* input, __gm__ float* scratch, __gm__ float* output,
    uint32_t block_index, uint32_t block_count)
{
    uint32_t thread_id = block_index * (uint32_t)blockDim.x + (uint32_t)threadIdx.x;
    uint32_t thread_count = block_count * (uint32_t)blockDim.x;
    uint32_t scratch_slot = block_index * (uint32_t)blockDim.x + (uint32_t)threadIdx.x;
    for (uint32_t row = thread_id; row < ROW_COUNT; row += thread_count) {
        scratch[scratch_slot] = compute_row_sum(input, row);
        output[row] = scratch[scratch_slot];
    }
}

// UNSAFE_REMOVAL_REPRODUCTION: using scratch_slot=threadIdx.x with FIXED_BLOCK_DIM
// lets different blocks overwrite the same 512 slots. This invalid path is modeled on host only.
__global__ __vector__ void row_sum_single_block_workaround_kernel(
    __gm__ const float* input, __gm__ float* scratch, __gm__ float* output)
{
    asc_vf_call<row_sum_single_block_workaround_vf>(
        dim3(THREAD_COUNT), input, scratch, output, block_idx, WORKAROUND_BLOCK_DIM);
}

__global__ __vector__ void row_sum_unique_scratch_multiblock_kernel(
    __gm__ const float* input, __gm__ float* scratch, __gm__ float* output)
{
    asc_vf_call<row_sum_unique_scratch_multiblock_vf>(
        dim3(THREAD_COUNT), input, scratch, output, block_idx, FIXED_BLOCK_DIM);
}

static uint32_t next_random(uint32_t* state)
{
    uint32_t value = *state;
    value ^= value << 13U;
    value ^= value >> 17U;
    value ^= value << 5U;
    *state = value;
    return value;
}

static void fill_input_fixed_seed(float* input)
{
    uint32_t state = RANDOM_SEED;
    size_t count = (size_t)ROW_COUNT * ROW_WIDTH;
    for (size_t offset = 0U; offset < count; ++offset) {
        int32_t quantized = (int32_t)(next_random(&state) & 0x7ffU) - 1024;
        input[offset] = (float)quantized * 0.25F;
    }
}

static void host_row_sum_oracle(const float* input, float* expected_output)
{
    for (uint32_t row = 0U; row < ROW_COUNT; ++row) {
        float sum = 0.0F;
        for (uint32_t col = 0U; col < ROW_WIDTH; ++col) {
            sum += input[row * ROW_WIDTH + col];
        }
        expected_output[row] = sum;
    }
}

static int verify_complete_output(const float* actual_output, const float* expected_output)
{
    for (uint32_t row = 0U; row < ROW_COUNT; ++row) {
        float actual = actual_output[row];
        if (actual != expected_output[row]) {
            fprintf(stderr, "mismatch row=%u expected=%.6f actual=%.6f\n", row, expected_output[row], actual);
            return 0;
        }
    }
    return 1;
}

static int validate_ownership_model(void)
{
    uint8_t* unsafe_seen = (uint8_t*)calloc(THREAD_COUNT, sizeof(uint8_t));
    uint8_t* fixed_seen = (uint8_t*)calloc(FIXED_BLOCK_DIM * THREAD_COUNT, sizeof(uint8_t));
    uint32_t unsafe_collision_count = 0U;
    uint32_t fixed_collision_count = 0U;
    if (unsafe_seen == NULL || fixed_seen == NULL) {
        free(fixed_seen);
        free(unsafe_seen);
        return 0;
    }
    for (uint32_t block = 0U; block < FIXED_BLOCK_DIM; ++block) {
        for (uint32_t thread = 0U; thread < THREAD_COUNT; ++thread) {
            uint32_t unsafe_slot = thread;
            uint32_t fixed_slot = block * THREAD_COUNT + thread;
            if (unsafe_seen[unsafe_slot] != 0U) {
                ++unsafe_collision_count;
            }
            if (fixed_seen[fixed_slot] != 0U) {
                ++fixed_collision_count;
            }
            unsafe_seen[unsafe_slot] = 1U;
            fixed_seen[fixed_slot] = 1U;
        }
    }
    free(fixed_seen);
    free(unsafe_seen);
    if (unsafe_collision_count == 0U || fixed_collision_count != 0U) {
        fprintf(stderr, "ownership model failed: unsafe=%u fixed=%u\n",
            unsafe_collision_count, fixed_collision_count);
        return 0;
    }
    printf("Ownership model PASSED: unsafe collisions=%u, fixed collisions=%u\n",
        unsafe_collision_count, fixed_collision_count);
    return 1;
}

static int check_acl(aclError result, const char* operation)
{
    if (result == ACL_SUCCESS) {
        return 1;
    }
    fprintf(stderr, "ACL call failed: %s, error=%d\n", operation, (int)result);
    return 0;
}

static void release_device_buffers(DeviceBuffers* buffers)
{
    if (buffers->output != NULL) {
        (void)aclrtFree(buffers->output);
        buffers->output = NULL;
    }
    if (buffers->scratch != NULL) {
        (void)aclrtFree(buffers->scratch);
        buffers->scratch = NULL;
    }
    if (buffers->input != NULL) {
        (void)aclrtFree(buffers->input);
        buffers->input = NULL;
    }
}

static int allocate_device_buffers(DeviceBuffers* buffers, size_t input_bytes, size_t output_bytes)
{
    size_t scratch_count = SCENARIO_NUM == 0 ? THREAD_COUNT : FIXED_BLOCK_DIM * THREAD_COUNT;
    if (!check_acl(aclrtMalloc((void**)&buffers->input, input_bytes, ACL_MEM_MALLOC_HUGE_FIRST),
            "aclrtMalloc input")) {
        return 0;
    }
    if (!check_acl(aclrtMalloc((void**)&buffers->scratch, scratch_count * sizeof(float),
            ACL_MEM_MALLOC_HUGE_FIRST), "aclrtMalloc scratch")) {
        return 0;
    }
    if (!check_acl(aclrtMalloc((void**)&buffers->output, output_bytes, ACL_MEM_MALLOC_HUGE_FIRST),
            "aclrtMalloc output")) {
        return 0;
    }
    return 1;
}

static void launch_selected_kernel(const DeviceBuffers* buffers, aclrtStream stream)
{
    for (uint32_t repeat = 0U; repeat < REPEAT_COUNT; ++repeat) {
#if SCENARIO_NUM == 0
        row_sum_single_block_workaround_kernel<<<WORKAROUND_BLOCK_DIM, 0, stream>>>(
            buffers->input, buffers->scratch, buffers->output);
#else
        row_sum_unique_scratch_multiblock_kernel<<<FIXED_BLOCK_DIM, 0, stream>>>(
            buffers->input, buffers->scratch, buffers->output);
#endif
    }
}

int main(void)
{
    size_t input_bytes = (size_t)ROW_COUNT * ROW_WIDTH * sizeof(float);
    size_t output_bytes = (size_t)ROW_COUNT * sizeof(float);
    float* input = (float*)malloc(input_bytes);
    float* actual_output = (float*)malloc(output_bytes);
    float* expected_output = (float*)malloc(output_bytes);
    DeviceBuffers device = {NULL, NULL, NULL};
    aclrtStream stream = NULL;
    int acl_initialized = 0;
    int device_selected = 0;
    int success = 0;

    if (input == NULL || actual_output == NULL || expected_output == NULL || !validate_ownership_model()) {
        goto cleanup;
    }
    fill_input_fixed_seed(input);
    host_row_sum_oracle(input, expected_output);
    if (!check_acl(aclInit(NULL), "aclInit")) {
        goto cleanup;
    }
    acl_initialized = 1;
    if (!check_acl(aclrtSetDevice(0), "aclrtSetDevice")) {
        goto cleanup;
    }
    device_selected = 1;
    if (!check_acl(aclrtCreateStream(&stream), "aclrtCreateStream")) {
        goto cleanup;
    }
    if (!allocate_device_buffers(&device, input_bytes, output_bytes)) {
        goto cleanup;
    }
    if (!check_acl(aclrtMemcpy(device.input, input_bytes, input, input_bytes,
            ACL_MEMCPY_HOST_TO_DEVICE), "copy input H2D")) {
        goto cleanup;
    }
    launch_selected_kernel(&device, stream);
    if (!check_acl(aclrtSynchronizeStream(stream), "repeated launch synchronize")) {
        goto cleanup;
    }
    if (!check_acl(aclrtMemcpy(actual_output, output_bytes, device.output, output_bytes,
            ACL_MEMCPY_DEVICE_TO_HOST), "copy output D2H")) {
        goto cleanup;
    }
    success = verify_complete_output(actual_output, expected_output);

cleanup:
    printf("Scenario %d: %s\n", SCENARIO_NUM,
        SCENARIO_NUM == 0 ? "single-block correctness workaround" : "unique-scratch multi-block fix");
    printf("Input [4099, 257] float32, output [4099], repeated launches=3\n");
    printf("Block dim=%u, threads=%u\n", SCENARIO_NUM == 0 ? WORKAROUND_BLOCK_DIM : FIXED_BLOCK_DIM, THREAD_COUNT);
    if (success) {
        printf("Verification PASSED\n");
    } else {
        printf("Verification FAILED\n");
    }
    release_device_buffers(&device);
    if (stream != NULL) (void)aclrtDestroyStream(stream);
    if (device_selected) (void)aclrtResetDevice(0);
    if (acl_initialized) (void)aclFinalize();
    free(expected_output);
    free(actual_output);
    free(input);
    return success ? 0 : 1;
}
