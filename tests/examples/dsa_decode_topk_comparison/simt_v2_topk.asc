#include <cstdint>

#include "c_api/asc_simd.h"
#include "host_common.h"
#include "basic_api/kernel_operator_block_sync_intf.h"
#include "simt_api/asc_simt.h"
#include "simt_api/device_atomic_functions.h"
#include "simt_api/device_sync_functions.h"
#include "simt_api/device_warp_functions.h"

namespace {

constexpr int32_t kCanonicalContextShardCount = 16;
constexpr int32_t kThreadsPerBlock = 1024;
constexpr int32_t kWarpSize = 32;
constexpr int32_t kReducerThreads = 256;
constexpr int32_t kRadixBins = 256;
constexpr int32_t kHistogramWarpCount = 8;
static_assert(kHistogramWarpCount * kWarpSize == kRadixBins);
constexpr int32_t kHistogramWords = kRadixBins;
constexpr int32_t kStateWordsPerRow = 4;
constexpr int32_t kOffsetWordsPerShard = 2;
constexpr int32_t kScoreShardElements =
    kContextCount / kCanonicalContextShardCount;
constexpr int32_t kScoreShardUbufBytes =
    kScoreShardElements * static_cast<int32_t>(sizeof(uint16_t));
constexpr int32_t kHistogramUbufBytes =
    kHistogramWords * static_cast<int32_t>(sizeof(uint32_t));
constexpr int32_t kHistogramShardWords =
    kCanonicalContextShardCount * kRadixBins;
constexpr int32_t kHistogramShardUbufBytes =
    kHistogramShardWords * static_cast<int32_t>(sizeof(uint32_t));
constexpr int32_t kReducerUbufWords =
    kHistogramWords + 2 * kCanonicalContextShardCount;
constexpr int32_t kReducerUbufBytes =
    kReducerUbufWords * static_cast<int32_t>(sizeof(uint32_t));
constexpr int32_t kCompactGreater = 0;
constexpr int32_t kCompactEqual = 1;
constexpr int32_t kCompactCounterWords = 2;
constexpr int32_t kCompactUbufBytes =
    2 * kThreadsPerBlock * static_cast<int32_t>(sizeof(uint32_t));
static_assert(kCompactUbufBytes >= kHistogramUbufBytes);
static_assert(kCompactUbufBytes >= kReducerUbufBytes);
static_assert(
    kCompactUbufBytes >=
    kCompactCounterWords * static_cast<int32_t>(sizeof(uint32_t)));
constexpr int32_t kTotalUbufBytes =
    kScoreShardUbufBytes + 2 * kHistogramShardUbufBytes + kCompactUbufBytes;

constexpr int32_t kStateSelectedHigh = 0;
constexpr int32_t kStateRemainingRank = 1;
constexpr int32_t kStateThresholdKey = 2;
constexpr int32_t kStateTotalGreater = 3;
constexpr int32_t kOffsetGreater = 0;
constexpr int32_t kOffsetEqual = 1;

__SIMT_DEVICE_FUNCTIONS_DECL__ inline uint16_t ordered_bf16_key(
    uint16_t bits) {
  return (bits & 0x8000U) != 0U
      ? static_cast<uint16_t>(~bits)
      : static_cast<uint16_t>(bits ^ 0x8000U);
}

__SIMT_DEVICE_FUNCTIONS_DECL__ inline void publish_gm_for_next_stage() {
  asc_syncthreads();
  if (threadIdx.x == 0) {
    __builtin_cce_dcci(nullptr, 1, 0);
  }
}

template <typename T>
__aicore__ inline __gm__ T* mutable_gm_ptr(__gm__ const T* pointer) {
  return const_cast<__gm__ T*>(pointer);
}

__simt_callee__ inline uint32_t histogram_to_inclusive_suffix(
    __ubuf__ uint32_t* histogram) {
  const int32_t thread_index = static_cast<int32_t>(threadIdx.x);
  __ubuf__ uint32_t* warp_suffix_totals = histogram + kRadixBins;
  uint32_t suffix_count = 0;
  if (thread_index < kRadixBins) {
    const int32_t lane_index = thread_index % kWarpSize;
    const int32_t warp_index = thread_index / kWarpSize;
    suffix_count = histogram[thread_index];
    for (int32_t shuffle_delta = 1;
         shuffle_delta < kWarpSize;
         shuffle_delta <<= 1) {
      const uint32_t higher_count = asc_shfl_down(
          suffix_count,
          static_cast<uint32_t>(shuffle_delta),
          kWarpSize);
      if (lane_index + shuffle_delta < kWarpSize) {
        suffix_count += higher_count;
      }
    }
    if (lane_index == 0) {
      warp_suffix_totals[warp_index] = suffix_count;
    }
  }
  asc_syncthreads();

  if (thread_index < kRadixBins) {
    const int32_t warp_index = thread_index / kWarpSize;
    uint32_t higher_warp_count = 0;
    for (int32_t higher_warp = warp_index + 1;
         higher_warp < kHistogramWarpCount;
         ++higher_warp) {
      higher_warp_count += warp_suffix_totals[higher_warp];
    }
    suffix_count += higher_warp_count;
  }
  return suffix_count;
}

__simt_vf__ __launch_bounds__(kThreadsPerBlock) inline void
lightning_indexer_decode_distributed_high_histogram_bfloat16_v2_vf(
    __ubuf__ const uint16_t* score_shard,
    __gm__ uint32_t* histogram,
    int32_t row_count,
    int32_t context_shard_count,
    __ubuf__ uint32_t* local_histogram) {
  const int32_t block_index = static_cast<int32_t>(blockIdx.x);
  const int32_t block_count = row_count * context_shard_count;
  if (block_index >= block_count) {
    return;
  }
  const int32_t thread_index = static_cast<int32_t>(threadIdx.x);
  const int64_t histogram_base =
      static_cast<int64_t>(block_index) * kRadixBins;

  if (thread_index < kRadixBins) {
    local_histogram[thread_index] = 0;
  }
  asc_syncthreads();
  for (int32_t shard_offset = thread_index;
       shard_offset < kScoreShardElements;
       shard_offset += kThreadsPerBlock) {
    const uint16_t score_key = ordered_bf16_key(score_shard[shard_offset]);
    const uint32_t bucket = static_cast<uint32_t>(score_key >> 8);
    asc_atomic_add(local_histogram + bucket, 1U);
  }
  asc_syncthreads();
  const uint32_t suffix_count =
      histogram_to_inclusive_suffix(local_histogram);
  if (thread_index < kRadixBins) {
    histogram[histogram_base + thread_index] = suffix_count;
  }
  publish_gm_for_next_stage();
}

__simt_callee__ inline uint32_t adjacent_suffix_greater_count(
    uint32_t inclusive_count,
    __ubuf__ uint32_t* warp_first_counts) {
  const int32_t thread_index = static_cast<int32_t>(threadIdx.x);
  const int32_t lane_index = thread_index % kWarpSize;
  const int32_t warp_index = thread_index / kWarpSize;
  if (lane_index == 0) {
    warp_first_counts[warp_index] = inclusive_count;
  }
  const uint32_t next_lane_count = asc_shfl_down(
      inclusive_count, 1, kWarpSize);
  asc_syncthreads();

  if (thread_index + 1 >= kRadixBins) {
    return 0U;
  }
  if (lane_index + 1 < kWarpSize) {
    return next_lane_count;
  }
  return warp_first_counts[warp_index + 1];
}

__simt_vf__ __launch_bounds__(kReducerThreads) inline void
lightning_indexer_decode_distributed_select_high_bfloat16_v2_vf(
    __ubuf__ const uint32_t* high_histogram_shards,
    __gm__ uint32_t* state,
    int32_t row_count,
    int32_t context_shard_count,
    __ubuf__ uint32_t* combined_histogram) {
  const int32_t row_index = static_cast<int32_t>(blockIdx.x);
  if (row_index >= row_count) {
    return;
  }
  const int32_t bucket = static_cast<int32_t>(threadIdx.x);
  uint32_t bucket_count = 0;
  for (int32_t shard_index = 0;
       shard_index < context_shard_count;
       ++shard_index) {
    const int32_t histogram_offset = shard_index * kRadixBins + bucket;
    bucket_count += high_histogram_shards[histogram_offset];
  }
  const uint32_t inclusive_count = bucket_count;
  const uint32_t greater_count =
      adjacent_suffix_greater_count(
          inclusive_count, combined_histogram);
  if (inclusive_count >= kTopK && greater_count < kTopK) {
    const int64_t state_base =
        static_cast<int64_t>(row_index) * kStateWordsPerRow;
    state[state_base + kStateSelectedHigh] = static_cast<uint32_t>(bucket);
    state[state_base + kStateRemainingRank] = kTopK - greater_count;
  }
  publish_gm_for_next_stage();
}

__simt_vf__ __launch_bounds__(kThreadsPerBlock) inline void
lightning_indexer_decode_distributed_low_histogram_bfloat16_v2_vf(
    __ubuf__ const uint16_t* score_shard,
    __gm__ const uint32_t* state,
    __gm__ uint32_t* histogram,
    int32_t row_count,
    int32_t context_shard_count,
    __ubuf__ uint32_t* local_histogram) {
  const int32_t block_index = static_cast<int32_t>(blockIdx.x);
  const int32_t block_count = row_count * context_shard_count;
  if (block_index >= block_count) {
    return;
  }
  const int32_t thread_index = static_cast<int32_t>(threadIdx.x);
  const int32_t row_index = block_index / context_shard_count;
  const int64_t histogram_base =
      static_cast<int64_t>(block_index) * kRadixBins;
  const uint16_t selected_high = static_cast<uint16_t>(
      state[static_cast<int64_t>(row_index) * kStateWordsPerRow +
            kStateSelectedHigh]);

  if (thread_index < kRadixBins) {
    local_histogram[thread_index] = 0;
  }
  asc_syncthreads();
  for (int32_t shard_offset = thread_index;
       shard_offset < kScoreShardElements;
       shard_offset += kThreadsPerBlock) {
    const uint16_t score_key = ordered_bf16_key(score_shard[shard_offset]);
    if (static_cast<uint16_t>(score_key >> 8) == selected_high) {
      const uint32_t bucket = static_cast<uint32_t>(score_key & 0xFFU);
      asc_atomic_add(local_histogram + bucket, 1U);
    }
  }
  asc_syncthreads();
  const uint32_t suffix_count =
      histogram_to_inclusive_suffix(local_histogram);
  if (thread_index < kRadixBins) {
    histogram[histogram_base + thread_index] = suffix_count;
  }
  publish_gm_for_next_stage();
}

__simt_vf__ __launch_bounds__(kReducerThreads) inline void
lightning_indexer_decode_distributed_select_low_offsets_bfloat16_v2_vf(
    __ubuf__ const uint32_t* high_histogram_shards,
    __ubuf__ const uint32_t* low_histogram_shards,
    __gm__ uint32_t* state,
    __gm__ uint32_t* shard_offsets,
    int32_t row_count,
    int32_t context_shard_count,
    __ubuf__ uint32_t* dynamic_start_ub) {
  const int32_t row_index = static_cast<int32_t>(blockIdx.x);
  if (row_index >= row_count ||
      context_shard_count != kCanonicalContextShardCount) {
    return;
  }
  __ubuf__ uint32_t* combined_histogram = dynamic_start_ub;
  __ubuf__ uint32_t* shard_greater_counts =
      combined_histogram + kHistogramWords;
  __ubuf__ uint32_t* shard_equal_counts =
      shard_greater_counts + kCanonicalContextShardCount;
  const int32_t thread_index = static_cast<int32_t>(threadIdx.x);
  const int64_t state_base =
      static_cast<int64_t>(row_index) * kStateWordsPerRow;
  const uint32_t selected_high = state[state_base + kStateSelectedHigh];
  const uint32_t remaining_rank = state[state_base + kStateRemainingRank];

  uint32_t bucket_count = 0;
  for (int32_t shard_index = 0;
       shard_index < context_shard_count;
       ++shard_index) {
    const int32_t histogram_offset =
        shard_index * kRadixBins + thread_index;
    bucket_count += low_histogram_shards[histogram_offset];
  }
  const uint32_t inclusive_count = bucket_count;
  const uint32_t greater_count =
      adjacent_suffix_greater_count(
          inclusive_count, combined_histogram);
  if (inclusive_count >= remaining_rank && greater_count < remaining_rank) {
    state[state_base + kStateThresholdKey] =
        (selected_high << 8) | static_cast<uint32_t>(thread_index);
  }
  asc_syncthreads();

  const uint32_t threshold_key = state[state_base + kStateThresholdKey];
  const uint32_t selected_low = threshold_key & 0xFFU;
  if (thread_index < kCanonicalContextShardCount) {
    const int32_t histogram_base = thread_index * kRadixBins;
    const uint32_t high_greater_count = selected_high + 1 < kRadixBins
        ? high_histogram_shards[histogram_base + selected_high + 1]
        : 0U;
    const uint32_t low_greater_count = selected_low + 1 < kRadixBins
        ? low_histogram_shards[histogram_base + selected_low + 1]
        : 0U;
    const uint32_t inclusive_low_count =
        low_histogram_shards[histogram_base + selected_low];
    shard_greater_counts[thread_index] =
        high_greater_count + low_greater_count;
    shard_equal_counts[thread_index] =
        inclusive_low_count - low_greater_count;
  }
  asc_syncthreads();

  if (thread_index < kWarpSize) {
    const bool owns_shard = thread_index < context_shard_count;
    const uint32_t shard_greater_count =
        owns_shard ? shard_greater_counts[thread_index] : 0U;
    const uint32_t shard_equal_count =
        owns_shard ? shard_equal_counts[thread_index] : 0U;
    uint32_t shard_greater_prefix = shard_greater_count;
    uint32_t shard_equal_prefix = shard_equal_count;
    const int32_t lane_in_scan_group =
        thread_index % kCanonicalContextShardCount;
    for (int32_t shuffle_delta = 1;
         shuffle_delta < kCanonicalContextShardCount;
         shuffle_delta <<= 1) {
      const uint32_t prior_greater = asc_shfl_up(
          shard_greater_prefix,
          shuffle_delta,
          kCanonicalContextShardCount);
      const uint32_t prior_equal = asc_shfl_up(
          shard_equal_prefix,
          shuffle_delta,
          kCanonicalContextShardCount);
      if (lane_in_scan_group >= shuffle_delta) {
        shard_greater_prefix += prior_greater;
        shard_equal_prefix += prior_equal;
      }
    }
    if (owns_shard) {
      const int32_t shard_index = thread_index;
      const int64_t offset_base =
          (static_cast<int64_t>(row_index) * context_shard_count + shard_index) *
          kOffsetWordsPerShard;
      shard_offsets[offset_base + kOffsetGreater] =
          shard_greater_prefix - shard_greater_count;
      shard_offsets[offset_base + kOffsetEqual] =
          shard_equal_prefix - shard_equal_count;
      if (shard_index + 1 == context_shard_count) {
        state[state_base + kStateTotalGreater] = shard_greater_prefix;
      }
    }
  }
  publish_gm_for_next_stage();
}

__simt_callee__ inline uint32_t reserve_warp_output(
    bool selected,
    __ubuf__ uint32_t* counter) {
  const uint32_t selected_mask = asc_ballot(selected ? 1 : 0);
  const uint32_t warp_selected_count =
      static_cast<uint32_t>(__popc(selected_mask));
  uint32_t warp_start = 0;
  if (laneid() == 0 && warp_selected_count != 0) {
    warp_start = asc_atomic_add(counter, warp_selected_count);
  }
  warp_start = asc_shfl(warp_start, 0, kWarpSize);
  const uint32_t lane_offset = static_cast<uint32_t>(
      __popc(selected_mask & static_cast<uint32_t>(lanemask_lt())));
  return warp_start + lane_offset;
}

__simt_vf__ __launch_bounds__(kThreadsPerBlock) inline void
lightning_indexer_decode_distributed_compact_bfloat16_v2_vf(
    __ubuf__ const uint16_t* score_shard,
    __gm__ const uint32_t* state,
    __gm__ const uint32_t* shard_offsets,
    __gm__ int32_t* output,
    int32_t row_count,
    int32_t context_shard_count,
    __ubuf__ uint32_t* dynamic_start_ub) {
  const int32_t block_index = static_cast<int32_t>(blockIdx.x);
  const int32_t block_count = row_count * context_shard_count;
  if (block_index >= block_count) {
    return;
  }
  __ubuf__ uint32_t* compact_counters = dynamic_start_ub;
  const int32_t thread_index = static_cast<int32_t>(threadIdx.x);
  const int32_t row_index = block_index / context_shard_count;
  const int32_t shard_index = block_index % context_shard_count;
  const int32_t shard_size = kContextCount / context_shard_count;
  const int32_t context_start = shard_index * shard_size;
  const int64_t row_offset = static_cast<int64_t>(row_index) * kTopK;
  const int64_t state_base =
      static_cast<int64_t>(row_index) * kStateWordsPerRow;
  const int64_t offset_base =
      static_cast<int64_t>(block_index) * kOffsetWordsPerShard;
  const uint16_t threshold_key =
      static_cast<uint16_t>(state[state_base + kStateThresholdKey]);
  const uint32_t total_greater_count =
      state[state_base + kStateTotalGreater];
  const uint32_t equal_count_needed = kTopK - total_greater_count;
  const uint32_t shard_greater_offset =
      shard_offsets[offset_base + kOffsetGreater];
  const uint32_t shard_equal_offset =
      shard_offsets[offset_base + kOffsetEqual];

  if (thread_index < kCompactCounterWords) {
    compact_counters[thread_index] = 0;
  }
  asc_syncthreads();

  for (int32_t shard_offset = thread_index;
       shard_offset < shard_size;
       shard_offset += kThreadsPerBlock) {
    const int32_t context_index = context_start + shard_offset;
    const uint16_t score_key = ordered_bf16_key(score_shard[shard_offset]);
    const bool greater = score_key > threshold_key;
    const bool equal = score_key == threshold_key;
    const uint32_t warp_greater_rank = reserve_warp_output(
        greater,
        compact_counters + kCompactGreater);
    const uint32_t warp_equal_rank = reserve_warp_output(
        equal,
        compact_counters + kCompactEqual);
    if (greater) {
      const uint32_t output_slot =
          shard_greater_offset + warp_greater_rank;
      output[row_offset + output_slot] = context_index;
    } else if (equal) {
      const uint32_t equal_rank = shard_equal_offset + warp_equal_rank;
      if (equal_rank < equal_count_needed) {
        const uint32_t output_slot = total_greater_count + equal_rank;
        output[row_offset + output_slot] = context_index;
      }
    }
  }
}

} // namespace

__global__ __vector__ void dsa_decode_topk_simt_v2_kernel(
    __gm__ const uint16_t* reduced_scores,
    __gm__ uint32_t* high_histogram,
    __gm__ uint32_t* low_histogram,
    __gm__ uint32_t* state,
    __gm__ uint32_t* shard_offsets,
    __gm__ int32_t* output,
    int32_t row_count,
    int32_t context_shard_count) {
  extern __ubuf__ uint32_t dynamicStartUB[];
  asc_init();
  const int32_t block_index = static_cast<int32_t>(get_block_idx());
  if (block_index >= row_count * context_shard_count ||
      context_shard_count != kCanonicalContextShardCount) {
    return;
  }
  const int32_t row_index = block_index / context_shard_count;
  const int32_t shard_index = block_index % context_shard_count;
  const int64_t score_base =
      static_cast<int64_t>(row_index) * kContextCount +
      shard_index * kScoreShardElements;
  __ubuf__ uint16_t* score_shard =
      reinterpret_cast<__ubuf__ uint16_t*>(dynamicStartUB);
  __ubuf__ uint32_t* high_histogram_shards =
      dynamicStartUB + kScoreShardUbufBytes / sizeof(uint32_t);
  __ubuf__ uint32_t* low_histogram_shards =
      high_histogram_shards + kHistogramShardWords;
  __ubuf__ uint32_t* stage_scratch =
      low_histogram_shards + kHistogramShardWords;

  asc_copy_gm2ub_align(
      score_shard,
      mutable_gm_ptr(reduced_scores + score_base),
      static_cast<uint32_t>(kScoreShardUbufBytes));
  asc_sync_notify(PIPE_MTE2, PIPE_V, EVENT_ID0);
  asc_sync_wait(PIPE_MTE2, PIPE_V, EVENT_ID0);

  asc_vf_call<
      lightning_indexer_decode_distributed_high_histogram_bfloat16_v2_vf>(
      dim3(kThreadsPerBlock, 1, 1),
      score_shard,
      high_histogram,
      row_count,
      context_shard_count,
      stage_scratch);
  AscendC::SyncAll();

  if (block_index < row_count) {
    const int64_t histogram_base =
        static_cast<int64_t>(block_index) * kHistogramShardWords;
    asc_copy_gm2ub_align(
        high_histogram_shards,
        high_histogram + histogram_base,
        static_cast<uint32_t>(kHistogramShardUbufBytes));
    asc_sync_notify(PIPE_MTE2, PIPE_V, EVENT_ID0);
    asc_sync_wait(PIPE_MTE2, PIPE_V, EVENT_ID0);
  }

  asc_vf_call<
      lightning_indexer_decode_distributed_select_high_bfloat16_v2_vf>(
      dim3(kReducerThreads, 1, 1),
      high_histogram_shards,
      state,
      row_count,
      context_shard_count,
      stage_scratch);
  AscendC::SyncAll();

  asc_vf_call<
      lightning_indexer_decode_distributed_low_histogram_bfloat16_v2_vf>(
      dim3(kThreadsPerBlock, 1, 1),
      score_shard,
      state,
      low_histogram,
      row_count,
      context_shard_count,
      stage_scratch);
  AscendC::SyncAll();

  if (block_index < row_count) {
    const int64_t histogram_base =
        static_cast<int64_t>(block_index) * kHistogramShardWords;
    asc_copy_gm2ub_align(
        low_histogram_shards,
        low_histogram + histogram_base,
        static_cast<uint32_t>(kHistogramShardUbufBytes));
    asc_sync_notify(PIPE_MTE2, PIPE_V, EVENT_ID0);
    asc_sync_wait(PIPE_MTE2, PIPE_V, EVENT_ID0);
  }

  asc_vf_call<
      lightning_indexer_decode_distributed_select_low_offsets_bfloat16_v2_vf>(
      dim3(kReducerThreads, 1, 1),
      high_histogram_shards,
      low_histogram_shards,
      state,
      shard_offsets,
      row_count,
      context_shard_count,
      stage_scratch);
  AscendC::SyncAll();

  asc_vf_call<lightning_indexer_decode_distributed_compact_bfloat16_v2_vf>(
      dim3(kThreadsPerBlock, 1, 1),
      score_shard,
      state,
      shard_offsets,
      output,
      row_count,
      context_shard_count,
      stage_scratch);
  asc_sync();
}

static void launch_topk(
    const bfloat16_t* reduced_scores,
    uint32_t* high_histogram,
    uint32_t* low_histogram,
    uint32_t* state,
    uint32_t* shard_offsets,
    int32_t* output,
    aclrtStream stream) {
  dsa_decode_topk_simt_v2_kernel
      <<<kRowCount * kCanonicalContextShardCount,
         kTotalUbufBytes, stream>>>(
      reinterpret_cast<const uint16_t*>(reduced_scores),
      high_histogram,
      low_histogram,
      state,
      shard_offsets,
      output,
      kRowCount,
      kCanonicalContextShardCount);
}

int main(void) { return run_topk_example(launch_topk); }
