/**
 * Stable candidate compaction practice.
 *
 * SCENARIO_NUM=0 counts selected items atomically, but derives every output
 * rank by rescanning earlier input indices. Atomic completion order never
 * determines output order.
 *
 * SCENARIO_NUM=1 visits each input once and derives ranks from packed warp
 * counts, per-warp prefix offsets, and a chunk running offset.
 */

#include <stdint.h>
#include <stdio.h>
#include <stdlib.h>

#include "acl/acl.h"
#include "c_api/asc_simd.h"
#include "simt_api/asc_simt.h"

static_assert(SCENARIO_NUM == 0 || SCENARIO_NUM == 1, "SCENARIO_NUM must be 0 or 1");

#define INPUT_COUNT 4099U
#define THREAD_COUNT 512U
#define WARP_SIZE 32U
#define WARP_COUNT (THREAD_COUNT / WARP_SIZE)
#define BLOCK_DIM 1U
#define OUTPUT_SENTINEL INT32_MIN

typedef struct {
    int32_t* input;
    int32_t* output;
    uint32_t* selected_count;
} DeviceBuffers;

static bool check_acl(aclError result, const char* expression, const char* file, int32_t line)
{
    if (result == ACL_SUCCESS) {
        return true;
    }
    fprintf(stderr, "ACL call failed: %s, ret=%d, at %s:%d\n", expression, (int32_t)result, file, line);
    return false;
}

static bool is_selected_host(int32_t value)
{
    return (value % 7 == 0) || (value % 11 == 3);
}

static void fill_fixed_input(int32_t* input, uint32_t count)
{
    for (uint32_t index = 0; index < count; ++index) {
        input[index] = (int32_t)((index * 37U + 11U) % 10007U) - 5000;
    }
}

static uint32_t build_host_oracle(const int32_t* input, uint32_t count, int32_t* expected)
{
    uint32_t selected_count = 0;
    for (uint32_t index = 0; index < count; ++index) {
        if (is_selected_host(input[index])) {
            expected[selected_count] = input[index];
            ++selected_count;
        }
    }
    return selected_count;
}

static bool verify_selected_count(uint32_t actual, uint32_t expected)
{
    if (actual == expected) {
        return true;
    }
    fprintf(stderr, "Selected count mismatch: expected=%u, actual=%u\n", expected, actual);
    return false;
}

static bool verify_stable_order(const int32_t* actual, const int32_t* expected, uint32_t selected_count)
{
    for (uint32_t rank = 0; rank < selected_count; ++rank) {
        if (actual[rank] != expected[rank]) {
            fprintf(
                stderr, "Stable order mismatch: rank=%u, expected=%d, actual=%d\n", rank, expected[rank],
                actual[rank]);
            return false;
        }
    }
    return true;
}

static bool verify_untouched_tail(const int32_t* output, uint32_t selected_count, uint32_t capacity)
{
    for (uint32_t index = selected_count; index < capacity; ++index) {
        if (output[index] != OUTPUT_SENTINEL) {
            fprintf(
                stderr, "Output tail was overwritten: index=%u, expected=%d, actual=%d\n", index,
                OUTPUT_SENTINEL, output[index]);
            return false;
        }
    }
    return true;
}

static void reset_device_buffers(DeviceBuffers* buffers)
{
    buffers->input = NULL;
    buffers->output = NULL;
    buffers->selected_count = NULL;
}

static void free_device_buffers(DeviceBuffers* buffers)
{
    if (buffers->selected_count != NULL) {
        (void)aclrtFree(buffers->selected_count);
        buffers->selected_count = NULL;
    }
    if (buffers->output != NULL) {
        (void)aclrtFree(buffers->output);
        buffers->output = NULL;
    }
    if (buffers->input != NULL) {
        (void)aclrtFree(buffers->input);
        buffers->input = NULL;
    }
}

static bool allocate_device_buffers(DeviceBuffers* buffers)
{
    reset_device_buffers(buffers);
    aclError result = aclrtMalloc((void**)&buffers->input, INPUT_COUNT * sizeof(int32_t), ACL_MEM_MALLOC_HUGE_FIRST);
    if (!check_acl(result, "aclrtMalloc(input)", __FILE__, __LINE__)) {
        free_device_buffers(buffers);
        return false;
    }
    result = aclrtMalloc((void**)&buffers->output, INPUT_COUNT * sizeof(int32_t), ACL_MEM_MALLOC_HUGE_FIRST);
    if (!check_acl(result, "aclrtMalloc(output)", __FILE__, __LINE__)) {
        free_device_buffers(buffers);
        return false;
    }
    result = aclrtMalloc((void**)&buffers->selected_count, sizeof(uint32_t), ACL_MEM_MALLOC_HUGE_FIRST);
    if (!check_acl(result, "aclrtMalloc(selected_count)", __FILE__, __LINE__)) {
        free_device_buffers(buffers);
        return false;
    }
    return true;
}

__simt_callee__ inline bool is_selected_device(int32_t value)
{
    return (value % 7 == 0) || (value % 11 == 3);
}

__simt_callee__ inline uint32_t count_selected_before(__gm__ const int32_t* input, uint32_t index)
{
    uint32_t rank = 0;
    for (uint32_t earlier_index = 0; earlier_index < index; ++earlier_index) {
        rank += is_selected_device(input[earlier_index]) ? 1U : 0U;
    }
    return rank;
}

__simt_vf__ inline void stable_atomic_scan_compaction_vf(
    __gm__ const int32_t* input, __gm__ int32_t* output, __gm__ uint32_t* selected_count, uint32_t input_count)
{
    const uint32_t thread_index = (uint32_t)threadIdx.x;
    const uint32_t thread_stride = (uint32_t)blockDim.x;
    if (thread_index == 0U) {
        selected_count[0] = 0U;
    }
    asc_syncthreads();

    for (uint32_t input_index = thread_index; input_index < input_count; input_index += thread_stride) {
        int32_t value = input[input_index];
        if (!is_selected_device(value)) {
            continue;
        }

        (void)asc_atomic_add(selected_count, 1U);
        uint32_t stable_rank = count_selected_before(input, input_index);
        output[stable_rank] = value;
    }
}

__global__ __vector__ void stable_atomic_scan_compaction_kernel(
    __gm__ const int32_t* input, __gm__ int32_t* output, __gm__ uint32_t* selected_count, uint32_t input_count)
{
    asc_vf_call<stable_atomic_scan_compaction_vf>(
        dim3(THREAD_COUNT), input, output, selected_count, input_count);
}

__simt_vf__ inline void packed_prefix_compaction_vf(
    __gm__ const int32_t* input, __gm__ int32_t* output, __gm__ uint32_t* selected_count,
    __ubuf__ uint32_t* warp_counts, __ubuf__ uint32_t* warp_offsets, __ubuf__ uint32_t* running_offset,
    uint32_t input_count)
{
    const uint32_t thread_index = (uint32_t)threadIdx.x;
    const uint32_t lane_index = (uint32_t)laneid();
    const uint32_t warp_index = thread_index / WARP_SIZE;

    if (thread_index == 0) {
        running_offset[0] = 0;
    }
    asc_syncthreads();

    for (uint32_t chunk_start = 0; chunk_start < input_count; chunk_start += THREAD_COUNT) {
        uint32_t input_index = chunk_start + thread_index;
        bool valid = input_index < input_count;
        int32_t value = valid ? input[input_index] : 0;
        bool selected = valid && is_selected_device(value);

        uint32_t selected_mask = asc_ballot(selected ? 1 : 0);
        uint32_t warp_selected_count = (uint32_t)__popc(selected_mask);
        uint32_t lane_offset = (uint32_t)__popc(selected_mask & (uint32_t)lanemask_lt());
        if (lane_index == 0) {
            warp_counts[warp_index] = warp_selected_count;
        }
        asc_syncthreads();

        if (thread_index < WARP_COUNT) {
            uint32_t prefix = 0;
            for (uint32_t earlier_warp = 0; earlier_warp < thread_index; ++earlier_warp) {
                prefix += warp_counts[earlier_warp];
            }
            warp_offsets[thread_index] = prefix;
        }
        asc_syncthreads();

        if (selected) {
            uint32_t stable_rank = running_offset[0] + warp_offsets[warp_index] + lane_offset;
            output[stable_rank] = value;
        }
        asc_syncthreads();

        if (thread_index == 0) {
            running_offset[0] += warp_offsets[WARP_COUNT - 1] + warp_counts[WARP_COUNT - 1];
        }
        asc_syncthreads();
    }

    if (thread_index == 0) {
        selected_count[0] = running_offset[0];
    }
}

__global__ __vector__ void packed_prefix_compaction_kernel(
    __gm__ const int32_t* input, __gm__ int32_t* output, __gm__ uint32_t* selected_count, uint32_t input_count)
{
    __ubuf__ uint32_t warp_counts[WARP_COUNT];
    __ubuf__ uint32_t warp_offsets[WARP_COUNT];
    __ubuf__ uint32_t running_offset[1];
    asc_vf_call<packed_prefix_compaction_vf>(
        dim3(THREAD_COUNT), input, output, selected_count, warp_counts, warp_offsets, running_offset, input_count);
}

static void launch_compaction(const DeviceBuffers* buffers, aclrtStream stream)
{
#if SCENARIO_NUM == 0
    stable_atomic_scan_compaction_kernel<<<BLOCK_DIM, 0, stream>>>(
        buffers->input, buffers->output, buffers->selected_count, INPUT_COUNT);
#else
    packed_prefix_compaction_kernel<<<BLOCK_DIM, 0, stream>>>(
        buffers->input, buffers->output, buffers->selected_count, INPUT_COUNT);
#endif
}

static bool run_compaction(aclrtStream stream)
{
    bool ok = false;
    DeviceBuffers buffers;
    reset_device_buffers(&buffers);

    int32_t* input = (int32_t*)malloc(INPUT_COUNT * sizeof(int32_t));
    int32_t* expected = (int32_t*)malloc(INPUT_COUNT * sizeof(int32_t));
    int32_t* output = (int32_t*)malloc(INPUT_COUNT * sizeof(int32_t));
    uint32_t expected_count = 0;
    uint32_t actual_count = 0;
    if (input == NULL || expected == NULL || output == NULL) {
        fprintf(stderr, "Host allocation failed\n");
        goto cleanup;
    }

    fill_fixed_input(input, INPUT_COUNT);
    expected_count = build_host_oracle(input, INPUT_COUNT, expected);
    for (uint32_t index = 0; index < INPUT_COUNT; ++index) {
        output[index] = OUTPUT_SENTINEL;
    }

    if (!allocate_device_buffers(&buffers)) {
        goto cleanup;
    }
    if (!check_acl(
            aclrtMemcpy(
                buffers.input, INPUT_COUNT * sizeof(int32_t), input, INPUT_COUNT * sizeof(int32_t),
                ACL_MEMCPY_HOST_TO_DEVICE),
            "aclrtMemcpy(input H2D)", __FILE__, __LINE__)) {
        goto cleanup;
    }
    if (!check_acl(
            aclrtMemcpy(
                buffers.output, INPUT_COUNT * sizeof(int32_t), output, INPUT_COUNT * sizeof(int32_t),
                ACL_MEMCPY_HOST_TO_DEVICE),
            "aclrtMemcpy(output H2D)", __FILE__, __LINE__)) {
        goto cleanup;
    }
    if (!check_acl(aclrtMemset(buffers.selected_count, sizeof(uint32_t), 0, sizeof(uint32_t)),
                   "aclrtMemset(selected_count)", __FILE__, __LINE__)) {
        goto cleanup;
    }

    launch_compaction(&buffers, stream);
    if (!check_acl(aclrtSynchronizeStream(stream), "aclrtSynchronizeStream", __FILE__, __LINE__)) {
        goto cleanup;
    }

    if (!check_acl(
            aclrtMemcpy(
                &actual_count, sizeof(uint32_t), buffers.selected_count, sizeof(uint32_t),
                ACL_MEMCPY_DEVICE_TO_HOST),
            "aclrtMemcpy(count D2H)", __FILE__, __LINE__)) {
        goto cleanup;
    }
    if (!check_acl(
            aclrtMemcpy(
                output, INPUT_COUNT * sizeof(int32_t), buffers.output, INPUT_COUNT * sizeof(int32_t),
                ACL_MEMCPY_DEVICE_TO_HOST),
            "aclrtMemcpy(output D2H)", __FILE__, __LINE__)) {
        goto cleanup;
    }

    ok = verify_selected_count(actual_count, expected_count) &&
         verify_stable_order(output, expected, expected_count) &&
         verify_untouched_tail(output, expected_count, INPUT_COUNT);
    printf(
        "scenario=%d input_count=%u selected_count=%u order=stable tail=checked result=%s\n", SCENARIO_NUM,
        INPUT_COUNT, actual_count, ok ? "PASS" : "FAIL");

cleanup:
    free_device_buffers(&buffers);
    free(output);
    free(expected);
    free(input);
    return ok;
}

int32_t main()
{
    bool initialized = false;
    bool device_set = false;
    aclrtStream stream = NULL;
    bool ok = false;

    if (!check_acl(aclInit(NULL), "aclInit", __FILE__, __LINE__)) {
        goto cleanup;
    }
    initialized = true;
    if (!check_acl(aclrtSetDevice(0), "aclrtSetDevice", __FILE__, __LINE__)) {
        goto cleanup;
    }
    device_set = true;
    if (!check_acl(aclrtCreateStream(&stream), "aclrtCreateStream", __FILE__, __LINE__)) {
        goto cleanup;
    }

    ok = run_compaction(stream);

cleanup:
    if (stream != NULL) {
        (void)aclrtDestroyStream(stream);
    }
    if (device_set) {
        (void)aclrtResetDevice(0);
    }
    if (initialized) {
        (void)aclFinalize();
    }

    printf("%s\n", ok ? "Verification PASSED" : "Verification FAILED");
    return ok ? 0 : 1;
}
