#include <stdint.h>
#include <stdio.h>
#include <stdlib.h>

#include "acl/acl.h"
#include "c_api/asc_simd.h"
#include "simt_api/asc_simt.h"

#ifndef SCENARIO_NUM
#define SCENARIO_NUM 0
#endif

#define MATRIX_ROWS 4096U
#define MATRIX_COLS 256U
#define TILE_SIZE 16U
#define COL_BLOCK_COUNT (MATRIX_COLS / TILE_SIZE)
#define ELEMENT_COUNT (MATRIX_ROWS * MATRIX_COLS)
#define BLOCK_DIM 64U
#define THREAD_COUNT 512U
#define RANDOM_SEED 20260812U

typedef struct {
    float* input;
    float* row_major_workspace;
    float* consumer_output;
} DeviceBuffers;

__simt_callee__ inline float producer_transform(float input_value)
{
    return input_value + 1.0F;
}

__simt_callee__ inline uint32_t blocked_offset_16x16(uint32_t row, uint32_t col)
{
    uint32_t row_block = row / TILE_SIZE;
    uint32_t col_block = col / TILE_SIZE;
    uint32_t row_inner = row - row_block * TILE_SIZE;
    uint32_t col_inner = col - col_block * TILE_SIZE;
    return (((row_block * COL_BLOCK_COUNT + col_block) * TILE_SIZE + row_inner) * TILE_SIZE + col_inner);
}

__simt_vf__ inline void row_major_producer_vf(
    __gm__ const float* input, __gm__ float* row_major_workspace,
    uint32_t block_index, uint32_t block_count)
{
    uint32_t thread_id = block_index * (uint32_t)blockDim.x + (uint32_t)threadIdx.x;
    uint32_t thread_count = block_count * (uint32_t)blockDim.x;
    for (uint32_t logical_offset = thread_id; logical_offset < ELEMENT_COUNT; logical_offset += thread_count) {
        row_major_workspace[logical_offset] = producer_transform(input[logical_offset]);
    }
}

__simt_vf__ inline void explicit_blocked_pack_vf(
    __gm__ const float* row_major_workspace, __gm__ float* consumer_output,
    uint32_t block_index, uint32_t block_count)
{
    uint32_t thread_id = block_index * (uint32_t)blockDim.x + (uint32_t)threadIdx.x;
    uint32_t thread_count = block_count * (uint32_t)blockDim.x;
    for (uint32_t logical_offset = thread_id; logical_offset < ELEMENT_COUNT; logical_offset += thread_count) {
        uint32_t row = logical_offset / MATRIX_COLS;
        uint32_t col = logical_offset - row * MATRIX_COLS;
        uint32_t consumer_offset = blocked_offset_16x16(row, col);
        consumer_output[consumer_offset] = row_major_workspace[logical_offset];
    }
}

__simt_vf__ inline void consumer_native_layout_vf(
    __gm__ const float* input, __gm__ float* consumer_output,
    uint32_t block_index, uint32_t block_count)
{
    uint32_t thread_id = block_index * (uint32_t)blockDim.x + (uint32_t)threadIdx.x;
    uint32_t thread_count = block_count * (uint32_t)blockDim.x;
    for (uint32_t logical_offset = thread_id; logical_offset < ELEMENT_COUNT; logical_offset += thread_count) {
        uint32_t row = logical_offset / MATRIX_COLS;
        uint32_t col = logical_offset - row * MATRIX_COLS;
        uint32_t consumer_offset = blocked_offset_16x16(row, col);
        consumer_output[consumer_offset] = producer_transform(input[logical_offset]);
    }
}

__global__ __vector__ void row_major_producer_kernel(
    __gm__ const float* input, __gm__ float* row_major_workspace)
{
    asc_vf_call<row_major_producer_vf>(
        dim3(THREAD_COUNT), input, row_major_workspace, block_idx, BLOCK_DIM);
}

__global__ __vector__ void explicit_blocked_pack_kernel(
    __gm__ const float* row_major_workspace, __gm__ float* consumer_output)
{
    asc_vf_call<explicit_blocked_pack_vf>(
        dim3(THREAD_COUNT), row_major_workspace, consumer_output, block_idx, BLOCK_DIM);
}

__global__ __vector__ void consumer_native_layout_kernel(
    __gm__ const float* input, __gm__ float* consumer_output)
{
    asc_vf_call<consumer_native_layout_vf>(
        dim3(THREAD_COUNT), input, consumer_output, block_idx, BLOCK_DIM);
}

static uint32_t next_random(uint32_t* state)
{
    uint32_t value = *state;
    value ^= value << 13U;
    value ^= value >> 17U;
    value ^= value << 5U;
    *state = value;
    return value;
}

static void fill_input_fixed_seed(float* input)
{
    uint32_t state = RANDOM_SEED;
    for (size_t offset = 0U; offset < (size_t)ELEMENT_COUNT; ++offset) {
        int32_t quantized = (int32_t)(next_random(&state) & 0xfffU) - 2048;
        input[offset] = (float)quantized * 0.125F;
    }
}

static uint32_t host_blocked_offset_16x16(uint32_t row, uint32_t col)
{
    uint32_t row_block = row / TILE_SIZE;
    uint32_t col_block = col / TILE_SIZE;
    uint32_t row_inner = row % TILE_SIZE;
    uint32_t col_inner = col % TILE_SIZE;
    return (((row_block * COL_BLOCK_COUNT + col_block) * TILE_SIZE + row_inner) * TILE_SIZE + col_inner);
}

static void host_consumer_layout_oracle(const float* input, float* expected_output)
{
    for (uint32_t row = 0U; row < MATRIX_ROWS; ++row) {
        for (uint32_t col = 0U; col < MATRIX_COLS; ++col) {
            uint32_t logical_offset = row * MATRIX_COLS + col;
            uint32_t consumer_offset = host_blocked_offset_16x16(row, col);
            expected_output[consumer_offset] = input[logical_offset] + 1.0F;
        }
    }
}

static int verify_complete_consumer_layout(const float* actual_output, const float* expected_output)
{
    for (size_t offset = 0U; offset < (size_t)ELEMENT_COUNT; ++offset) {
        float actual = actual_output[offset];
        if (actual != expected_output[offset]) {
            fprintf(stderr, "consumer layout mismatch offset=%zu expected=%.6f actual=%.6f\n",
                offset, expected_output[offset], actual);
            return 0;
        }
    }
    return 1;
}

static int check_acl(aclError result, const char* operation)
{
    if (result == ACL_SUCCESS) {
        return 1;
    }
    fprintf(stderr, "ACL call failed: %s, error=%d\n", operation, (int)result);
    return 0;
}

static void release_device_buffers(DeviceBuffers* buffers)
{
    if (buffers->consumer_output != NULL) {
        (void)aclrtFree(buffers->consumer_output);
        buffers->consumer_output = NULL;
    }
    if (buffers->row_major_workspace != NULL) {
        (void)aclrtFree(buffers->row_major_workspace);
        buffers->row_major_workspace = NULL;
    }
    if (buffers->input != NULL) {
        (void)aclrtFree(buffers->input);
        buffers->input = NULL;
    }
}

static int allocate_device_buffers(DeviceBuffers* buffers, size_t bytes)
{
    if (!check_acl(aclrtMalloc((void**)&buffers->input, bytes, ACL_MEM_MALLOC_HUGE_FIRST),
            "aclrtMalloc input")) {
        return 0;
    }
#if SCENARIO_NUM == 0
    if (!check_acl(aclrtMalloc((void**)&buffers->row_major_workspace, bytes, ACL_MEM_MALLOC_HUGE_FIRST),
            "aclrtMalloc row-major workspace")) {
        return 0;
    }
#endif
    if (!check_acl(aclrtMalloc((void**)&buffers->consumer_output, bytes, ACL_MEM_MALLOC_HUGE_FIRST),
            "aclrtMalloc consumer output")) {
        return 0;
    }
    return 1;
}

static void launch_selected_pipeline(const DeviceBuffers* buffers, aclrtStream stream)
{
#if SCENARIO_NUM == 0
    row_major_producer_kernel<<<BLOCK_DIM, 0, stream>>>(buffers->input, buffers->row_major_workspace);
    explicit_blocked_pack_kernel<<<BLOCK_DIM, 0, stream>>>(
        buffers->row_major_workspace, buffers->consumer_output);
#else
    consumer_native_layout_kernel<<<BLOCK_DIM, 0, stream>>>(buffers->input, buffers->consumer_output);
#endif
}

int main(void)
{
    size_t bytes = (size_t)ELEMENT_COUNT * sizeof(float);
    float* input = (float*)malloc(bytes);
    float* actual_output = (float*)malloc(bytes);
    float* expected_output = (float*)malloc(bytes);
    DeviceBuffers device = {NULL, NULL, NULL};
    aclrtStream stream = NULL;
    int acl_initialized = 0;
    int device_selected = 0;
    int success = 0;

    if (input == NULL || actual_output == NULL || expected_output == NULL) {
        fprintf(stderr, "host allocation failed\n");
        goto cleanup;
    }
    fill_input_fixed_seed(input);
    host_consumer_layout_oracle(input, expected_output);

    if (!check_acl(aclInit(NULL), "aclInit")) {
        goto cleanup;
    }
    acl_initialized = 1;
    if (!check_acl(aclrtSetDevice(0), "aclrtSetDevice")) {
        goto cleanup;
    }
    device_selected = 1;
    if (!check_acl(aclrtCreateStream(&stream), "aclrtCreateStream")) {
        goto cleanup;
    }
    if (!allocate_device_buffers(&device, bytes)) {
        goto cleanup;
    }
    if (!check_acl(aclrtMemcpy(
            device.input, bytes, input, bytes, ACL_MEMCPY_HOST_TO_DEVICE), "copy input H2D")) {
        goto cleanup;
    }

    launch_selected_pipeline(&device, stream);
    if (!check_acl(aclrtSynchronizeStream(stream), "pipeline synchronize")) {
        goto cleanup;
    }
    if (!check_acl(aclrtMemcpy(
            actual_output, bytes, device.consumer_output, bytes, ACL_MEMCPY_DEVICE_TO_HOST),
            "copy consumer output D2H")) {
        goto cleanup;
    }
    success = verify_complete_consumer_layout(actual_output, expected_output);

cleanup:
    printf("Scenario %d: %s\n", SCENARIO_NUM,
        SCENARIO_NUM == 0 ? "row-major producer plus explicit blocked pack" : "consumer-native blocked producer");
    printf("Logical [4096, 256] float32 -> consumer [256, 16, 16, 16]\n");
    printf("Launch 64 blocks x 512 SIMT threads per kernel\n");
    if (success) {
        printf("Verification PASSED\n");
    } else {
        printf("Verification FAILED\n");
    }

    release_device_buffers(&device);
    if (stream != NULL) {
        (void)aclrtDestroyStream(stream);
    }
    if (device_selected) {
        (void)aclrtResetDevice(0);
    }
    if (acl_initialized) {
        (void)aclFinalize();
    }
    free(expected_output);
    free(actual_output);
    free(input);
    return success ? 0 : 1;
}
