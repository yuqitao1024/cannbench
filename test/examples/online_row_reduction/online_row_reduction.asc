#include <float.h>
#include <math.h>
#include <stdint.h>
#include <stdio.h>
#include <stdlib.h>

#include "acl/acl.h"
#include "c_api/asc_simd.h"
#include "simt_api/asc_simt.h"

#ifndef SCENARIO_NUM
#define SCENARIO_NUM 0
#endif

#define BLOCK_DIM 1U
#define THREAD_COUNT 512U
#define TILE_ELEMENTS 4096U
#define ORDINARY_ROWS 64U
#define ORDINARY_WIDTH 1024U
#define EXTREME_ROWS 8U
#define EXTREME_WIDTH 4096U
#define TAIL_ROWS 4U
#define TAIL_WIDTH 65537U
#define OUTPUT_GUARD_ELEMENTS 64U
#define OUTPUT_SENTINEL (-1234567.0F)
#define ABS_TOLERANCE 2.0e-6
#define REL_TOLERANCE 3.0e-3
#define ROW_SUM_TOLERANCE 3.0e-3

static_assert(SCENARIO_NUM >= 0 && SCENARIO_NUM <= 2, "SCENARIO_NUM must be 0, 1, or 2");

typedef struct {
    const char* name;
    uint32_t rows;
    uint32_t width;
} CaseSpec;

typedef struct {
    uint64_t scenario;
    uint64_t stats_scans_per_row;
    uint64_t normalize_scans_per_row;
    uint64_t input_element_visits;
    uint64_t tile_merges;
    uint64_t tail_elements;
} WorkCounters;

typedef struct {
    float* input;
    float* output;
    WorkCounters* counters;
} DeviceBuffers;

__simt_callee__ inline void online_update(float value, float* running_max, float* running_sum)
{
    if (*running_sum == 0.0F) {
        *running_max = value;
        *running_sum = 1.0F;
        return;
    }
    if (value <= *running_max) {
        *running_sum += expf(value - *running_max);
        return;
    }
    *running_sum = *running_sum * expf(*running_max - value) + 1.0F;
    *running_max = value;
}

__simt_callee__ inline void merge_online_stats(
    float tile_max, float tile_sum, float* running_max, float* running_sum)
{
    if (*running_sum == 0.0F) {
        *running_max = tile_max;
        *running_sum = tile_sum;
        return;
    }
    float merged_max = (*running_max > tile_max) ? *running_max : tile_max;
    *running_sum = *running_sum * expf(*running_max - merged_max) +
        tile_sum * expf(tile_max - merged_max);
    *running_max = merged_max;
}

__simt_callee__ inline void write_work_counters(
    __gm__ WorkCounters* counters, uint64_t scenario, uint64_t stats_scans_per_row,
    uint64_t normalize_scans_per_row, uint64_t input_element_visits,
    uint64_t tile_merges, uint64_t tail_elements)
{
    counters->scenario = scenario;
    counters->stats_scans_per_row = stats_scans_per_row;
    counters->normalize_scans_per_row = normalize_scans_per_row;
    counters->input_element_visits = input_element_visits;
    counters->tile_merges = tile_merges;
    counters->tail_elements = tail_elements;
}

__simt_vf__ inline void three_scan_softmax_vf(
    __gm__ const float* input, __gm__ float* output, __gm__ WorkCounters* counters,
    uint32_t rows, uint32_t width)
{
    uint32_t thread_index = (uint32_t)threadIdx.x;
    for (uint32_t row = thread_index; row < rows; row += (uint32_t)blockDim.x) {
        uint64_t row_offset = (uint64_t)row * width;
        float row_max = -FLT_MAX;
        for (uint32_t column = 0U; column < width; ++column) {
            float value = input[row_offset + column];
            row_max = (value > row_max) ? value : row_max;
        }

        float row_sum = 0.0F;
        for (uint32_t column = 0U; column < width; ++column) {
            row_sum += expf(input[row_offset + column] - row_max);
        }

        for (uint32_t column = 0U; column < width; ++column) {
            output[row_offset + column] = expf(input[row_offset + column] - row_max) / row_sum;
        }
    }

    if (thread_index == 0U) {
        uint64_t elements = (uint64_t)rows * width;
        write_work_counters(
            counters, 0U, 2U, 1U, elements * 3U, 0U, width % TILE_ELEMENTS);
    }
}

__global__ __vector__ void three_scan_softmax_kernel(
    __gm__ const float* input, __gm__ float* output, __gm__ WorkCounters* counters,
    uint32_t rows, uint32_t width)
{
    asc_vf_call<three_scan_softmax_vf>(dim3(THREAD_COUNT), input, output, counters, rows, width);
}

__simt_vf__ inline void online_stats_softmax_vf(
    __gm__ const float* input, __gm__ float* output, __gm__ WorkCounters* counters,
    uint32_t rows, uint32_t width)
{
    uint32_t thread_index = (uint32_t)threadIdx.x;
    for (uint32_t row = thread_index; row < rows; row += (uint32_t)blockDim.x) {
        uint64_t row_offset = (uint64_t)row * width;
        float row_max = -FLT_MAX;
        float row_sum = 0.0F;
        for (uint32_t column = 0U; column < width; ++column) {
            online_update(input[row_offset + column], &row_max, &row_sum);
        }

        for (uint32_t column = 0U; column < width; ++column) {
            output[row_offset + column] = expf(input[row_offset + column] - row_max) / row_sum;
        }
    }

    if (thread_index == 0U) {
        uint64_t elements = (uint64_t)rows * width;
        write_work_counters(
            counters, 1U, 1U, 1U, elements * 2U, 0U, width % TILE_ELEMENTS);
    }
}

__global__ __vector__ void online_stats_softmax_kernel(
    __gm__ const float* input, __gm__ float* output, __gm__ WorkCounters* counters,
    uint32_t rows, uint32_t width)
{
    asc_vf_call<online_stats_softmax_vf>(dim3(THREAD_COUNT), input, output, counters, rows, width);
}

__simt_vf__ inline void tiled_online_softmax_vf(
    __gm__ const float* input, __gm__ float* output, __gm__ WorkCounters* counters,
    uint32_t rows, uint32_t width)
{
    uint32_t thread_index = (uint32_t)threadIdx.x;
    for (uint32_t row = thread_index; row < rows; row += (uint32_t)blockDim.x) {
        uint64_t row_offset = (uint64_t)row * width;
        float row_max = -FLT_MAX;
        float row_sum = 0.0F;

        for (uint32_t tile_start = 0U; tile_start < width; tile_start += TILE_ELEMENTS) {
            uint32_t tile_end = tile_start + TILE_ELEMENTS;
            tile_end = (tile_end < width) ? tile_end : width;
            float tile_max = -FLT_MAX;
            float tile_sum = 0.0F;
            for (uint32_t column = tile_start; column < tile_end; ++column) {
                online_update(input[row_offset + column], &tile_max, &tile_sum);
            }
            merge_online_stats(tile_max, tile_sum, &row_max, &row_sum);
        }

        for (uint32_t column = 0U; column < width; ++column) {
            output[row_offset + column] = expf(input[row_offset + column] - row_max) / row_sum;
        }
    }

    if (thread_index == 0U) {
        uint64_t elements = (uint64_t)rows * width;
        uint64_t tiles_per_row = (width + TILE_ELEMENTS - 1U) / TILE_ELEMENTS;
        write_work_counters(
            counters, 2U, 1U, 1U, elements * 2U,
            (uint64_t)rows * tiles_per_row, width % TILE_ELEMENTS);
    }
}

__global__ __vector__ void tiled_online_softmax_kernel(
    __gm__ const float* input, __gm__ float* output, __gm__ WorkCounters* counters,
    uint32_t rows, uint32_t width)
{
    asc_vf_call<tiled_online_softmax_vf>(dim3(THREAD_COUNT), input, output, counters, rows, width);
}

static int check_acl(aclError result, const char* expression, const char* file, int line)
{
    if (result == ACL_SUCCESS) {
        return 1;
    }
    fprintf(stderr, "ACL call failed: %s, ret=%d, at %s:%d\n", expression, (int)result, file, line);
    return 0;
}

static int get_case_spec(uint32_t case_id, CaseSpec* spec)
{
    if (case_id == 0U) {
        spec->name = "ordinary";
        spec->rows = ORDINARY_ROWS;
        spec->width = ORDINARY_WIDTH;
        return 1;
    }
    if (case_id == 1U) {
        spec->name = "extreme";
        spec->rows = EXTREME_ROWS;
        spec->width = EXTREME_WIDTH;
        return 1;
    }
    if (case_id == 2U) {
        spec->name = "tail";
        spec->rows = TAIL_ROWS;
        spec->width = TAIL_WIDTH;
        return 1;
    }
    return 0;
}

static int parse_case_id(int argc, char** argv, uint32_t* case_id)
{
    if (argc != 2) {
        fprintf(stderr, "usage: %s <case_id: 0|1|2>\n", argv[0]);
        return 0;
    }
    char* end = NULL;
    unsigned long value = strtoul(argv[1], &end, 10);
    if (end == argv[1] || *end != '\0' || value > 2U) {
        fprintf(stderr, "invalid case_id: %s\n", argv[1]);
        return 0;
    }
    *case_id = (uint32_t)value;
    return 1;
}

static void fill_fixed_input(float* input, const CaseSpec* spec, uint32_t case_id)
{
    for (uint32_t row = 0U; row < spec->rows; ++row) {
        uint64_t row_offset = (uint64_t)row * spec->width;
        for (uint32_t column = 0U; column < spec->width; ++column) {
            uint32_t pattern = (column * 17U + row * 13U + 5U) % 101U;
            input[row_offset + column] = ((float)((int32_t)pattern - 50)) * 0.03125F;
        }
        if (case_id == 1U) {
            input[row_offset] = 1000.0F;
            input[row_offset + 1U] = 999.0F;
            input[row_offset + 2U] = -1000.0F;
            input[row_offset + spec->width - 1U] = 998.5F;
        } else if (case_id == 2U) {
            input[row_offset + spec->width - 1U] = 12.0F + (float)row * 0.25F;
        }
    }
}

static void build_double_softmax_oracle(const float* input, double* expected, const CaseSpec* spec)
{
    for (uint32_t row = 0U; row < spec->rows; ++row) {
        uint64_t row_offset = (uint64_t)row * spec->width;
        double row_max = -DBL_MAX;
        for (uint32_t column = 0U; column < spec->width; ++column) {
            double value = (double)input[row_offset + column];
            row_max = (value > row_max) ? value : row_max;
        }
        double row_sum = 0.0;
        for (uint32_t column = 0U; column < spec->width; ++column) {
            row_sum += exp((double)input[row_offset + column] - row_max);
        }
        for (uint32_t column = 0U; column < spec->width; ++column) {
            expected[row_offset + column] =
                exp((double)input[row_offset + column] - row_max) / row_sum;
        }
    }
}

static int verify_full_output(const float* output, const double* expected, uint64_t element_count)
{
    for (uint64_t index = 0U; index < element_count; ++index) {
        double actual = (double)output[index];
        double difference = fabs(actual - expected[index]);
        double tolerance = ABS_TOLERANCE + REL_TOLERANCE * fabs(expected[index]);
        if (difference > tolerance) {
            fprintf(
                stderr, "softmax mismatch: index=%llu expected=%.12e actual=%.12e tolerance=%.12e\n",
                (unsigned long long)index, expected[index], actual, tolerance);
            return 0;
        }
    }
    return 1;
}

static int verify_row_sums(const float* output, const CaseSpec* spec)
{
    for (uint32_t row = 0U; row < spec->rows; ++row) {
        uint64_t row_offset = (uint64_t)row * spec->width;
        double sum = 0.0;
        for (uint32_t column = 0U; column < spec->width; ++column) {
            sum += (double)output[row_offset + column];
        }
        if (fabs(sum - 1.0) > ROW_SUM_TOLERANCE) {
            fprintf(stderr, "row sum mismatch: row=%u sum=%.12e\n", row, sum);
            return 0;
        }
    }
    return 1;
}

static int verify_output_guard(const float* output, uint64_t element_count)
{
    for (uint64_t index = element_count; index < element_count + OUTPUT_GUARD_ELEMENTS; ++index) {
        if (output[index] != OUTPUT_SENTINEL) {
            fprintf(stderr, "output guard mismatch: index=%llu\n", (unsigned long long)index);
            return 0;
        }
    }
    return 1;
}

static void expected_work_counters(WorkCounters* counters, const CaseSpec* spec)
{
    uint64_t elements = (uint64_t)spec->rows * spec->width;
    counters->scenario = SCENARIO_NUM;
    counters->normalize_scans_per_row = 1U;
    counters->tail_elements = spec->width % TILE_ELEMENTS;
#if SCENARIO_NUM == 0
    counters->stats_scans_per_row = 2U;
    counters->input_element_visits = elements * 3U;
    counters->tile_merges = 0U;
#elif SCENARIO_NUM == 1
    counters->stats_scans_per_row = 1U;
    counters->input_element_visits = elements * 2U;
    counters->tile_merges = 0U;
#else
    counters->stats_scans_per_row = 1U;
    counters->input_element_visits = elements * 2U;
    counters->tile_merges = (uint64_t)spec->rows *
        ((spec->width + TILE_ELEMENTS - 1U) / TILE_ELEMENTS);
#endif
}

static int counter_equal(const char* name, uint64_t actual, uint64_t expected)
{
    if (actual == expected) {
        return 1;
    }
    fprintf(
        stderr, "counter mismatch: %s expected=%llu actual=%llu\n", name,
        (unsigned long long)expected, (unsigned long long)actual);
    return 0;
}

static int verify_work_counters(const WorkCounters* actual, const WorkCounters* expected)
{
    return counter_equal("scenario", actual->scenario, expected->scenario) &&
        counter_equal("stats_scans_per_row", actual->stats_scans_per_row, expected->stats_scans_per_row) &&
        counter_equal("normalize_scans_per_row", actual->normalize_scans_per_row, expected->normalize_scans_per_row) &&
        counter_equal("input_element_visits", actual->input_element_visits, expected->input_element_visits) &&
        counter_equal("tile_merges", actual->tile_merges, expected->tile_merges) &&
        counter_equal("tail_elements", actual->tail_elements, expected->tail_elements);
}

static void reset_device_buffers(DeviceBuffers* buffers)
{
    buffers->input = NULL;
    buffers->output = NULL;
    buffers->counters = NULL;
}

static void free_device_buffers(DeviceBuffers* buffers)
{
    if (buffers->counters != NULL) {
        (void)aclrtFree(buffers->counters);
        buffers->counters = NULL;
    }
    if (buffers->output != NULL) {
        (void)aclrtFree(buffers->output);
        buffers->output = NULL;
    }
    if (buffers->input != NULL) {
        (void)aclrtFree(buffers->input);
        buffers->input = NULL;
    }
}

static int allocate_device_buffers(DeviceBuffers* buffers, size_t input_bytes, size_t output_bytes)
{
    reset_device_buffers(buffers);
    if (!check_acl(
            aclrtMalloc((void**)&buffers->input, input_bytes, ACL_MEM_MALLOC_HUGE_FIRST),
            "aclrtMalloc(input)", __FILE__, __LINE__)) {
        goto failed;
    }
    if (!check_acl(
            aclrtMalloc((void**)&buffers->output, output_bytes, ACL_MEM_MALLOC_HUGE_FIRST),
            "aclrtMalloc(output)", __FILE__, __LINE__)) {
        goto failed;
    }
    if (!check_acl(
            aclrtMalloc((void**)&buffers->counters, sizeof(WorkCounters), ACL_MEM_MALLOC_HUGE_FIRST),
            "aclrtMalloc(counters)", __FILE__, __LINE__)) {
        goto failed;
    }
    return 1;

failed:
    free_device_buffers(buffers);
    return 0;
}

static void launch_selected_scenario(
    const DeviceBuffers* buffers, const CaseSpec* spec, aclrtStream stream)
{
#if SCENARIO_NUM == 0
    three_scan_softmax_kernel<<<BLOCK_DIM, 0, stream>>>(
        buffers->input, buffers->output, buffers->counters, spec->rows, spec->width);
#elif SCENARIO_NUM == 1
    online_stats_softmax_kernel<<<BLOCK_DIM, 0, stream>>>(
        buffers->input, buffers->output, buffers->counters, spec->rows, spec->width);
#else
    tiled_online_softmax_kernel<<<BLOCK_DIM, 0, stream>>>(
        buffers->input, buffers->output, buffers->counters, spec->rows, spec->width);
#endif
}

static int run_case(uint32_t case_id, const CaseSpec* spec, aclrtStream stream)
{
    DeviceBuffers buffers;
    WorkCounters actual_counters = {};
    WorkCounters expected_counters = {};
    float* input = NULL;
    float* output = NULL;
    double* expected = NULL;
    uint64_t element_count = (uint64_t)spec->rows * spec->width;
    size_t input_bytes = (size_t)element_count * sizeof(float);
    size_t output_count = (size_t)element_count + OUTPUT_GUARD_ELEMENTS;
    size_t output_bytes = output_count * sizeof(float);
    int ok = 0;

    reset_device_buffers(&buffers);
    input = (float*)malloc(input_bytes);
    output = (float*)malloc(output_bytes);
    expected = (double*)malloc((size_t)element_count * sizeof(double));
    if (input == NULL || output == NULL || expected == NULL) {
        fprintf(stderr, "host allocation failed\n");
        goto cleanup;
    }

    fill_fixed_input(input, spec, case_id);
    build_double_softmax_oracle(input, expected, spec);
    expected_work_counters(&expected_counters, spec);
    for (size_t index = 0U; index < output_count; ++index) {
        output[index] = OUTPUT_SENTINEL;
    }

    if (!allocate_device_buffers(&buffers, input_bytes, output_bytes)) {
        goto cleanup;
    }
    if (!check_acl(
            aclrtMemcpy(buffers.input, input_bytes, input, input_bytes, ACL_MEMCPY_HOST_TO_DEVICE),
            "aclrtMemcpy(input H2D)", __FILE__, __LINE__)) {
        goto cleanup;
    }
    if (!check_acl(
            aclrtMemcpy(buffers.output, output_bytes, output, output_bytes, ACL_MEMCPY_HOST_TO_DEVICE),
            "aclrtMemcpy(output H2D)", __FILE__, __LINE__)) {
        goto cleanup;
    }
    if (!check_acl(
            aclrtMemset(buffers.counters, sizeof(WorkCounters), 0, sizeof(WorkCounters)),
            "aclrtMemset(counters)", __FILE__, __LINE__)) {
        goto cleanup;
    }

    launch_selected_scenario(&buffers, spec, stream);
    if (!check_acl(aclrtSynchronizeStream(stream), "aclrtSynchronizeStream", __FILE__, __LINE__)) {
        goto cleanup;
    }
    if (!check_acl(
            aclrtMemcpy(output, output_bytes, buffers.output, output_bytes, ACL_MEMCPY_DEVICE_TO_HOST),
            "aclrtMemcpy(output D2H)", __FILE__, __LINE__)) {
        goto cleanup;
    }
    if (!check_acl(
            aclrtMemcpy(
                &actual_counters, sizeof(WorkCounters), buffers.counters, sizeof(WorkCounters),
                ACL_MEMCPY_DEVICE_TO_HOST),
            "aclrtMemcpy(counters D2H)", __FILE__, __LINE__)) {
        goto cleanup;
    }

    ok = verify_full_output(output, expected, element_count) &&
        verify_row_sums(output, spec) && verify_output_guard(output, element_count) &&
        verify_work_counters(&actual_counters, &expected_counters);
    printf(
        "scenario=%d case=%u name=%s rows=%u width=%u stats_scans=%llu normalize_scans=%llu "
        "element_visits=%llu tile_merges=%llu tail=%llu result=%s\n",
        SCENARIO_NUM, case_id, spec->name, spec->rows, spec->width,
        (unsigned long long)actual_counters.stats_scans_per_row,
        (unsigned long long)actual_counters.normalize_scans_per_row,
        (unsigned long long)actual_counters.input_element_visits,
        (unsigned long long)actual_counters.tile_merges,
        (unsigned long long)actual_counters.tail_elements, ok ? "PASS" : "FAIL");

cleanup:
    free_device_buffers(&buffers);
    free(expected);
    free(output);
    free(input);
    return ok;
}

int main(int argc, char** argv)
{
    uint32_t case_id = 0U;
    CaseSpec spec = {};
    int initialized = 0;
    int device_set = 0;
    int ok = 0;
    aclrtStream stream = NULL;

    if (!parse_case_id(argc, argv, &case_id) || !get_case_spec(case_id, &spec)) {
        return 1;
    }
    if (!check_acl(aclInit(NULL), "aclInit", __FILE__, __LINE__)) {
        goto cleanup;
    }
    initialized = 1;
    if (!check_acl(aclrtSetDevice(0), "aclrtSetDevice", __FILE__, __LINE__)) {
        goto cleanup;
    }
    device_set = 1;
    if (!check_acl(aclrtCreateStream(&stream), "aclrtCreateStream", __FILE__, __LINE__)) {
        goto cleanup;
    }

    ok = run_case(case_id, &spec, stream);

cleanup:
    if (stream != NULL) {
        (void)aclrtDestroyStream(stream);
    }
    if (device_set) {
        (void)aclrtResetDevice(0);
    }
    if (initialized) {
        (void)aclFinalize();
    }
    printf("%s\n", ok ? "Verification PASSED" : "Verification FAILED");
    return ok ? 0 : 1;
}
