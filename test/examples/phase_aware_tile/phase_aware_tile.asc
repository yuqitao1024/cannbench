#include <stdint.h>
#include <stdio.h>
#include <stdlib.h>

#include "acl/acl.h"
#include "c_api/asc_simd.h"
#include "simt_api/asc_simt.h"

#ifndef SCENARIO_NUM
#define SCENARIO_NUM 0
#endif

#define ROW_COUNT 128U
#define ROW_WIDTH 8192U
#define TOTAL_ELEMENTS ((uint64_t)ROW_COUNT * (uint64_t)ROW_WIDTH)
#define OUTPUT_GUARD_ELEMENTS 64U
#define OUTPUT_SENTINEL (-1234567.0F)
#define BLOCK_DIM 32U
#define THREAD_COUNT 512U

#define CONSERVATIVE_TILE 1024U
#define REUSE_TILE 2048U
#define OVERSIZED_OUTER_TILE 4096U
#define STREAMED_SUBTILE 1024U

static_assert(SCENARIO_NUM >= 0 && SCENARIO_NUM <= 2, "SCENARIO_NUM must be 0, 1, or 2");

typedef struct {
    uint64_t scenario;
    uint64_t outer_tile_elements;
    uint64_t compute_subtile_elements;
    uint64_t outer_rounds;
    uint64_t barrier_rounds;
    uint64_t logical_gm_read_elements;
    uint64_t logical_gm_write_elements;
    uint64_t logical_ub_copy_elements;
    uint64_t declared_ub_bytes;
    uint64_t peak_live_set_bytes;
} WorkCounters;

typedef struct {
    float* input;
    float* operand;
    float* workspace;
    float* output;
    WorkCounters* counters;
} DeviceBuffers;

__simt_callee__ inline float phase_one(float input, float operand)
{
    return input * operand + 1.0F;
}

__simt_callee__ inline float phase_two(float intermediate, float operand)
{
    return intermediate + operand;
}

__simt_callee__ inline void write_work_counters(
    __gm__ WorkCounters* counters, uint64_t scenario, uint64_t outer_tile_elements,
    uint64_t compute_subtile_elements, uint64_t outer_rounds, uint64_t barrier_rounds,
    uint64_t logical_gm_read_elements, uint64_t logical_gm_write_elements,
    uint64_t logical_ub_copy_elements, uint64_t declared_ub_bytes, uint64_t peak_live_set_bytes)
{
    counters->scenario = scenario;
    counters->outer_tile_elements = outer_tile_elements;
    counters->compute_subtile_elements = compute_subtile_elements;
    counters->outer_rounds = outer_rounds;
    counters->barrier_rounds = barrier_rounds;
    counters->logical_gm_read_elements = logical_gm_read_elements;
    counters->logical_gm_write_elements = logical_gm_write_elements;
    counters->logical_ub_copy_elements = logical_ub_copy_elements;
    counters->declared_ub_bytes = declared_ub_bytes;
    counters->peak_live_set_bytes = peak_live_set_bytes;
}

__simt_vf__ inline void conservative_phase_buffers_vf(
    __gm__ const float* input, __gm__ const float* operand, __gm__ float* workspace,
    __gm__ float* output, __gm__ WorkCounters* counters, __ubuf__ float* persistent_operand,
    __ubuf__ float* phase_a_scratch, __ubuf__ float* phase_b_scratch,
    uint32_t block_index, uint32_t block_count)
{
    uint32_t thread_index = (uint32_t)threadIdx.x;
    uint32_t thread_count = (uint32_t)blockDim.x;

    for (uint32_t row = block_index; row < ROW_COUNT; row += block_count) {
        uint32_t row_offset = row * ROW_WIDTH;
        for (uint32_t tile_start = 0U; tile_start < ROW_WIDTH; tile_start += CONSERVATIVE_TILE) {
            for (uint32_t local = thread_index; local < CONSERVATIVE_TILE; local += thread_count) {
                uint32_t global = row_offset + tile_start + local;
                persistent_operand[local] = operand[global];
                phase_a_scratch[local] = input[global];
            }
            asc_syncthreads();

            for (uint32_t local = thread_index; local < CONSERVATIVE_TILE; local += thread_count) {
                phase_a_scratch[local] = phase_one(phase_a_scratch[local], persistent_operand[local]);
            }
            asc_syncthreads();

            for (uint32_t local = thread_index; local < CONSERVATIVE_TILE; local += thread_count) {
                uint32_t global = row_offset + tile_start + local;
                workspace[global] = phase_a_scratch[local];
            }
            asc_syncthreads();

            for (uint32_t local = thread_index; local < CONSERVATIVE_TILE; local += thread_count) {
                uint32_t global = row_offset + tile_start + local;
                phase_b_scratch[local] = workspace[global];
            }
            asc_syncthreads();

            for (uint32_t local = thread_index; local < CONSERVATIVE_TILE; local += thread_count) {
                uint32_t global = row_offset + tile_start + local;
                output[global] = phase_two(phase_b_scratch[local], persistent_operand[local]);
            }
            asc_syncthreads();
        }
    }

    if (block_index == 0U && thread_index == 0U) {
        write_work_counters(
            counters, 0U, CONSERVATIVE_TILE, CONSERVATIVE_TILE,
            (uint64_t)ROW_COUNT * (ROW_WIDTH / CONSERVATIVE_TILE),
            (uint64_t)ROW_COUNT * (ROW_WIDTH / CONSERVATIVE_TILE) * 5U,
            TOTAL_ELEMENTS * 3U, TOTAL_ELEMENTS * 2U, 0U,
            (uint64_t)CONSERVATIVE_TILE * sizeof(float) * 3U,
            (uint64_t)CONSERVATIVE_TILE * sizeof(float) * 2U);
    }
}

__global__ __vector__ void conservative_phase_buffers_kernel(
    __gm__ const float* input, __gm__ const float* operand, __gm__ float* workspace,
    __gm__ float* output, __gm__ WorkCounters* counters)
{
    __ubuf__ float persistent_operand[CONSERVATIVE_TILE];
    __ubuf__ float phase_a_scratch[CONSERVATIVE_TILE];
    __ubuf__ float phase_b_scratch[CONSERVATIVE_TILE];
    asc_vf_call<conservative_phase_buffers_vf>(
        dim3(THREAD_COUNT), input, operand, workspace, output, counters, persistent_operand,
        phase_a_scratch, phase_b_scratch, block_idx, BLOCK_DIM);
}

__simt_vf__ inline void peak_live_set_reuse_vf(
    __gm__ const float* input, __gm__ const float* operand, __gm__ float* output,
    __gm__ WorkCounters* counters, __ubuf__ float* persistent_operand,
    __ubuf__ float* shared_phase_scratch, uint32_t block_index, uint32_t block_count)
{
    uint32_t thread_index = (uint32_t)threadIdx.x;
    uint32_t thread_count = (uint32_t)blockDim.x;

    for (uint32_t row = block_index; row < ROW_COUNT; row += block_count) {
        uint32_t row_offset = row * ROW_WIDTH;
        for (uint32_t tile_start = 0U; tile_start < ROW_WIDTH; tile_start += REUSE_TILE) {
            for (uint32_t local = thread_index; local < REUSE_TILE; local += thread_count) {
                uint32_t global = row_offset + tile_start + local;
                persistent_operand[local] = operand[global];
                shared_phase_scratch[local] = input[global];
            }
            asc_syncthreads();

            for (uint32_t local = thread_index; local < REUSE_TILE; local += thread_count) {
                shared_phase_scratch[local] = phase_one(shared_phase_scratch[local], persistent_operand[local]);
            }
            asc_syncthreads();

            for (uint32_t local = thread_index; local < REUSE_TILE; local += thread_count) {
                uint32_t global = row_offset + tile_start + local;
                output[global] = phase_two(shared_phase_scratch[local], persistent_operand[local]);
            }
            asc_syncthreads();
        }
    }

    if (block_index == 0U && thread_index == 0U) {
        write_work_counters(
            counters, 1U, REUSE_TILE, REUSE_TILE,
            (uint64_t)ROW_COUNT * (ROW_WIDTH / REUSE_TILE),
            (uint64_t)ROW_COUNT * (ROW_WIDTH / REUSE_TILE) * 3U,
            TOTAL_ELEMENTS * 2U, TOTAL_ELEMENTS, 0U,
            (uint64_t)REUSE_TILE * sizeof(float) * 2U,
            (uint64_t)REUSE_TILE * sizeof(float) * 2U);
    }
}

__global__ __vector__ void peak_live_set_reuse_kernel(
    __gm__ const float* input, __gm__ const float* operand, __gm__ float* workspace,
    __gm__ float* output, __gm__ WorkCounters* counters)
{
    (void)workspace;
    __ubuf__ float persistent_operand[REUSE_TILE];
    __ubuf__ float shared_phase_scratch[REUSE_TILE];
    asc_vf_call<peak_live_set_reuse_vf>(
        dim3(THREAD_COUNT), input, operand, output, counters, persistent_operand,
        shared_phase_scratch, block_idx, BLOCK_DIM);
}

__simt_vf__ inline void oversized_outer_tile_vf(
    __gm__ const float* input, __gm__ const float* operand, __gm__ float* output,
    __gm__ WorkCounters* counters, __ubuf__ float* outer_input,
    __ubuf__ float* persistent_operand, __ubuf__ float* coarse_replay_operand,
    uint32_t block_index, uint32_t block_count)
{
    uint32_t thread_index = (uint32_t)threadIdx.x;
    uint32_t thread_count = (uint32_t)blockDim.x;

    for (uint32_t row = block_index; row < ROW_COUNT; row += block_count) {
        uint32_t row_offset = row * ROW_WIDTH;
        for (uint32_t outer_start = 0U; outer_start < ROW_WIDTH; outer_start += OVERSIZED_OUTER_TILE) {
            for (uint32_t local = thread_index; local < OVERSIZED_OUTER_TILE; local += thread_count) {
                uint32_t global = row_offset + outer_start + local;
                outer_input[local] = input[global];
                persistent_operand[local] = operand[global];
            }
            asc_syncthreads();

            for (uint32_t subtile_start = 0U; subtile_start < OVERSIZED_OUTER_TILE;
                 subtile_start += STREAMED_SUBTILE) {
                for (uint32_t local = thread_index; local < OVERSIZED_OUTER_TILE; local += thread_count) {
                    coarse_replay_operand[local] = persistent_operand[local];
                }
                asc_syncthreads();

                for (uint32_t local = thread_index; local < STREAMED_SUBTILE; local += thread_count) {
                    uint32_t outer_local = subtile_start + local;
                    outer_input[outer_local] = phase_one(
                        outer_input[outer_local], coarse_replay_operand[outer_local]);
                }
                asc_syncthreads();

                for (uint32_t local = thread_index; local < STREAMED_SUBTILE; local += thread_count) {
                    uint32_t outer_local = subtile_start + local;
                    uint32_t global = row_offset + outer_start + outer_local;
                    output[global] = phase_two(
                        outer_input[outer_local], coarse_replay_operand[outer_local]);
                }
                asc_syncthreads();
            }
        }
    }

    if (block_index == 0U && thread_index == 0U) {
        write_work_counters(
            counters, 2U, OVERSIZED_OUTER_TILE, STREAMED_SUBTILE,
            (uint64_t)ROW_COUNT * (ROW_WIDTH / OVERSIZED_OUTER_TILE),
            (uint64_t)ROW_COUNT * (ROW_WIDTH / OVERSIZED_OUTER_TILE) *
                (1U + (OVERSIZED_OUTER_TILE / STREAMED_SUBTILE) * 3U),
            TOTAL_ELEMENTS * 2U, TOTAL_ELEMENTS,
            TOTAL_ELEMENTS * (OVERSIZED_OUTER_TILE / STREAMED_SUBTILE),
            (uint64_t)OVERSIZED_OUTER_TILE * sizeof(float) * 3U,
            (uint64_t)OVERSIZED_OUTER_TILE * sizeof(float) * 3U);
    }
}

__global__ __vector__ void oversized_outer_tile_kernel(
    __gm__ const float* input, __gm__ const float* operand, __gm__ float* workspace,
    __gm__ float* output, __gm__ WorkCounters* counters)
{
    (void)workspace;
    __ubuf__ float outer_input[OVERSIZED_OUTER_TILE];
    __ubuf__ float persistent_operand[OVERSIZED_OUTER_TILE];
    __ubuf__ float coarse_replay_operand[OVERSIZED_OUTER_TILE];
    asc_vf_call<oversized_outer_tile_vf>(
        dim3(THREAD_COUNT), input, operand, output, counters, outer_input,
        persistent_operand, coarse_replay_operand, block_idx, BLOCK_DIM);
}

static int check_acl(aclError result, const char* expression, const char* file, int line)
{
    if (result == ACL_SUCCESS) {
        return 1;
    }
    fprintf(stderr, "ACL call failed: %s, ret=%d, at %s:%d\n", expression, (int)result, file, line);
    return 0;
}

static void reset_device_buffers(DeviceBuffers* buffers)
{
    buffers->input = NULL;
    buffers->operand = NULL;
    buffers->workspace = NULL;
    buffers->output = NULL;
    buffers->counters = NULL;
}

static void free_device_buffers(DeviceBuffers* buffers)
{
    if (buffers->counters != NULL) {
        (void)aclrtFree(buffers->counters);
        buffers->counters = NULL;
    }
    if (buffers->output != NULL) {
        (void)aclrtFree(buffers->output);
        buffers->output = NULL;
    }
    if (buffers->workspace != NULL) {
        (void)aclrtFree(buffers->workspace);
        buffers->workspace = NULL;
    }
    if (buffers->operand != NULL) {
        (void)aclrtFree(buffers->operand);
        buffers->operand = NULL;
    }
    if (buffers->input != NULL) {
        (void)aclrtFree(buffers->input);
        buffers->input = NULL;
    }
}

static int allocate_one(void** pointer, size_t bytes, const char* name)
{
    aclError result = aclrtMalloc(pointer, bytes, ACL_MEM_MALLOC_HUGE_FIRST);
    return check_acl(result, name, __FILE__, __LINE__);
}

static int allocate_device_buffers(DeviceBuffers* buffers)
{
    size_t data_bytes = (size_t)TOTAL_ELEMENTS * sizeof(float);
    size_t output_bytes = ((size_t)TOTAL_ELEMENTS + OUTPUT_GUARD_ELEMENTS) * sizeof(float);
    reset_device_buffers(buffers);
    if (!allocate_one((void**)&buffers->input, data_bytes, "aclrtMalloc(input)")) {
        goto failed;
    }
    if (!allocate_one((void**)&buffers->operand, data_bytes, "aclrtMalloc(operand)")) {
        goto failed;
    }
    if (!allocate_one((void**)&buffers->workspace, data_bytes, "aclrtMalloc(workspace)")) {
        goto failed;
    }
    if (!allocate_one((void**)&buffers->output, output_bytes, "aclrtMalloc(output)")) {
        goto failed;
    }
    if (!allocate_one((void**)&buffers->counters, sizeof(WorkCounters), "aclrtMalloc(counters)")) {
        goto failed;
    }
    return 1;

failed:
    free_device_buffers(buffers);
    return 0;
}

static void fill_fixed_inputs(float* input, float* operand)
{
    for (uint64_t index = 0U; index < TOTAL_ELEMENTS; ++index) {
        input[index] = (float)((int32_t)((index * 17U + 3U) % 29U) - 14);
        operand[index] = (float)((index * 5U + 1U) % 7U + 1U);
    }
}

static void build_host_oracle(const float* input, const float* operand, float* expected)
{
    for (uint64_t index = 0U; index < TOTAL_ELEMENTS; ++index) {
        float intermediate = input[index] * operand[index] + 1.0F;
        expected[index] = intermediate + operand[index];
    }
}

static int verify_output(const float* output, const float* expected)
{
    for (uint64_t index = 0U; index < TOTAL_ELEMENTS; ++index) {
        if (output[index] != expected[index]) {
            fprintf(
                stderr, "output mismatch: index=%llu expected=%f actual=%f\n",
                (unsigned long long)index, expected[index], output[index]);
            return 0;
        }
    }
    return 1;
}

static int verify_output_guard(const float* output)
{
    for (uint64_t index = TOTAL_ELEMENTS; index < TOTAL_ELEMENTS + OUTPUT_GUARD_ELEMENTS; ++index) {
        if (output[index] != OUTPUT_SENTINEL) {
            fprintf(stderr, "output guard mismatch: index=%llu\n", (unsigned long long)index);
            return 0;
        }
    }
    return 1;
}

static void expected_work_counters(WorkCounters* counters)
{
#if SCENARIO_NUM == 0
    counters->scenario = 0U;
    counters->outer_tile_elements = CONSERVATIVE_TILE;
    counters->compute_subtile_elements = CONSERVATIVE_TILE;
    counters->outer_rounds = (uint64_t)ROW_COUNT * (ROW_WIDTH / CONSERVATIVE_TILE);
    counters->barrier_rounds = counters->outer_rounds * 5U;
    counters->logical_gm_read_elements = TOTAL_ELEMENTS * 3U;
    counters->logical_gm_write_elements = TOTAL_ELEMENTS * 2U;
    counters->logical_ub_copy_elements = 0U;
    counters->declared_ub_bytes = (uint64_t)CONSERVATIVE_TILE * sizeof(float) * 3U;
    counters->peak_live_set_bytes = (uint64_t)CONSERVATIVE_TILE * sizeof(float) * 2U;
#elif SCENARIO_NUM == 1
    counters->scenario = 1U;
    counters->outer_tile_elements = REUSE_TILE;
    counters->compute_subtile_elements = REUSE_TILE;
    counters->outer_rounds = (uint64_t)ROW_COUNT * (ROW_WIDTH / REUSE_TILE);
    counters->barrier_rounds = counters->outer_rounds * 3U;
    counters->logical_gm_read_elements = TOTAL_ELEMENTS * 2U;
    counters->logical_gm_write_elements = TOTAL_ELEMENTS;
    counters->logical_ub_copy_elements = 0U;
    counters->declared_ub_bytes = (uint64_t)REUSE_TILE * sizeof(float) * 2U;
    counters->peak_live_set_bytes = (uint64_t)REUSE_TILE * sizeof(float) * 2U;
#else
    counters->scenario = 2U;
    counters->outer_tile_elements = OVERSIZED_OUTER_TILE;
    counters->compute_subtile_elements = STREAMED_SUBTILE;
    counters->outer_rounds = (uint64_t)ROW_COUNT * (ROW_WIDTH / OVERSIZED_OUTER_TILE);
    counters->barrier_rounds = counters->outer_rounds *
        (1U + (OVERSIZED_OUTER_TILE / STREAMED_SUBTILE) * 3U);
    counters->logical_gm_read_elements = TOTAL_ELEMENTS * 2U;
    counters->logical_gm_write_elements = TOTAL_ELEMENTS;
    counters->logical_ub_copy_elements = TOTAL_ELEMENTS * (OVERSIZED_OUTER_TILE / STREAMED_SUBTILE);
    counters->declared_ub_bytes = (uint64_t)OVERSIZED_OUTER_TILE * sizeof(float) * 3U;
    counters->peak_live_set_bytes = (uint64_t)OVERSIZED_OUTER_TILE * sizeof(float) * 3U;
#endif
}

static int counter_equal(const char* name, uint64_t actual, uint64_t expected)
{
    if (actual == expected) {
        return 1;
    }
    fprintf(
        stderr, "counter mismatch: %s expected=%llu actual=%llu\n", name,
        (unsigned long long)expected, (unsigned long long)actual);
    return 0;
}

static int verify_work_counters(const WorkCounters* actual, const WorkCounters* expected)
{
    return counter_equal("scenario", actual->scenario, expected->scenario) &&
        counter_equal("outer_tile_elements", actual->outer_tile_elements, expected->outer_tile_elements) &&
        counter_equal("compute_subtile_elements", actual->compute_subtile_elements, expected->compute_subtile_elements) &&
        counter_equal("outer_rounds", actual->outer_rounds, expected->outer_rounds) &&
        counter_equal("barrier_rounds", actual->barrier_rounds, expected->barrier_rounds) &&
        counter_equal("logical_gm_read_elements", actual->logical_gm_read_elements, expected->logical_gm_read_elements) &&
        counter_equal("logical_gm_write_elements", actual->logical_gm_write_elements, expected->logical_gm_write_elements) &&
        counter_equal("logical_ub_copy_elements", actual->logical_ub_copy_elements, expected->logical_ub_copy_elements) &&
        counter_equal("declared_ub_bytes", actual->declared_ub_bytes, expected->declared_ub_bytes) &&
        counter_equal("peak_live_set_bytes", actual->peak_live_set_bytes, expected->peak_live_set_bytes);
}

static void launch_selected_scenario(const DeviceBuffers* buffers, aclrtStream stream)
{
#if SCENARIO_NUM == 0
    conservative_phase_buffers_kernel<<<BLOCK_DIM, 0, stream>>>(
        buffers->input, buffers->operand, buffers->workspace, buffers->output, buffers->counters);
#elif SCENARIO_NUM == 1
    peak_live_set_reuse_kernel<<<BLOCK_DIM, 0, stream>>>(
        buffers->input, buffers->operand, buffers->workspace, buffers->output, buffers->counters);
#else
    oversized_outer_tile_kernel<<<BLOCK_DIM, 0, stream>>>(
        buffers->input, buffers->operand, buffers->workspace, buffers->output, buffers->counters);
#endif
}

static int run_case(aclrtStream stream)
{
    DeviceBuffers buffers;
    WorkCounters actual_counters = {};
    WorkCounters expected_counters = {};
    float* input = NULL;
    float* operand = NULL;
    float* expected = NULL;
    float* output = NULL;
    size_t data_bytes = (size_t)TOTAL_ELEMENTS * sizeof(float);
    size_t output_count = (size_t)TOTAL_ELEMENTS + OUTPUT_GUARD_ELEMENTS;
    size_t output_bytes = output_count * sizeof(float);
    int ok = 0;

    reset_device_buffers(&buffers);
    input = (float*)malloc(data_bytes);
    operand = (float*)malloc(data_bytes);
    expected = (float*)malloc(data_bytes);
    output = (float*)malloc(output_bytes);
    if (input == NULL || operand == NULL || expected == NULL || output == NULL) {
        fprintf(stderr, "host allocation failed\n");
        goto cleanup;
    }

    fill_fixed_inputs(input, operand);
    build_host_oracle(input, operand, expected);
    expected_work_counters(&expected_counters);
    for (size_t index = 0U; index < output_count; ++index) {
        output[index] = OUTPUT_SENTINEL;
    }

    if (!allocate_device_buffers(&buffers)) {
        goto cleanup;
    }
    if (!check_acl(
            aclrtMemcpy(buffers.input, data_bytes, input, data_bytes, ACL_MEMCPY_HOST_TO_DEVICE),
            "aclrtMemcpy(input H2D)", __FILE__, __LINE__)) {
        goto cleanup;
    }
    if (!check_acl(
            aclrtMemcpy(buffers.operand, data_bytes, operand, data_bytes, ACL_MEMCPY_HOST_TO_DEVICE),
            "aclrtMemcpy(operand H2D)", __FILE__, __LINE__)) {
        goto cleanup;
    }
    if (!check_acl(
            aclrtMemcpy(buffers.output, output_bytes, output, output_bytes, ACL_MEMCPY_HOST_TO_DEVICE),
            "aclrtMemcpy(output H2D)", __FILE__, __LINE__)) {
        goto cleanup;
    }
    if (!check_acl(
            aclrtMemset(buffers.counters, sizeof(WorkCounters), 0, sizeof(WorkCounters)),
            "aclrtMemset(counters)", __FILE__, __LINE__)) {
        goto cleanup;
    }

    launch_selected_scenario(&buffers, stream);
    if (!check_acl(aclrtSynchronizeStream(stream), "aclrtSynchronizeStream", __FILE__, __LINE__)) {
        goto cleanup;
    }
    if (!check_acl(
            aclrtMemcpy(output, output_bytes, buffers.output, output_bytes, ACL_MEMCPY_DEVICE_TO_HOST),
            "aclrtMemcpy(output D2H)", __FILE__, __LINE__)) {
        goto cleanup;
    }
    if (!check_acl(
            aclrtMemcpy(
                &actual_counters, sizeof(WorkCounters), buffers.counters, sizeof(WorkCounters),
                ACL_MEMCPY_DEVICE_TO_HOST),
            "aclrtMemcpy(counters D2H)", __FILE__, __LINE__)) {
        goto cleanup;
    }

    ok = verify_output(output, expected) && verify_output_guard(output) &&
        verify_work_counters(&actual_counters, &expected_counters);
    printf(
        "scenario=%d outer_tile=%llu compute_subtile=%llu outer_rounds=%llu barriers=%llu "
        "gm_reads=%llu gm_writes=%llu ub_copies=%llu declared_ub_bytes=%llu peak_live_bytes=%llu result=%s\n",
        SCENARIO_NUM, (unsigned long long)actual_counters.outer_tile_elements,
        (unsigned long long)actual_counters.compute_subtile_elements,
        (unsigned long long)actual_counters.outer_rounds,
        (unsigned long long)actual_counters.barrier_rounds,
        (unsigned long long)actual_counters.logical_gm_read_elements,
        (unsigned long long)actual_counters.logical_gm_write_elements,
        (unsigned long long)actual_counters.logical_ub_copy_elements,
        (unsigned long long)actual_counters.declared_ub_bytes,
        (unsigned long long)actual_counters.peak_live_set_bytes, ok ? "PASS" : "FAIL");

cleanup:
    free_device_buffers(&buffers);
    free(output);
    free(expected);
    free(operand);
    free(input);
    return ok;
}

int main(void)
{
    int initialized = 0;
    int device_set = 0;
    int ok = 0;
    aclrtStream stream = NULL;

    if (!check_acl(aclInit(NULL), "aclInit", __FILE__, __LINE__)) {
        goto cleanup;
    }
    initialized = 1;
    if (!check_acl(aclrtSetDevice(0), "aclrtSetDevice", __FILE__, __LINE__)) {
        goto cleanup;
    }
    device_set = 1;
    if (!check_acl(aclrtCreateStream(&stream), "aclrtCreateStream", __FILE__, __LINE__)) {
        goto cleanup;
    }

    ok = run_case(stream);

cleanup:
    if (stream != NULL) {
        (void)aclrtDestroyStream(stream);
    }
    if (device_set) {
        (void)aclrtResetDevice(0);
    }
    if (initialized) {
        (void)aclFinalize();
    }
    printf("%s\n", ok ? "Verification PASSED" : "Verification FAILED");
    return ok ? 0 : 1;
}
