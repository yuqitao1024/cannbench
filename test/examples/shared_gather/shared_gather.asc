#include <stdint.h>
#include <stdio.h>
#include <stdlib.h>

#include "acl/acl.h"
#include "c_api/asc_simd.h"
#include "simt_api/asc_simt.h"

#ifndef SCENARIO_NUM
#define SCENARIO_NUM 0
#endif

#define SOURCE_ROW_COUNT 65536U
#define FEATURE_WIDTH 128U
#define SELECTED_ROW_COUNT 8192U
#define BLOCK_DIM 64U
#define THREAD_COUNT 512U
#define RANDOM_SEED 20260812U

typedef struct {
    float* source;
    uint32_t* selected_indices;
    float* consumer_a;
    float* consumer_b;
} DeviceBuffers;

__simt_callee__ inline float consumer_a_transform(float gathered)
{
    return gathered + 1.0F;
}

__simt_callee__ inline float consumer_b_transform(float gathered)
{
    return gathered - 1.0F;
}

// Volatile reads keep the baseline's two logical consumers as two physical GM loads.
__simt_callee__ inline float consumer_a_independent_gather(
    __gm__ volatile const float* source, uint32_t source_offset)
{
    return source[source_offset];
}

__simt_callee__ inline float consumer_b_independent_gather(
    __gm__ volatile const float* source, uint32_t source_offset)
{
    return source[source_offset];
}

__simt_callee__ inline float shared_gather_producer(
    __gm__ const float* source, uint32_t source_offset)
{
    return source[source_offset];
}

__simt_vf__ inline void shared_gather_independent_consumers_vf(
    __gm__ const float* source, __gm__ const uint32_t* selected_indices,
    __gm__ float* consumer_a, __gm__ float* consumer_b,
    uint32_t block_index, uint32_t block_count)
{
    uint32_t thread_id = block_index * (uint32_t)blockDim.x + (uint32_t)threadIdx.x;
    uint32_t thread_count = block_count * (uint32_t)blockDim.x;
    uint32_t output_count = SELECTED_ROW_COUNT * FEATURE_WIDTH;
    __gm__ volatile const float* volatile_source = (__gm__ volatile const float*)source;
    for (uint32_t output_offset = thread_id; output_offset < output_count; output_offset += thread_count) {
        uint32_t selected_row = output_offset / FEATURE_WIDTH;
        uint32_t feature = output_offset - selected_row * FEATURE_WIDTH;
        uint32_t source_offset = selected_indices[selected_row] * FEATURE_WIDTH + feature;
        float gathered_a = consumer_a_independent_gather(volatile_source, source_offset);
        float gathered_b = consumer_b_independent_gather(volatile_source, source_offset);
        consumer_a[output_offset] = consumer_a_transform(gathered_a);
        consumer_b[output_offset] = consumer_b_transform(gathered_b);
    }
}

__simt_vf__ inline void shared_gather_reuse_vf(
    __gm__ const float* source, __gm__ const uint32_t* selected_indices,
    __gm__ float* consumer_a, __gm__ float* consumer_b,
    uint32_t block_index, uint32_t block_count)
{
    uint32_t thread_id = block_index * (uint32_t)blockDim.x + (uint32_t)threadIdx.x;
    uint32_t thread_count = block_count * (uint32_t)blockDim.x;
    uint32_t output_count = SELECTED_ROW_COUNT * FEATURE_WIDTH;
    for (uint32_t output_offset = thread_id; output_offset < output_count; output_offset += thread_count) {
        uint32_t selected_row = output_offset / FEATURE_WIDTH;
        uint32_t feature = output_offset - selected_row * FEATURE_WIDTH;
        uint32_t source_offset = selected_indices[selected_row] * FEATURE_WIDTH + feature;
        float shared_value = shared_gather_producer(source, source_offset);
        consumer_a[output_offset] = consumer_a_transform(shared_value);
        consumer_b[output_offset] = consumer_b_transform(shared_value);
    }
}

__global__ __vector__ void shared_gather_independent_kernel(
    __gm__ const float* source, __gm__ const uint32_t* selected_indices,
    __gm__ float* consumer_a, __gm__ float* consumer_b)
{
    asc_vf_call<shared_gather_independent_consumers_vf>(
        dim3(THREAD_COUNT), source, selected_indices, consumer_a, consumer_b, block_idx, BLOCK_DIM);
}

__global__ __vector__ void shared_gather_reuse_kernel(
    __gm__ const float* source, __gm__ const uint32_t* selected_indices,
    __gm__ float* consumer_a, __gm__ float* consumer_b)
{
    asc_vf_call<shared_gather_reuse_vf>(
        dim3(THREAD_COUNT), source, selected_indices, consumer_a, consumer_b, block_idx, BLOCK_DIM);
}

static uint32_t next_random(uint32_t* state)
{
    uint32_t value = *state;
    value ^= value << 13U;
    value ^= value >> 17U;
    value ^= value << 5U;
    *state = value;
    return value;
}

static void fill_inputs_fixed_seed(float* source, uint32_t* selected_indices)
{
    uint32_t state = RANDOM_SEED;
    size_t source_count = (size_t)SOURCE_ROW_COUNT * FEATURE_WIDTH;
    for (size_t offset = 0U; offset < source_count; ++offset) {
        int32_t quantized = (int32_t)(next_random(&state) & 0x7ffU) - 1024;
        source[offset] = (float)quantized * 0.25F;
    }
    for (uint32_t row = 0U; row < SELECTED_ROW_COUNT; ++row) {
        selected_indices[row] = next_random(&state) % SOURCE_ROW_COUNT;
    }
}

static float host_consumer_a_transform(float gathered)
{
    return gathered + 1.0F;
}

static float host_consumer_b_transform(float gathered)
{
    return gathered - 1.0F;
}

static void host_shared_gather_oracle(
    const float* source, const uint32_t* selected_indices,
    float* expected_consumer_a, float* expected_consumer_b)
{
    for (uint32_t selected_row = 0U; selected_row < SELECTED_ROW_COUNT; ++selected_row) {
        uint32_t source_base = selected_indices[selected_row] * FEATURE_WIDTH;
        uint32_t output_base = selected_row * FEATURE_WIDTH;
        for (uint32_t feature = 0U; feature < FEATURE_WIDTH; ++feature) {
            float gathered = source[source_base + feature];
            expected_consumer_a[output_base + feature] = host_consumer_a_transform(gathered);
            expected_consumer_b[output_base + feature] = host_consumer_b_transform(gathered);
        }
    }
}

static int verify_complete_outputs(
    const float* actual_consumer_a, const float* actual_consumer_b,
    const float* expected_consumer_a, const float* expected_consumer_b)
{
    size_t output_count = (size_t)SELECTED_ROW_COUNT * FEATURE_WIDTH;
    for (size_t offset = 0U; offset < output_count; ++offset) {
        float consumer_a = actual_consumer_a[offset];
        float consumer_b = actual_consumer_b[offset];
        if (consumer_a != expected_consumer_a[offset] || consumer_b != expected_consumer_b[offset]) {
            fprintf(stderr,
                "mismatch selected_row=%zu feature=%zu: expected=(%.6f,%.6f), actual=(%.6f,%.6f)\n",
                offset / FEATURE_WIDTH, offset % FEATURE_WIDTH,
                expected_consumer_a[offset], expected_consumer_b[offset], consumer_a, consumer_b);
            return 0;
        }
    }
    return 1;
}

static int check_acl(aclError result, const char* operation)
{
    if (result == ACL_SUCCESS) {
        return 1;
    }
    fprintf(stderr, "ACL call failed: %s, error=%d\n", operation, (int)result);
    return 0;
}

static void release_device_buffers(DeviceBuffers* buffers)
{
    if (buffers->consumer_b != NULL) {
        (void)aclrtFree(buffers->consumer_b);
        buffers->consumer_b = NULL;
    }
    if (buffers->consumer_a != NULL) {
        (void)aclrtFree(buffers->consumer_a);
        buffers->consumer_a = NULL;
    }
    if (buffers->selected_indices != NULL) {
        (void)aclrtFree(buffers->selected_indices);
        buffers->selected_indices = NULL;
    }
    if (buffers->source != NULL) {
        (void)aclrtFree(buffers->source);
        buffers->source = NULL;
    }
}

static int allocate_device_buffers(
    DeviceBuffers* buffers, size_t source_bytes, size_t index_bytes, size_t output_bytes)
{
    if (!check_acl(aclrtMalloc(
            (void**)&buffers->source, source_bytes, ACL_MEM_MALLOC_HUGE_FIRST), "aclrtMalloc source")) {
        return 0;
    }
    if (!check_acl(aclrtMalloc(
            (void**)&buffers->selected_indices, index_bytes, ACL_MEM_MALLOC_HUGE_FIRST),
            "aclrtMalloc selected indices")) {
        return 0;
    }
    if (!check_acl(aclrtMalloc(
            (void**)&buffers->consumer_a, output_bytes, ACL_MEM_MALLOC_HUGE_FIRST),
            "aclrtMalloc consumer A")) {
        return 0;
    }
    if (!check_acl(aclrtMalloc(
            (void**)&buffers->consumer_b, output_bytes, ACL_MEM_MALLOC_HUGE_FIRST),
            "aclrtMalloc consumer B")) {
        return 0;
    }
    return 1;
}

static void launch_selected_kernel(const DeviceBuffers* buffers, aclrtStream stream)
{
#if SCENARIO_NUM == 0
    shared_gather_independent_kernel<<<BLOCK_DIM, 0, stream>>>(
        buffers->source, buffers->selected_indices, buffers->consumer_a, buffers->consumer_b);
#else
    shared_gather_reuse_kernel<<<BLOCK_DIM, 0, stream>>>(
        buffers->source, buffers->selected_indices, buffers->consumer_a, buffers->consumer_b);
#endif
}

int main(void)
{
    size_t source_count = (size_t)SOURCE_ROW_COUNT * FEATURE_WIDTH;
    size_t output_count = (size_t)SELECTED_ROW_COUNT * FEATURE_WIDTH;
    size_t source_bytes = source_count * sizeof(float);
    size_t index_bytes = (size_t)SELECTED_ROW_COUNT * sizeof(uint32_t);
    size_t output_bytes = output_count * sizeof(float);
    float* source = (float*)malloc(source_bytes);
    uint32_t* selected_indices = (uint32_t*)malloc(index_bytes);
    float* actual_consumer_a = (float*)malloc(output_bytes);
    float* actual_consumer_b = (float*)malloc(output_bytes);
    float* expected_consumer_a = (float*)malloc(output_bytes);
    float* expected_consumer_b = (float*)malloc(output_bytes);
    DeviceBuffers device = {NULL, NULL, NULL, NULL};
    aclrtStream stream = NULL;
    int acl_initialized = 0;
    int device_selected = 0;
    int success = 0;

    if (source == NULL || selected_indices == NULL || actual_consumer_a == NULL || actual_consumer_b == NULL ||
        expected_consumer_a == NULL || expected_consumer_b == NULL) {
        fprintf(stderr, "host allocation failed\n");
        goto cleanup;
    }
    fill_inputs_fixed_seed(source, selected_indices);
    host_shared_gather_oracle(source, selected_indices, expected_consumer_a, expected_consumer_b);

    if (!check_acl(aclInit(NULL), "aclInit")) {
        goto cleanup;
    }
    acl_initialized = 1;
    if (!check_acl(aclrtSetDevice(0), "aclrtSetDevice")) {
        goto cleanup;
    }
    device_selected = 1;
    if (!check_acl(aclrtCreateStream(&stream), "aclrtCreateStream")) {
        goto cleanup;
    }
    if (!allocate_device_buffers(&device, source_bytes, index_bytes, output_bytes)) {
        goto cleanup;
    }
    if (!check_acl(aclrtMemcpy(
            device.source, source_bytes, source, source_bytes, ACL_MEMCPY_HOST_TO_DEVICE), "copy source H2D")) {
        goto cleanup;
    }
    if (!check_acl(aclrtMemcpy(
            device.selected_indices, index_bytes, selected_indices, index_bytes, ACL_MEMCPY_HOST_TO_DEVICE),
            "copy selected indices H2D")) {
        goto cleanup;
    }

    launch_selected_kernel(&device, stream);
    if (!check_acl(aclrtSynchronizeStream(stream), "kernel synchronize")) {
        goto cleanup;
    }
    if (!check_acl(aclrtMemcpy(
            actual_consumer_a, output_bytes, device.consumer_a, output_bytes, ACL_MEMCPY_DEVICE_TO_HOST),
            "copy consumer A D2H")) {
        goto cleanup;
    }
    if (!check_acl(aclrtMemcpy(
            actual_consumer_b, output_bytes, device.consumer_b, output_bytes, ACL_MEMCPY_DEVICE_TO_HOST),
            "copy consumer B D2H")) {
        goto cleanup;
    }
    success = verify_complete_outputs(
        actual_consumer_a, actual_consumer_b, expected_consumer_a, expected_consumer_b);

cleanup:
    printf("Scenario %d: %s\n", SCENARIO_NUM,
        SCENARIO_NUM == 0 ? "two independent consumer gathers" : "single producer shared gather");
    printf("Source [65536, 128] float32, selected [8192] uint32, outputs [8192, 128] float32\n");
    printf("Launch 64 blocks x 512 SIMT threads\n");
    if (success) {
        printf("Verification PASSED\n");
    } else {
        printf("Verification FAILED\n");
    }

    release_device_buffers(&device);
    if (stream != NULL) {
        (void)aclrtDestroyStream(stream);
    }
    if (device_selected) {
        (void)aclrtResetDevice(0);
    }
    if (acl_initialized) {
        (void)aclFinalize();
    }
    free(expected_consumer_b);
    free(expected_consumer_a);
    free(actual_consumer_b);
    free(actual_consumer_a);
    free(selected_indices);
    free(source);
    return success ? 0 : 1;
}
