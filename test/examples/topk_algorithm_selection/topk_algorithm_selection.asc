#include <stdint.h>
#include <stdio.h>
#include <stdlib.h>

#include "acl/acl.h"
#include "c_api/asc_simd.h"
#include "simt_api/asc_simt.h"

#ifndef SCENARIO_NUM
#define SCENARIO_NUM 0
#endif

#define ROW_COUNT 32U
#define ELEMENT_COUNT 1024U
#define TOPK_COUNT 32U
#define MERGE_CHUNK 16U
#define BITONIC_PADDED_WIDTH 64U
#define BLOCK_DIM 1U
#define THREAD_COUNT 512U
#define RANDOM_SEED 20260811U
#define INVALID_INDEX 0xffffffffU
#define SENTINEL_VALUE (-3.402823466e+38F)

typedef struct {
    float value;
    uint32_t index;
} HostPair;

typedef struct {
    float* input;
    float* output_values;
    uint32_t* output_indices;
} DeviceBuffers;

__simt_callee__ inline bool pair_precedes(float lhs_value, uint32_t lhs_index, float rhs_value, uint32_t rhs_index)
{
    return (lhs_value > rhs_value) || ((lhs_value == rhs_value) && (lhs_index < rhs_index));
}

__simt_callee__ inline bool pair_is_worse(float lhs_value, uint32_t lhs_index, float rhs_value, uint32_t rhs_index)
{
    return pair_precedes(rhs_value, rhs_index, lhs_value, lhs_index);
}

__simt_callee__ inline void swap_pair(
    float* values, uint32_t* indices, uint32_t lhs, uint32_t rhs)
{
    float value_tmp = values[lhs];
    uint32_t index_tmp = indices[lhs];
    values[lhs] = values[rhs];
    indices[lhs] = indices[rhs];
    values[rhs] = value_tmp;
    indices[rhs] = index_tmp;
}

// Sort all 64 slots even though every merge contributes only 16 fresh candidates.
__simt_callee__ inline void bitonic_sort_64_descending(float* values, uint32_t* indices)
{
    for (uint32_t span = 2U; span <= BITONIC_PADDED_WIDTH; span <<= 1U) {
        for (uint32_t stride = span >> 1U; stride > 0U; stride >>= 1U) {
            for (uint32_t lhs = 0U; lhs < BITONIC_PADDED_WIDTH; ++lhs) {
                uint32_t rhs = lhs ^ stride;
                if (rhs <= lhs) {
                    continue;
                }
                bool descending_group = (lhs & span) == 0U;
                bool lhs_precedes = pair_precedes(values[lhs], indices[lhs], values[rhs], indices[rhs]);
                if ((descending_group && !lhs_precedes) || (!descending_group && lhs_precedes)) {
                    swap_pair(values, indices, lhs, rhs);
                }
            }
        }
    }
}

__simt_callee__ inline void bounded_insert(
    float* heap_values, uint32_t* heap_indices, uint32_t* heap_size, float value, uint32_t index)
{
    if (*heap_size < TOPK_COUNT) {
        uint32_t child = *heap_size;
        *heap_size += 1U;
        heap_values[child] = value;
        heap_indices[child] = index;
        while (child > 0U) {
            uint32_t parent = (child - 1U) >> 1U;
            if (!pair_is_worse(heap_values[child], heap_indices[child], heap_values[parent], heap_indices[parent])) {
                break;
            }
            swap_pair(heap_values, heap_indices, child, parent);
            child = parent;
        }
        return;
    }

    if (!pair_precedes(value, index, heap_values[0], heap_indices[0])) {
        return;
    }
    heap_values[0] = value;
    heap_indices[0] = index;

    uint32_t parent = 0U;
    while (true) {
        uint32_t left = parent * 2U + 1U;
        if (left >= TOPK_COUNT) {
            break;
        }
        uint32_t right = left + 1U;
        uint32_t worse_child = left;
        if (right < TOPK_COUNT && pair_is_worse(
                heap_values[right], heap_indices[right], heap_values[left], heap_indices[left])) {
            worse_child = right;
        }
        if (!pair_is_worse(
                heap_values[worse_child], heap_indices[worse_child], heap_values[parent], heap_indices[parent])) {
            break;
        }
        swap_pair(heap_values, heap_indices, parent, worse_child);
        parent = worse_child;
    }
}

__simt_callee__ inline void sort_topk_descending(float* values, uint32_t* indices)
{
    for (uint32_t current = 1U; current < TOPK_COUNT; ++current) {
        uint32_t position = current;
        while (position > 0U && pair_precedes(
                values[position], indices[position], values[position - 1U], indices[position - 1U])) {
            swap_pair(values, indices, position, position - 1U);
            position -= 1U;
        }
    }
}

__simt_vf__ inline void topk_repeated_padded_bitonic_vf(
    __gm__ const float* input, __gm__ float* output_values, __gm__ uint32_t* output_indices,
    uint32_t block_index, uint32_t block_count)
{
    uint32_t thread_id = block_index * (uint32_t)blockDim.x + (uint32_t)threadIdx.x;
    uint32_t thread_count = block_count * (uint32_t)blockDim.x;
    for (uint32_t row = thread_id; row < ROW_COUNT; row += thread_count) {
        float merge_values[BITONIC_PADDED_WIDTH];
        uint32_t merge_indices[BITONIC_PADDED_WIDTH];
        for (uint32_t slot = 0U; slot < TOPK_COUNT; ++slot) {
            merge_values[slot] = SENTINEL_VALUE;
            merge_indices[slot] = INVALID_INDEX;
        }

        uint32_t row_offset = row * ELEMENT_COUNT;
        for (uint32_t chunk = 0U; chunk < ELEMENT_COUNT; chunk += MERGE_CHUNK) {
            for (uint32_t slot = TOPK_COUNT; slot < BITONIC_PADDED_WIDTH; ++slot) {
                merge_values[slot] = SENTINEL_VALUE;
                merge_indices[slot] = INVALID_INDEX;
            }
            for (uint32_t item = 0U; item < MERGE_CHUNK; ++item) {
                uint32_t input_index = chunk + item;
                merge_values[TOPK_COUNT + item] = input[row_offset + input_index];
                merge_indices[TOPK_COUNT + item] = input_index;
            }
            bitonic_sort_64_descending(merge_values, merge_indices);
        }

        uint32_t output_offset = row * TOPK_COUNT;
        for (uint32_t rank = 0U; rank < TOPK_COUNT; ++rank) {
            output_values[output_offset + rank] = merge_values[rank];
            output_indices[output_offset + rank] = merge_indices[rank];
        }
    }
}

__simt_vf__ inline void topk_streaming_bounded_vf(
    __gm__ const float* input, __gm__ float* output_values, __gm__ uint32_t* output_indices,
    uint32_t block_index, uint32_t block_count)
{
    uint32_t thread_id = block_index * (uint32_t)blockDim.x + (uint32_t)threadIdx.x;
    uint32_t thread_count = block_count * (uint32_t)blockDim.x;
    for (uint32_t row = thread_id; row < ROW_COUNT; row += thread_count) {
        float heap_values[TOPK_COUNT];
        uint32_t heap_indices[TOPK_COUNT];
        uint32_t heap_size = 0U;
        uint32_t row_offset = row * ELEMENT_COUNT;
        for (uint32_t input_index = 0U; input_index < ELEMENT_COUNT; ++input_index) {
            bounded_insert(
                heap_values, heap_indices, &heap_size, input[row_offset + input_index], input_index);
        }
        sort_topk_descending(heap_values, heap_indices);

        uint32_t output_offset = row * TOPK_COUNT;
        for (uint32_t rank = 0U; rank < TOPK_COUNT; ++rank) {
            output_values[output_offset + rank] = heap_values[rank];
            output_indices[output_offset + rank] = heap_indices[rank];
        }
    }
}

__global__ __vector__ void topk_repeated_padded_bitonic_kernel(
    __gm__ const float* input, __gm__ float* output_values, __gm__ uint32_t* output_indices)
{
    asc_vf_call<topk_repeated_padded_bitonic_vf>(
        dim3(THREAD_COUNT), input, output_values, output_indices, block_idx, BLOCK_DIM);
}

__global__ __vector__ void topk_streaming_bounded_kernel(
    __gm__ const float* input, __gm__ float* output_values, __gm__ uint32_t* output_indices)
{
    asc_vf_call<topk_streaming_bounded_vf>(
        dim3(THREAD_COUNT), input, output_values, output_indices, block_idx, BLOCK_DIM);
}

static uint32_t next_random(uint32_t* state)
{
    uint32_t value = *state;
    value ^= value << 13U;
    value ^= value >> 17U;
    value ^= value << 5U;
    *state = value;
    return value;
}

static void fill_input_fixed_seed(float* input)
{
    uint32_t state = RANDOM_SEED;
    size_t count = (size_t)ROW_COUNT * ELEMENT_COUNT;
    for (size_t offset = 0U; offset < count; ++offset) {
        input[offset] = (float)(next_random(&state) & 0x3ffU) * 0.0625F;
    }
}

static int compare_host_pair(const void* lhs_ptr, const void* rhs_ptr)
{
    const HostPair* lhs = (const HostPair*)lhs_ptr;
    const HostPair* rhs = (const HostPair*)rhs_ptr;
    if (lhs->value > rhs->value) {
        return -1;
    }
    if (lhs->value < rhs->value) {
        return 1;
    }
    if (lhs->index < rhs->index) {
        return -1;
    }
    if (lhs->index > rhs->index) {
        return 1;
    }
    return 0;
}

static int host_topk_oracle(const float* input, float* expected_values, uint32_t* expected_indices)
{
    HostPair* candidates = (HostPair*)malloc((size_t)ELEMENT_COUNT * sizeof(HostPair));
    if (candidates == NULL) {
        fprintf(stderr, "host oracle allocation failed\n");
        return 0;
    }
    for (uint32_t row = 0U; row < ROW_COUNT; ++row) {
        uint32_t input_offset = row * ELEMENT_COUNT;
        uint32_t output_offset = row * TOPK_COUNT;
        for (uint32_t index = 0U; index < ELEMENT_COUNT; ++index) {
            candidates[index].value = input[input_offset + index];
            candidates[index].index = index;
        }
        qsort(candidates, ELEMENT_COUNT, sizeof(HostPair), compare_host_pair);
        for (uint32_t rank = 0U; rank < TOPK_COUNT; ++rank) {
            expected_values[output_offset + rank] = candidates[rank].value;
            expected_indices[output_offset + rank] = candidates[rank].index;
        }
    }
    free(candidates);
    return 1;
}

static int verify_result(
    const float* values, const uint32_t* indices, const float* expected_values, const uint32_t* expected_indices)
{
    size_t count = (size_t)ROW_COUNT * TOPK_COUNT;
    for (size_t offset = 0U; offset < count; ++offset) {
        float value = values[offset];
        uint32_t index = indices[offset];
        if (value != expected_values[offset] || index != expected_indices[offset]) {
            fprintf(stderr,
                "mismatch row=%zu rank=%zu: expected=(%.6f,%u), actual=(%.6f,%u)\n",
                offset / TOPK_COUNT, offset % TOPK_COUNT, expected_values[offset], expected_indices[offset],
                value, index);
            return 0;
        }
    }
    return 1;
}

static int check_acl(aclError result, const char* operation)
{
    if (result == ACL_SUCCESS) {
        return 1;
    }
    fprintf(stderr, "ACL call failed: %s, error=%d\n", operation, (int)result);
    return 0;
}

static void release_device_buffers(DeviceBuffers* buffers)
{
    if (buffers->output_indices != NULL) {
        (void)aclrtFree(buffers->output_indices);
        buffers->output_indices = NULL;
    }
    if (buffers->output_values != NULL) {
        (void)aclrtFree(buffers->output_values);
        buffers->output_values = NULL;
    }
    if (buffers->input != NULL) {
        (void)aclrtFree(buffers->input);
        buffers->input = NULL;
    }
}

static int allocate_device_buffers(DeviceBuffers* buffers, size_t input_bytes, size_t value_bytes, size_t index_bytes)
{
    if (!check_acl(aclrtMalloc((void**)&buffers->input, input_bytes, ACL_MEM_MALLOC_HUGE_FIRST), "aclrtMalloc input")) {
        return 0;
    }
    if (!check_acl(aclrtMalloc(
            (void**)&buffers->output_values, value_bytes, ACL_MEM_MALLOC_HUGE_FIRST), "aclrtMalloc values")) {
        return 0;
    }
    if (!check_acl(aclrtMalloc(
            (void**)&buffers->output_indices, index_bytes, ACL_MEM_MALLOC_HUGE_FIRST), "aclrtMalloc indices")) {
        return 0;
    }
    return 1;
}

static void launch_selected_kernel(const DeviceBuffers* buffers, aclrtStream stream)
{
#if SCENARIO_NUM == 0
    topk_repeated_padded_bitonic_kernel<<<BLOCK_DIM, 0, stream>>>(
        buffers->input, buffers->output_values, buffers->output_indices);
#else
    topk_streaming_bounded_kernel<<<BLOCK_DIM, 0, stream>>>(
        buffers->input, buffers->output_values, buffers->output_indices);
#endif
}

int main(void)
{
    size_t input_count = (size_t)ROW_COUNT * ELEMENT_COUNT;
    size_t output_count = (size_t)ROW_COUNT * TOPK_COUNT;
    size_t input_bytes = input_count * sizeof(float);
    size_t value_bytes = output_count * sizeof(float);
    size_t index_bytes = output_count * sizeof(uint32_t);
    float* input = (float*)malloc(input_bytes);
    float* values = (float*)malloc(value_bytes);
    uint32_t* indices = (uint32_t*)malloc(index_bytes);
    float* expected_values = (float*)malloc(value_bytes);
    uint32_t* expected_indices = (uint32_t*)malloc(index_bytes);
    DeviceBuffers device = {NULL, NULL, NULL};
    aclrtStream stream = NULL;
    int acl_initialized = 0;
    int device_selected = 0;
    int success = 0;

    if (input == NULL || values == NULL || indices == NULL || expected_values == NULL || expected_indices == NULL) {
        fprintf(stderr, "host allocation failed\n");
        goto cleanup;
    }
    fill_input_fixed_seed(input);
    if (!host_topk_oracle(input, expected_values, expected_indices)) {
        goto cleanup;
    }
    if (!check_acl(aclInit(NULL), "aclInit")) {
        goto cleanup;
    }
    acl_initialized = 1;
    if (!check_acl(aclrtSetDevice(0), "aclrtSetDevice")) {
        goto cleanup;
    }
    device_selected = 1;
    if (!check_acl(aclrtCreateStream(&stream), "aclrtCreateStream")) {
        goto cleanup;
    }
    if (!allocate_device_buffers(&device, input_bytes, value_bytes, index_bytes)) {
        goto cleanup;
    }
    if (!check_acl(aclrtMemcpy(
            device.input, input_bytes, input, input_bytes, ACL_MEMCPY_HOST_TO_DEVICE), "copy input H2D")) {
        goto cleanup;
    }

    launch_selected_kernel(&device, stream);
    if (!check_acl(aclrtSynchronizeStream(stream), "kernel synchronize")) {
        goto cleanup;
    }
    if (!check_acl(aclrtMemcpy(
            values, value_bytes, device.output_values, value_bytes, ACL_MEMCPY_DEVICE_TO_HOST), "copy values D2H")) {
        goto cleanup;
    }
    if (!check_acl(aclrtMemcpy(
            indices, index_bytes, device.output_indices, index_bytes, ACL_MEMCPY_DEVICE_TO_HOST), "copy indices D2H")) {
        goto cleanup;
    }
    success = verify_result(values, indices, expected_values, expected_indices);

cleanup:
    printf("Scenario %d: %s\n", SCENARIO_NUM,
        SCENARIO_NUM == 0 ? "repeated padded bitonic merge" : "streaming bounded heap Top-K");
    printf("Input [32, 1024] float32, Top-32, launch 1 block x 512 SIMT threads\n");
    if (success) {
        printf("Verification PASSED\n");
    } else {
        printf("Verification FAILED\n");
    }
    release_device_buffers(&device);
    if (stream != NULL) {
        (void)aclrtDestroyStream(stream);
    }
    if (device_selected) {
        (void)aclrtResetDevice(0);
    }
    if (acl_initialized) {
        (void)aclFinalize();
    }
    free(expected_indices);
    free(expected_values);
    free(indices);
    free(values);
    free(input);
    return success ? 0 : 1;
}
