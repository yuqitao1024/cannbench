/**
 * 256-bin histogram threshold microbenchmark for Ascend 950.
 *
 * SCENARIO_NUM=0: one block scans the complete context and emits the result.
 * SCENARIO_NUM=1: 64 blocks scan disjoint shards, then one block reduces them.
 */

#include <stdint.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>

#include "acl/acl.h"
#include "simt_api/asc_simt.h"
#include "simt_api/device_atomic_functions.h"
#include "simt_api/device_sync_functions.h"

static_assert(SCENARIO_NUM == 0 || SCENARIO_NUM == 1, "SCENARIO_NUM must be 0 or 1");

enum {
    DEVICE_ID = 0,
    BIN_COUNT = 256,
    THREAD_COUNT = 512,
    BASELINE_BLOCK_COUNT = 1,
    SHARD_COUNT = 64,
    REDUCE_BLOCK_COUNT = 1,
    CONTEXT_COUNT = 16 * 1024 * 1024,
    TOP_K = 4096,
    OUTPUT_WORD_COUNT = 3,
    OUTPUT_TOTAL = 0,
    OUTPUT_THRESHOLD = 1,
    OUTPUT_THRESHOLD_TAIL = 2,
    LOCAL_HISTOGRAM_BYTES = BIN_COUNT * sizeof(uint32_t),
};

static const uint32_t RANDOM_SEED = 0x5a17c9e3U;
static const char *SCENARIO_NAME =
    SCENARIO_NUM == 0 ? "single-block histogram + threshold" : "64-shard histogram + hierarchical reduction";

typedef struct DeviceBuffers {
    uint8_t *scores;
    uint32_t *partial_histograms;
    uint32_t *histogram;
    uint32_t *output;
} DeviceBuffers;

#define CHECK_ACL(expr)                                                                                \
    do {                                                                                               \
        aclError check_acl_result = (expr);                                                            \
        if (check_acl_result != ACL_SUCCESS) {                                                         \
            fprintf(stderr, "ACL call failed: %s, ret=%d\n", #expr, (int)check_acl_result);           \
            exit(1);                                                                                   \
        }                                                                                              \
    } while (0)

#if SCENARIO_NUM == 0
__simt_vf__ __launch_bounds__(THREAD_COUNT) inline void baseline_histogram_threshold_vf(
    __gm__ const uint8_t *scores,
    __gm__ uint32_t *histogram,
    __gm__ uint32_t *output,
    uint32_t context_count,
    uint32_t top_k,
    __ubuf__ uint32_t *local_histogram)
{
    uint32_t thread_index = (uint32_t)threadIdx.x;
    if (thread_index < BIN_COUNT) {
        local_histogram[thread_index] = 0;
    }
    asc_syncthreads();

    for (uint32_t index = thread_index; index < context_count; index += THREAD_COUNT) {
        asc_atomic_add(local_histogram + (uint32_t)scores[index], 1U);
    }
    asc_syncthreads();

    if (thread_index < BIN_COUNT) {
        histogram[thread_index] = local_histogram[thread_index];
    }
    asc_syncthreads();

    if (thread_index == 0) {
        uint32_t total = 0;
        uint32_t greater = 0;
        uint32_t threshold = 0;
        uint32_t threshold_tail = 0;
        for (uint32_t bin = 0; bin < BIN_COUNT; ++bin) {
            total += local_histogram[bin];
        }
        for (int32_t bin = BIN_COUNT - 1; bin >= 0; --bin) {
            uint32_t bin_count = local_histogram[bin];
            if (greater + bin_count >= top_k) {
                threshold = (uint32_t)bin;
                threshold_tail = top_k - greater;
                break;
            }
            greater += bin_count;
        }
        output[OUTPUT_TOTAL] = total;
        output[OUTPUT_THRESHOLD] = threshold;
        output[OUTPUT_THRESHOLD_TAIL] = threshold_tail;
    }
}

__global__ __vector__ void baseline_histogram_threshold_kernel(
    __gm__ const uint8_t *scores,
    __gm__ uint32_t *histogram,
    __gm__ uint32_t *output,
    uint32_t context_count,
    uint32_t top_k)
{
    extern __ubuf__ uint32_t dynamic_start_ub[];
    asc_vf_call<baseline_histogram_threshold_vf>(
        dim3(THREAD_COUNT, 1, 1), scores, histogram, output, context_count, top_k, dynamic_start_ub);
}
#else
__simt_vf__ __launch_bounds__(THREAD_COUNT) inline void shard_histogram_vf(
    __gm__ const uint8_t *scores,
    __gm__ uint32_t *partial_histograms,
    uint32_t context_count,
    __ubuf__ uint32_t *local_histogram)
{
    uint32_t thread_index = (uint32_t)threadIdx.x;
    uint32_t shard_index = (uint32_t)blockIdx.x;
    uint32_t shard_begin = (uint32_t)(((uint64_t)context_count * shard_index) / SHARD_COUNT);
    uint32_t shard_end = (uint32_t)(((uint64_t)context_count * (shard_index + 1U)) / SHARD_COUNT);

    if (thread_index < BIN_COUNT) {
        local_histogram[thread_index] = 0;
    }
    asc_syncthreads();

    for (uint32_t index = shard_begin + thread_index; index < shard_end; index += THREAD_COUNT) {
        asc_atomic_add(local_histogram + (uint32_t)scores[index], 1U);
    }
    asc_syncthreads();

    if (thread_index < BIN_COUNT) {
        partial_histograms[shard_index * BIN_COUNT + thread_index] = local_histogram[thread_index];
    }
}

__simt_vf__ __launch_bounds__(BIN_COUNT) inline void reduce_histogram_threshold_vf(
    __gm__ const uint32_t *partial_histograms,
    __gm__ uint32_t *histogram,
    __gm__ uint32_t *output,
    uint32_t top_k,
    __ubuf__ uint32_t *combined_histogram)
{
    uint32_t bin = (uint32_t)threadIdx.x;
    uint32_t bin_count = 0;
    for (uint32_t shard = 0; shard < SHARD_COUNT; ++shard) {
        bin_count += partial_histograms[shard * BIN_COUNT + bin];
    }
    combined_histogram[bin] = bin_count;
    histogram[bin] = bin_count;
    asc_syncthreads();

    if (bin == 0) {
        uint32_t total = 0;
        uint32_t greater = 0;
        uint32_t threshold = 0;
        uint32_t threshold_tail = 0;
        for (uint32_t selected_bin = 0; selected_bin < BIN_COUNT; ++selected_bin) {
            total += combined_histogram[selected_bin];
        }
        for (int32_t selected_bin = BIN_COUNT - 1; selected_bin >= 0; --selected_bin) {
            uint32_t selected_count = combined_histogram[selected_bin];
            if (greater + selected_count >= top_k) {
                threshold = (uint32_t)selected_bin;
                threshold_tail = top_k - greater;
                break;
            }
            greater += selected_count;
        }
        output[OUTPUT_TOTAL] = total;
        output[OUTPUT_THRESHOLD] = threshold;
        output[OUTPUT_THRESHOLD_TAIL] = threshold_tail;
    }
}

__global__ __vector__ void shard_histogram_kernel(
    __gm__ const uint8_t *scores,
    __gm__ uint32_t *partial_histograms,
    uint32_t context_count)
{
    extern __ubuf__ uint32_t dynamic_start_ub[];
    asc_vf_call<shard_histogram_vf>(
        dim3(THREAD_COUNT, 1, 1), scores, partial_histograms, context_count, dynamic_start_ub);
}

__global__ __vector__ void reduce_histogram_threshold_kernel(
    __gm__ const uint32_t *partial_histograms,
    __gm__ uint32_t *histogram,
    __gm__ uint32_t *output,
    uint32_t top_k)
{
    extern __ubuf__ uint32_t dynamic_start_ub[];
    asc_vf_call<reduce_histogram_threshold_vf>(
        dim3(BIN_COUNT, 1, 1), partial_histograms, histogram, output, top_k, dynamic_start_ub);
}
#endif

static uint32_t next_random(uint32_t *state)
{
    uint32_t value = *state;
    value ^= value << 13;
    value ^= value >> 17;
    value ^= value << 5;
    *state = value;
    return value;
}

static void initialize_input(uint8_t *scores, uint32_t *golden_histogram)
{
    uint32_t random_state = RANDOM_SEED;
    memset(golden_histogram, 0, BIN_COUNT * sizeof(uint32_t));
    for (uint32_t index = 0; index < CONTEXT_COUNT; ++index) {
        uint8_t score = index < BIN_COUNT ? (uint8_t)index : (uint8_t)(next_random(&random_state) >> 24);
        scores[index] = score;
        golden_histogram[(uint32_t)score] += 1U;
    }
}

static void compute_oracle(
    const uint32_t *histogram,
    uint32_t *total,
    uint32_t *threshold,
    uint32_t *threshold_tail)
{
    uint32_t greater = 0;
    *total = 0;
    *threshold = 0;
    *threshold_tail = 0;
    for (uint32_t bin = 0; bin < BIN_COUNT; ++bin) {
        *total += histogram[bin];
    }
    for (int32_t bin = BIN_COUNT - 1; bin >= 0; --bin) {
        uint32_t count = histogram[bin];
        if (greater + count >= TOP_K) {
            *threshold = (uint32_t)bin;
            *threshold_tail = TOP_K - greater;
            return;
        }
        greater += count;
    }
}

static void allocate_device_buffers(DeviceBuffers *buffers)
{
    size_t partial_bytes = (size_t)SHARD_COUNT * BIN_COUNT * sizeof(uint32_t);
    CHECK_ACL(aclrtMalloc((void **)&buffers->scores, CONTEXT_COUNT * sizeof(uint8_t), ACL_MEM_MALLOC_HUGE_FIRST));
    CHECK_ACL(aclrtMalloc((void **)&buffers->partial_histograms, partial_bytes, ACL_MEM_MALLOC_HUGE_FIRST));
    CHECK_ACL(aclrtMalloc((void **)&buffers->histogram, BIN_COUNT * sizeof(uint32_t), ACL_MEM_MALLOC_HUGE_FIRST));
    CHECK_ACL(aclrtMalloc((void **)&buffers->output, OUTPUT_WORD_COUNT * sizeof(uint32_t), ACL_MEM_MALLOC_HUGE_FIRST));
}

static void free_device_buffers(DeviceBuffers *buffers)
{
    CHECK_ACL(aclrtFree(buffers->output));
    CHECK_ACL(aclrtFree(buffers->histogram));
    CHECK_ACL(aclrtFree(buffers->partial_histograms));
    CHECK_ACL(aclrtFree(buffers->scores));
}

static void launch_selected_scenario(const DeviceBuffers *buffers, aclrtStream stream)
{
#if SCENARIO_NUM == 0
    baseline_histogram_threshold_kernel<<<BASELINE_BLOCK_COUNT, LOCAL_HISTOGRAM_BYTES, stream>>>(
        buffers->scores, buffers->histogram, buffers->output, CONTEXT_COUNT, TOP_K);
#else
    shard_histogram_kernel<<<SHARD_COUNT, LOCAL_HISTOGRAM_BYTES, stream>>>(
        buffers->scores, buffers->partial_histograms, CONTEXT_COUNT);
    reduce_histogram_threshold_kernel<<<REDUCE_BLOCK_COUNT, LOCAL_HISTOGRAM_BYTES, stream>>>(
        buffers->partial_histograms, buffers->histogram, buffers->output, TOP_K);
#endif
}

static int verify_result(
    const uint32_t *golden_histogram,
    const uint32_t *actual_histogram,
    const uint32_t *actual_output)
{
    uint32_t expected_total = 0;
    uint32_t expected_threshold = 0;
    uint32_t expected_threshold_tail = 0;
    int valid = 1;
    compute_oracle(golden_histogram, &expected_total, &expected_threshold, &expected_threshold_tail);

    for (uint32_t bin = 0; bin < BIN_COUNT; ++bin) {
        if (actual_histogram[bin] != golden_histogram[bin]) {
            fprintf(stderr, "histogram mismatch: bin=%u actual=%u expected=%u\n", bin,
                actual_histogram[bin], golden_histogram[bin]);
            valid = 0;
        }
    }
    if (actual_output[OUTPUT_TOTAL] != expected_total) {
        fprintf(stderr, "total mismatch: actual=%u expected=%u\n", actual_output[OUTPUT_TOTAL], expected_total);
        valid = 0;
    }
    if (actual_output[OUTPUT_THRESHOLD] != expected_threshold) {
        fprintf(stderr, "threshold mismatch: actual=%u expected=%u\n",
            actual_output[OUTPUT_THRESHOLD], expected_threshold);
        valid = 0;
    }
    if (actual_output[OUTPUT_THRESHOLD_TAIL] != expected_threshold_tail) {
        fprintf(stderr, "threshold tail mismatch: actual=%u expected=%u\n",
            actual_output[OUTPUT_THRESHOLD_TAIL], expected_threshold_tail);
        valid = 0;
    }
    return valid;
}

int main(void)
{
    uint8_t *host_scores = (uint8_t *)malloc(CONTEXT_COUNT * sizeof(uint8_t));
    uint32_t *golden_histogram = (uint32_t *)calloc(BIN_COUNT, sizeof(uint32_t));
    uint32_t *actual_histogram = (uint32_t *)calloc(BIN_COUNT, sizeof(uint32_t));
    uint32_t *actual_output = (uint32_t *)calloc(OUTPUT_WORD_COUNT, sizeof(uint32_t));
    DeviceBuffers buffers = {0};
    aclrtStream stream = NULL;
    int valid = 0;

    if (host_scores == NULL || golden_histogram == NULL || actual_histogram == NULL || actual_output == NULL) {
        fprintf(stderr, "host allocation failed\n");
        free(actual_output);
        free(actual_histogram);
        free(golden_histogram);
        free(host_scores);
        return 1;
    }
    initialize_input(host_scores, golden_histogram);

    CHECK_ACL(aclInit(NULL));
    CHECK_ACL(aclrtSetDevice(DEVICE_ID));
    CHECK_ACL(aclrtCreateStream(&stream));
    allocate_device_buffers(&buffers);
    CHECK_ACL(aclrtMemcpy(buffers.scores, CONTEXT_COUNT * sizeof(uint8_t), host_scores,
        CONTEXT_COUNT * sizeof(uint8_t), ACL_MEMCPY_HOST_TO_DEVICE));

    launch_selected_scenario(&buffers, stream);
    CHECK_ACL(aclrtSynchronizeStream(stream));
    CHECK_ACL(aclrtMemcpy(actual_histogram, BIN_COUNT * sizeof(uint32_t), buffers.histogram,
        BIN_COUNT * sizeof(uint32_t), ACL_MEMCPY_DEVICE_TO_HOST));
    CHECK_ACL(aclrtMemcpy(actual_output, OUTPUT_WORD_COUNT * sizeof(uint32_t), buffers.output,
        OUTPUT_WORD_COUNT * sizeof(uint32_t), ACL_MEMCPY_DEVICE_TO_HOST));

    valid = verify_result(golden_histogram, actual_histogram, actual_output);
    printf("scenario=%d\n", SCENARIO_NUM);
    printf("implementation=%s\n", SCENARIO_NAME);
    printf("context_count=%u\n", (uint32_t)CONTEXT_COUNT);
    printf("top_k=%u\n", (uint32_t)TOP_K);
    printf("launch_count=%d\n", SCENARIO_NUM == 0 ? 1 : 2);
    printf("threshold=%u\n", actual_output[OUTPUT_THRESHOLD]);
    printf("threshold_tail=%u\n", actual_output[OUTPUT_THRESHOLD_TAIL]);
    printf("%s\n", valid ? "Verification PASSED" : "Verification FAILED");

    free_device_buffers(&buffers);
    CHECK_ACL(aclrtDestroyStream(stream));
    CHECK_ACL(aclrtResetDevice(DEVICE_ID));
    CHECK_ACL(aclFinalize());
    free(actual_output);
    free(actual_histogram);
    free(golden_histogram);
    free(host_scores);
    return valid ? 0 : 1;
}
