__global__ __vector__ void
lightning_indexer_decode_distributed_compact_bfloat16_v2_kernel(
    __gm__ const uint16_t* reduced_scores,
    __gm__ const uint32_t* state,
    __gm__ const uint32_t* shard_offsets,
    __gm__ int32_t* output,
    int32_t row_count,
    int32_t context_shard_count) {
  extern __ubuf__ uint32_t dynamicStartUB[];
  asc_vf_call<lightning_indexer_decode_distributed_compact_bfloat16_v2_vf>(
      dim3(kThreadsPerBlock, 1, 1),
      reduced_scores,
      state,
      shard_offsets,
      output,
      row_count,
      context_shard_count,
      dynamicStartUB);
}

} // namespace

extern "C" void
launch_lightning_indexer_decode_distributed_high_histogram_bfloat16_v2(
    const bfloat16_t* reduced_scores,
    uint32_t* high_histogram,
    int32_t row_count,
    int32_t context_shard_count,
    aclrtStream stream) {
  lightning_indexer_decode_distributed_high_histogram_bfloat16_v2_kernel
      <<<row_count * context_shard_count, kHistogramUbufBytes, stream>>>(
      reinterpret_cast<const uint16_t*>(reduced_scores),
      high_histogram,
      row_count,
      context_shard_count);
}

extern "C" void
launch_lightning_indexer_decode_distributed_select_high_bfloat16_v2(
    const uint32_t* high_histogram,
    uint32_t* state,
    int32_t row_count,
    int32_t context_shard_count,
    aclrtStream stream) {
  lightning_indexer_decode_distributed_select_high_bfloat16_v2_kernel
      <<<row_count, kHistogramUbufBytes, stream>>>(
      high_histogram,
      state,
      row_count,
      context_shard_count);
}

extern "C" void
launch_lightning_indexer_decode_distributed_low_histogram_bfloat16_v2(
    const bfloat16_t* reduced_scores,
    const uint32_t* state,
    uint32_t* low_histogram,
    int32_t row_count,
    int32_t context_shard_count,
    aclrtStream stream) {
  lightning_indexer_decode_distributed_low_histogram_bfloat16_v2_kernel
      <<<row_count * context_shard_count, kHistogramUbufBytes, stream>>>(
      reinterpret_cast<const uint16_t*>(reduced_scores),
      state,
      low_histogram,
      row_count,
      context_shard_count);
}

extern "C" void
launch_lightning_indexer_decode_distributed_select_low_offsets_bfloat16_v2(
    const uint32_t* high_histogram,
    const uint32_t* low_histogram,
    uint32_t* state,
    uint32_t* shard_offsets,
    int32_t row_count,
    int32_t context_shard_count,
    aclrtStream stream) {
  lightning_indexer_decode_distributed_select_low_offsets_bfloat16_v2_kernel
      <<<row_count, kReducerUbufBytes, stream>>>(
      high_histogram,
      low_histogram,
      state,
      shard_offsets,
      row_count,
      context_shard_count);
}

extern "C" void
launch_lightning_indexer_decode_distributed_compact_bfloat16_v2(
    const bfloat16_t* reduced_scores,
    const uint32_t* state,
    const uint32_t* shard_offsets,
    int32_t* output,
    int32_t row_count,
    int32_t context_shard_count,
    aclrtStream stream) {
  lightning_indexer_decode_distributed_compact_bfloat16_v2_kernel
      <<<row_count * context_shard_count, kCompactUbufBytes, stream>>>(
      reinterpret_cast<const uint16_t*>(reduced_scores),
      state,
      shard_offsets,
      output,
      row_count,
      context_shard_count);
}
