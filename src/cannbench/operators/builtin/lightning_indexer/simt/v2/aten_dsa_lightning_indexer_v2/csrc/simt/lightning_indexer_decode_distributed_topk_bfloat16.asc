#include <cstdint>

#include "acl/acl.h"
#include "simt_api/asc_bf16.h"
#include "simt_api/asc_simt.h"
#include "simt_api/device_atomic_functions.h"
#include "simt_api/device_sync_functions.h"

namespace {

constexpr int32_t kContextCount = 32768;
constexpr int32_t kTopK = 2048;
constexpr int32_t kCanonicalContextShardCount = 16;
constexpr int32_t kThreadsPerBlock = 1024;
constexpr int32_t kReducerThreads = 256;
constexpr int32_t kRadixBins = 256;
constexpr int32_t kHistogramWords = kRadixBins;
constexpr int32_t kStateWordsPerRow = 4;
constexpr int32_t kOffsetWordsPerShard = 2;
constexpr int32_t kHistogramUbufBytes =
    kHistogramWords * static_cast<int32_t>(sizeof(uint32_t));
constexpr int32_t kReducerUbufWords =
    kHistogramWords + 2 * kCanonicalContextShardCount;
constexpr int32_t kReducerUbufBytes =
    kReducerUbufWords * static_cast<int32_t>(sizeof(uint32_t));
constexpr int32_t kCompactScanWords = 2 * kThreadsPerBlock;
constexpr int32_t kCompactUbufBytes =
    kCompactScanWords * static_cast<int32_t>(sizeof(uint32_t));
constexpr uint32_t kCountFieldBits = 16U;
constexpr uint32_t kCountFieldMask =
    (1U << kCountFieldBits) - 1U;
static_assert(kContextCount <= static_cast<int32_t>(kCountFieldMask));

constexpr int32_t kStateSelectedHigh = 0;
constexpr int32_t kStateRemainingRank = 1;
constexpr int32_t kStateThresholdKey = 2;
constexpr int32_t kStateTotalGreater = 3;
constexpr int32_t kOffsetGreater = 0;
constexpr int32_t kOffsetEqual = 1;

__SIMT_DEVICE_FUNCTIONS_DECL__ inline uint16_t ordered_bf16_key(
    uint16_t bits) {
  return (bits & 0x8000U) != 0U
      ? static_cast<uint16_t>(~bits)
      : static_cast<uint16_t>(bits ^ 0x8000U);
}

__simt_vf__ __launch_bounds__(kThreadsPerBlock) inline void
lightning_indexer_decode_distributed_high_histogram_bfloat16_v2_vf(
    __gm__ const uint16_t* reduced_score_bits,
    __gm__ uint32_t* histogram,
    int32_t row_count,
    int32_t context_shard_count,
    __ubuf__ uint32_t* local_histogram) {
  const int32_t block_index = static_cast<int32_t>(blockIdx.x);
  const int32_t block_count = row_count * context_shard_count;
  if (block_index >= block_count) {
    return;
  }
  const int32_t thread_index = static_cast<int32_t>(threadIdx.x);
  const int32_t row_index = block_index / context_shard_count;
  const int32_t shard_index = block_index % context_shard_count;
  const int32_t shard_size = kContextCount / context_shard_count;
  const int32_t context_start = shard_index * shard_size;
  const int64_t score_base =
      static_cast<int64_t>(row_index) * kContextCount + context_start;
  const int64_t histogram_base =
      static_cast<int64_t>(block_index) * kRadixBins;

  if (thread_index < kRadixBins) {
    local_histogram[thread_index] = 0;
  }
  asc_syncthreads();
  for (int32_t shard_offset = thread_index;
       shard_offset < shard_size;
       shard_offset += kThreadsPerBlock) {
    const uint16_t score_key = ordered_bf16_key(
        reduced_score_bits[score_base + shard_offset]);
    const uint32_t bucket = static_cast<uint32_t>(score_key >> 8);
    asc_atomic_add(local_histogram + bucket, 1U);
  }
  asc_syncthreads();
  if (thread_index < kRadixBins) {
    histogram[histogram_base + thread_index] =
        local_histogram[thread_index];
  }
}

__simt_vf__ __launch_bounds__(kReducerThreads) inline void
lightning_indexer_decode_distributed_select_high_bfloat16_v2_vf(
    __gm__ const uint32_t* high_histogram,
    __gm__ uint32_t* state,
    int32_t row_count,
    int32_t context_shard_count,
    __ubuf__ uint32_t* combined_histogram) {
  const int32_t row_index = static_cast<int32_t>(blockIdx.x);
  if (row_index >= row_count) {
    return;
  }
  const int32_t bucket = static_cast<int32_t>(threadIdx.x);
  uint32_t bucket_count = 0;
  for (int32_t shard_index = 0;
       shard_index < context_shard_count;
       ++shard_index) {
    const int64_t histogram_offset =
        (static_cast<int64_t>(row_index) * context_shard_count + shard_index) *
            kRadixBins +
        bucket;
    bucket_count += high_histogram[histogram_offset];
  }
  combined_histogram[bucket] = bucket_count;
  asc_syncthreads();
  if (bucket == 0) {
    uint32_t greater_count = 0;
    for (int32_t selected_bucket = kRadixBins - 1;
         selected_bucket >= 0;
         --selected_bucket) {
      const uint32_t selected_count = combined_histogram[selected_bucket];
      if (greater_count + selected_count >= kTopK) {
        const int64_t state_base =
            static_cast<int64_t>(row_index) * kStateWordsPerRow;
        state[state_base + kStateSelectedHigh] =
            static_cast<uint32_t>(selected_bucket);
        state[state_base + kStateRemainingRank] = kTopK - greater_count;
        break;
      }
      greater_count += selected_count;
    }
  }
}

__simt_vf__ __launch_bounds__(kThreadsPerBlock) inline void
lightning_indexer_decode_distributed_low_histogram_bfloat16_v2_vf(
    __gm__ const uint16_t* reduced_score_bits,
    __gm__ const uint32_t* state,
    __gm__ uint32_t* histogram,
    int32_t row_count,
    int32_t context_shard_count,
    __ubuf__ uint32_t* local_histogram) {
  const int32_t block_index = static_cast<int32_t>(blockIdx.x);
  const int32_t block_count = row_count * context_shard_count;
  if (block_index >= block_count) {
    return;
  }
  const int32_t thread_index = static_cast<int32_t>(threadIdx.x);
  const int32_t row_index = block_index / context_shard_count;
  const int32_t shard_index = block_index % context_shard_count;
  const int32_t shard_size = kContextCount / context_shard_count;
  const int32_t context_start = shard_index * shard_size;
  const int64_t score_base =
      static_cast<int64_t>(row_index) * kContextCount + context_start;
  const int64_t histogram_base =
      static_cast<int64_t>(block_index) * kRadixBins;
  const uint16_t selected_high = static_cast<uint16_t>(
      state[static_cast<int64_t>(row_index) * kStateWordsPerRow +
            kStateSelectedHigh]);

  if (thread_index < kRadixBins) {
    local_histogram[thread_index] = 0;
  }
  asc_syncthreads();
  for (int32_t shard_offset = thread_index;
       shard_offset < shard_size;
       shard_offset += kThreadsPerBlock) {
    const uint16_t score_key = ordered_bf16_key(
        reduced_score_bits[score_base + shard_offset]);
    if (static_cast<uint16_t>(score_key >> 8) == selected_high) {
      const uint32_t bucket = static_cast<uint32_t>(score_key & 0xFFU);
      asc_atomic_add(local_histogram + bucket, 1U);
    }
  }
  asc_syncthreads();
  if (thread_index < kRadixBins) {
    histogram[histogram_base + thread_index] =
        local_histogram[thread_index];
  }
}

__simt_vf__ __launch_bounds__(kReducerThreads) inline void
lightning_indexer_decode_distributed_select_low_offsets_bfloat16_v2_vf(
    __gm__ const uint32_t* high_histogram,
    __gm__ const uint32_t* low_histogram,
    __gm__ uint32_t* state,
    __gm__ uint32_t* shard_offsets,
    int32_t row_count,
    int32_t context_shard_count,
    __ubuf__ uint32_t* dynamic_start_ub) {
  const int32_t row_index = static_cast<int32_t>(blockIdx.x);
  if (row_index >= row_count) {
    return;
  }
  __ubuf__ uint32_t* combined_histogram = dynamic_start_ub;
  __ubuf__ uint32_t* shard_greater_counts =
      combined_histogram + kHistogramWords;
  __ubuf__ uint32_t* shard_equal_counts =
      shard_greater_counts + kCanonicalContextShardCount;
  const int32_t thread_index = static_cast<int32_t>(threadIdx.x);
  const int64_t state_base =
      static_cast<int64_t>(row_index) * kStateWordsPerRow;
  const uint32_t selected_high = state[state_base + kStateSelectedHigh];
  const uint32_t remaining_rank = state[state_base + kStateRemainingRank];

  uint32_t bucket_count = 0;
  for (int32_t shard_index = 0;
       shard_index < context_shard_count;
       ++shard_index) {
    const int64_t histogram_offset =
        (static_cast<int64_t>(row_index) * context_shard_count + shard_index) *
            kRadixBins +
        thread_index;
    bucket_count += low_histogram[histogram_offset];
  }
  combined_histogram[thread_index] = bucket_count;
  asc_syncthreads();

  if (thread_index == 0) {
    uint32_t greater_count = 0;
    for (int32_t selected_bucket = kRadixBins - 1;
         selected_bucket >= 0;
         --selected_bucket) {
      const uint32_t selected_count = combined_histogram[selected_bucket];
      if (greater_count + selected_count >= remaining_rank) {
        state[state_base + kStateThresholdKey] =
            (selected_high << 8) | static_cast<uint32_t>(selected_bucket);
        break;
      }
      greater_count += selected_count;
    }
  }
  asc_syncthreads();

  if (thread_index < context_shard_count) {
    const int32_t shard_index = thread_index;
    const int64_t histogram_base =
        (static_cast<int64_t>(row_index) * context_shard_count + shard_index) *
        kRadixBins;
    const uint32_t threshold_key = state[state_base + kStateThresholdKey];
    const uint32_t selected_low = threshold_key & 0xFFU;
    uint32_t shard_greater_count = 0;
    for (uint32_t bucket = selected_high + 1U;
         bucket < static_cast<uint32_t>(kRadixBins);
         ++bucket) {
      shard_greater_count += high_histogram[histogram_base + bucket];
    }
    for (uint32_t bucket = selected_low + 1U;
         bucket < static_cast<uint32_t>(kRadixBins);
         ++bucket) {
      shard_greater_count += low_histogram[histogram_base + bucket];
    }
    shard_greater_counts[shard_index] = shard_greater_count;
    shard_equal_counts[shard_index] =
        low_histogram[histogram_base + selected_low];
  }
  asc_syncthreads();

  if (thread_index == 0) {
    uint32_t shard_greater_offset = 0;
    uint32_t shard_equal_offset = 0;
    for (int32_t shard_index = 0;
         shard_index < context_shard_count;
         ++shard_index) {
      const int64_t offset_base =
          (static_cast<int64_t>(row_index) * context_shard_count +
           shard_index) *
          kOffsetWordsPerShard;
      shard_offsets[offset_base + kOffsetGreater] = shard_greater_offset;
      shard_offsets[offset_base + kOffsetEqual] = shard_equal_offset;
      shard_greater_offset += shard_greater_counts[shard_index];
      shard_equal_offset += shard_equal_counts[shard_index];
    }
    state[state_base + kStateTotalGreater] = shard_greater_offset;
  }
}

__simt_vf__ __launch_bounds__(kThreadsPerBlock) inline void
lightning_indexer_decode_distributed_compact_bfloat16_v2_vf(
    __gm__ const uint16_t* reduced_score_bits,
    __gm__ const uint32_t* state,
    __gm__ const uint32_t* shard_offsets,
    __gm__ int32_t* output,
    int32_t row_count,
    int32_t context_shard_count,
    __ubuf__ uint32_t* dynamic_start_ub) {
  const int32_t block_index = static_cast<int32_t>(blockIdx.x);
  const int32_t block_count = row_count * context_shard_count;
  if (block_index >= block_count) {
    return;
  }
  __ubuf__ uint32_t* scan_a = dynamic_start_ub;
  __ubuf__ uint32_t* scan_b = scan_a + kThreadsPerBlock;
  const int32_t thread_index = static_cast<int32_t>(threadIdx.x);
  const int32_t row_index = block_index / context_shard_count;
  const int32_t shard_index = block_index % context_shard_count;
  const int32_t shard_size = kContextCount / context_shard_count;
  const int32_t context_start = shard_index * shard_size;
  const int64_t score_base =
      static_cast<int64_t>(row_index) * kContextCount + context_start;
  const int64_t row_offset = static_cast<int64_t>(row_index) * kTopK;
  const int64_t state_base =
      static_cast<int64_t>(row_index) * kStateWordsPerRow;
  const int64_t offset_base =
      static_cast<int64_t>(block_index) * kOffsetWordsPerShard;
  const uint16_t threshold_key =
      static_cast<uint16_t>(state[state_base + kStateThresholdKey]);
  const uint32_t total_greater_count =
      state[state_base + kStateTotalGreater];
  const uint32_t equal_count_needed = kTopK - total_greater_count;
  const uint32_t shard_greater_offset =
      shard_offsets[offset_base + kOffsetGreater];
  const uint32_t shard_equal_offset =
      shard_offsets[offset_base + kOffsetEqual];

  uint32_t thread_greater_count = 0;
  uint32_t thread_equal_count = 0;
  for (int32_t shard_offset = thread_index;
       shard_offset < shard_size;
       shard_offset += kThreadsPerBlock) {
    const uint16_t score_key = ordered_bf16_key(
        reduced_score_bits[score_base + shard_offset]);
    if (score_key > threshold_key) {
      ++thread_greater_count;
    } else if (score_key == threshold_key) {
      ++thread_equal_count;
    }
  }

  scan_a[thread_index] =
      (thread_equal_count << kCountFieldBits) | thread_greater_count;
  asc_syncthreads();
  __ubuf__ uint32_t* scan_source = scan_a;
  __ubuf__ uint32_t* scan_destination = scan_b;
  for (int32_t offset = 1; offset < kThreadsPerBlock; offset <<= 1) {
    uint32_t prefix_count = scan_source[thread_index];
    if (thread_index >= offset) {
      prefix_count += scan_source[thread_index - offset];
    }
    asc_syncthreads();
    scan_destination[thread_index] = prefix_count;
    asc_syncthreads();
    __ubuf__ uint32_t* old_source = scan_source;
    scan_source = scan_destination;
    scan_destination = old_source;
  }

  const uint32_t packed_inclusive_counts = scan_source[thread_index];
  const uint32_t thread_greater_offset =
      (packed_inclusive_counts & kCountFieldMask) - thread_greater_count;
  const uint32_t thread_equal_offset =
      (packed_inclusive_counts >> kCountFieldBits) - thread_equal_count;
  uint32_t local_greater_rank = 0;
  uint32_t local_equal_rank = 0;
  for (int32_t shard_offset = thread_index;
       shard_offset < shard_size;
       shard_offset += kThreadsPerBlock) {
    const int32_t context_index = context_start + shard_offset;
    const uint16_t score_key = ordered_bf16_key(
        reduced_score_bits[score_base + shard_offset]);
    if (score_key > threshold_key) {
      const uint32_t output_slot =
          shard_greater_offset + thread_greater_offset + local_greater_rank;
      output[row_offset + output_slot] = context_index;
      ++local_greater_rank;
    } else if (score_key == threshold_key) {
      const uint32_t equal_rank =
          shard_equal_offset + thread_equal_offset + local_equal_rank;
      if (equal_rank < equal_count_needed) {
        const uint32_t output_slot = total_greater_count + equal_rank;
        output[row_offset + output_slot] = context_index;
      }
      ++local_equal_rank;
    }
  }
}

__global__ __vector__ void
lightning_indexer_decode_distributed_high_histogram_bfloat16_v2_kernel(
    __gm__ const uint16_t* reduced_scores,
    __gm__ uint32_t* high_histogram,
    int32_t row_count,
    int32_t context_shard_count) {
  extern __ubuf__ uint32_t dynamicStartUB[];
  asc_vf_call<
      lightning_indexer_decode_distributed_high_histogram_bfloat16_v2_vf>(
      dim3(kThreadsPerBlock, 1, 1),
      reduced_scores,
      high_histogram,
      row_count,
      context_shard_count,
      dynamicStartUB);
}

__global__ __vector__ void
lightning_indexer_decode_distributed_select_high_bfloat16_v2_kernel(
    __gm__ const uint32_t* high_histogram,
    __gm__ uint32_t* state,
    int32_t row_count,
    int32_t context_shard_count) {
  extern __ubuf__ uint32_t dynamicStartUB[];
  asc_vf_call<
      lightning_indexer_decode_distributed_select_high_bfloat16_v2_vf>(
      dim3(kReducerThreads, 1, 1),
      high_histogram,
      state,
      row_count,
      context_shard_count,
      dynamicStartUB);
}

__global__ __vector__ void
lightning_indexer_decode_distributed_low_histogram_bfloat16_v2_kernel(
    __gm__ const uint16_t* reduced_scores,
    __gm__ const uint32_t* state,
    __gm__ uint32_t* low_histogram,
