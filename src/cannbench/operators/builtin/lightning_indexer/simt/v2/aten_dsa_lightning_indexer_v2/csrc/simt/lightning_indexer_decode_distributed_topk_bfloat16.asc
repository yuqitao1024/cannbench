      context_shard_count,
      dynamicStartUB);
}

__global__ __vector__ void
lightning_indexer_decode_distributed_select_low_offsets_bfloat16_v2_kernel(
    __gm__ const uint32_t* high_histogram,
    __gm__ const uint32_t* low_histogram,
    __gm__ uint32_t* state,
    __gm__ uint32_t* shard_offsets,
