#include <cstdint>

#include "acl/acl.h"
#include "simt_api/asc_bf16.h"
#include "simt_api/asc_simt.h"
#include "simt_api/device_atomic_functions.h"
#include "simt_api/device_sync_functions.h"

namespace {

constexpr int32_t kContextCount = 32768;
constexpr int32_t kTopK = 2048;
constexpr int32_t kThreadsPerBlock = 1024;
constexpr int32_t kPersistentBlockCount = 32;
constexpr int32_t kRadixBits = 8;
constexpr int32_t kRadixBins = 256;
constexpr int32_t kRadixPassCount = 2;
constexpr int32_t kHistogramWords = kRadixBins;
constexpr int32_t kStateWords = 8;
constexpr int32_t kScanWords = kThreadsPerBlock;
constexpr int32_t kDynamicUbufWords =
    kHistogramWords + kStateWords + 2 * kTopK + 2 * kScanWords;
constexpr int32_t kDynamicUbufBytes =
    kDynamicUbufWords * static_cast<int32_t>(sizeof(uint32_t));

constexpr int32_t kStatePrefix = 0;
constexpr int32_t kStateRemainingRank = 1;
constexpr int32_t kStateSelectedCount = 2;
constexpr int32_t kStateGreaterCount = 3;
constexpr int32_t kStateEqualSeen = 4;

__SIMT_DEVICE_FUNCTIONS_DECL__ inline uint16_t ordered_bf16_key(
    uint16_t bits) {
  return (bits & 0x8000U) != 0U
      ? static_cast<uint16_t>(~bits)
      : static_cast<uint16_t>(bits ^ 0x8000U);
}

__SIMT_DEVICE_FUNCTIONS_DECL__ inline bool candidate_is_better(
    float candidate_score,
    int32_t candidate_index,
    float other_score,
    int32_t other_index) {
  return candidate_score > other_score ||
      (candidate_score == other_score && candidate_index < other_index);
}

__SIMT_DEVICE_FUNCTIONS_DECL__ inline void select_row_topk(
    __gm__ const bfloat16_t* reduced_scores,
    __gm__ const uint16_t* reduced_score_bits,
    __gm__ int32_t* output,
    int32_t row_index,
    __ubuf__ uint32_t* dynamic_start_ub) {
  __ubuf__ uint32_t* histogram = dynamic_start_ub;
  __ubuf__ uint32_t* state = histogram + kHistogramWords;
  __ubuf__ float* candidate_scores =
      reinterpret_cast<__ubuf__ float*>(state + kStateWords);
  __ubuf__ int32_t* candidate_indices = reinterpret_cast<__ubuf__ int32_t*>(
      candidate_scores + kTopK);
  __ubuf__ uint32_t* scan_a = reinterpret_cast<__ubuf__ uint32_t*>(
      candidate_indices + kTopK);
  __ubuf__ uint32_t* scan_b = scan_a + kScanWords;

  const int32_t thread_index = static_cast<int32_t>(threadIdx.x);
  const int64_t row_offset = static_cast<int64_t>(row_index) * kContextCount;

  if (thread_index == 0) {
    state[kStatePrefix] = 0;
    state[kStateRemainingRank] = kTopK;
  }
  asc_syncthreads();

  for (int32_t pass = 0; pass < kRadixPassCount; ++pass) {
    if (thread_index < kRadixBins) {
      histogram[thread_index] = 0;
    }
    asc_syncthreads();

    const int32_t shift = (kRadixPassCount - 1 - pass) * kRadixBits;
    const uint16_t prefix_mask = pass == 0 ? 0U : 0xFF00U;
    const uint16_t selected_prefix =
        static_cast<uint16_t>(state[kStatePrefix]);
    for (int32_t context_index = thread_index;
         context_index < kContextCount;
         context_index += kThreadsPerBlock) {
      const uint16_t score_key = ordered_bf16_key(
          reduced_score_bits[row_offset + context_index]);
      if ((score_key & prefix_mask) != (selected_prefix & prefix_mask)) {
        continue;
      }
      const uint32_t bucket =
          (static_cast<uint32_t>(score_key) >> shift) &
          static_cast<uint32_t>(kRadixBins - 1);
      asc_atomic_add(histogram + bucket, 1U);
    }
    asc_syncthreads();

    if (thread_index == 0) {
      uint32_t greater_count = 0;
      const uint32_t remaining_rank = state[kStateRemainingRank];
      for (int32_t bucket = kRadixBins - 1; bucket >= 0; --bucket) {
        const uint32_t bucket_count = histogram[bucket];
        if (greater_count + bucket_count >= remaining_rank) {
          state[kStatePrefix] |=
              static_cast<uint32_t>(bucket) << shift;
          state[kStateRemainingRank] = remaining_rank - greater_count;
          break;
        }
        greater_count += bucket_count;
      }
    }
    asc_syncthreads();
  }

  const uint16_t threshold_key =
      static_cast<uint16_t>(state[kStatePrefix]);
  if (thread_index == 0) {
    state[kStateSelectedCount] = 0;
  }
  asc_syncthreads();

  for (int32_t context_index = thread_index;
       context_index < kContextCount;
       context_index += kThreadsPerBlock) {
    const uint16_t score_key = ordered_bf16_key(
        reduced_score_bits[row_offset + context_index]);
    if (score_key > threshold_key) {
      const uint32_t candidate_slot =
          asc_atomic_add(state + kStateSelectedCount, 1U);
      if (candidate_slot < static_cast<uint32_t>(kTopK)) {
        candidate_scores[candidate_slot] = static_cast<float>(
            reduced_scores[row_offset + context_index]);
        candidate_indices[candidate_slot] = context_index;
      }
    }
  }
  asc_syncthreads();

  if (thread_index == 0) {
    state[kStateGreaterCount] = state[kStateSelectedCount];
    state[kStateEqualSeen] = 0;
  }
  asc_syncthreads();

  const uint32_t greater_count = state[kStateGreaterCount];
  const uint32_t equal_count_needed = state[kStateRemainingRank];
  for (int32_t chunk_start = 0; chunk_start < kContextCount;
       chunk_start += kThreadsPerBlock) {
    if (state[kStateEqualSeen] >= equal_count_needed) {
      break;
    }

    const int32_t context_index = chunk_start + thread_index;
    const uint16_t score_key = ordered_bf16_key(
        reduced_score_bits[row_offset + context_index]);
    const uint32_t is_threshold = score_key == threshold_key ? 1U : 0U;
    scan_a[thread_index] = is_threshold;
    asc_syncthreads();

    __ubuf__ uint32_t* scan_source = scan_a;
    __ubuf__ uint32_t* scan_destination = scan_b;
    for (int32_t offset = 1; offset < kThreadsPerBlock; offset <<= 1) {
      uint32_t prefix_count = scan_source[thread_index];
      if (thread_index >= offset) {
        prefix_count += scan_source[thread_index - offset];
      }
      asc_syncthreads();
      scan_destination[thread_index] = prefix_count;
      asc_syncthreads();
      __ubuf__ uint32_t* old_source = scan_source;
      scan_source = scan_destination;
      scan_destination = old_source;
    }

    const uint32_t equal_seen = state[kStateEqualSeen];
    if (is_threshold != 0U) {
      const uint32_t equal_rank =
          equal_seen + scan_source[thread_index] - 1U;
      if (equal_rank < equal_count_needed) {
        const uint32_t candidate_slot = greater_count + equal_rank;
        candidate_scores[candidate_slot] = static_cast<float>(
            reduced_scores[row_offset + context_index]);
        candidate_indices[candidate_slot] = context_index;
      }
    }
    asc_syncthreads();
    if (thread_index == 0) {
      state[kStateEqualSeen] = equal_seen + scan_source[kThreadsPerBlock - 1];
    }
    asc_syncthreads();
  }

  for (uint32_t bitonic_size = 2U;
       bitonic_size <= kTopK;
       bitonic_size <<= 1U) {
    for (uint32_t stride = bitonic_size >> 1U; stride > 0U; stride >>= 1U) {
      for (uint32_t position = static_cast<uint32_t>(thread_index);
           position < static_cast<uint32_t>(kTopK);
           position += static_cast<uint32_t>(kThreadsPerBlock)) {
        const uint32_t partner = position ^ stride;
        if (partner <= position) {
          continue;
        }

        const float left_score = candidate_scores[position];
        const int32_t left_index = candidate_indices[position];
        const float right_score = candidate_scores[partner];
        const int32_t right_index = candidate_indices[partner];
        const bool better_first = (position & bitonic_size) == 0U;
        const bool swap = better_first
            ? candidate_is_better(
                  right_score, right_index, left_score, left_index)
            : candidate_is_better(
                  left_score, left_index, right_score, right_index);
        if (swap) {
          candidate_scores[position] = right_score;
          candidate_indices[position] = right_index;
          candidate_scores[partner] = left_score;
          candidate_indices[partner] = left_index;
        }
      }
      asc_syncthreads();
    }
  }

  for (int32_t rank = thread_index; rank < kTopK;
       rank += kThreadsPerBlock) {
    output[static_cast<int64_t>(row_index) * kTopK + rank] =
        candidate_indices[rank];
  }
  asc_syncthreads();
}

__simt_vf__ __launch_bounds__(kThreadsPerBlock) inline void
lightning_indexer_radix_topk_bfloat16_vf(
    __gm__ const bfloat16_t* reduced_scores,
    __gm__ const uint16_t* reduced_score_bits,
    __gm__ int32_t* output,
    int32_t row_count,
    __ubuf__ uint32_t* dynamic_start_ub) {
  for (int32_t row_index = static_cast<int32_t>(blockIdx.x);
       row_index < row_count;
       row_index += kPersistentBlockCount) {
    select_row_topk(
        reduced_scores,
        reduced_score_bits,
        output,
        row_index,
        dynamic_start_ub);
  }
}

__global__ __vector__ void lightning_indexer_radix_topk_bfloat16_kernel(
    __gm__ const uint16_t* reduced_scores,
    __gm__ int32_t* output,
    int32_t row_count) {
  extern __ubuf__ uint32_t dynamicStartUB[];
  asc_vf_call<lightning_indexer_radix_topk_bfloat16_vf>(
      dim3(kThreadsPerBlock, 1, 1),
      reinterpret_cast<__gm__ const bfloat16_t*>(reduced_scores),
      reduced_scores,
      output,
      row_count,
      dynamicStartUB);
}

} // namespace

extern "C" void launch_lightning_indexer_radix_topk_bfloat16_v2(
    const bfloat16_t* reduced_scores,
    int32_t* output,
    int32_t row_count,
    aclrtStream stream) {
  lightning_indexer_radix_topk_bfloat16_kernel
      <<<kPersistentBlockCount, kDynamicUbufBytes, stream>>>(
      reinterpret_cast<const uint16_t*>(reduced_scores),
      output,
      row_count);
}
