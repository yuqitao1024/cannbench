#include <cstdint>

#include "acl/acl.h"
#include "simt_api/asc_simt.h"

namespace {

constexpr int32_t kThreadsPerBlock = 1024;
constexpr int32_t kGridSize = 1;

__simt_vf__ __launch_bounds__(kThreadsPerBlock) inline void add_one_vf(
    __gm__ const int32_t* input,
    __gm__ int32_t* output,
    int32_t element_count) {
  for (int32_t index = static_cast<int32_t>(threadIdx.x); index < element_count;
       index += static_cast<int32_t>(blockDim.x)) {
    output[index] = input[index] + 1;
  }
}

__global__ __vector__ void add_one_kernel(
    __gm__ const int32_t* input,
    __gm__ int32_t* output,
    int32_t element_count) {
  asc_vf_call<add_one_vf>(
      dim3(kThreadsPerBlock, 1, 1), input, output, element_count);
}

} // namespace

extern "C" void launch_add_one_vf_repro(
    const int32_t* input,
    int32_t* output,
    int32_t element_count,
    aclrtStream stream) {
  add_one_kernel<<<kGridSize, 0, stream>>>(input, output, element_count);
}
