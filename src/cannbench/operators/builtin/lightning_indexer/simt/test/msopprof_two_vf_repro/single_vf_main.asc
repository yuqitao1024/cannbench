#include <array>
#include <cstdint>
#include <cstdlib>
#include <iostream>

#include "acl/acl.h"

namespace {

constexpr int32_t kDeviceId = 0;
constexpr int32_t kElementCount = 4;
constexpr std::array<int32_t, kElementCount> kInput = {3, 5, 7, 11};

#define CHECK_ACL(expr)                                                        \
  do {                                                                         \
    const aclError result = (expr);                                             \
    if (result != ACL_SUCCESS) {                                                \
      std::cerr << "ACL call failed: " #expr ", ret="                         \
                << static_cast<int32_t>(result) << std::endl;                   \
      std::exit(1);                                                             \
    }                                                                          \
  } while (0)

} // namespace

extern "C" void launch_copy_vf_repro(
    const int32_t* input,
    int32_t* output,
    int32_t element_count,
    aclrtStream stream);

int main() {
  constexpr size_t kBytes = kElementCount * sizeof(int32_t);
  std::array<int32_t, kElementCount> output = {};
  int32_t* input_device = nullptr;
  int32_t* output_device = nullptr;
  aclrtStream stream = nullptr;

  CHECK_ACL(aclInit(nullptr));
  CHECK_ACL(aclrtSetDevice(kDeviceId));
  CHECK_ACL(aclrtCreateStream(&stream));
  CHECK_ACL(aclrtMalloc(
      reinterpret_cast<void**>(&input_device), kBytes, ACL_MEM_MALLOC_HUGE_FIRST));
  CHECK_ACL(aclrtMalloc(
      reinterpret_cast<void**>(&output_device), kBytes, ACL_MEM_MALLOC_HUGE_FIRST));
  CHECK_ACL(aclrtMemcpy(
      input_device,
      kBytes,
      kInput.data(),
      kBytes,
      ACL_MEMCPY_HOST_TO_DEVICE));
  CHECK_ACL(aclrtMemset(output_device, kBytes, 0, kBytes));

  launch_copy_vf_repro(input_device, output_device, kElementCount, stream);
  const aclError sync_result = aclrtSynchronizeStream(stream);
  CHECK_ACL(aclrtMemcpy(
      output.data(),
      kBytes,
      output_device,
      kBytes,
      ACL_MEMCPY_DEVICE_TO_HOST));

  const bool valid = sync_result == ACL_SUCCESS && output == kInput;
  std::cout << "target=single_vf_control\n";
  std::cout << "layout=one-vector-vf-in-shared-library\n";
  std::cout << "sync_ret=" << static_cast<int32_t>(sync_result) << '\n';
  std::cout << "validation=" << (valid ? "pass" : "fail") << std::endl;

  CHECK_ACL(aclrtFree(output_device));
  CHECK_ACL(aclrtFree(input_device));
  CHECK_ACL(aclrtDestroyStream(stream));
  CHECK_ACL(aclrtResetDevice(kDeviceId));
  CHECK_ACL(aclFinalize());
  return valid ? 0 : 1;
}
