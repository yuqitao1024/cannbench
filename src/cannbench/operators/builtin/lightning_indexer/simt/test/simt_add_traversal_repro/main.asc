#include <cstdint>
#include <cstdlib>
#include <iostream>
#include <string>
#include <vector>

#include "acl/acl.h"
#include "simt_api/asc_simt.h"

namespace {

constexpr int32_t kDeviceId = 0;
constexpr uint32_t kGridDim = 64;
constexpr uint32_t kBlockDim = 2048;
constexpr uint32_t kElementsPerThread = 4;
constexpr uint32_t kElementsPerBlock = kBlockDim * kElementsPerThread;
constexpr uint32_t kTotalElements = kGridDim * kElementsPerBlock;

#if defined(ADD_TRAVERSAL_DIRECT_SIMT) && defined(ADD_TRAVERSAL_HYBRID)
#error "select exactly one add traversal execution model"
#endif
#if !defined(ADD_TRAVERSAL_DIRECT_SIMT) && !defined(ADD_TRAVERSAL_HYBRID)
#error "select exactly one add traversal execution model"
#endif

#if defined(ADD_TRAVERSAL_DIRECT_SIMT)
#define ADD_TRAVERSAL_DEVICE_FUNCTION(name) \
    __global__ __launch_bounds__(kBlockDim) void name##_kernel
#define ADD_TRAVERSAL_GM
constexpr const char* kExecutionModel = "direct-simt";
#else
#define ADD_TRAVERSAL_DEVICE_FUNCTION(name) \
    __simt_vf__ __launch_bounds__(kBlockDim) inline void name##_vf
#define ADD_TRAVERSAL_GM __gm__
constexpr const char* kExecutionModel = "hybrid";
#endif

#define CHECK_ACL(expr)                                                                                 \
    do {                                                                                                \
        const aclError result = (expr);                                                                 \
        if (result != ACL_SUCCESS) {                                                                    \
            std::cerr << "ACL call failed: " #expr ", ret=" << static_cast<int32_t>(result)            \
                      << std::endl;                                                                     \
            std::exit(1);                                                                               \
        }                                                                                               \
    } while (0)

ADD_TRAVERSAL_DEVICE_FUNCTION(add_global_stride)(
    ADD_TRAVERSAL_GM const float* input_x,
    ADD_TRAVERSAL_GM const float* input_y,
    ADD_TRAVERSAL_GM float* output)
{
    const uint32_t global_thread = blockIdx.x * blockDim.x + threadIdx.x;
    const uint32_t stride = gridDim.x * blockDim.x;
    for (uint32_t iteration = 0; iteration < kElementsPerThread; ++iteration) {
        const uint32_t index = global_thread + iteration * stride;
        output[index] = input_x[index] + input_y[index];
    }
}

ADD_TRAVERSAL_DEVICE_FUNCTION(add_global_stride_unrolled)(
    ADD_TRAVERSAL_GM const float* input_x,
    ADD_TRAVERSAL_GM const float* input_y,
    ADD_TRAVERSAL_GM float* output)
{
    const uint32_t global_thread = blockIdx.x * blockDim.x + threadIdx.x;
    const uint32_t stride = gridDim.x * blockDim.x;
    const uint32_t index0 = global_thread;
    const uint32_t index1 = index0 + stride;
    const uint32_t index2 = index1 + stride;
    const uint32_t index3 = index2 + stride;

    const float input_x0 = input_x[index0];
    const float input_x1 = input_x[index1];
    const float input_x2 = input_x[index2];
    const float input_x3 = input_x[index3];

    const float input_y0 = input_y[index0];
    const float input_y1 = input_y[index1];
    const float input_y2 = input_y[index2];
    const float input_y3 = input_y[index3];

    output[index0] = input_x0 + input_y0;
    output[index1] = input_x1 + input_y1;
    output[index2] = input_x2 + input_y2;
    output[index3] = input_x3 + input_y3;
}

ADD_TRAVERSAL_DEVICE_FUNCTION(add_block_contiguous)(
    ADD_TRAVERSAL_GM const float* input_x,
    ADD_TRAVERSAL_GM const float* input_y,
    ADD_TRAVERSAL_GM float* output)
{
    const uint32_t block_base = blockIdx.x * kElementsPerBlock;
    for (uint32_t iteration = 0; iteration < kElementsPerThread; ++iteration) {
        const uint32_t index = block_base + threadIdx.x + iteration * kBlockDim;
        output[index] = input_x[index] + input_y[index];
    }
}

ADD_TRAVERSAL_DEVICE_FUNCTION(add_block_contiguous_unrolled)(
    ADD_TRAVERSAL_GM const float* input_x,
    ADD_TRAVERSAL_GM const float* input_y,
    ADD_TRAVERSAL_GM float* output)
{
    const uint32_t block_base = blockIdx.x * kElementsPerBlock;
    const uint32_t index0 = block_base + threadIdx.x;
    const uint32_t index1 = index0 + kBlockDim;
    const uint32_t index2 = index1 + kBlockDim;
    const uint32_t index3 = index2 + kBlockDim;

    const float input_x0 = input_x[index0];
    const float input_x1 = input_x[index1];
    const float input_x2 = input_x[index2];
    const float input_x3 = input_x[index3];

    const float input_y0 = input_y[index0];
    const float input_y1 = input_y[index1];
    const float input_y2 = input_y[index2];
    const float input_y3 = input_y[index3];

    output[index0] = input_x0 + input_y0;
    output[index1] = input_x1 + input_y1;
    output[index2] = input_x2 + input_y2;
    output[index3] = input_x3 + input_y3;
}

#if defined(ADD_TRAVERSAL_HYBRID)
__global__ __vector__ void add_global_stride_kernel(
    __gm__ const float* input_x, __gm__ const float* input_y, __gm__ float* output)
{
    asc_vf_call<add_global_stride_vf>(dim3(kBlockDim, 1, 1), input_x, input_y, output);
}

__global__ __vector__ void add_global_stride_unrolled_kernel(
    __gm__ const float* input_x, __gm__ const float* input_y, __gm__ float* output)
{
    asc_vf_call<add_global_stride_unrolled_vf>(dim3(kBlockDim, 1, 1), input_x, input_y, output);
}

__global__ __vector__ void add_block_contiguous_kernel(
    __gm__ const float* input_x, __gm__ const float* input_y, __gm__ float* output)
{
    asc_vf_call<add_block_contiguous_vf>(dim3(kBlockDim, 1, 1), input_x, input_y, output);
}

__global__ __vector__ void add_block_contiguous_unrolled_kernel(
    __gm__ const float* input_x, __gm__ const float* input_y, __gm__ float* output)
{
    asc_vf_call<add_block_contiguous_unrolled_vf>(dim3(kBlockDim, 1, 1), input_x, input_y, output);
}
#endif

#if defined(ADD_TRAVERSAL_DIRECT_SIMT)
#define DEFINE_ADD_TRAVERSAL_LAUNCHER(name)                                                      \
    void launch_##name(const float* input_x, const float* input_y, float* output, aclrtStream stream) \
    {                                                                                            \
        name##_kernel<<<kGridDim, kBlockDim, 0, stream>>>(input_x, input_y, output);             \
    }
#else
#define DEFINE_ADD_TRAVERSAL_LAUNCHER(name)                                                      \
    void launch_##name(const float* input_x, const float* input_y, float* output, aclrtStream stream) \
    {                                                                                            \
        name##_kernel<<<kGridDim, 0, stream>>>(input_x, input_y, output);                        \
    }
#endif

DEFINE_ADD_TRAVERSAL_LAUNCHER(add_global_stride)
DEFINE_ADD_TRAVERSAL_LAUNCHER(add_global_stride_unrolled)
DEFINE_ADD_TRAVERSAL_LAUNCHER(add_block_contiguous)
DEFINE_ADD_TRAVERSAL_LAUNCHER(add_block_contiguous_unrolled)

#undef DEFINE_ADD_TRAVERSAL_LAUNCHER
#undef ADD_TRAVERSAL_DEVICE_FUNCTION
#undef ADD_TRAVERSAL_GM

} // namespace

int main(int argc, char* argv[])
{
    if (argc != 2) {
        std::cerr << "usage: " << argv[0]
                  << " <global-stride|global-stride-unrolled|block-contiguous|"
                     "block-contiguous-unrolled>"
                  << std::endl;
        return 2;
    }

    const std::string mode(argv[1]);
    if (mode != "global-stride" && mode != "global-stride-unrolled" &&
        mode != "block-contiguous" && mode != "block-contiguous-unrolled") {
        std::cerr << "unsupported mode: " << mode << std::endl;
        return 2;
    }

    constexpr size_t kBytes = static_cast<size_t>(kTotalElements) * sizeof(float);
    std::vector<float> input_x(kTotalElements);
    std::vector<float> input_y(kTotalElements);
    std::vector<float> output(kTotalElements, 0.0F);
    std::vector<float> golden(kTotalElements);
    for (uint32_t index = 0; index < kTotalElements; ++index) {
        input_x[index] = static_cast<float>(index % 1024U) * 0.25F;
        input_y[index] = static_cast<float>(index % 17U) * 0.5F;
        golden[index] = input_x[index] + input_y[index];
    }

    float* input_x_device = nullptr;
    float* input_y_device = nullptr;
    float* output_device = nullptr;
    aclrtStream stream = nullptr;

    CHECK_ACL(aclInit(nullptr));
    CHECK_ACL(aclrtSetDevice(kDeviceId));
    CHECK_ACL(aclrtCreateStream(&stream));
    CHECK_ACL(aclrtMalloc(reinterpret_cast<void**>(&input_x_device), kBytes, ACL_MEM_MALLOC_HUGE_FIRST));
    CHECK_ACL(aclrtMalloc(reinterpret_cast<void**>(&input_y_device), kBytes, ACL_MEM_MALLOC_HUGE_FIRST));
    CHECK_ACL(aclrtMalloc(reinterpret_cast<void**>(&output_device), kBytes, ACL_MEM_MALLOC_HUGE_FIRST));
    CHECK_ACL(aclrtMemcpy(input_x_device, kBytes, input_x.data(), kBytes, ACL_MEMCPY_HOST_TO_DEVICE));
    CHECK_ACL(aclrtMemcpy(input_y_device, kBytes, input_y.data(), kBytes, ACL_MEMCPY_HOST_TO_DEVICE));
    CHECK_ACL(aclrtMemset(output_device, kBytes, 0, kBytes));

    if (mode == "global-stride") {
        launch_add_global_stride(input_x_device, input_y_device, output_device, stream);
    } else if (mode == "global-stride-unrolled") {
        launch_add_global_stride_unrolled(input_x_device, input_y_device, output_device, stream);
    } else if (mode == "block-contiguous") {
        launch_add_block_contiguous(input_x_device, input_y_device, output_device, stream);
    } else {
        launch_add_block_contiguous_unrolled(input_x_device, input_y_device, output_device, stream);
    }

    CHECK_ACL(aclrtSynchronizeStream(stream));
    CHECK_ACL(aclrtMemcpy(output.data(), kBytes, output_device, kBytes, ACL_MEMCPY_DEVICE_TO_HOST));

    size_t mismatch_count = 0;
    for (size_t index = 0; index < output.size(); ++index) {
        if (output[index] != golden[index]) {
            if (mismatch_count == 0) {
                std::cout << "first_mismatch_index=" << index << '\n';
                std::cout << "first_mismatch_actual=" << output[index] << '\n';
                std::cout << "first_mismatch_expected=" << golden[index] << '\n';
            }
            ++mismatch_count;
        }
    }
    const bool valid = mismatch_count == 0;
    std::cout << "execution_model=" << kExecutionModel << '\n';
    std::cout << "mode=" << mode << '\n';
    std::cout << "grid_dim=" << kGridDim << '\n';
    std::cout << "block_dim=" << kBlockDim << '\n';
    std::cout << "elements=" << kTotalElements << '\n';
    std::cout << "mismatch_count=" << mismatch_count << '\n';
    std::cout << "validation=" << (valid ? "pass" : "fail") << std::endl;

    CHECK_ACL(aclrtFree(output_device));
    CHECK_ACL(aclrtFree(input_y_device));
    CHECK_ACL(aclrtFree(input_x_device));
    CHECK_ACL(aclrtDestroyStream(stream));
    CHECK_ACL(aclrtResetDevice(kDeviceId));
    CHECK_ACL(aclFinalize());
    return valid ? 0 : 1;
}
