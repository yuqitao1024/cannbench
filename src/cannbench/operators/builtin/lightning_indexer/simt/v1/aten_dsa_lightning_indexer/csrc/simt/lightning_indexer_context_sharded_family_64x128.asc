#include <cstdint>
#include <limits>

#include "acl/acl.h"
#include "basic_api/kernel_basic_intf.h"
#include "basic_api/kernel_operator_block_sync_intf.h"
#include "c_api/sync/sync.h"
#include "kernel_operator.h"
#include "simt_api/asc_bf16.h"
#include "simt_api/asc_simt.h"
#include "simt_api/device_sync_functions.h"
#include "tensor_api/tensor.h"

namespace {

using namespace AscendC::Te;

constexpr int32_t kQueryAtomSize = 2;
constexpr int32_t kHeadCount = 64;
constexpr int32_t kHeadDim = 128;
constexpr int32_t kContextCount = 32768;
constexpr int32_t kContextTileSize = 32;
constexpr int32_t kTopK = 2048;
constexpr int32_t kScoreTileSize = 2048;
constexpr int32_t kSortCapacity = 4096;
constexpr int32_t kThreadsPerBlock = 1024;
constexpr int32_t kDynamicUbufBytes =
    2 * kSortCapacity * sizeof(uint32_t);
constexpr uint16_t kScoreReadyFlag = 0;
constexpr int32_t kTopkInputLocalShard = 0;
constexpr int32_t kTopkInputRawRow = 1;
constexpr int32_t kTopkInputShardCandidates = 2;
constexpr int32_t kQueryAtomRows = kQueryAtomSize * kHeadCount;
constexpr uint32_t kMmadScoresEntries = kQueryAtomRows * kContextTileSize;
constexpr uint32_t kSharedScoresEntries = kHeadCount * kContextTileSize;
constexpr AscendC::FixpipeConfig kRowMajorUbFixpipeConfig = {
    AscendC::CO2Layout::ROW_MAJOR,
    true,
};

struct LightningIndexerContextShardedMmadTrait {
  using TraitType = MmadTrait;
  static constexpr const TraitType value =
      MmadTrait(0, false, false, false, MmadType::NORMAL);
};

__SIMT_DEVICE_FUNCTIONS_DECL__ inline float relu_float(float value) {
  return value > 0.0F ? value : 0.0F;
}

__simt_vf__ __launch_bounds__(kThreadsPerBlock) inline void
lightning_indexer_context_sharded_postprocess_vf(
    __ubuf__ const float* shared_scores,
    __gm__ const bfloat16_t* weights,
    __gm__ const int32_t* valid_context_lengths,
    __gm__ bfloat16_t* reduced_scores,
    int32_t row_index,
    int32_t tile_context_start) {
  const int64_t weight_base = static_cast<int64_t>(row_index) * kHeadCount;
  const int64_t output_base = static_cast<int64_t>(row_index) * kContextCount;

  for (int32_t tile_context_index = static_cast<int32_t>(threadIdx.x);
       tile_context_index < kContextTileSize;
       tile_context_index += static_cast<int32_t>(blockDim.x)) {
    const int32_t context_index = tile_context_start + tile_context_index;
    if (context_index >= valid_context_lengths[row_index]) {
      reduced_scores[output_base + context_index] = static_cast<bfloat16_t>(
          -std::numeric_limits<float>::infinity());
      continue;
    }

    float reduced_score = 0.0F;
    for (int32_t head_index = 0; head_index < kHeadCount; ++head_index) {
      const bfloat16_t dot_bf16 = static_cast<bfloat16_t>(
          shared_scores[head_index * kContextTileSize + tile_context_index]);
      const bfloat16_t relu_bf16 =
          static_cast<bfloat16_t>(relu_float(static_cast<float>(dot_bf16)));
      const bfloat16_t weighted_bf16 = static_cast<bfloat16_t>(
          static_cast<float>(relu_bf16) *
          static_cast<float>(weights[weight_base + head_index]));
      reduced_score += static_cast<float>(weighted_bf16);
    }
    reduced_scores[output_base + context_index] =
        static_cast<bfloat16_t>(reduced_score);
  }
}

__SIMT_DEVICE_FUNCTIONS_DECL__ inline bool topk_candidate_is_better(
    float candidate_score,
    int32_t candidate_index,
    float other_score,
    int32_t other_index) {
  return candidate_score > other_score ||
      (candidate_score == other_score && candidate_index < other_index);
}

__simt_vf__ __launch_bounds__(kThreadsPerBlock) inline void
lightning_indexer_context_sharded_topk_vf(
    __gm__ bfloat16_t* reduced_scores,
    __gm__ int32_t* shard_candidate_indices,
    __gm__ int32_t* output,
    __ubuf__ uint32_t* dynamic_start_ub,
    int32_t row_index,
    int32_t shard_index,
    int32_t shard_size,
    int32_t context_shard_count,
    int32_t input_count,
    int32_t input_mode,
    int32_t write_output) {
  __ubuf__ float* candidate_scores =
      reinterpret_cast<__ubuf__ float*>(dynamic_start_ub);
  __ubuf__ int32_t* candidate_indices = reinterpret_cast<__ubuf__ int32_t*>(
      candidate_scores + kSortCapacity);
  const int32_t thread_index = static_cast<int32_t>(threadIdx.x);
  const int64_t row_score_base =
      static_cast<int64_t>(row_index) * kContextCount;

  for (int32_t rank = thread_index; rank < kTopK;
       rank += kThreadsPerBlock) {
    candidate_scores[rank] = -std::numeric_limits<float>::infinity();
    candidate_indices[rank] = std::numeric_limits<int32_t>::max();
  }
  asc_syncthreads();

  for (int32_t tile_start = 0; tile_start < input_count;
       tile_start += kScoreTileSize) {
    for (int32_t tile_index = thread_index; tile_index < kScoreTileSize;
         tile_index += kThreadsPerBlock) {
      const int32_t input_index = tile_start + tile_index;
      const int32_t candidate_slot = kTopK + tile_index;
      if (input_index >= input_count) {
        candidate_scores[candidate_slot] =
            -std::numeric_limits<float>::infinity();
        candidate_indices[candidate_slot] =
            std::numeric_limits<int32_t>::max();
        continue;
      }

      int64_t score_offset = 0;
      int32_t global_context_index = 0;
      if (input_mode == kTopkInputLocalShard) {
        global_context_index = shard_index * shard_size + input_index;
        score_offset = row_score_base + global_context_index;
      } else if (input_mode == kTopkInputRawRow) {
        global_context_index = input_index;
        score_offset = row_score_base + input_index;
      } else {
        const int32_t candidate_shard = input_index / kTopK;
        const int32_t candidate_rank = input_index % kTopK;
        score_offset = row_score_base +
            static_cast<int64_t>(candidate_shard) * shard_size +
            candidate_rank;
        const int64_t candidate_index_offset =
            (static_cast<int64_t>(row_index) * context_shard_count +
             candidate_shard) *
                kTopK +
            candidate_rank;
        global_context_index =
            shard_candidate_indices[candidate_index_offset];
      }
      candidate_scores[candidate_slot] =
          static_cast<float>(reduced_scores[score_offset]);
      candidate_indices[candidate_slot] = global_context_index;
    }
    asc_syncthreads();

    for (uint32_t bitonic_size = 2U; bitonic_size <= kSortCapacity;
         bitonic_size <<= 1U) {
      for (uint32_t stride = bitonic_size >> 1U; stride > 0U;
           stride >>= 1U) {
        for (uint32_t position = static_cast<uint32_t>(thread_index);
             position < static_cast<uint32_t>(kSortCapacity);
             position += static_cast<uint32_t>(kThreadsPerBlock)) {
          const uint32_t partner = position ^ stride;
          if (partner <= position) {
            continue;
          }

          const float left_score = candidate_scores[position];
          const int32_t left_index = candidate_indices[position];
          const float right_score = candidate_scores[partner];
          const int32_t right_index = candidate_indices[partner];
          const bool better_first = (position & bitonic_size) == 0U;
          const bool swap = better_first
              ? topk_candidate_is_better(
                    right_score, right_index, left_score, left_index)
              : topk_candidate_is_better(
                    left_score, left_index, right_score, right_index);
          if (swap) {
            candidate_scores[position] = right_score;
            candidate_indices[position] = right_index;
            candidate_scores[partner] = left_score;
            candidate_indices[partner] = left_index;
          }
        }
        asc_syncthreads();
      }
    }
  }

  for (int32_t rank = thread_index; rank < kTopK;
       rank += kThreadsPerBlock) {
    if (write_output != 0) {
      output[static_cast<int64_t>(row_index) * kTopK + rank] =
          candidate_indices[rank];
      continue;
    }
    const int64_t local_score_offset = row_score_base +
        static_cast<int64_t>(shard_index) * shard_size + rank;
    const int64_t local_index_offset =
        (static_cast<int64_t>(row_index) * context_shard_count + shard_index) *
            kTopK +
        rank;
    reduced_scores[local_score_offset] =
        static_cast<bfloat16_t>(candidate_scores[rank]);
    shard_candidate_indices[local_index_offset] = candidate_indices[rank];
  }
}

__aicore__ inline void lightning_indexer_context_sharded_aic(
    __gm__ bfloat16_t* query,
    __gm__ bfloat16_t* keys,
    int32_t query_count,
    int32_t context_shard_count,
    int32_t mixed_task_count) {
  AscendC::InitSocState();
  const int32_t task_id = static_cast<int32_t>(AscendC::GetBlockIdx());
  if (task_id >= mixed_task_count) {
    return;
  }
  const int32_t query_atom_count = (query_count + kQueryAtomSize - 1) / kQueryAtomSize;
  const int32_t base_task_index = task_id / context_shard_count;
  const int32_t batch_index = base_task_index / query_atom_count;
  const int32_t atom_index = base_task_index % query_atom_count;
  const int32_t shard_index = task_id % context_shard_count;
  const int32_t shard_size = kContextCount / context_shard_count;
  const int32_t context_start = shard_index * shard_size;
  const int32_t first_query_index = atom_index * kQueryAtomSize;
  const int32_t second_query_index = first_query_index + 1;
  const int32_t atom_query_rows = second_query_index < query_count
      ? kQueryAtomRows
      : kHeadCount;

  __cbuf__ bfloat16_t l1_query_buf[kQueryAtomRows * kHeadDim];
  __cbuf__ bfloat16_t l1_keys_buf[kHeadDim * kContextTileSize];
  __ca__ bfloat16_t l0_query_buf[kQueryAtomRows * kHeadDim];
  __cb__ bfloat16_t l0_keys_buf[kHeadDim * kContextTileSize];
  __cc__ float l0_scores_buf[kQueryAtomRows * kContextTileSize];

  AscendC::LocalTensor<float> l0_scores_tensor(
      AscendC::TPosition::CO1, 0, kMmadScoresEntries);
  AscendC::LocalTensor<float> shared_scores_tensor(
      AscendC::TPosition::LCM, 0, kSharedScoresEntries);

  auto copy_gm_to_l1 = MakeCopy(CopyGM2L1{}, CopyGM2L1TraitDefault{});
  auto copy_l1_to_l0a = MakeCopy(CopyL12L0A{}, CopyL12L0ATraitDefault{});
  auto copy_l1_to_l0b = MakeCopy(CopyL12L0B{}, CopyL12L0BTraitDefault{});
  auto mm = MakeMmad(MmadOperation{}, LightningIndexerContextShardedMmadTrait{});
  AscendC::SetFlag<AscendC::HardEvent::M_MTE1>(EVENT_ID0);
  AscendC::SetFlag<AscendC::HardEvent::MTE1_MTE2>(EVENT_ID0);
  AscendC::SetFlag<AscendC::HardEvent::FIX_M>(EVENT_ID0);

  auto l0_query = MakeTensor(
      MakeMemPtr(l0_query_buf),
      MakeFrameLayout<NZLayoutPtn, bfloat16_t>(atom_query_rows, kHeadDim));
  auto l1_query = MakeTensor(
      MakeMemPtr(l1_query_buf),
      MakeFrameLayout<NZLayoutPtn, bfloat16_t>(atom_query_rows, kHeadDim));
  auto gm_query = MakeTensor(
      MakeMemPtr(
          query +
          (static_cast<int64_t>(batch_index) * query_count +
           first_query_index) *
              kHeadCount * kHeadDim),
      MakeFrameLayout<NDExtLayoutPtn>(atom_query_rows, kHeadDim));

  AscendC::WaitFlag<AscendC::HardEvent::MTE1_MTE2>(EVENT_ID0);
  Copy(copy_gm_to_l1, l1_query, gm_query);
  AscendC::SetFlag<AscendC::HardEvent::MTE2_MTE1>(EVENT_ID0);
  AscendC::WaitFlag<AscendC::HardEvent::MTE2_MTE1>(EVENT_ID0);
  AscendC::WaitFlag<AscendC::HardEvent::M_MTE1>(EVENT_ID0);
  Copy(copy_l1_to_l0a, l0_query, l1_query);
  AscendC::SetFlag<AscendC::HardEvent::MTE1_MTE2>(EVENT_ID0);
  AscendC::SetFlag<AscendC::HardEvent::MTE1_M>(EVENT_ID0);
  AscendC::WaitFlag<AscendC::HardEvent::MTE1_M>(EVENT_ID0);

  for (int32_t tile_context_start = context_start;
       tile_context_start < context_start + shard_size;
       tile_context_start += kContextTileSize) {
    auto l1_keys = MakeTensor(
        MakeMemPtr(l1_keys_buf),
        MakeFrameLayout<ZNLayoutPtn, bfloat16_t>(kHeadDim, kContextTileSize));
    auto l0_keys = MakeTensor(
        MakeMemPtr(l0_keys_buf),
        MakeFrameLayout<ZNLayoutPtn, bfloat16_t>(kHeadDim, kContextTileSize));
    auto l0_scores = MakeTensor(
        MakeMemPtr(l0_scores_buf),
        MakeFrameLayout<NZLayoutPtn>(atom_query_rows, kContextTileSize));
    auto gm_keys = MakeTensor(
        MakeMemPtr(
            keys + static_cast<int64_t>(batch_index) * kContextCount * kHeadDim +
            static_cast<int64_t>(tile_context_start) * kHeadDim),
        MakeFrameLayout<DNExtLayoutPtn>(kHeadDim, kContextTileSize));

    AscendC::WaitFlag<AscendC::HardEvent::MTE1_MTE2>(EVENT_ID0);
    Copy(copy_gm_to_l1, l1_keys, gm_keys);
    AscendC::SetFlag<AscendC::HardEvent::MTE2_MTE1>(EVENT_ID1);
    AscendC::WaitFlag<AscendC::HardEvent::MTE2_MTE1>(EVENT_ID1);
    if (tile_context_start != context_start) {
      AscendC::WaitFlag<AscendC::HardEvent::M_MTE1>(EVENT_ID0);
    }
    Copy(copy_l1_to_l0b, l0_keys, l1_keys);
    AscendC::SetFlag<AscendC::HardEvent::MTE1_MTE2>(EVENT_ID0);
    AscendC::SetFlag<AscendC::HardEvent::MTE1_M>(EVENT_ID1);
    AscendC::WaitFlag<AscendC::HardEvent::MTE1_M>(EVENT_ID1);

    MmadParams params;
    params.m = atom_query_rows;
    params.n = kContextTileSize;
    params.k = kHeadDim;
    params.unitFlag = 0;
    params.cmatrixInitVal = true;
    AscendC::WaitFlag<AscendC::HardEvent::FIX_M>(EVENT_ID0);
    Mmad(mm.with(params), l0_scores, l0_query, l0_keys);
    AscendC::SetFlag<AscendC::HardEvent::M_MTE1>(EVENT_ID0);
    AscendC::SetFlag<AscendC::HardEvent::M_FIX>(EVENT_ID0);
    AscendC::WaitFlag<AscendC::HardEvent::M_FIX>(EVENT_ID0);

    asc_sync_block_wait(PIPE_S, kScoreReadyFlag);
    AscendC::FixpipeParamsC310<AscendC::CO2Layout::ROW_MAJOR> fixpipe_params;
    fixpipe_params.nSize = kContextTileSize;
    fixpipe_params.mSize = atom_query_rows;
    fixpipe_params.srcStride = atom_query_rows;
    fixpipe_params.dstStride = kContextTileSize;
    fixpipe_params.dualDstCtl = atom_query_rows == kQueryAtomRows ? 1 : 0;
    fixpipe_params.subBlockId = false;
    fixpipe_params.unitFlag = 0;
    AscendC::Fixpipe<float, float, kRowMajorUbFixpipeConfig>(
        shared_scores_tensor, l0_scores_tensor, fixpipe_params);
    AscendC::SetFlag<AscendC::HardEvent::FIX_M>(EVENT_ID0);
    asc_sync_block_arrive(PIPE_FIX, kScoreReadyFlag);
  }

  AscendC::WaitFlag<AscendC::HardEvent::M_MTE1>(EVENT_ID0);
  AscendC::WaitFlag<AscendC::HardEvent::MTE1_MTE2>(EVENT_ID0);
  AscendC::WaitFlag<AscendC::HardEvent::FIX_M>(EVENT_ID0);
  AscendC::PipeBarrier<PIPE_ALL>();
}

__aicore__ inline void lightning_indexer_context_sharded_aiv(
    __gm__ const bfloat16_t* weights,
    __gm__ const int32_t* valid_context_lengths,
    __gm__ bfloat16_t* reduced_scores,
    __gm__ int32_t* shard_candidate_indices,
    __gm__ int32_t* output,
    int32_t query_count,
    int32_t context_shard_count,
    int32_t mixed_task_count) {
  AscendC::InitSocState();
  const int32_t task_id = static_cast<int32_t>(
      AscendC::GetBlockIdx() / AscendC::GetTaskRatio());
  if (task_id >= mixed_task_count) {
    return;
  }
  const int32_t query_atom_count = (query_count + kQueryAtomSize - 1) / kQueryAtomSize;
  const int32_t base_task_index = task_id / context_shard_count;
  const int32_t batch_index = base_task_index / query_atom_count;
  const int32_t atom_index = base_task_index % query_atom_count;
  const int32_t shard_index = task_id % context_shard_count;
  const int32_t shard_size = kContextCount / context_shard_count;
  const int32_t context_start = shard_index * shard_size;
  const int32_t query_in_atom = static_cast<int32_t>(AscendC::GetSubBlockIdx());
  const int32_t query_index = atom_index * kQueryAtomSize + query_in_atom;
  const bool valid_query = query_index < query_count;
  const int32_t row_index = batch_index * query_count + query_index;
  const bool needs_local_topk = shard_size > kTopK;

  AscendC::LocalTensor<float> shared_scores_tensor(
      AscendC::TPosition::LCM, 0, kSharedScoresEntries);
  __ubuf__ const float* shared_scores =
      reinterpret_cast<__ubuf__ const float*>(shared_scores_tensor.GetPhyAddr());
  extern __ubuf__ uint32_t dynamicStartUB[];

  for (int32_t tile_context_start = context_start;
       tile_context_start < context_start + shard_size;
       tile_context_start += kContextTileSize) {
    asc_sync_block_arrive(PIPE_V, kScoreReadyFlag);
    asc_sync_block_wait(PIPE_S, kScoreReadyFlag);
    if (valid_query) {
      asc_vf_call<lightning_indexer_context_sharded_postprocess_vf>(
          dim3(kThreadsPerBlock, 1, 1),
          shared_scores,
          weights,
          valid_context_lengths,
          reduced_scores,
          row_index,
          tile_context_start);
    }
  }

  if (valid_query && needs_local_topk) {
    asc_sync_vec();
    asc_sync_data_barrier(mem_dsb_t::DSB_DDR);
    asc_vf_call<lightning_indexer_context_sharded_topk_vf>(
        dim3(kThreadsPerBlock, 1, 1),
        reduced_scores,
        shard_candidate_indices,
        output,
        dynamicStartUB,
        row_index,
        shard_index,
        shard_size,
        context_shard_count,
        shard_size,
        kTopkInputLocalShard,
        context_shard_count == 1 ? 1 : 0);
  }

  if (context_shard_count > 1) {
    asc_sync_inter_arrive(PIPE_V, kScoreReadyFlag);
    asc_sync_inter_wait(PIPE_S, kScoreReadyFlag);
  }

  if (valid_query && shard_index == 0 && context_shard_count > 1) {
    const int32_t per_shard_candidate_count = shard_size < kTopK ? shard_size : kTopK;
    const int32_t final_candidate_count = context_shard_count * per_shard_candidate_count;
    const bool raw_score_candidates = shard_size == kTopK;
    asc_vf_call<lightning_indexer_context_sharded_topk_vf>(
        dim3(kThreadsPerBlock, 1, 1),
        reduced_scores,
        shard_candidate_indices,
        output,
        dynamicStartUB,
        row_index,
        shard_index,
        shard_size,
        context_shard_count,
        final_candidate_count,
        raw_score_candidates ? kTopkInputRawRow : kTopkInputShardCandidates,
        1);
  }
}

__global__ __aicore__ __schedmode__(1) void
lightning_indexer_context_sharded_family_64x128_kernel(
    __gm__ const uint16_t* query,
    __gm__ const uint16_t* keys,
    __gm__ const uint16_t* weights,
    __gm__ const int32_t* valid_context_lengths,
    __gm__ uint16_t* reduced_scores,
    __gm__ int32_t* candidate_indices,
    __gm__ int32_t* output,
    __kfc_workspace__ __gm__ uint8_t* workspace,
    int32_t query_count,
    int32_t context_shard_count,
    int32_t mixed_task_count) {
  (void)workspace;
  (void)candidate_indices;
  (void)output;
  KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_MIX_AIC_1_2);
  if ASCEND_IS_AIC {
    lightning_indexer_context_sharded_aic(
        reinterpret_cast<__gm__ bfloat16_t*>(
            const_cast<__gm__ uint16_t*>(query)),
        reinterpret_cast<__gm__ bfloat16_t*>(
            const_cast<__gm__ uint16_t*>(keys)),
        query_count,
        context_shard_count,
        mixed_task_count);
  } else if ASCEND_IS_AIV {
    lightning_indexer_context_sharded_aiv(
        reinterpret_cast<__gm__ const bfloat16_t*>(weights),
        valid_context_lengths,
        reinterpret_cast<__gm__ bfloat16_t*>(reduced_scores),
        candidate_indices,
        output,
        query_count,
        context_shard_count,
        mixed_task_count);
  }
}

} // namespace

extern "C" void launch_lightning_indexer_context_sharded_family_64x128_bfloat16(
    const bfloat16_t* query,
    const bfloat16_t* keys,
    const bfloat16_t* weights,
    const int32_t* valid_context_lengths,
    bfloat16_t* reduced_scores,
    int32_t* candidate_indices,
    int32_t* output,
    int64_t batch_size,
    int64_t query_count,
    int32_t context_shard_count,
    int32_t mixed_task_count,
    aclrtStream stream) {
  (void)batch_size;
  lightning_indexer_context_sharded_family_64x128_kernel
      <<<mixed_task_count, kDynamicUbufBytes, stream>>>(
      reinterpret_cast<const uint16_t*>(query),
      reinterpret_cast<const uint16_t*>(keys),
      reinterpret_cast<const uint16_t*>(weights),
      valid_context_lengths,
      reinterpret_cast<uint16_t*>(reduced_scores),
      candidate_indices,
      output,
      reinterpret_cast<uint8_t*>(reduced_scores),
      static_cast<int32_t>(query_count),
      context_shard_count,
      mixed_task_count);
}
