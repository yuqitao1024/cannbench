#include <cstdint>
#include <limits>

#include "c_api/asc_simd.h"
#include "simt_api/asc_fp16.h"
#include "simt_api/asc_simt.h"

namespace aten_softmax_v3 {
namespace persistent_256_detail {

template <typename T>
struct Add {
  __simt_callee__ inline T operator()(T a, T b) const {
    return a + b;
  }
};

template <typename T>
struct Max {
  __simt_callee__ inline T operator()(T a, T b) const {
    return a < b ? b : a;
  }
};

template <typename T, template <typename> class ReduceOp>
__simt_callee__ inline T warp_reduce(T value) {
  ReduceOp<T> reduce_op;
#pragma unroll
  for (int64_t offset = 16; offset > 0; offset /= 2) {
    const T peer = asc_shfl_xor(value, static_cast<int32_t>(offset), 32);
    value = reduce_op(value, peer);
  }
  return value;
}

template <typename scalar_t, typename accscalar_t, typename outscalar_t>
__simt_vf__ __launch_bounds__(1024) inline void
row_softmax_persistent_exact_256_vf(
    __ubuf__ outscalar_t* output_ub,
    __ubuf__ const scalar_t* input_ub,
    int64_t row_count) {
  constexpr int32_t kElements = 256;
  constexpr int32_t kBlockX = 32;
  constexpr int32_t kWarpIterations = 8;
  const int32_t row_in_tile = threadIdx.x / kBlockX;
  const int32_t lane = threadIdx.x % kBlockX;
  if (row_in_tile >= row_count) {
    return;
  }

  const int32_t row_offset = row_in_tile * kElements;
  accscalar_t elements[kWarpIterations];

#pragma unroll
  for (int32_t iter = 0; iter < kWarpIterations; ++iter) {
    const int32_t element_index = lane + iter * kBlockX;
    elements[iter] =
        static_cast<accscalar_t>(input_ub[row_offset + element_index]);
  }

  accscalar_t max_value = elements[0];
#pragma unroll
  for (int32_t iter = 1; iter < kWarpIterations; ++iter) {
    max_value = Max<accscalar_t>()(max_value, elements[iter]);
  }
  max_value = warp_reduce<accscalar_t, Max>(max_value);

  accscalar_t sum_value = 0;
#pragma unroll
  for (int32_t iter = 0; iter < kWarpIterations; ++iter) {
    elements[iter] = __expf(elements[iter] - max_value);
    sum_value += elements[iter];
  }
  sum_value = warp_reduce<accscalar_t, Add>(sum_value);

#pragma unroll
  for (int32_t iter = 0; iter < kWarpIterations; ++iter) {
    const int32_t element_index = lane + iter * kBlockX;
    output_ub[row_offset + element_index] =
        static_cast<outscalar_t>(elements[iter] / sum_value);
  }
}

template <
    typename scalar_t,
    typename accscalar_t,
    typename outscalar_t,
    int64_t kMaxElements>
__simt_vf__ __launch_bounds__(1024) inline void row_softmax_persistent_256_vf(
    __ubuf__ outscalar_t* output_ub,
    __ubuf__ const scalar_t* input_ub,
    int64_t row_count,
    int64_t dim_size) {
  constexpr int64_t kBlockX = 32;
  constexpr int64_t kWarpIterations = kMaxElements / kBlockX;
  const int64_t row_in_tile = threadIdx.x / kBlockX;
  const int64_t lane = threadIdx.x % kBlockX;
  if (row_in_tile >= row_count) {
    return;
  }

  const int64_t row_offset = row_in_tile * dim_size;
  accscalar_t elements[kWarpIterations];

#pragma unroll
  for (int64_t iter = 0; iter < kWarpIterations; ++iter) {
    const int64_t element_index = lane + iter * kBlockX;
    elements[iter] = element_index < dim_size
        ? static_cast<accscalar_t>(input_ub[row_offset + element_index])
        : std::numeric_limits<accscalar_t>::lowest();
  }

  accscalar_t max_value = elements[0];
#pragma unroll
  for (int64_t iter = 1; iter < kWarpIterations; ++iter) {
    max_value = Max<accscalar_t>()(max_value, elements[iter]);
  }
  max_value = warp_reduce<accscalar_t, Max>(max_value);

  accscalar_t sum_value = 0;
#pragma unroll
  for (int64_t iter = 0; iter < kWarpIterations; ++iter) {
    const int64_t element_index = lane + iter * kBlockX;
    if (element_index < dim_size) {
      elements[iter] = __expf(elements[iter] - max_value);
      sum_value += elements[iter];
    } else {
      elements[iter] = 0;
    }
  }
  sum_value = warp_reduce<accscalar_t, Add>(sum_value);

#pragma unroll
  for (int64_t iter = 0; iter < kWarpIterations; ++iter) {
    const int64_t element_index = lane + iter * kBlockX;
    if (element_index < dim_size) {
      output_ub[row_offset + element_index] =
          static_cast<outscalar_t>(elements[iter] / sum_value);
    }
  }
}

template <typename scalar_t>
__aicore__ inline __gm__ scalar_t* mutable_gm_ptr(__gm__ const scalar_t* ptr) {
  return const_cast<__gm__ scalar_t*>(ptr);
}

template <
    typename scalar_t,
    typename accscalar_t,
    typename outscalar_t,
    int64_t kMaxElements,
    bool kExactWidth>
__aicore__ inline void row_softmax_persistent_256_pipeline_impl(
    __gm__ outscalar_t* output,
    __gm__ const scalar_t* input,
    int64_t outer_size,
    int64_t dim_size) {
  asc_init();
  constexpr int64_t kThreadsPerBlock = 1024;
  constexpr int64_t kRowsPerTile = kThreadsPerBlock / 32;
  const int64_t row_elements = kExactWidth ? kMaxElements : dim_size;
  __ubuf__ scalar_t input_tile_ub[2][kRowsPerTile * kMaxElements];
  __ubuf__ outscalar_t output_tile_ub[2][kRowsPerTile * kMaxElements];

  const int64_t tile_stride = gridDim.x * kRowsPerTile;
  const int64_t first_row_base = blockIdx.x * kRowsPerTile;
  if (first_row_base >= outer_size) {
    return;
  }
  const int64_t tile_count =
      ((outer_size - first_row_base) + tile_stride - 1) / tile_stride;

  asc_sync_notify(PIPE_V, PIPE_MTE2, EVENT_ID0);
  asc_sync_notify(PIPE_V, PIPE_MTE2, EVENT_ID1);
  asc_sync_notify(PIPE_MTE3, PIPE_V, EVENT_ID0);
  asc_sync_notify(PIPE_MTE3, PIPE_V, EVENT_ID1);

  const int64_t first_rows_remaining = outer_size - first_row_base;
  const int64_t first_row_count = first_rows_remaining >= kRowsPerTile
      ? kRowsPerTile
      : first_rows_remaining;
  const uint32_t first_input_bytes = static_cast<uint32_t>(
      first_row_count * row_elements * sizeof(scalar_t));
  asc_sync_wait(PIPE_V, PIPE_MTE2, EVENT_ID0);
  asc_copy_gm2ub_align(
      input_tile_ub[0],
      mutable_gm_ptr(input + first_row_base * row_elements),
      first_input_bytes);
  asc_sync_notify(PIPE_MTE2, PIPE_V, EVENT_ID0);

  for (int64_t tile_idx = 0; tile_idx < tile_count; ++tile_idx) {
    const int64_t slot = tile_idx & 1;
    const int32_t event_id = slot == 0 ? EVENT_ID0 : EVENT_ID1;
    const int64_t row_base = first_row_base + tile_idx * tile_stride;
    const int64_t rows_remaining = outer_size - row_base;
    const int64_t row_count = rows_remaining >= kRowsPerTile
        ? kRowsPerTile
        : rows_remaining;

    asc_sync_wait(PIPE_MTE2, PIPE_V, event_id);
    if (tile_idx + 1 < tile_count) {
      const int64_t next_slot = slot ^ 1;
      const int32_t next_event_id =
          next_slot == 0 ? EVENT_ID0 : EVENT_ID1;
      const int64_t next_row_base = row_base + tile_stride;
      const int64_t next_rows_remaining = outer_size - next_row_base;
      const int64_t next_row_count = next_rows_remaining >= kRowsPerTile
          ? kRowsPerTile
          : next_rows_remaining;
      const uint32_t next_input_bytes = static_cast<uint32_t>(
          next_row_count * row_elements * sizeof(scalar_t));

      asc_sync_wait(PIPE_V, PIPE_MTE2, next_event_id);
      asc_copy_gm2ub_align(
          input_tile_ub[next_slot],
          mutable_gm_ptr(input + next_row_base * row_elements),
          next_input_bytes);
      asc_sync_notify(PIPE_MTE2, PIPE_V, next_event_id);
    }

    asc_sync_wait(PIPE_MTE3, PIPE_V, event_id);
    if constexpr (kExactWidth) {
      asc_vf_call<row_softmax_persistent_exact_256_vf<
          scalar_t,
          accscalar_t,
          outscalar_t>>(
          dim3(kThreadsPerBlock),
          output_tile_ub[slot],
          input_tile_ub[slot],
          row_count);
    } else {
      asc_vf_call<row_softmax_persistent_256_vf<
          scalar_t,
          accscalar_t,
          outscalar_t,
          kMaxElements>>(
          dim3(kThreadsPerBlock),
          output_tile_ub[slot],
          input_tile_ub[slot],
          row_count,
          dim_size);
    }
    asc_sync_notify(PIPE_V, PIPE_MTE2, event_id);

    asc_sync_notify(PIPE_V, PIPE_MTE3, event_id);
    asc_sync_wait(PIPE_V, PIPE_MTE3, event_id);
    asc_copy_ub2gm_align(
        output + row_base * row_elements,
        output_tile_ub[slot],
        static_cast<uint32_t>(row_count * row_elements * sizeof(outscalar_t)));
    asc_sync_notify(PIPE_MTE3, PIPE_V, event_id);
  }

  asc_sync_wait(PIPE_V, PIPE_MTE2, EVENT_ID0);
  asc_sync_wait(PIPE_V, PIPE_MTE2, EVENT_ID1);
  asc_sync_wait(PIPE_MTE3, PIPE_V, EVENT_ID0);
  asc_sync_wait(PIPE_MTE3, PIPE_V, EVENT_ID1);
}

template <
    typename scalar_t,
    typename accscalar_t,
    typename outscalar_t,
    int64_t kMaxElements>
__global__ __vector__ void row_softmax_persistent_256_pipeline_kernel(
    __gm__ outscalar_t* output,
    __gm__ const scalar_t* input,
    int64_t outer_size,
    int64_t dim_size) {
  row_softmax_persistent_256_pipeline_impl<
      scalar_t,
      accscalar_t,
      outscalar_t,
      kMaxElements,
      false>(output, input, outer_size, dim_size);
}

template <typename scalar_t, typename accscalar_t, typename outscalar_t>
__global__ __vector__ void row_softmax_persistent_exact_256_pipeline_kernel(
    __gm__ outscalar_t* output,
    __gm__ const scalar_t* input,
    int64_t outer_size) {
  row_softmax_persistent_256_pipeline_impl<
      scalar_t,
      accscalar_t,
      outscalar_t,
      256,
      true>(output, input, outer_size, 256);
}

template <typename scalar_t, typename accscalar_t, typename outscalar_t>
void dispatch_row_persistent_forward_kernel_256(
    const scalar_t* input_ptr,
    outscalar_t* output_ptr,
    int64_t outer_size,
    int64_t dim_size,
    int64_t grid_x,
    void* acl_stream) {
  constexpr int64_t kMaxElements = 256;
  row_softmax_persistent_256_pipeline_kernel<
      scalar_t,
      accscalar_t,
      outscalar_t,
      kMaxElements>
      <<<grid_x, 0, acl_stream>>>(
          output_ptr,
          input_ptr,
          outer_size,
          dim_size);
}

template <typename scalar_t, typename accscalar_t, typename outscalar_t>
void dispatch_row_persistent_forward_kernel_exact_256(
    const scalar_t* input_ptr,
    outscalar_t* output_ptr,
    int64_t outer_size,
    int64_t grid_x,
    void* acl_stream) {
  row_softmax_persistent_exact_256_pipeline_kernel<
      scalar_t,
      accscalar_t,
      outscalar_t>
      <<<grid_x, 0, acl_stream>>>(output_ptr, input_ptr, outer_size);
}

} // namespace persistent_256_detail

void dispatch_row_persistent_forward_kernel_exact_256_fp16(
    const __fp16* input_ptr,
    __fp16* output_ptr,
    int64_t outer_size,
    int64_t grid_x,
    void* acl_stream) {
  persistent_256_detail::dispatch_row_persistent_forward_kernel_exact_256<
      __fp16,
      float,
      __fp16>(input_ptr, output_ptr, outer_size, grid_x, acl_stream);
}

void dispatch_row_persistent_forward_kernel_exact_256_fp32(
    const float* input_ptr,
    float* output_ptr,
    int64_t outer_size,
    int64_t grid_x,
    void* acl_stream) {
  persistent_256_detail::dispatch_row_persistent_forward_kernel_exact_256<
      float,
      float,
      float>(input_ptr, output_ptr, outer_size, grid_x, acl_stream);
}

void dispatch_row_persistent_forward_kernel_256_fp16(
    const __fp16* input_ptr,
    __fp16* output_ptr,
    int64_t outer_size,
    int64_t dim_size,
    int64_t grid_x,
    void* acl_stream) {
  persistent_256_detail::dispatch_row_persistent_forward_kernel_256<
      __fp16,
      float,
      __fp16>(input_ptr, output_ptr, outer_size, dim_size, grid_x, acl_stream);
}

void dispatch_row_persistent_forward_kernel_256_fp32(
    const float* input_ptr,
    float* output_ptr,
    int64_t outer_size,
    int64_t dim_size,
    int64_t grid_x,
    void* acl_stream) {
  persistent_256_detail::dispatch_row_persistent_forward_kernel_256<
      float,
      float,
      float>(input_ptr, output_ptr, outer_size, dim_size, grid_x, acl_stream);
}

} // namespace aten_softmax_v3
