#include <cmath>
#include <cstdint>
#include <limits>

#include "acl/acl.h"
#include "basic_api/kernel_common.h"
#include "basic_api/kernel_operator_block_sync_intf.h"
#include "c_api/asc_simd.h"
#include "simt_api/asc_bf16.h"
#include "simt_api/asc_simt.h"
#include "tensor_api/tensor.h"

#include "sparse_attention_head64_common.h"
#include "sparse_attention_head64_plan.h"

namespace {

using namespace AscendC::Te;
using aten_dsa_sparse_attention_v2::kHead64QkTile;
using aten_dsa_sparse_attention_v2::kHead64SelectedTile;
using aten_dsa_sparse_attention_v2::kHead64Tile;
using aten_dsa_sparse_attention_v2::kHead64ValueTile;
using aten_dsa_sparse_attention_v2::SparseAttentionHead64Plan;
using aten_dsa_sparse_attention_v2::head64::Head64Task;
using aten_dsa_sparse_attention_v2::head64::copy_head64_plan;
using aten_dsa_sparse_attention_v2::head64::decode_head64_task;
using aten_dsa_sparse_attention_v2::head64::head64_partition_begin;
using aten_dsa_sparse_attention_v2::head64::head64_partition_end;
using aten_dsa_sparse_attention_v2::head64::head64_score_row_stride;
using aten_dsa_sparse_attention_v2::head64::head64_warp_max;
using aten_dsa_sparse_attention_v2::head64::head64_warp_sum;

constexpr uint8_t kAivToAicReady = 8;
constexpr uint8_t kAicToAivReady = 9;

struct Head64QkMmadTrait {
  using TraitType = MmadTrait;
  static constexpr const TraitType value =
      MmadTrait(0, false, false, false, MmadType::NORMAL);
};

struct Head64PvMmadTrait {
  using TraitType = MmadTrait;
  static constexpr const TraitType value =
      MmadTrait(0, false, false, false, MmadType::NORMAL);
};

__simt_vf__ __aicore__ __launch_bounds__(1024) inline void head64_probe_vf(
    __gm__ int32_t* probe,
    int32_t task_id,
    uint32_t subblock_index) {
  const uint32_t local_head = threadIdx.x / 32;
  const uint32_t lane = threadIdx.x % 32;
  if (lane == 0) {
    const uint32_t probe_offset =
        static_cast<uint32_t>(task_id) * 64 +
        subblock_index * 32 + local_head;
    probe[probe_offset] = 1;
  }
}

__global__ __aicore__ void sparse_attention_head64_probe_kernel(
    __gm__ int32_t* probe,
    __gm__ const uint8_t* plan_gm) {
  KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_MIX_AIC_1_2);
  SparseAttentionHead64Plan plan;
  copy_head64_plan(&plan, plan_gm);
  const int32_t block_id = static_cast<int32_t>(AscendC::GetBlockIdx());
  if (block_id >= plan.used_core_num) {
    return;
  }

  for (int32_t task_id = block_id;
       task_id < plan.task_count;
       task_id += plan.used_core_num) {
    const Head64Task task = decode_head64_task(task_id, plan);
    (void)task;
    if ASCEND_IS_AIC {
      AscendC::CrossCoreWaitFlag<2, PIPE_MTE1>(kAivToAicReady);
      AscendC::CrossCoreSetFlag<2, PIPE_M>(kAicToAivReady);
    } else if ASCEND_IS_AIV {
      AscendC::CrossCoreSetFlag<2, PIPE_MTE3>(kAivToAicReady);
      AscendC::CrossCoreWaitFlag<2, PIPE_V>(kAicToAivReady);
      const uint32_t subblock_index = AscendC::GetSubBlockIdx();
      asc_vf_call<head64_probe_vf>(
          dim3(1024, 1, 1), probe, task_id, subblock_index);
    }
  }
}

__simt_vf__ __aicore__ __launch_bounds__(1024) inline void
head64_query_pack_vf(
    __gm__ const bfloat16_t* query,
    __ubuf__ bfloat16_t* packed_query,
    int32_t batch_index,
    int32_t query_token,
    int32_t head_base,
    int32_t head_begin,
    int32_t query_heads,
    int32_t query_tokens,
    int32_t qk_head_dim) {
  const uint32_t local_head = threadIdx.x / 32;
  const uint32_t lane = threadIdx.x % 32;
  const int32_t head = head_base + head_begin + local_head;
  for (uint32_t dim_index = lane;
       dim_index < static_cast<uint32_t>(qk_head_dim);
       dim_index += 32) {
    const int64_t source_offset =
        ((static_cast<int64_t>(batch_index) * query_heads + head) *
             query_tokens +
         query_token) *
            qk_head_dim +
        dim_index;
    const uint32_t packed_offset =
        (dim_index / 16) * 16 * 32 + (local_head / 16) * 16 * 16 +
        (local_head % 16) * 16 + dim_index % 16;
    packed_query[packed_offset] = query[source_offset];
  }
}

__simt_vf__ __aicore__ __launch_bounds__(1024) inline void
head64_key_pack_vf(
    __gm__ const bfloat16_t* keys,
    __gm__ const int32_t* indices,
    __ubuf__ bfloat16_t* packed_keys,
    int32_t batch_index,
    int32_t query_token,
    int32_t selected_start,
    int32_t selected_begin,
    int32_t current_selected,
    int32_t k_start,
    int32_t current_k,
    int32_t query_tokens,
    int32_t context_tokens,
    int32_t selected_tokens,
    int32_t qk_head_dim) {
  const uint32_t local_selected = threadIdx.x / 32;
  const uint32_t lane = threadIdx.x % 32;
  const int32_t selected_offset = selected_begin + local_selected;
  const int32_t selected_index = selected_start + selected_offset;
  int32_t context_index = -1;
  if (selected_offset < current_selected) {
    context_index = indices[
        (static_cast<int64_t>(batch_index) * query_tokens + query_token) *
            selected_tokens +
        selected_index];
  }

  for (uint32_t dim_offset = lane;
       dim_offset < static_cast<uint32_t>(current_k);
       dim_offset += 32) {
    const uint32_t packed_offset =
        (dim_offset / 16) * 16 * 32 +
        (local_selected / 16) * 16 * 16 +
        (local_selected % 16) * 16 + dim_offset % 16;
    if (context_index < 0 || context_index >= context_tokens) {
      packed_keys[packed_offset] = static_cast<bfloat16_t>(0.0F);
    } else {
      packed_keys[packed_offset] = keys[
          (static_cast<int64_t>(batch_index) * context_tokens +
           context_index) *
              qk_head_dim +
          k_start + dim_offset];
    }
  }
}

__aicore__ inline void sparse_attention_head64_qk_aiv(
    __gm__ const bfloat16_t* query,
    __gm__ const bfloat16_t* keys,
    __gm__ const int32_t* indices,
    __gm__ const uint8_t* plan_gm) {
  SparseAttentionHead64Plan plan;
  copy_head64_plan(&plan, plan_gm);
  const uint32_t sub_block = AscendC::GetSubBlockIdx();
  const uint32_t block_id =
      AscendC::GetBlockIdx() / AscendC::GetTaskRatio();
  if (block_id >= static_cast<uint32_t>(plan.used_core_num)) {
    return;
  }

  const uint32_t head_begin = sub_block * 32;
  const uint32_t selected_begin = sub_block * 32;
  __cbuf__ bfloat16_t l1_query_buf[kHead64Tile * 576];
  __cbuf__ bfloat16_t l1_keys_buf[kHead64QkTile * kHead64SelectedTile];
  __ubuf__ bfloat16_t ub_query_buf[32 * 576];
  __ubuf__ bfloat16_t ub_keys_buf[kHead64QkTile * 32];
  auto copy_ub_to_l1 = MakeCopy(CopyUB2L1{}, CopyUB2L1TraitDefault{});
  auto l1_query = MakeTensor(
      MakeMemPtr(l1_query_buf),
      MakeFrameLayout<NZLayoutPtn, bfloat16_t>(kHead64Tile, 576));
  auto ub_query = MakeTensor(
      MakeMemPtr(ub_query_buf),
      MakeFrameLayout<NZLayoutPtn, bfloat16_t>(32, 576));
  auto l1_query_half = l1_query.Slice(
      MakeCoord(static_cast<int32_t>(head_begin), 0),
      MakeShape(32, 576));

  for (int32_t logical_task = static_cast<int32_t>(block_id);
       logical_task < plan.task_count;
       logical_task += plan.used_core_num) {
    const Head64Task task = decode_head64_task(logical_task, plan);
    const int32_t head_base = task.head_group * kHead64Tile;
    const int32_t partition_begin = head64_partition_begin(task, plan);
    const int32_t partition_end = head64_partition_end(task, plan);
    const int32_t partition_length =
        partition_end > partition_begin ? partition_end - partition_begin : 0;
    asc_vf_call<head64_query_pack_vf>(
        dim3(1024, 1, 1),
        query,
        ub_query_buf,
        task.batch_index,
        task.query_token,
        head_base,
        static_cast<int32_t>(head_begin),
        plan.query_heads,
        plan.query_tokens,
        plan.qk_head_dim);
    asc_sync_notify(PIPE_V, PIPE_MTE3, EVENT_ID0);
    asc_sync_wait(PIPE_V, PIPE_MTE3, EVENT_ID0);
    Copy(copy_ub_to_l1, l1_query_half, ub_query);
    AscendC::CrossCoreSetFlag<2, PIPE_MTE3>(kAivToAicReady);

    for (int32_t local_selected_start = 0;
         local_selected_start < partition_length;
         local_selected_start += kHead64SelectedTile) {
      const int32_t current_selected =
          partition_length - local_selected_start < kHead64SelectedTile
          ? partition_length - local_selected_start
          : kHead64SelectedTile;
      for (int32_t k_start = 0;
           k_start < plan.qk_head_dim;
           k_start += kHead64QkTile) {
        const int32_t current_k =
            plan.qk_head_dim - k_start < kHead64QkTile
            ? plan.qk_head_dim - k_start
            : kHead64QkTile;
        AscendC::CrossCoreWaitFlag<2, PIPE_V>(kAicToAivReady);
        asc_vf_call<head64_key_pack_vf>(
            dim3(1024, 1, 1),
            keys,
            indices,
            ub_keys_buf,
            task.batch_index,
            task.query_token,
            partition_begin + local_selected_start,
            static_cast<int32_t>(selected_begin),
            current_selected,
            k_start,
            current_k,
            plan.query_tokens,
            plan.context_tokens,
            plan.selected_tokens,
            plan.qk_head_dim);
        asc_sync_notify(PIPE_V, PIPE_MTE3, EVENT_ID0);
        asc_sync_wait(PIPE_V, PIPE_MTE3, EVENT_ID0);
        auto ub_keys = MakeTensor(
            MakeMemPtr(ub_keys_buf),
            MakeFrameLayout<ZNLayoutPtn, bfloat16_t>(current_k, 32));
        auto l1_keys = MakeTensor(
            MakeMemPtr(l1_keys_buf),
            MakeFrameLayout<ZNLayoutPtn, bfloat16_t>(
                current_k, kHead64SelectedTile));
        auto l1_keys_half = l1_keys.Slice(
            MakeCoord(0, static_cast<int32_t>(selected_begin)),
            MakeShape(current_k, 32));
        Copy(copy_ub_to_l1, l1_keys_half, ub_keys);
        AscendC::CrossCoreSetFlag<2, PIPE_MTE3>(kAivToAicReady);
      }
    }
  }
}

__aicore__ inline void sparse_attention_head64_qk_aic(
    __gm__ float* scores,
    __gm__ const uint8_t* plan_gm) {
  SparseAttentionHead64Plan plan;
  copy_head64_plan(&plan, plan_gm);
  const int32_t block_id = static_cast<int32_t>(AscendC::GetBlockIdx());
  if (block_id >= plan.used_core_num) {
    return;
  }

  __cbuf__ bfloat16_t l1_query_buf[kHead64Tile * 576];
  __cbuf__ bfloat16_t l1_keys_buf[kHead64QkTile * kHead64SelectedTile];
  __ca__ bfloat16_t l0_query_buf[kHead64Tile * kHead64QkTile];
  __cb__ bfloat16_t l0_keys_buf[kHead64QkTile * kHead64SelectedTile];
  __cc__ float l0_scores_buf[kHead64Tile * kHead64SelectedTile];
  auto copy_l1_to_l0a = MakeCopy(CopyL12L0A{}, CopyL12L0ATraitDefault{});
  auto copy_l1_to_l0b = MakeCopy(CopyL12L0B{}, CopyL12L0BTraitDefault{});
  auto copy_l0c_to_gm = MakeCopy(CopyL0C2GM{}, CopyL0C2GMTraitDefault{});
  auto mm = MakeMmad(MmadOperation{}, Head64QkMmadTrait{});
  auto l1_query = MakeTensor(
      MakeMemPtr(l1_query_buf),
      MakeFrameLayout<NZLayoutPtn, bfloat16_t>(kHead64Tile, 576));
  asc_sync_notify(PIPE_FIX, PIPE_M, EVENT_ID0);
  asc_sync_notify(PIPE_M, PIPE_MTE1, EVENT_ID1);

  for (int32_t logical_task = block_id;
       logical_task < plan.task_count;
       logical_task += plan.used_core_num) {
    const Head64Task task = decode_head64_task(logical_task, plan);
    const int32_t partition_begin = head64_partition_begin(task, plan);
    const int32_t partition_end = head64_partition_end(task, plan);
    const int32_t partition_length =
        partition_end > partition_begin ? partition_end - partition_begin : 0;
    const int32_t partition_token_capacity = head64_score_row_stride(plan);
    AscendC::CrossCoreWaitFlag<2, PIPE_MTE1>(kAivToAicReady);
    const int64_t score_base =
        static_cast<int64_t>(logical_task) * kHead64Tile *
        partition_token_capacity;
    auto gm_scores = MakeTensor(
        MakeMemPtr(scores + score_base),
        MakeFrameLayout<NDExtLayoutPtn>(
            kHead64Tile, partition_token_capacity));

    for (int32_t local_selected_start = 0;
         local_selected_start < partition_length;
         local_selected_start += kHead64SelectedTile) {
      const int32_t current_selected =
          partition_length - local_selected_start < kHead64SelectedTile
          ? partition_length - local_selected_start
          : kHead64SelectedTile;
      auto l0_scores = MakeTensor(
          MakeMemPtr(l0_scores_buf),
          MakeFrameLayout<NZLayoutPtn>(kHead64Tile, current_selected));
      for (int32_t k_start = 0;
           k_start < plan.qk_head_dim;
           k_start += kHead64QkTile) {
        const int32_t current_k =
            plan.qk_head_dim - k_start < kHead64QkTile
            ? plan.qk_head_dim - k_start
            : kHead64QkTile;
        auto l1_query_tile = l1_query.Slice(
            MakeCoord(0, k_start),
            MakeShape(kHead64Tile, current_k));
        auto l0_query = MakeTensor(
            MakeMemPtr(l0_query_buf),
            MakeFrameLayout<NZLayoutPtn, bfloat16_t>(
                kHead64Tile, current_k));
        asc_sync_wait(PIPE_M, PIPE_MTE1, EVENT_ID1);
        Copy(copy_l1_to_l0a, l0_query, l1_query_tile);
        AscendC::CrossCoreSetFlag<2, PIPE_MTE1>(kAicToAivReady);
        AscendC::CrossCoreWaitFlag<2, PIPE_MTE1>(kAivToAicReady);
        auto l1_keys = MakeTensor(
            MakeMemPtr(l1_keys_buf),
            MakeFrameLayout<ZNLayoutPtn, bfloat16_t>(
                current_k, kHead64SelectedTile));
        auto l0_keys = MakeTensor(
            MakeMemPtr(l0_keys_buf),
            MakeFrameLayout<ZNLayoutPtn, bfloat16_t>(
                current_k, current_selected));
        Copy(copy_l1_to_l0b, l0_keys, l1_keys);
        asc_sync_notify(PIPE_MTE1, PIPE_M, EVENT_ID1);
        asc_sync_wait(PIPE_MTE1, PIPE_M, EVENT_ID1);
        MmadParams params;
        params.m = 64;
        params.n = current_selected;
        params.k = current_k;
        params.unitFlag = 0;
        params.cmatrixInitVal = k_start == 0;
        if (k_start == 0) {
          asc_sync_wait(PIPE_FIX, PIPE_M, EVENT_ID0);
        }
        Mmad(mm.with(params), l0_scores, l0_query, l0_keys);
        asc_sync_notify(PIPE_M, PIPE_MTE1, EVENT_ID1);
        if (k_start + current_k == plan.qk_head_dim) {
          asc_sync_notify(PIPE_M, PIPE_FIX, EVENT_ID0);
        }
      }
      auto gm_score_tile = gm_scores.Slice(
          MakeCoord(0, local_selected_start),
          MakeShape(kHead64Tile, current_selected));
      asc_sync_wait(PIPE_M, PIPE_FIX, EVENT_ID0);
      Copy(copy_l0c_to_gm, gm_score_tile, l0_scores);
      asc_sync_notify(PIPE_FIX, PIPE_M, EVENT_ID0);
    }
  }
  asc_sync_wait(PIPE_FIX, PIPE_M, EVENT_ID0);
  asc_sync_wait(PIPE_M, PIPE_MTE1, EVENT_ID1);
}

__global__ __aicore__ void sparse_attention_head64_qk_kernel(
    __gm__ bfloat16_t* query,
    __gm__ bfloat16_t* keys,
    __gm__ const int32_t* indices,
    __gm__ float* scores,
    __kfc_workspace__ __gm__ uint8_t* workspace,
    __gm__ const uint8_t* plan_gm) {
  (void)workspace;
  KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_MIX_AIC_1_2);
  if ASCEND_IS_AIC {
    sparse_attention_head64_qk_aic(scores, plan_gm);
  } else if ASCEND_IS_AIV {
    sparse_attention_head64_qk_aiv(query, keys, indices, plan_gm);
  }
}

__simt_vf__ __aicore__ __launch_bounds__(1024) inline void
head64_online_softmax_vf(
    __gm__ const float* scores,
    __gm__ const int32_t* indices,
    __gm__ float* partial_lse,
    __ubuf__ float* running_max_values,
    __ubuf__ float* running_sum_values,
    int32_t logical_task,
    int32_t batch_index,
    int32_t query_token,
    int32_t head_base,
    int32_t head_begin,
    int32_t partition_begin,
    int32_t partition_length,
    int32_t partition_token_capacity,
    int32_t query_heads,
    int32_t query_tokens,
    int32_t context_tokens,
    int32_t selected_tokens,
    int32_t selected_partitions,
    float score_scale,
    int32_t causal) {
  const uint32_t local_head = threadIdx.x / 32;
  const uint32_t lane = threadIdx.x % 32;
  const int32_t task_head = head_begin + static_cast<int32_t>(local_head);
  const int32_t global_head = head_base + task_head;
  const int64_t score_row =
      (static_cast<int64_t>(logical_task) * kHead64Tile + task_head) *
      partition_token_capacity;
  const int64_t indices_row =
      (static_cast<int64_t>(batch_index) * query_tokens + query_token) *
          selected_tokens +
      partition_begin;
  const int32_t causal_limit = context_tokens - query_tokens + query_token;

  float running_max = -std::numeric_limits<float>::infinity();
  float running_sum = 0.0F;
  for (int32_t local_selected_start = 0;
       local_selected_start < partition_length;
       local_selected_start += kHead64SelectedTile) {
    const int32_t current_selected =
        partition_length - local_selected_start < kHead64SelectedTile
        ? partition_length - local_selected_start
        : kHead64SelectedTile;
    float lane_max = -std::numeric_limits<float>::infinity();
    float lane_valid = 0.0F;
    for (int32_t selected_index = static_cast<int32_t>(lane);
         selected_index < current_selected;
         selected_index += 32) {
      const int32_t local_selected = local_selected_start + selected_index;
      const int32_t context_index = indices[indices_row + local_selected];
      const bool valid =
          context_index >= 0 && context_index < context_tokens &&
          (!causal || context_index <= causal_limit);
      if (valid) {
        const float scaled_score =
            scores[score_row + local_selected] * score_scale;
        lane_max = lane_max < scaled_score ? scaled_score : lane_max;
        lane_valid = 1.0F;
      }
    }
    const float tile_max = head64_warp_max(lane_max);
    const float tile_valid = head64_warp_sum(lane_valid);
    if (tile_valid > 0.0F) {
      const float new_max =
          running_sum > 0.0F && running_max > tile_max
          ? running_max
          : tile_max;
      const float old_scale =
          running_sum > 0.0F ? __expf(running_max - new_max) : 0.0F;
      float lane_sum = 0.0F;
      for (int32_t selected_index = static_cast<int32_t>(lane);
           selected_index < current_selected;
           selected_index += 32) {
        const int32_t local_selected = local_selected_start + selected_index;
        const int32_t context_index = indices[indices_row + local_selected];
        const bool valid =
            context_index >= 0 && context_index < context_tokens &&
            (!causal || context_index <= causal_limit);
        if (valid) {
          lane_sum += __expf(
              scores[score_row + local_selected] * score_scale - new_max);
        }
      }
      running_sum = old_scale * running_sum + head64_warp_sum(lane_sum);
      running_max = new_max;
    }
  }

  if (lane == 0) {
    running_max_values[local_head] = running_max;
    running_sum_values[local_head] = running_sum;
    const float lse_value = running_sum > 0.0F
        ? running_max + logf(running_sum)
        : -std::numeric_limits<float>::infinity();
    const int64_t final_lse_offset =
        (static_cast<int64_t>(batch_index) * query_heads + global_head) *
            query_tokens +
        query_token;
    if (selected_partitions == 1) {
      partial_lse[final_lse_offset] = lse_value;
    } else {
      partial_lse[
          static_cast<int64_t>(logical_task) * kHead64Tile + task_head] =
          lse_value;
    }
  }
}

__simt_vf__ __aicore__ __launch_bounds__(1024) inline void
head64_probability_pack_vf(
    __gm__ const float* scores,
    __gm__ const int32_t* indices,
    __ubuf__ bfloat16_t* packed_probabilities,
    __ubuf__ const float* running_max_values,
    __ubuf__ const float* running_sum_values,
    int32_t logical_task,
    int32_t batch_index,
    int32_t query_token,
    int32_t head_begin,
    int32_t partition_begin,
    int32_t partition_length,
    int32_t partition_token_capacity,
    int32_t local_selected_start,
    int32_t current_selected,
    int32_t query_tokens,
    int32_t context_tokens,
    int32_t selected_tokens,
    float score_scale,
    int32_t causal) {
  const uint32_t local_head = threadIdx.x / 32;
  const uint32_t lane = threadIdx.x % 32;
  const int32_t task_head = head_begin + static_cast<int32_t>(local_head);
  const int64_t score_row =
      (static_cast<int64_t>(logical_task) * kHead64Tile + task_head) *
      partition_token_capacity;
  const int64_t indices_row =
      (static_cast<int64_t>(batch_index) * query_tokens + query_token) *
          selected_tokens +
      partition_begin;
  const int32_t causal_limit = context_tokens - query_tokens + query_token;
  const float running_max = running_max_values[local_head];
  const float running_sum = running_sum_values[local_head];

  for (int32_t selected_index = static_cast<int32_t>(lane);
       selected_index < kHead64SelectedTile;
       selected_index += 32) {
    int32_t context_index = -1;
    const int32_t local_selected = local_selected_start + selected_index;
    if (selected_index < current_selected &&
        local_selected < partition_length) {
      context_index = indices[indices_row + local_selected];
    }
    const bool valid =
        selected_index < current_selected &&
        context_index >= 0 && context_index < context_tokens &&
        (!causal || context_index <= causal_limit);
    const uint32_t packed_offset =
        local_head * kHead64SelectedTile +
        static_cast<uint32_t>(selected_index);
    if (!valid || running_sum <= 0.0F) {
      packed_probabilities[packed_offset] = static_cast<bfloat16_t>(0.0F);
      continue;
    }
    const float probability = __expf(
        scores[score_row + local_selected] * score_scale - running_max) /
        running_sum;
    packed_probabilities[packed_offset] =
        static_cast<bfloat16_t>(probability);
  }
}

__simt_vf__ __aicore__ __launch_bounds__(1024) inline void
head64_value_pack_vf(
    __gm__ const bfloat16_t* values,
    __gm__ const int32_t* indices,
    __ubuf__ bfloat16_t* packed_values,
    int32_t batch_index,
    int32_t query_token,
    int32_t partition_begin,
    int32_t local_selected_start,
    int32_t selected_begin,
    int32_t current_selected,
    int32_t value_start,
    int32_t current_value,
    int32_t query_tokens,
    int32_t context_tokens,
    int32_t selected_tokens,
    int32_t qk_head_dim) {
  const uint32_t local_selected = threadIdx.x / 32;
  const uint32_t lane = threadIdx.x % 32;
  const int32_t selected_offset =
      selected_begin + static_cast<int32_t>(local_selected);
  const int32_t absolute_selected =
      partition_begin + local_selected_start + selected_offset;
  int32_t context_index = -1;
  if (selected_offset < current_selected) {
    context_index = indices[
        (static_cast<int64_t>(batch_index) * query_tokens + query_token) *
            selected_tokens +
        absolute_selected];
  }
  const uint32_t aligned_value =
      (static_cast<uint32_t>(current_value) + 15U) / 16U * 16U;
  for (int32_t dim_index = static_cast<int32_t>(lane);
       dim_index < current_value;
       dim_index += 32) {
    const uint32_t packed_offset =
        (local_selected / 16U) * 16U * aligned_value +
        (static_cast<uint32_t>(dim_index) / 16U) * 16U * 16U +
        (static_cast<uint32_t>(dim_index) % 16U) * 16U +
        local_selected % 16U;
    if (context_index < 0 || context_index >= context_tokens) {
      packed_values[packed_offset] = static_cast<bfloat16_t>(0.0F);
    } else {
      packed_values[packed_offset] = values[
          (static_cast<int64_t>(batch_index) * context_tokens + context_index) *
              qk_head_dim +
          value_start + dim_index];
    }
  }
}

__aicore__ inline int32_t head64_pv_value_tile_index(
    int32_t value_iteration) {
  // TODO(cann): remove the duplicated first PV tile after root-causing the
  // invalid device state observed on the first complete Cube PV transaction.
  return value_iteration == 0 ? 0 : value_iteration - 1;
}

__aicore__ inline void sparse_attention_head64_pv_aiv(
    __gm__ const float* scores,
    __gm__ bfloat16_t* probabilities,
    __gm__ const bfloat16_t* values,
    __gm__ const int32_t* indices,
    __gm__ float* partial_lse,
    __gm__ const uint8_t* plan_gm,
    int32_t causal) {
  SparseAttentionHead64Plan plan;
  copy_head64_plan(&plan, plan_gm);
  const uint32_t sub_block = AscendC::GetSubBlockIdx();
  const uint32_t block_id =
      AscendC::GetBlockIdx() / AscendC::GetTaskRatio();
  if (block_id >= static_cast<uint32_t>(plan.used_core_num)) {
    return;
  }

  const int32_t selected_begin = static_cast<int32_t>(sub_block) * 32;
  __cbuf__ bfloat16_t l1_values_buf[
      kHead64SelectedTile * kHead64ValueTile];
  __ubuf__ bfloat16_t ub_probabilities_buf[32 * kHead64SelectedTile];
  __ubuf__ float ub_running_max_buf[32];
  __ubuf__ float ub_running_sum_buf[32];
  __ubuf__ bfloat16_t ub_values_buf[32 * kHead64ValueTile];
  auto copy_ub_to_l1 = MakeCopy(CopyUB2L1{}, CopyUB2L1TraitDefault{});
  asc_sync_notify(PIPE_MTE3, PIPE_V, EVENT_ID0);

  for (int32_t logical_task = static_cast<int32_t>(block_id);
       logical_task < plan.task_count;
       logical_task += plan.used_core_num) {
    const Head64Task task = decode_head64_task(logical_task, plan);
    const int32_t head_base = task.head_group * kHead64Tile;
    const int32_t partition_begin = head64_partition_begin(task, plan);
    const int32_t partition_end = head64_partition_end(task, plan);
    const int32_t partition_length =
        partition_end > partition_begin ? partition_end - partition_begin : 0;
    const int32_t partition_token_capacity = head64_score_row_stride(plan);
    const int32_t probability_tile_capacity =
        (partition_token_capacity + kHead64SelectedTile - 1) /
        kHead64SelectedTile;
    asc_vf_call<head64_online_softmax_vf>(
        dim3(1024, 1, 1),
        scores,
        indices,
        partial_lse,
        ub_running_max_buf,
        ub_running_sum_buf,
        logical_task,
        task.batch_index,
        task.query_token,
        head_base,
        selected_begin,
        partition_begin,
        partition_length,
        partition_token_capacity,
        plan.query_heads,
        plan.query_tokens,
        plan.context_tokens,
        plan.selected_tokens,
        plan.selected_partitions,
        1.0F / 24.0F,
        causal);
    if (partition_length == 0) {
      if (probability_tile_capacity > 0) {
        asc_sync_wait(PIPE_MTE3, PIPE_V, EVENT_ID0);
        asc_vf_call<head64_probability_pack_vf>(
            dim3(1024, 1, 1),
            scores,
            indices,
            ub_probabilities_buf,
            ub_running_max_buf,
            ub_running_sum_buf,
            logical_task,
            task.batch_index,
            task.query_token,
            selected_begin,
            partition_begin,
            partition_length,
            partition_token_capacity,
            0,
            0,
            plan.query_tokens,
            plan.context_tokens,
            plan.selected_tokens,
            1.0F / 24.0F,
            causal);
        asc_sync_notify(PIPE_V, PIPE_MTE3, EVENT_ID0);
        asc_sync_wait(PIPE_V, PIPE_MTE3, EVENT_ID0);
        for (int32_t probability_tile = 0;
             probability_tile < probability_tile_capacity;
             ++probability_tile) {
          const int64_t probability_base =
              (static_cast<int64_t>(logical_task) *
                   probability_tile_capacity +
               probability_tile) *
                  kHead64Tile * kHead64SelectedTile +
              static_cast<int64_t>(selected_begin) * kHead64SelectedTile;
          asc_copy_ub2gm_align(
              probabilities + probability_base,
              ub_probabilities_buf,
              static_cast<uint32_t>(
                  32 * kHead64SelectedTile * sizeof(bfloat16_t)));
        }
        asc_sync_notify(PIPE_MTE3, PIPE_V, EVENT_ID0);
      }
      continue;
    }

    const int32_t probability_tile_count =
        (partition_length + kHead64SelectedTile - 1) /
        kHead64SelectedTile;
    for (int32_t probability_tile = 0;
         probability_tile < probability_tile_count;
         ++probability_tile) {
      const int32_t local_selected_start =
          probability_tile * kHead64SelectedTile;
      const int32_t current_selected =
          partition_length - local_selected_start < kHead64SelectedTile
          ? partition_length - local_selected_start
          : kHead64SelectedTile;
      asc_sync_wait(PIPE_MTE3, PIPE_V, EVENT_ID0);
      asc_vf_call<head64_probability_pack_vf>(
          dim3(1024, 1, 1),
          scores,
          indices,
          ub_probabilities_buf,
          ub_running_max_buf,
          ub_running_sum_buf,
          logical_task,
          task.batch_index,
          task.query_token,
          selected_begin,
          partition_begin,
          partition_length,
          partition_token_capacity,
          local_selected_start,
          current_selected,
          plan.query_tokens,
          plan.context_tokens,
          plan.selected_tokens,
          1.0F / 24.0F,
          causal);
      asc_sync_notify(PIPE_V, PIPE_MTE3, EVENT_ID0);
      asc_sync_wait(PIPE_V, PIPE_MTE3, EVENT_ID0);
      const int64_t probability_base =
          (static_cast<int64_t>(logical_task) *
               probability_tile_capacity +
           probability_tile) *
              kHead64Tile * kHead64SelectedTile +
          static_cast<int64_t>(selected_begin) * kHead64SelectedTile;
      asc_copy_ub2gm_align(
          probabilities + probability_base,
          ub_probabilities_buf,
          static_cast<uint32_t>(
              32 * kHead64SelectedTile * sizeof(bfloat16_t)));
      asc_sync_notify(PIPE_MTE3, PIPE_V, EVENT_ID0);
    }
    AscendC::CrossCoreSetFlag<4, PIPE_MTE3>(
        kAivToAicReady + sub_block * 16);

    const int32_t value_tile_count =
        (plan.value_head_dim + kHead64ValueTile - 1) /
        kHead64ValueTile;
    for (int32_t value_iteration = 0;
         value_iteration <= value_tile_count;
         ++value_iteration) {
      const int32_t value_start =
          head64_pv_value_tile_index(value_iteration) *
          kHead64ValueTile;
      const int32_t current_value =
          plan.value_head_dim - value_start < kHead64ValueTile
          ? plan.value_head_dim - value_start
          : kHead64ValueTile;
      auto ub_values = MakeTensor(
          MakeMemPtr(ub_values_buf),
          MakeFrameLayout<ZNLayoutPtn, bfloat16_t>(32, current_value));
      auto l1_values = MakeTensor(
          MakeMemPtr(l1_values_buf),
          MakeFrameLayout<ZNLayoutPtn, bfloat16_t>(
              kHead64SelectedTile, current_value));
      auto l1_values_half = l1_values.Slice(
          MakeCoord(selected_begin, 0),
          MakeShape(32, current_value));
      for (int32_t probability_tile = 0;
           probability_tile < probability_tile_count;
           ++probability_tile) {
        const int32_t local_selected_start =
            probability_tile * kHead64SelectedTile;
        const int32_t current_selected =
            partition_length - local_selected_start < kHead64SelectedTile
            ? partition_length - local_selected_start
            : kHead64SelectedTile;
        AscendC::CrossCoreWaitFlag<2, PIPE_V>(kAicToAivReady);
        asc_vf_call<head64_value_pack_vf>(
            dim3(1024, 1, 1),
            values,
            indices,
            ub_values_buf,
            task.batch_index,
            task.query_token,
            partition_begin,
            local_selected_start,
            selected_begin,
            current_selected,
            value_start,
            current_value,
            plan.query_tokens,
            plan.context_tokens,
            plan.selected_tokens,
            plan.qk_head_dim);
        asc_sync_notify(PIPE_V, PIPE_MTE3, EVENT_ID0);
        asc_sync_wait(PIPE_V, PIPE_MTE3, EVENT_ID0);
        Copy(copy_ub_to_l1, l1_values_half, ub_values);
        AscendC::CrossCoreSetFlag<4, PIPE_MTE3>(
            kAivToAicReady + sub_block * 16);
      }
    }
  }
  asc_sync_wait(PIPE_MTE3, PIPE_V, EVENT_ID0);
}

__aicore__ inline void sparse_attention_head64_pv_aic(
    __gm__ bfloat16_t* probabilities,
    __gm__ float* task_output,
    __gm__ const uint8_t* plan_gm) {
  SparseAttentionHead64Plan plan;
  copy_head64_plan(&plan, plan_gm);
  const int32_t block_id = static_cast<int32_t>(AscendC::GetBlockIdx());
  if (block_id >= plan.used_core_num) {
    return;
  }

  __cbuf__ bfloat16_t l1_values_buf[
      kHead64SelectedTile * kHead64ValueTile];
  __cbuf__ bfloat16_t l1_probability_buf[
      kHead64Tile * kHead64SelectedTile];
  __ca__ bfloat16_t l0_probability_buf[
      kHead64Tile * kHead64SelectedTile];
  __cb__ bfloat16_t l0_values_buf[
      kHead64SelectedTile * kHead64ValueTile];
  __cc__ float l0_pv_buf[kHead64Tile * kHead64ValueTile];
  auto copy_gm_to_l1 = MakeCopy(CopyGM2L1{}, CopyGM2L1TraitDefault{});
  auto copy_l1_to_l0a = MakeCopy(CopyL12L0A{}, CopyL12L0ATraitDefault{});
  auto copy_l1_to_l0b = MakeCopy(CopyL12L0B{}, CopyL12L0BTraitDefault{});
  auto copy_l0c_to_gm = MakeCopy(CopyL0C2GM{}, CopyL0C2GMTraitDefault{});
  auto pv_mm = MakeMmad(MmadOperation{}, Head64PvMmadTrait{});
  asc_sync_notify(PIPE_FIX, PIPE_M, EVENT_ID0);
  asc_sync_notify(PIPE_M, PIPE_MTE1, EVENT_ID1);
  asc_sync_notify(PIPE_MTE1, PIPE_MTE2, EVENT_ID2);

  for (int32_t logical_task = block_id;
       logical_task < plan.task_count;
       logical_task += plan.used_core_num) {
    const Head64Task task = decode_head64_task(logical_task, plan);
    const int32_t partition_begin = head64_partition_begin(task, plan);
    const int32_t partition_end = head64_partition_end(task, plan);
    const int32_t partition_length =
        partition_end > partition_begin ? partition_end - partition_begin : 0;
    const int32_t partition_token_capacity = head64_score_row_stride(plan);
    const int64_t output_base =
        static_cast<int64_t>(logical_task) * kHead64Tile *
        plan.value_head_dim;
    if (partition_length == 0) {
      for (int32_t output_index = 0;
           output_index < kHead64Tile * plan.value_head_dim;
           ++output_index) {
        task_output[output_base + output_index] = 0.0F;
      }
      continue;
    }

    AscendC::CrossCoreWaitFlag<4, PIPE_MTE1>(kAivToAicReady);
    AscendC::CrossCoreWaitFlag<4, PIPE_MTE1>(kAivToAicReady + 16);
    const int32_t probability_tile_count =
        (partition_length + kHead64SelectedTile - 1) /
        kHead64SelectedTile;
    const int32_t probability_tile_capacity =
        (partition_token_capacity + kHead64SelectedTile - 1) /
        kHead64SelectedTile;
    auto gm_output = MakeTensor(
        MakeMemPtr(task_output + output_base),
        MakeFrameLayout<NDExtLayoutPtn>(
            kHead64Tile, plan.value_head_dim));

    const int32_t value_tile_count =
        (plan.value_head_dim + kHead64ValueTile - 1) /
        kHead64ValueTile;
    for (int32_t value_iteration = 0;
         value_iteration <= value_tile_count;
         ++value_iteration) {
      const int32_t value_start =
          head64_pv_value_tile_index(value_iteration) *
          kHead64ValueTile;
      const int32_t current_value =
          plan.value_head_dim - value_start < kHead64ValueTile
          ? plan.value_head_dim - value_start
          : kHead64ValueTile;
      auto l0_pv = MakeTensor(
          MakeMemPtr(l0_pv_buf),
          MakeFrameLayout<NZLayoutPtn>(kHead64Tile, current_value));
      for (int32_t probability_tile = 0;
           probability_tile < probability_tile_count;
           ++probability_tile) {
        const int32_t local_selected_start =
            probability_tile * kHead64SelectedTile;
        const int32_t current_selected =
            partition_length - local_selected_start < kHead64SelectedTile
            ? partition_length - local_selected_start
            : kHead64SelectedTile;
        AscendC::CrossCoreSetFlag<2, PIPE_MTE1>(kAicToAivReady);
        asc_sync_wait(PIPE_MTE1, PIPE_MTE2, EVENT_ID2);
        const int64_t probability_base =
            (static_cast<int64_t>(logical_task) * probability_tile_capacity +
             probability_tile) *
            kHead64Tile * kHead64SelectedTile;
        auto gm_probability_tile = MakeTensor(
            MakeMemPtr(probabilities + probability_base),
            MakeFrameLayout<NDExtLayoutPtn>(
                kHead64Tile, kHead64SelectedTile));
        auto l1_probability = MakeTensor(
            MakeMemPtr(l1_probability_buf),
            MakeFrameLayout<NZLayoutPtn, bfloat16_t>(
                kHead64Tile, kHead64SelectedTile));
        Copy(copy_gm_to_l1, l1_probability, gm_probability_tile);
        asc_sync_notify(PIPE_MTE2, PIPE_MTE1, EVENT_ID2);
        asc_sync_wait(PIPE_MTE2, PIPE_MTE1, EVENT_ID2);
        AscendC::CrossCoreWaitFlag<4, PIPE_MTE1>(kAivToAicReady);
        AscendC::CrossCoreWaitFlag<4, PIPE_MTE1>(kAivToAicReady + 16);

        auto l1_values = MakeTensor(
            MakeMemPtr(l1_values_buf),
            MakeFrameLayout<ZNLayoutPtn, bfloat16_t>(
                kHead64SelectedTile, current_value));
        auto l0_probability = MakeTensor(
            MakeMemPtr(l0_probability_buf),
            MakeFrameLayout<NZLayoutPtn, bfloat16_t>(
                kHead64Tile, current_selected));
        auto l1_probability_active = l1_probability.Slice(
            MakeCoord(0, 0),
            MakeShape(kHead64Tile, current_selected));
        auto l0_values = MakeTensor(
            MakeMemPtr(l0_values_buf),
            MakeFrameLayout<ZNLayoutPtn, bfloat16_t>(
                current_selected, current_value));
        asc_sync_wait(PIPE_M, PIPE_MTE1, EVENT_ID1);
        Copy(copy_l1_to_l0a, l0_probability, l1_probability_active);
        Copy(copy_l1_to_l0b, l0_values, l1_values);
        asc_sync_notify(PIPE_MTE1, PIPE_M, EVENT_ID1);
        asc_sync_wait(PIPE_MTE1, PIPE_M, EVENT_ID1);
        asc_sync_notify(PIPE_MTE1, PIPE_MTE2, EVENT_ID2);
        if (local_selected_start == 0) {
          asc_sync_wait(PIPE_FIX, PIPE_M, EVENT_ID0);
        }
        MmadParams pv_params;
        pv_params.m = 64;
        pv_params.n = current_value;
        pv_params.k = current_selected;
        pv_params.unitFlag = 0;
        pv_params.cmatrixInitVal = local_selected_start == 0;
        Mmad(pv_mm.with(pv_params), l0_pv, l0_probability, l0_values);
        asc_sync_notify(PIPE_M, PIPE_MTE1, EVENT_ID1);
        if (local_selected_start + current_selected == partition_length) {
          asc_sync_notify(PIPE_M, PIPE_FIX, EVENT_ID0);
        }
      }
      auto gm_output_tile = gm_output.Slice(
          MakeCoord(0, value_start),
          MakeShape(kHead64Tile, current_value));
      asc_sync_wait(PIPE_M, PIPE_FIX, EVENT_ID0);
      Copy(copy_l0c_to_gm, gm_output_tile, l0_pv);
      asc_sync_notify(PIPE_FIX, PIPE_M, EVENT_ID0);
    }
  }
  asc_sync_wait(PIPE_FIX, PIPE_M, EVENT_ID0);
  asc_sync_wait(PIPE_M, PIPE_MTE1, EVENT_ID1);
  asc_sync_wait(PIPE_MTE1, PIPE_MTE2, EVENT_ID2);
}

__global__ __aicore__ void sparse_attention_head64_pv_kernel(
    __gm__ const float* scores,
    __gm__ bfloat16_t* probabilities,
    __gm__ bfloat16_t* values,
    __gm__ const int32_t* indices,
    __gm__ float* task_output,
    __gm__ float* partial_lse,
    __kfc_workspace__ __gm__ uint8_t* workspace,
    __gm__ const uint8_t* plan_gm,
    int32_t causal) {
  (void)workspace;
  KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_MIX_AIC_1_2);
  if ASCEND_IS_AIC {
    sparse_attention_head64_pv_aic(probabilities, task_output, plan_gm);
  } else if ASCEND_IS_AIV {
    sparse_attention_head64_pv_aiv(
        scores,
        probabilities,
        values,
        indices,
        partial_lse,
        plan_gm,
        causal);
  }
}

__aicore__ inline bool head64_combine_is_canonical_v32_decode(
    const SparseAttentionHead64Plan& plan) {
  return plan.used_core_num == 32 && plan.task_count == 32 &&
      plan.batch_size == 2 && plan.query_heads == 128 &&
      plan.query_tokens == 2 && plan.context_tokens == 32768 &&
      plan.selected_tokens == 2048 && plan.qk_head_dim == 576 &&
      plan.value_head_dim == 512 && plan.head_tile == 64 &&
      plan.head_group_count == 2 && plan.selected_tile == 64 &&
      plan.selected_partitions == 4 &&
      plan.selected_partition_tile_capacity == 8 &&
      plan.output_mode == aten_dsa_sparse_attention_v2::kHead64OutputPartialFloat;
}

__simt_vf__ __aicore__ __launch_bounds__(1024) inline void
head64_combine_p4_vf(
    __gm__ const float* partial_output,
    __gm__ const float* partial_lse,
    __gm__ float* output,
    __gm__ float* lse,
    int32_t base_task,
    uint32_t sub_block_index) {
  const uint32_t local_head = threadIdx.x / 32;
  const uint32_t lane = threadIdx.x % 32;
  int32_t remainder = base_task;
  const int32_t head_group = remainder % 2;
  remainder /= 2;
  const int32_t query_token = remainder % 2;
  const int32_t batch_index = remainder / 2;
  const int32_t task_head =
      sub_block_index * 32 + static_cast<int32_t>(local_head);
  const int32_t global_head = head_group * kHead64Tile + task_head;
  const int64_t lse_offset =
      (static_cast<int64_t>(batch_index) * 128 + global_head) * 2 +
      query_token;
  const int64_t output_row = lse_offset * 512;
  const int64_t partial_row0 =
      static_cast<int64_t>(base_task * 4) * kHead64Tile + task_head;
  const int64_t partial_row1 = partial_row0 + kHead64Tile;
  const int64_t partial_row2 = partial_row1 + kHead64Tile;
  const int64_t partial_row3 = partial_row2 + kHead64Tile;
  const float partial_lse0 = partial_lse[partial_row0];
  const float partial_lse1 = partial_lse[partial_row1];
  const float partial_lse2 = partial_lse[partial_row2];
  const float partial_lse3 = partial_lse[partial_row3];

  float global_max = partial_lse0;
  global_max = global_max < partial_lse1 ? partial_lse1 : global_max;
  global_max = global_max < partial_lse2 ? partial_lse2 : global_max;
  global_max = global_max < partial_lse3 ? partial_lse3 : global_max;
  if (!isfinite(global_max)) {
    if (lane == 0) {
      lse[lse_offset] = -std::numeric_limits<float>::infinity();
    }
    for (int32_t dim = static_cast<int32_t>(lane); dim < 512; dim += 32) {
      output[output_row + dim] = 0.0F;
    }
    return;
  }

  float global_sum = 0.0F;
  if (isfinite(partial_lse0)) {
    global_sum += __expf(partial_lse0 - global_max);
  }
  if (isfinite(partial_lse1)) {
    global_sum += __expf(partial_lse1 - global_max);
  }
  if (isfinite(partial_lse2)) {
    global_sum += __expf(partial_lse2 - global_max);
  }
  if (isfinite(partial_lse3)) {
    global_sum += __expf(partial_lse3 - global_max);
  }
  const float global_lse = global_max + logf(global_sum);
  if (lane == 0) {
    lse[lse_offset] = global_lse;
  }
  const float partition_weight0 = isfinite(partial_lse0)
      ? __expf(partial_lse0 - global_lse)
      : 0.0F;
  const float partition_weight1 = isfinite(partial_lse1)
      ? __expf(partial_lse1 - global_lse)
      : 0.0F;
  const float partition_weight2 = isfinite(partial_lse2)
      ? __expf(partial_lse2 - global_lse)
      : 0.0F;
  const float partition_weight3 = isfinite(partial_lse3)
      ? __expf(partial_lse3 - global_lse)
      : 0.0F;

  for (int32_t dim = static_cast<int32_t>(lane); dim < 512; dim += 32) {
    float combined = 0.0F;
    combined += partition_weight0 * partial_output[partial_row0 * 512 + dim];
    combined += partition_weight1 * partial_output[partial_row1 * 512 + dim];
    combined += partition_weight2 * partial_output[partial_row2 * 512 + dim];
    combined += partition_weight3 * partial_output[partial_row3 * 512 + dim];
    output[output_row + dim] = combined;
  }
}

__simt_vf__ __aicore__ __launch_bounds__(1024) inline void
head64_combine_vf(
    __gm__ const float* partial_output,
    __gm__ const float* partial_lse,
    __gm__ float* output,
    __gm__ float* lse,
    int32_t query_heads,
    int32_t query_tokens,
    int32_t head_group_count,
    int32_t value_head_dim,
    int32_t selected_partitions,
    int32_t base_task,
    uint32_t sub_block_index) {
  const uint32_t local_head = threadIdx.x / 32;
  const uint32_t lane = threadIdx.x % 32;
  int32_t remainder = base_task;
  const int32_t head_group = remainder % head_group_count;
  remainder /= head_group_count;
  const int32_t query_token = remainder % query_tokens;
  const int32_t batch_index = remainder / query_tokens;
  const int32_t task_head =
      sub_block_index * 32 + static_cast<int32_t>(local_head);
  const int32_t global_head = head_group * kHead64Tile + task_head;
  const int64_t lse_offset =
      (static_cast<int64_t>(batch_index) * query_heads + global_head) *
          query_tokens +
      query_token;
  const int64_t output_row = lse_offset * value_head_dim;

  float global_max = -std::numeric_limits<float>::infinity();
  for (int32_t p = 0; p < selected_partitions; ++p) {
    const float value = partial_lse[
        (base_task * selected_partitions + p) * kHead64Tile + task_head];
    global_max = global_max < value ? value : global_max;
  }

  if (!isfinite(global_max)) {
    if (lane == 0) {
      lse[lse_offset] = -std::numeric_limits<float>::infinity();
    }
    for (int32_t dim = lane; dim < value_head_dim; dim += 32) {
      output[output_row + dim] = 0.0F;
    }
    return;
  }

  float global_sum = 0.0F;
  for (int32_t p = 0; p < selected_partitions; ++p) {
    const float value = partial_lse[
        (base_task * selected_partitions + p) * kHead64Tile + task_head];
    if (isfinite(value)) {
      global_sum += __expf(value - global_max);
    }
  }
  const float global_lse = global_max + logf(global_sum);
  if (lane == 0) {
    lse[lse_offset] = global_lse;
  }

  for (int32_t dim = static_cast<int32_t>(lane);
       dim < value_head_dim;
       dim += 32) {
    float combined = 0.0F;
    for (int32_t p = 0; p < selected_partitions; ++p) {
      const int64_t partial_row =
          (static_cast<int64_t>(base_task) * selected_partitions + p) *
              kHead64Tile +
          task_head;
      const float partial_lse_value = partial_lse[partial_row];
      if (isfinite(partial_lse_value)) {
        combined += __expf(partial_lse_value - global_lse) *
            partial_output[partial_row * value_head_dim + dim];
      }
    }
    output[output_row + dim] = combined;
  }
}

__global__ __aicore__ void sparse_attention_head64_combine_kernel(
    __gm__ const float* partial_output,
    __gm__ const float* partial_lse,
    __gm__ float* output,
    __gm__ float* lse,
    __gm__ const uint8_t* plan_gm) {
  KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_MIX_AIC_1_2);
  if ASCEND_IS_AIC {
    return;
  } else if ASCEND_IS_AIV {
    SparseAttentionHead64Plan plan;
    copy_head64_plan(&plan, plan_gm);
    const int32_t base_task = static_cast<int32_t>(
        AscendC::GetBlockIdx() / AscendC::GetTaskRatio());
    const uint32_t sub_block_index = AscendC::GetSubBlockIdx();
    if (head64_combine_is_canonical_v32_decode(plan)) {
      asc_vf_call<head64_combine_p4_vf>(
          dim3(1024, 1, 1),
          partial_output,
          partial_lse,
          output,
          lse,
          base_task,
          sub_block_index);
    } else {
      asc_vf_call<head64_combine_vf>(
          dim3(1024, 1, 1),
          partial_output,
          partial_lse,
          output,
          lse,
          plan.query_heads,
          plan.query_tokens,
          plan.head_group_count,
          plan.value_head_dim,
          plan.selected_partitions,
          base_task,
          sub_block_index);
    }
  }
}

}  // namespace

extern "C" void launch_sparse_attention_head64_probe_v2(
    int32_t* probe,
    uint8_t* plan_gm,
    const aten_dsa_sparse_attention_v2::SparseAttentionHead64Plan* plan,
    aclrtStream stream) {
  aclrtMemcpyAsync(
      plan_gm,
      sizeof(*plan),
      plan,
      sizeof(*plan),
      ACL_MEMCPY_HOST_TO_DEVICE,
      stream);
  sparse_attention_head64_probe_kernel
      <<<static_cast<uint32_t>(plan->used_core_num), 0, stream>>>(probe, plan_gm);
}

extern "C" void launch_sparse_attention_head64_qk_hd576_bf16_v2(
    const bfloat16_t* query,
    const bfloat16_t* keys,
    const int32_t* indices,
    float* scores,
    uint8_t* workspace,
    uint8_t* plan_gm,
    const aten_dsa_sparse_attention_v2::SparseAttentionHead64Plan* plan,
    aclrtStream stream) {
  aclrtMemcpyAsync(
      plan_gm,
      sizeof(*plan),
      plan,
      sizeof(*plan),
      ACL_MEMCPY_HOST_TO_DEVICE,
      stream);
  sparse_attention_head64_qk_kernel
      <<<static_cast<uint32_t>(plan->used_core_num), 0, stream>>>(
          const_cast<bfloat16_t*>(query),
          const_cast<bfloat16_t*>(keys),
          indices,
          scores,
          workspace,
          plan_gm);
}

extern "C" void launch_sparse_attention_head64_pv_hd576_bf16_v2(
    const float* scores,
    bfloat16_t* probabilities,
    const bfloat16_t* values,
    const int32_t* indices,
    float* task_output,
    float* partial_lse,
    uint8_t* workspace,
    uint8_t* plan_gm,
    bool causal,
    const aten_dsa_sparse_attention_v2::SparseAttentionHead64Plan* plan,
    aclrtStream stream) {
  aclrtMemcpyAsync(
      plan_gm,
      sizeof(*plan),
      plan,
      sizeof(*plan),
      ACL_MEMCPY_HOST_TO_DEVICE,
      stream);
  sparse_attention_head64_pv_kernel
      <<<static_cast<uint32_t>(plan->used_core_num), 0, stream>>>(
          scores,
          probabilities,
          const_cast<bfloat16_t*>(values),
          indices,
          task_output,
          partial_lse,
          workspace,
          plan_gm,
          static_cast<int32_t>(causal));
}

extern "C" void launch_sparse_attention_head64_combine_hd576_bf16_v2(
    const float* partial_output,
    const float* partial_lse,
    float* output,
    float* lse,
    uint8_t* plan_gm,
    const aten_dsa_sparse_attention_v2::SparseAttentionHead64Plan* plan,
    aclrtStream stream) {
  aclrtMemcpyAsync(
      plan_gm,
      sizeof(*plan),
      plan,
      sizeof(*plan),
      ACL_MEMCPY_HOST_TO_DEVICE,
      stream);
  sparse_attention_head64_combine_kernel
      <<<static_cast<uint32_t>(
             plan->task_count / plan->selected_partitions),
         0,
         stream>>>(partial_output, partial_lse, output, lse, plan_gm);
}
