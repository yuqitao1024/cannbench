constexpr uint8_t kAivToAicReady = 8;
constexpr uint8_t kAicToAivReady = 9;
constexpr uint8_t kAicToAivGatherSlot0 = 0;
constexpr uint8_t kAicToAivGatherSlot1 = 1;
constexpr uint8_t kAivToAicGatherSlot0 = 2;
constexpr uint8_t kAivToAicGatherSlot1 = 3;
constexpr uint8_t kVllmAicToAivSlotFree0 = 0;
constexpr uint8_t kVllmAicToAivSlotFree1 = 1;
constexpr uint8_t kVllmAicToAivSlotFree2 = 2;
constexpr uint8_t kVllmAivToAicSlotReady0 = 3;
constexpr uint8_t kVllmAivToAicSlotReady1 = 4;
constexpr uint8_t kVllmAivToAicSlotReady2 = 5;
constexpr uint8_t kVllmAivToAicQueryReady = 6;
constexpr uint8_t kVllmAivToAicScoreFree = 7;
constexpr uint8_t kVllmAicToAivScoreReady = 8;
constexpr uint8_t kVllmAivToAicProbabilityReady = 9;
constexpr uint8_t kVllmAivToAicPvFree = 10;
constexpr uint8_t kVllmAicToAivPvReady = 11;
constexpr uint32_t kHead64FusedTaskRatio = 2;
constexpr uint32_t kHead64FusedLaunchThreads = 1024;
constexpr uint32_t kHead64FusedActiveThreads = 1024;
constexpr uint32_t kHead64FusedActiveWarps = 32;
constexpr int32_t kHead64InvalidKvRowOffset = -1;
constexpr int32_t kHead64FusedGenericSelectedTile = kHead64SelectedTile;
constexpr int32_t kHead64FusedCanonicalSelectedTile = 256;
constexpr int32_t kHead64FusedGenericSelectedSubtile =
    kHead64FusedGenericSelectedTile;
constexpr int32_t kHead64FusedCanonicalSelectedSubtile = 128;
constexpr int32_t kHead64FusedMaxSelectedTile =
    kHead64FusedCanonicalSelectedTile;
constexpr int32_t kHead64FusedMaxSelectedSubtile =
    kHead64FusedCanonicalSelectedSubtile;
constexpr int32_t kHead64FusedMaxSelectedSubtileHalf =
    kHead64FusedMaxSelectedSubtile / 2;
constexpr int32_t kHead64FusedMaxSelectedOwnerRows =
    kHead64FusedMaxSelectedTile / 2;
constexpr uint32_t kHead64FusedPvBlockGapBytes = 64;
constexpr uint32_t kHead64FusedPvBlockGapElements = 16;
static_assert(
    kHead64FusedPvBlockGapElements * sizeof(float) ==
    kHead64FusedPvBlockGapBytes);
constexpr int32_t kHead64FusedGenericQkGatherSlots = 2;
constexpr int32_t kHead64FusedCanonicalQkGatherSlots = 1;
constexpr int32_t kHead64FusedGenericPvGatherSlots = 2;
constexpr int32_t kHead64FusedCanonicalPvGatherSlots = 1;
constexpr int32_t kHead64FusedGenericQkTile = kHead64QkTile;
constexpr int32_t kHead64FusedCanonicalQkTile = 256;
constexpr int32_t kHead64FusedMaxQkTile = kHead64FusedCanonicalQkTile;
constexpr int32_t kHead64FusedGenericValueTile = kHead64ValueTile;
constexpr int32_t kHead64FusedCanonicalValueTile = 256;
constexpr int32_t kHead64FusedMaxValueTile = kHead64FusedCanonicalValueTile;
constexpr int32_t kHead64FusedVllmSelectedTile = 128;
constexpr int32_t kHead64FusedVllmSelectedHalf = 64;
constexpr int32_t kHead64FusedVllmRollingSlots = 3;
constexpr int32_t kHead64FusedVllmQkTile = 256;
constexpr int32_t kHead64FusedVllmValueTile = 256;
constexpr uint8_t kHead64FusedVllmDualDstCtl = 1;
constexpr uint8_t kHead64FusedCanonicalValueFractals =
    kHead64FusedCanonicalSelectedSubtile / 16 *
    kHead64FusedCanonicalValueTile / 16;
constexpr uint32_t kHead64FusedMaxValueBlocks =
    kHead64FusedMaxValueTile / 16;
constexpr uint32_t kHead64FusedL1CanonicalKeySlotBytes =
    kHead64FusedMaxQkTile * kHead64FusedCanonicalSelectedSubtile *
    sizeof(bfloat16_t);
constexpr uint32_t kHead64FusedL1GenericKeySlotBytes =
    kHead64FusedMaxQkTile * kHead64FusedGenericSelectedSubtile *
    sizeof(bfloat16_t);
constexpr uint32_t kHead64FusedL1QkKeyStorageBytes =
    kHead64FusedL1CanonicalKeySlotBytes;
static_assert(
    kHead64FusedL1QkKeyStorageBytes >=
    kHead64FusedGenericQkGatherSlots * kHead64FusedL1GenericKeySlotBytes);
constexpr uint32_t kHead64FusedL1CanonicalValueSlotBytes =
    kHead64FusedCanonicalSelectedSubtile * kHead64FusedMaxValueTile *
    sizeof(bfloat16_t);
constexpr uint32_t kHead64FusedL1GenericValueSlotBytes =
    kHead64FusedGenericSelectedSubtile * kHead64FusedMaxValueTile *
    sizeof(bfloat16_t);
constexpr uint32_t kHead64FusedL1PvValueStorageBytes =
    kHead64FusedL1CanonicalValueSlotBytes;
static_assert(
    kHead64FusedL1PvValueStorageBytes >=
    kHead64FusedGenericPvGatherSlots * kHead64FusedL1GenericValueSlotBytes);
constexpr uint32_t kHead64FusedL1PersistentQueryOffset = 0;
constexpr uint32_t kHead64FusedL1PersistentQueryBytes =
    kHead64Tile * 576 * sizeof(bfloat16_t);
constexpr uint32_t kHead64FusedL1QkQueryOffset = kHead64FusedL1PersistentQueryOffset;
constexpr uint32_t kHead64FusedL1QkKeysOffset =
    kHead64FusedL1PersistentQueryBytes;
constexpr uint32_t kHead64FusedL1QkScoresOffset =
    kHead64FusedL1QkKeysOffset + kHead64FusedL1QkKeyStorageBytes;
constexpr uint32_t kHead64FusedL1QkBytes =
    kHead64FusedL1QkScoresOffset +
    kHead64Tile * kHead64FusedMaxSelectedTile * sizeof(float);
constexpr uint32_t kHead64FusedL1PvProbabilitiesOffset =
    kHead64FusedL1PersistentQueryBytes;
constexpr uint32_t kHead64FusedL1PvValuesOffset =
    kHead64FusedL1PvProbabilitiesOffset +
    kHead64Tile * kHead64FusedMaxSelectedTile * sizeof(bfloat16_t);
constexpr uint32_t kHead64FusedL1PvPvOffset =
    kHead64FusedL1PvValuesOffset + kHead64FusedL1PvValueStorageBytes;
constexpr uint32_t kHead64FusedL1PvBytes =
    kHead64FusedL1PvPvOffset +
    kHead64Tile * kHead64FusedMaxValueTile * sizeof(float);
constexpr uint32_t kHead64FusedLegacyL1Bytes = kHead64FusedL1PvBytes;
static_assert(kHead64FusedL1PvBytes >= kHead64FusedL1QkBytes);

constexpr uint32_t kHead64FusedVllmL1QueryOffset = 0;
constexpr uint32_t kHead64FusedVllmL1QueryBytes = 73728;
constexpr uint32_t kHead64FusedVllmL1KvSlotsOffset =
    kHead64FusedVllmL1QueryOffset + kHead64FusedVllmL1QueryBytes;
constexpr uint32_t kHead64FusedVllmL1KvSlotBytes = 147456;
constexpr uint32_t kHead64FusedVllmL1ProbabilityOffset = 131072;
constexpr uint32_t kHead64FusedVllmL1Bytes = 516096;
constexpr uint32_t kHead64FusedL1Bytes =
    kHead64FusedLegacyL1Bytes > kHead64FusedVllmL1Bytes
    ? kHead64FusedLegacyL1Bytes
    : kHead64FusedVllmL1Bytes;
static_assert(kHead64FusedVllmL1QueryBytes == 64 * 576 * sizeof(bfloat16_t));
static_assert(kHead64FusedVllmL1KvSlotBytes == 128 * 576 * sizeof(bfloat16_t));
static_assert(
    kHead64FusedVllmL1Bytes ==
    kHead64FusedVllmL1KvSlotsOffset +
        kHead64FusedVllmRollingSlots * kHead64FusedVllmL1KvSlotBytes);
static_assert(
    kHead64FusedVllmL1ProbabilityOffset ==
    128 * 512 * sizeof(bfloat16_t));
static_assert(kHead64FusedVllmL1Bytes == 516096);
static_assert(kHead64FusedVllmL1Bytes <= 512 * 1024);

constexpr uint32_t kHead64FusedUbRunningMaxOffset = 0;
constexpr uint32_t kHead64FusedUbRunningSumOffset =
    kHead64FusedUbRunningMaxOffset + 32 * sizeof(float);
constexpr uint32_t kHead64FusedUbOldScaleOffset =
    kHead64FusedUbRunningSumOffset + 32 * sizeof(float);
constexpr uint32_t kHead64FusedUbRunningOutputOffset =
    kHead64FusedUbOldScaleOffset + 32 * sizeof(float);
constexpr uint32_t kHead64FusedUbKvRowOffsetsOffset =
    kHead64FusedUbRunningOutputOffset + 32 * 512 * sizeof(float);
constexpr uint32_t kHead64FusedUbKvRowOffsetsBytes =
    kHead64FusedMaxSelectedOwnerRows * sizeof(int32_t);
constexpr uint32_t kHead64FusedUbPersistentBytes =
    kHead64FusedUbKvRowOffsetsOffset + kHead64FusedUbKvRowOffsetsBytes;

constexpr uint32_t kHead64FusedUbQkQueryOffset =
    kHead64FusedUbPersistentBytes;
constexpr uint32_t kHead64FusedUbQkKeysOffset =
    kHead64FusedUbQkQueryOffset + 32 * 576 * sizeof(bfloat16_t);
constexpr uint32_t kHead64FusedUbQkScoresOffset =
    kHead64FusedUbQkKeysOffset +
    kHead64FusedMaxQkTile * kHead64FusedMaxSelectedSubtileHalf *
        sizeof(bfloat16_t);
constexpr uint32_t kHead64FusedUbQkBytes =
    kHead64FusedUbQkScoresOffset +
    32 * kHead64FusedMaxSelectedTile * sizeof(float);

constexpr uint32_t kHead64FusedUbPvProbabilitiesOffset =
    kHead64FusedUbPersistentBytes;
constexpr uint32_t kHead64FusedUbPvValuesOffset =
    kHead64FusedUbPvProbabilitiesOffset;
constexpr uint32_t kHead64FusedUbValueStagingOffset =
    kHead64FusedUbPvValuesOffset +
    kHead64FusedMaxSelectedSubtileHalf * kHead64FusedMaxValueTile *
        sizeof(bfloat16_t);
constexpr uint32_t kHead64FusedUbValueStagingBytes =
    kHead64FusedMaxSelectedSubtileHalf * kHead64FusedMaxValueTile *
    sizeof(bfloat16_t);
constexpr uint32_t kHead64FusedUbPvOffset =
    kHead64FusedUbValueStagingOffset + kHead64FusedUbValueStagingBytes;
constexpr uint32_t kHead64FusedUbPvResultBytes =
    32 * kHead64FusedMaxValueTile * sizeof(float) +
    (kHead64FusedMaxValueBlocks - 1) * kHead64FusedPvBlockGapBytes;
constexpr uint32_t kHead64FusedUbPvBytes =
    kHead64FusedUbPvOffset + kHead64FusedUbPvResultBytes;
constexpr uint32_t kHead64FusedUbBytes = kHead64FusedUbQkBytes;
static_assert(kHead64FusedUbQkBytes >= kHead64FusedUbPvBytes);

constexpr uint32_t kHead64FusedVllmUbRunningMaxOffset = 0;
constexpr uint32_t kHead64FusedVllmUbRunningSumOffset =
    kHead64FusedVllmUbRunningMaxOffset + 32 * sizeof(float);
constexpr uint32_t kHead64FusedVllmUbOldScaleOffset =
    kHead64FusedVllmUbRunningSumOffset + 32 * sizeof(float);
constexpr uint32_t kHead64FusedVllmUbRunningOutputOffset =
    kHead64FusedVllmUbOldScaleOffset +
    kHead64FusedVllmRollingSlots * 32 * sizeof(float);
constexpr uint32_t kHead64FusedVllmUbKvRowOffsetsOffset =
    kHead64FusedVllmUbRunningOutputOffset + 32 * 512 * sizeof(float);
constexpr uint32_t kHead64FusedVllmUbKvRowOffsetsBytes =
    kHead64FusedVllmSelectedHalf * sizeof(int32_t);
constexpr uint32_t kHead64FusedVllmUbGatherOffset =
    kHead64FusedVllmUbKvRowOffsetsOffset +
    kHead64FusedVllmUbKvRowOffsetsBytes;
constexpr uint32_t kHead64FusedVllmUbGatherBytes =
    32 * 576 * sizeof(bfloat16_t);
constexpr uint32_t kHead64FusedVllmUbScoresOffset =
    kHead64FusedVllmUbGatherOffset + kHead64FusedVllmUbGatherBytes;
constexpr uint32_t kHead64FusedVllmUbScoresBytes =
    32 * kHead64FusedVllmSelectedTile * sizeof(float);
constexpr uint32_t kHead64FusedVllmUbProbabilitiesOffset =
    kHead64FusedVllmUbScoresOffset + kHead64FusedVllmUbScoresBytes;
constexpr uint32_t kHead64FusedVllmUbProbabilitiesBytes =
    32 * kHead64FusedVllmSelectedTile * sizeof(bfloat16_t);
constexpr uint32_t kHead64FusedVllmUbPvOffset =
    kHead64FusedVllmUbProbabilitiesOffset +
    kHead64FusedVllmUbProbabilitiesBytes;
constexpr uint32_t kHead64FusedVllmUbPvBytes =
    32 * kHead64FusedVllmValueTile * sizeof(float);
constexpr uint32_t kHead64FusedVllmUbBytes =
    kHead64FusedVllmUbPvOffset + kHead64FusedVllmUbPvBytes;
constexpr uint32_t kHead64FusedDynamicUbBytes =
    kHead64FusedUbBytes > kHead64FusedVllmUbBytes
    ? kHead64FusedUbBytes
    : kHead64FusedVllmUbBytes;
static_assert(kHead64FusedVllmUbBytes == 160640);
static_assert(kHead64FusedDynamicUbBytes <= 216 * 1024);

__aicore__ inline bool head64_fused_is_canonical_v32_decode(
    const SparseAttentionHead64Plan& plan,
    int32_t causal) {
  return causal != 0 && plan.used_core_num == 32 && plan.task_count == 32 &&
      plan.batch_size == 2 && plan.query_heads == 128 &&
      plan.query_tokens == 2 && plan.context_tokens == 32768 &&
      plan.selected_tokens == 2048 && plan.qk_head_dim == 576 &&
      plan.value_head_dim == 512 && plan.head_tile == 64 &&
      plan.head_group_count == 2 && plan.selected_tile == 64 &&
      plan.selected_partitions == 4 &&
      plan.selected_partition_tile_capacity == 8 &&
      plan.output_mode == kHead64OutputPartialFloat;
}

__aicore__ inline bool head64_fused_is_vllm_rolling_decode(
    const SparseAttentionHead64Plan& plan,
    int32_t causal) {
  return causal != 0 && plan.used_core_num == 8 && plan.task_count == 8 &&
      plan.batch_size == 2 && plan.query_heads == 128 &&
      plan.query_tokens == 2 && plan.context_tokens == 32768 &&
      plan.selected_tokens == 2048 && plan.qk_head_dim == 576 &&
      plan.value_head_dim == 512 && plan.head_tile == 64 &&
      plan.head_group_count == 2 && plan.selected_tile == 64 &&
      plan.selected_partitions == 1 &&
      plan.selected_partition_tile_capacity == 32 &&
      plan.output_mode == kHead64OutputDirectBfloat16;
}

__aicore__ inline void head64_vllm_aic_release_l1_slot(uint32_t slot) {
  if (slot == 0) {
    AscendC::CrossCoreSetFlag<2, PIPE_MTE1>(kVllmAicToAivSlotFree0);
  } else if (slot == 1) {
    AscendC::CrossCoreSetFlag<2, PIPE_MTE1>(kVllmAicToAivSlotFree1);
  } else {
    AscendC::CrossCoreSetFlag<2, PIPE_MTE1>(kVllmAicToAivSlotFree2);
  }
}

__aicore__ inline void head64_vllm_aiv_wait_l1_slot(uint32_t slot) {
  if (slot == 0) {
    AscendC::CrossCoreWaitFlag<2, PIPE_V>(kVllmAicToAivSlotFree0);
  } else if (slot == 1) {
    AscendC::CrossCoreWaitFlag<2, PIPE_V>(kVllmAicToAivSlotFree1);
  } else {
    AscendC::CrossCoreWaitFlag<2, PIPE_V>(kVllmAicToAivSlotFree2);
  }
}

__aicore__ inline void head64_vllm_aiv_publish_l1_slot(uint32_t slot) {
  if (slot == 0) {
    AscendC::CrossCoreSetFlag<2, PIPE_MTE3>(kVllmAivToAicSlotReady0);
  } else if (slot == 1) {
    AscendC::CrossCoreSetFlag<2, PIPE_MTE3>(kVllmAivToAicSlotReady1);
  } else {
    AscendC::CrossCoreSetFlag<2, PIPE_MTE3>(kVllmAivToAicSlotReady2);
  }
}

__aicore__ inline void head64_vllm_aic_wait_l1_slot(uint32_t slot) {
  if (slot == 0) {
    AscendC::CrossCoreWaitFlag<2, PIPE_MTE1>(kVllmAivToAicSlotReady0);
  } else if (slot == 1) {
    AscendC::CrossCoreWaitFlag<2, PIPE_MTE1>(kVllmAivToAicSlotReady1);
  } else {
    AscendC::CrossCoreWaitFlag<2, PIPE_MTE1>(kVllmAivToAicSlotReady2);
  }
}

__aicore__ inline void head64_vllm_copy_query_half_ub_to_l1(
    __cbuf__ bfloat16_t* l1_query,
    __ubuf__ bfloat16_t* ub_query,
    int32_t head_begin) {
  constexpr uint16_t kColumnBlocks = 576 / 16;
  constexpr uint16_t kHalfRowsInBlocks = 32;
  constexpr uint16_t kFullToHalfRowGapInBlocks = 32;
  asc_copy_ub2l1(
      l1_query + head_begin * 16,
      ub_query,
      kColumnBlocks,
      kHalfRowsInBlocks,
      0,
      kFullToHalfRowGapInBlocks);
}

__aicore__ inline void head64_vllm_copy_kv_half_ub_to_l1(
    __cbuf__ bfloat16_t* l1_kv,
    __ubuf__ bfloat16_t* ub_kv,
    int32_t k_start,
    int32_t current_k,
    int32_t selected_begin) {
  constexpr uint16_t kHalfSelectedRowsInBlocks = 64;
  constexpr uint16_t kFullToHalfSelectedGapInBlocks = 64;
  asc_copy_ub2l1(
      l1_kv + k_start * kHead64FusedVllmSelectedTile + selected_begin * 16,
      ub_kv,
      static_cast<uint16_t>(current_k / 16),
      kHalfSelectedRowsInBlocks,
      0,
      kFullToHalfSelectedGapInBlocks);
}

__aicore__ inline void head64_vllm_copy_probability_half_ub_to_l1(
    __cbuf__ bfloat16_t* l1_probability,
    __ubuf__ bfloat16_t* ub_probability,
    int32_t head_begin) {
  constexpr uint16_t kSelectedBlocks =
      kHead64FusedVllmSelectedTile / 16;
  constexpr uint16_t kHalfRowsInBlocks = 32;
  constexpr uint16_t kFullToHalfRowGapInBlocks = 32;
  asc_copy_ub2l1(
      l1_probability + head_begin * 16,
      ub_probability,
      kSelectedBlocks,
      kHalfRowsInBlocks,
      0,
      kFullToHalfRowGapInBlocks);
}

