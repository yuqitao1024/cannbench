using namespace AscendC::Te;
using aten_dsa_sparse_attention_v2::kHead64QkTile;
using aten_dsa_sparse_attention_v2::kHead64OutputDirectBfloat16;
using aten_dsa_sparse_attention_v2::kHead64OutputPartialFloat;
using aten_dsa_sparse_attention_v2::kHead64SelectedTile;
using aten_dsa_sparse_attention_v2::kHead64Tile;
using aten_dsa_sparse_attention_v2::kHead64ValueTile;
using aten_dsa_sparse_attention_v2::SparseAttentionHead64Plan;
using aten_dsa_sparse_attention_v2::head64::Head64Task;
using aten_dsa_sparse_attention_v2::head64::copy_head64_plan;
using aten_dsa_sparse_attention_v2::head64::decode_head64_task;
using aten_dsa_sparse_attention_v2::head64::head64_partition_begin;
using aten_dsa_sparse_attention_v2::head64::head64_partition_end;
using aten_dsa_sparse_attention_v2::head64::head64_warp_max;
using aten_dsa_sparse_attention_v2::head64::head64_warp_sum;

constexpr uint8_t kAivToAicReady = 8;
constexpr uint8_t kAicToAivReady = 9;
constexpr uint8_t kAicToAivGatherSlot0 = 0;
constexpr uint8_t kAicToAivGatherSlot1 = 1;
constexpr uint8_t kAivToAicGatherSlot0 = 2;
constexpr uint8_t kAivToAicGatherSlot1 = 3;
constexpr uint32_t kHead64FusedLaunchThreads = 1024;
constexpr uint32_t kHead64FusedActiveThreads = 1024;
constexpr uint32_t kHead64FusedActiveWarps = 32;
constexpr int32_t kHead64InvalidKvRowOffset = -1;
constexpr uint32_t kHead64FusedGatherSlots = 2;
constexpr int32_t kHead64FusedGenericValueTile = kHead64ValueTile;
constexpr int32_t kHead64FusedCanonicalValueTile = 256;
constexpr int32_t kHead64FusedMaxValueTile = kHead64FusedCanonicalValueTile;
constexpr uint32_t kHead64FusedL1KeySlotBytes =
    kHead64QkTile * kHead64SelectedTile * sizeof(bfloat16_t);
constexpr uint32_t kHead64FusedL1ValueSlotBytes =
    kHead64SelectedTile * kHead64FusedMaxValueTile * sizeof(bfloat16_t);
constexpr uint32_t kHead64FusedL1PersistentQueryOffset = 0;
constexpr uint32_t kHead64FusedL1PersistentQueryBytes =
    kHead64Tile * 576 * sizeof(bfloat16_t);
constexpr uint32_t kHead64FusedL1QkQueryOffset = kHead64FusedL1PersistentQueryOffset;
constexpr uint32_t kHead64FusedL1QkKeysOffset =
    kHead64FusedL1PersistentQueryBytes;
constexpr uint32_t kHead64FusedL1QkScoresOffset =
    kHead64FusedL1QkKeysOffset +
    kHead64FusedGatherSlots * kHead64FusedL1KeySlotBytes;
constexpr uint32_t kHead64FusedL1QkBytes =
    kHead64FusedL1QkScoresOffset +
    kHead64Tile * kHead64SelectedTile * sizeof(float);
constexpr uint32_t kHead64FusedL1PvProbabilitiesOffset =
    kHead64FusedL1PersistentQueryBytes;
constexpr uint32_t kHead64FusedL1PvValuesOffset =
    kHead64FusedL1PvProbabilitiesOffset +
    kHead64Tile * kHead64SelectedTile * sizeof(bfloat16_t);
constexpr uint32_t kHead64FusedL1PvPvOffset =
    kHead64FusedL1PvValuesOffset +
    kHead64FusedGatherSlots * kHead64FusedL1ValueSlotBytes;
constexpr uint32_t kHead64FusedL1PvBytes =
    kHead64FusedL1PvPvOffset +
    kHead64Tile * kHead64FusedMaxValueTile * sizeof(float);
constexpr uint32_t kHead64FusedL1Bytes = kHead64FusedL1PvBytes;
static_assert(kHead64FusedL1PvBytes >= kHead64FusedL1QkBytes);
constexpr uint32_t kHead64FusedUbQueryOffset = 0;
constexpr uint32_t kHead64FusedUbKeysOffset =
    kHead64FusedUbQueryOffset + 32 * 576 * sizeof(bfloat16_t);
constexpr uint32_t kHead64FusedUbScoresOffset =
    kHead64FusedUbKeysOffset + kHead64QkTile * 32 * sizeof(bfloat16_t);
constexpr uint32_t kHead64FusedUbProbabilitiesOffset =
    kHead64FusedUbScoresOffset +
    32 * kHead64SelectedTile * sizeof(float);
constexpr uint32_t kHead64FusedUbValuesOffset =
    kHead64FusedUbProbabilitiesOffset +
    32 * kHead64SelectedTile * sizeof(bfloat16_t);
constexpr uint32_t kHead64FusedUbPvOffset =
    kHead64FusedUbValuesOffset +
    32 * kHead64FusedMaxValueTile * sizeof(bfloat16_t);
constexpr uint32_t kHead64FusedUbRunningMaxOffset =
    kHead64FusedUbPvOffset +
    32 * kHead64FusedMaxValueTile * sizeof(float);
constexpr uint32_t kHead64FusedUbRunningSumOffset =
    kHead64FusedUbRunningMaxOffset + 32 * sizeof(float);
constexpr uint32_t kHead64FusedUbOldScaleOffset =
    kHead64FusedUbRunningSumOffset + 32 * sizeof(float);
constexpr uint32_t kHead64FusedUbRunningOutputOffset =
    kHead64FusedUbOldScaleOffset + 32 * sizeof(float);
constexpr uint32_t kHead64FusedUbKvRowOffsetsOffset =
    kHead64FusedUbRunningOutputOffset + 32 * 512 * sizeof(float);
constexpr uint32_t kHead64FusedUbKvRowOffsetsBytes = 32 * sizeof(int32_t);
constexpr uint32_t kHead64FusedUbValueStagingOffset =
    kHead64FusedUbKvRowOffsetsOffset + kHead64FusedUbKvRowOffsetsBytes;
constexpr uint32_t kHead64FusedUbValueStagingBytes =
    32 * kHead64FusedMaxValueTile * sizeof(bfloat16_t);
constexpr uint32_t kHead64FusedUbBytes =
    kHead64FusedUbValueStagingOffset + kHead64FusedUbValueStagingBytes;

__aicore__ inline bool head64_fused_is_canonical_v32_decode(
    const SparseAttentionHead64Plan& plan,
    int32_t causal) {
  return causal != 0 && plan.used_core_num == 32 && plan.task_count == 32 &&
      plan.batch_size == 2 && plan.query_heads == 128 &&
      plan.query_tokens == 2 && plan.context_tokens == 32768 &&
      plan.selected_tokens == 2048 && plan.qk_head_dim == 576 &&
      plan.value_head_dim == 512 && plan.head_tile == 64 &&
      plan.head_group_count == 2 && plan.selected_tile == 64 &&
      plan.selected_partitions == 4 &&
      plan.selected_partition_tile_capacity == 8 &&
      plan.output_mode == kHead64OutputPartialFloat;
}

__aicore__ inline void head64_aic_request_gather_slot(uint32_t slot) {
  if (slot == 0) {
    AscendC::CrossCoreSetFlag<2, PIPE_MTE1>(kAicToAivGatherSlot0);
  } else {
    AscendC::CrossCoreSetFlag<2, PIPE_MTE1>(kAicToAivGatherSlot1);
  }
}

__aicore__ inline void head64_aiv_wait_gather_slot(uint32_t slot) {
  if (slot == 0) {
    AscendC::CrossCoreWaitFlag<2, PIPE_V>(kAicToAivGatherSlot0);
  } else {
    AscendC::CrossCoreWaitFlag<2, PIPE_V>(kAicToAivGatherSlot1);
  }
}

__aicore__ inline void head64_aiv_publish_gather_slot(uint32_t slot) {
  if (slot == 0) {
    AscendC::CrossCoreSetFlag<2, PIPE_MTE3>(kAivToAicGatherSlot0);
  } else {
    AscendC::CrossCoreSetFlag<2, PIPE_MTE3>(kAivToAicGatherSlot1);
  }
}

__aicore__ inline void head64_aic_wait_gather_slot(uint32_t slot) {
  if (slot == 0) {
    AscendC::CrossCoreWaitFlag<2, PIPE_MTE1>(kAivToAicGatherSlot0);
  } else {
    AscendC::CrossCoreWaitFlag<2, PIPE_MTE1>(kAivToAicGatherSlot1);
  }
}

struct Head64QkMmadTrait {
  using TraitType = MmadTrait;
  static constexpr const TraitType value =
      MmadTrait(0, false, false, false, MmadType::NORMAL);
};

struct Head64PvMmadTrait {
  using TraitType = MmadTrait;
  static constexpr const TraitType value =
      MmadTrait(0, false, false, false, MmadType::NORMAL);
};

__aicore__ inline void head64_copy_l0c_to_l1_nz(
    __cbuf__ float* dst,
    __cc__ float* src,
    uint16_t n_size,
    uint16_t m_size) {
  const uint16_t aligned_m =
      static_cast<uint16_t>((m_size + 15U) / 16U * 16U);
  const uint32_t dst_stride = static_cast<uint32_t>(aligned_m) * 16U;
  asc_copy_l0c2l1_sync(
      dst,
      src,
      n_size,
      m_size,
      dst_stride,
      aligned_m,
      0,
      0,
      0,
      0,
      0,
      false,
      false,
      0,
      0,
      false,
      0,
      false,
      false,
      false,
      false);
}

__SIMT_DEVICE_FUNCTIONS_DECL__ inline uint32_t head64_fused_nz_offset(
    uint32_t row,
    uint32_t column,
    uint32_t row_count) {
  return (column / 16U) * 16U * row_count +
      (row / 16U) * 16U * 16U + (row % 16U) * 16U + column % 16U;
}

__SIMT_DEVICE_FUNCTIONS_DECL__ inline void head64_fused_query_pack_row(
    __gm__ const bfloat16_t* query,
    __ubuf__ bfloat16_t* packed_query,
    int32_t batch_index,
    int32_t query_token,
    int32_t head_base,
    int32_t head_begin,
    uint32_t local_head,
    uint32_t lane,
    int32_t query_heads,
    int32_t query_tokens,
    int32_t qk_head_dim) {
  const int32_t head = head_base + head_begin + local_head;
  for (uint32_t dim_index = lane;
       dim_index < static_cast<uint32_t>(qk_head_dim);
       dim_index += 32) {
    const int64_t source_offset =
        ((static_cast<int64_t>(batch_index) * query_heads + head) *
             query_tokens +
         query_token) *
            qk_head_dim +
        dim_index;
    const uint32_t packed_offset =
        (dim_index / 16) * 16 * 32 + (local_head / 16) * 16 * 16 +
        (local_head % 16) * 16 + dim_index % 16;
    packed_query[packed_offset] = query[source_offset];
  }
}

__simt_vf__ __aicore__ __launch_bounds__(1024) inline void
head64_fused_query_pack_vf(
    __gm__ const bfloat16_t* query,
    __ubuf__ bfloat16_t* packed_query,
    int32_t batch_index,
    int32_t query_token,
    int32_t head_base,
    int32_t head_begin,
    int32_t query_heads,
    int32_t query_tokens,
    int32_t qk_head_dim) {
  if (threadIdx.x >= kHead64FusedActiveThreads) {
    return;
  }
  const uint32_t warp = threadIdx.x / 32;
  const uint32_t lane = threadIdx.x % 32;
  head64_fused_query_pack_row(
      query,
      packed_query,
      batch_index,
      query_token,
      head_base,
      head_begin,
      warp,
      lane,
      query_heads,
      query_tokens,
      qk_head_dim);
}

__simt_vf__ __aicore__ __launch_bounds__(1024) inline void
head64_fused_key_pack_vf(
    __gm__ const bfloat16_t* keys,
    __gm__ const int32_t* indices,
    __ubuf__ bfloat16_t* packed_keys,
    int32_t batch_index,
    int32_t query_token,
    int32_t selected_start,
    int32_t selected_begin,
    int32_t current_selected,
    int32_t k_start,
    int32_t current_k,
    int32_t query_tokens,
    int32_t context_tokens,
    int32_t selected_tokens,
    int32_t qk_head_dim) {
  if (threadIdx.x >= kHead64FusedActiveThreads) {
    return;
  }
  const uint32_t warp = threadIdx.x / 32;
  const uint32_t lane = threadIdx.x % 32;
  for (uint32_t local_selected = warp;
       local_selected < 32;
       local_selected += kHead64FusedActiveWarps) {
    const int32_t selected_offset = selected_begin + local_selected;
    const int32_t selected_index = selected_start + selected_offset;
    int32_t context_index = -1;
    if (selected_offset < current_selected) {
      context_index = indices[
          (static_cast<int64_t>(batch_index) * query_tokens + query_token) *
              selected_tokens +
          selected_index];
    }
    for (uint32_t dim_offset = lane;
         dim_offset < static_cast<uint32_t>(current_k);
         dim_offset += 32) {
      const uint32_t packed_offset =
          (dim_offset / 16) * 16 * 32 +
          (local_selected / 16) * 16 * 16 +
          (local_selected % 16) * 16 + dim_offset % 16;
      packed_keys[packed_offset] =
          context_index < 0 || context_index >= context_tokens
          ? static_cast<bfloat16_t>(0.0F)
          : keys[(static_cast<int64_t>(batch_index) * context_tokens +
                  context_index) *
                     qk_head_dim +
                 k_start + dim_offset];
    }
  }
}

__simt_vf__ __aicore__ __launch_bounds__(1024) inline void
head64_fused_key_pack_prepare_vf(
    __gm__ const bfloat16_t* kv_batch,
    __gm__ const int32_t* tile_indices,
    __ubuf__ int32_t* kv_row_offsets,
    __ubuf__ bfloat16_t* packed_keys) {
  if (threadIdx.x >= kHead64FusedActiveThreads) {
    return;
  }
  const uint32_t warp = threadIdx.x / 32;
  const uint32_t lane = threadIdx.x % 32;
  int32_t context_index = lane == 0 ? tile_indices[warp] : -1;
  for (int32_t offset = 16; offset > 0; offset /= 2) {
    const int32_t peer = asc_shfl_xor(context_index, offset, 32);
    context_index = context_index < 0 ? peer : context_index;
  }
  const int32_t row_offset =
      context_index >= 0 && context_index < 32768
      ? context_index * 576
      : kHead64InvalidKvRowOffset;
  if (lane == 0) {
    kv_row_offsets[warp] = row_offset;
  }
  for (uint32_t dim = lane; dim < 128; dim += 32) {
    const uint32_t packed_offset =
        (dim / 16) * 16 * 32 + (warp / 16) * 16 * 16 +
        (warp % 16) * 16 + dim % 16;
    packed_keys[packed_offset] = row_offset == kHead64InvalidKvRowOffset
        ? static_cast<bfloat16_t>(0.0F)
        : kv_batch[row_offset + dim];
  }
}

__simt_vf__ __aicore__ __launch_bounds__(1024) inline void
head64_fused_key_pack_fast_vf(
    __gm__ const bfloat16_t* kv_batch,
    __ubuf__ const int32_t* kv_row_offsets,
    __ubuf__ bfloat16_t* packed_keys,
    int32_t dimension_start) {
  if (threadIdx.x >= kHead64FusedActiveThreads) {
    return;
  }
  const uint32_t warp = threadIdx.x / 32;
  const uint32_t lane = threadIdx.x % 32;
  const uint32_t current_dimension =
      dimension_start == 512 ? 64U : 128U;
  const int32_t row_offset = kv_row_offsets[warp];
  for (uint32_t dim = lane; dim < current_dimension; dim += 32) {
    const uint32_t packed_offset =
        (dim / 16) * 16 * 32 + (warp / 16) * 16 * 16 +
        (warp % 16) * 16 + dim % 16;
    packed_keys[packed_offset] = row_offset == kHead64InvalidKvRowOffset
        ? static_cast<bfloat16_t>(0.0F)
        : kv_batch[row_offset + dimension_start + dim];
  }
}

__simt_vf__ __aicore__ __launch_bounds__(1024) inline void
head64_fused_softmax_init_vf(
    __ubuf__ float* running_max_values,
    __ubuf__ float* running_sum_values,
    __ubuf__ float* old_scale_values) {
  if (threadIdx.x >= kHead64FusedActiveThreads) {
    return;
  }
  const uint32_t warp = threadIdx.x / 32;
  const uint32_t lane = threadIdx.x % 32;
  if (lane == 0) {
    for (uint32_t local_head = warp;
         local_head < 32;
         local_head += kHead64FusedActiveWarps) {
      running_max_values[local_head] =
          -std::numeric_limits<float>::infinity();
      running_sum_values[local_head] = 0.0F;
      old_scale_values[local_head] = 0.0F;
    }
  }
}

__simt_vf__ __aicore__ __launch_bounds__(1024) inline void
head64_fused_softmax_vf(
    __ubuf__ const float* ub_scores_buf,
    __ubuf__ bfloat16_t* ub_probabilities_buf,
    __ubuf__ float* running_max_values,
    __ubuf__ float* running_sum_values,
    __ubuf__ float* old_scale_values,
    __gm__ const int32_t* indices,
    int32_t batch_index,
    int32_t query_token,
    int32_t partition_begin,
    int32_t local_selected_start,
    int32_t current_selected,
    int32_t query_tokens,
    int32_t context_tokens,
    int32_t selected_tokens,
    float score_scale,
    int32_t causal) {
  if (threadIdx.x >= kHead64FusedActiveThreads) {
    return;
  }
  const uint32_t warp = threadIdx.x / 32;
  const uint32_t lane = threadIdx.x % 32;
  const int64_t indices_row =
      (static_cast<int64_t>(batch_index) * query_tokens + query_token) *
      selected_tokens;
  const int32_t causal_limit = context_tokens - query_tokens + query_token;
  for (uint32_t local_head = warp;
       local_head < 32;
       local_head += kHead64FusedActiveWarps) {
    float lane_max = -std::numeric_limits<float>::infinity();
    float lane_valid = 0.0F;
    for (int32_t selected = static_cast<int32_t>(lane);
         selected < current_selected;
         selected += 32) {
      const int32_t absolute_selected =
          partition_begin + local_selected_start + selected;
      const int32_t context_index = indices[indices_row + absolute_selected];
      const bool valid =
          context_index >= 0 && context_index < context_tokens &&
          (!causal || context_index <= causal_limit);
      if (valid) {
        const float score =
            ub_scores_buf[head64_fused_nz_offset(
                local_head, static_cast<uint32_t>(selected), 32U)] *
            score_scale;
        lane_max = lane_max < score ? score : lane_max;
        lane_valid = 1.0F;
      }
    }
    const float tile_max = head64_warp_max(lane_max);
    const float tile_valid = head64_warp_sum(lane_valid);
    const float running_max = running_max_values[local_head];
    const float running_sum = running_sum_values[local_head];
    const float new_max = tile_valid > 0.0F
        ? (running_sum > 0.0F && running_max > tile_max
               ? running_max
               : tile_max)
        : running_max;
    const float old_scale = running_sum > 0.0F
        ? __expf(running_max - new_max)
        : 0.0F;
    float lane_sum = 0.0F;
    for (int32_t selected = static_cast<int32_t>(lane);
         selected < kHead64SelectedTile;
         selected += 32) {
      float probability = 0.0F;
      if (selected < current_selected) {
        const int32_t absolute_selected =
            partition_begin + local_selected_start + selected;
        const int32_t context_index = indices[indices_row + absolute_selected];
        const bool valid =
            context_index >= 0 && context_index < context_tokens &&
            (!causal || context_index <= causal_limit);
        if (valid) {
          probability = __expf(
              ub_scores_buf[head64_fused_nz_offset(
                  local_head, static_cast<uint32_t>(selected), 32U)] *
                  score_scale -
              new_max);
          lane_sum += probability;
        }
      }
      const uint32_t probability_offset =
          (static_cast<uint32_t>(selected) / 16U) * 16U * 32U +
          (local_head / 16U) * 16U * 16U +
          (local_head % 16U) * 16U +
          static_cast<uint32_t>(selected) % 16U;
      ub_probabilities_buf[probability_offset] =
          static_cast<bfloat16_t>(probability);
    }
    const float tile_sum = head64_warp_sum(lane_sum);
    if (lane == 0) {
      old_scale_values[local_head] = old_scale;
      running_max_values[local_head] = new_max;
      running_sum_values[local_head] = old_scale * running_sum + tile_sum;
    }
  }
}

__simt_vf__ __aicore__ __launch_bounds__(1024) inline void
head64_fused_value_pack_vf(
    __gm__ const bfloat16_t* values,
    __gm__ const int32_t* indices,
    __ubuf__ bfloat16_t* packed_values,
    int32_t batch_index,
    int32_t query_token,
    int32_t partition_begin,
    int32_t local_selected_start,
    int32_t selected_begin,
    int32_t current_selected,
    int32_t value_start,
    int32_t current_value,
    int32_t query_tokens,
    int32_t context_tokens,
    int32_t selected_tokens,
    int32_t qk_head_dim) {
  if (threadIdx.x >= kHead64FusedActiveThreads) {
    return;
  }
  const uint32_t warp = threadIdx.x / 32;
  const uint32_t lane = threadIdx.x % 32;
  const uint32_t aligned_value =
      (static_cast<uint32_t>(current_value) + 15U) / 16U * 16U;
  for (uint32_t local_selected = warp;
       local_selected < 32;
       local_selected += kHead64FusedActiveWarps) {
    const int32_t selected_offset = selected_begin + local_selected;
    const int32_t absolute_selected =
        partition_begin + local_selected_start + selected_offset;
    int32_t context_index = -1;
    if (selected_offset < current_selected) {
      context_index = indices[
          (static_cast<int64_t>(batch_index) * query_tokens + query_token) *
              selected_tokens +
          absolute_selected];
    }
    for (int32_t dim = static_cast<int32_t>(lane);
         dim < current_value;
         dim += 32) {
      const uint32_t packed_offset =
          (local_selected / 16U) * 16U * aligned_value +
          (static_cast<uint32_t>(dim) / 16U) * 16U * 16U +
          (static_cast<uint32_t>(dim) % 16U) * 16U +
          local_selected % 16U;
      packed_values[packed_offset] =
          context_index < 0 || context_index >= context_tokens
          ? static_cast<bfloat16_t>(0.0F)
          : values[(static_cast<int64_t>(batch_index) * context_tokens +
                    context_index) *
                       qk_head_dim +
                   value_start + dim];
    }
  }
}

__simt_vf__ __aicore__ __launch_bounds__(1024) inline void
head64_fused_value_pack_fast_vf(
    __gm__ const bfloat16_t* kv_batch,
    __ubuf__ const int32_t* kv_row_offsets,
    __ubuf__ bfloat16_t* staged_values,
    int32_t dimension_start) {
  if (threadIdx.x >= kHead64FusedActiveThreads) {
    return;
  }
  const uint32_t warp = threadIdx.x / 32;
  const uint32_t lane = threadIdx.x % 32;
  const int32_t row_offset = kv_row_offsets[warp];
  for (uint32_t dim = lane; dim < kHead64FusedCanonicalValueTile; dim += 32) {
    const uint32_t row_block = warp / 16U;
    const uint32_t dim_block = dim / 16U;
    const uint32_t row_in_tile = warp % 16U;
    const uint32_t dim_in_tile = dim % 16U;
    const uint32_t tile_index = row_block * 16U + dim_block;
    const uint32_t staging_offset =
        tile_index * 16U * 16U + row_in_tile * 16U + dim_in_tile;
    staged_values[staging_offset] = row_offset == kHead64InvalidKvRowOffset
        ? static_cast<bfloat16_t>(0.0F)
        : kv_batch[row_offset + dimension_start + dim];
  }
}

__simt_vf__ __aicore__ __launch_bounds__(1024) inline void
head64_fused_output_init_vf(__ubuf__ float* running_output) {
  if (threadIdx.x >= kHead64FusedActiveThreads) {
    return;
  }
  for (uint32_t index = threadIdx.x;
       index < 32U * 512U;
       index += kHead64FusedActiveThreads) {
    running_output[index] = 0.0F;
  }
}

__simt_vf__ __aicore__ __launch_bounds__(1024) inline void
head64_fused_output_update_vf(
    __ubuf__ float* running_output,
    __ubuf__ const float* pv_tile,
    __ubuf__ const float* old_scale_values,
    int32_t value_start,
    int32_t current_value) {
  if (threadIdx.x >= kHead64FusedActiveThreads) {
    return;
  }
  const uint32_t warp = threadIdx.x / 32;
  const uint32_t lane = threadIdx.x % 32;
  for (uint32_t local_head = warp;
       local_head < 32;
       local_head += kHead64FusedActiveWarps) {
    const float old_scale = old_scale_values[local_head];
    for (int32_t dim = static_cast<int32_t>(lane);
         dim < current_value;
         dim += 32) {
      const int32_t output_dim = value_start + dim;
      running_output[local_head * 512 + output_dim] =
          old_scale * running_output[local_head * 512 + output_dim] +
          pv_tile[head64_fused_nz_offset(
              local_head, static_cast<uint32_t>(dim), 32U)];
    }
  }
}

__simt_vf__ __aicore__ __launch_bounds__(1024) inline void
head64_fused_output_write_vf(
    __gm__ float* task_output,
    __gm__ float* partial_lse,
    __gm__ bfloat16_t* output,
    __gm__ float* lse,
    __ubuf__ const float* running_output_values,
    __ubuf__ const float* running_max_values,
    __ubuf__ const float* running_sum_values,
    int32_t logical_task,
    Head64Task task,
    SparseAttentionHead64Plan plan,
    uint32_t subblock_index) {
  if (threadIdx.x >= kHead64FusedActiveThreads) {
    return;
  }
  const uint32_t warp = threadIdx.x / 32;
  const uint32_t lane = threadIdx.x % 32;
  for (uint32_t local_head = warp;
       local_head < 32;
       local_head += kHead64FusedActiveWarps) {
    const int32_t task_head =
        static_cast<int32_t>(subblock_index * 32 + local_head);
    const float running_max = running_max_values[local_head];
    const float running_sum = running_sum_values[local_head];
    const int32_t value_head_dim = plan.value_head_dim;
    if (plan.output_mode == kHead64OutputDirectBfloat16) {
      const int32_t global_head =
          task.head_group * kHead64Tile + task_head;
      const int64_t final_row =
          (static_cast<int64_t>(task.batch_index) * plan.query_heads +
           global_head) *
              plan.query_tokens +
          task.query_token;
      for (int32_t dim = static_cast<int32_t>(lane);
           dim < plan.value_head_dim;
           dim += 32) {
        output[final_row * plan.value_head_dim + dim] = running_sum > 0.0F
            ? static_cast<bfloat16_t>(
                  running_output_values[local_head * 512 + dim] / running_sum)
            : static_cast<bfloat16_t>(0.0F);
      }
      if (lane == 0) {
        lse[final_row] = running_sum > 0.0F
            ? running_max + logf(running_sum)
            : -std::numeric_limits<float>::infinity();
      }
    } else if (plan.output_mode == kHead64OutputPartialFloat) {
      const int64_t output_base =
          (static_cast<int64_t>(logical_task) * kHead64Tile + task_head) *
          value_head_dim;
      for (int32_t dim = static_cast<int32_t>(lane);
           dim < value_head_dim;
           dim += 32) {
        task_output[output_base + dim] = running_sum > 0.0F
            ? running_output_values[local_head * 512 + dim] / running_sum
            : 0.0F;
      }
      if (lane == 0) {
        partial_lse[
            static_cast<int64_t>(logical_task) * kHead64Tile + task_head] =
            running_sum > 0.0F
            ? running_max + logf(running_sum)
            : -std::numeric_limits<float>::infinity();
      }
    }
  }
}

__simt_vf__ __aicore__ __launch_bounds__(1024) inline void
head64_fused_init_vf(
    __gm__ float* task_output,
    __gm__ float* partial_lse,
    int32_t logical_task,
    int32_t value_head_dim,
    uint32_t subblock_index) {
  if (threadIdx.x >= kHead64FusedActiveThreads) {
    return;
  }
  const uint32_t warp = threadIdx.x / 32;
  const uint32_t lane = threadIdx.x % 32;
  for (uint32_t local_head = warp;
       local_head < 32;
       local_head += kHead64FusedActiveWarps) {
    const int32_t task_head =
        static_cast<int32_t>(subblock_index * 32 + local_head);
    const int64_t output_base =
        (static_cast<int64_t>(logical_task) * kHead64Tile + task_head) *
        value_head_dim;
    for (int32_t dim = static_cast<int32_t>(lane);
         dim < value_head_dim;
         dim += 32) {
      task_output[output_base + dim] = 0.0F;
    }
    if (lane == 0) {
      partial_lse[
          static_cast<int64_t>(logical_task) * kHead64Tile + task_head] =
          -std::numeric_limits<float>::infinity();
    }
  }
}

__aicore__ inline void head64_fused_gather_value_slot(
    __gm__ const bfloat16_t* shared_kv,
    __gm__ const int32_t* indices,
    __cbuf__ uint8_t* l1_workspace,
    __ubuf__ uint8_t* ub_workspace,
    uint32_t slot,
    int32_t batch_index,
    int32_t query_token,
    int32_t partition_begin,
    int32_t local_selected_start,
    int32_t selected_begin,
    int32_t current_selected,
    int32_t value_start,
    int32_t current_value,
    int32_t query_tokens,
    int32_t context_tokens,
    int32_t selected_tokens,
    int32_t qk_head_dim) {
  head64_aiv_wait_gather_slot(slot);
  auto ub_values_slot = reinterpret_cast<__ubuf__ bfloat16_t*>(
      ub_workspace + kHead64FusedUbValuesOffset);
  asc_vf_call<head64_fused_value_pack_vf>(
      dim3(kHead64FusedLaunchThreads, 1, 1),
      shared_kv,
      indices,
      ub_values_slot,
      batch_index,
      query_token,
      partition_begin,
      local_selected_start,
      selected_begin,
      current_selected,
      value_start,
      current_value,
      query_tokens,
      context_tokens,
      selected_tokens,
      qk_head_dim);
  asc_sync_notify(PIPE_V, PIPE_MTE3, EVENT_ID0);
  asc_sync_wait(PIPE_V, PIPE_MTE3, EVENT_ID0);
  auto ub_values = MakeTensor(
      MakeMemPtr(ub_values_slot),
      MakeFrameLayout<ZNLayoutPtn, bfloat16_t>(32, current_value));
  auto l1_values_slot = reinterpret_cast<__cbuf__ bfloat16_t*>(
      l1_workspace + kHead64FusedL1PvValuesOffset +
      slot * kHead64FusedL1ValueSlotBytes);
  auto l1_values = MakeTensor(
      MakeMemPtr(l1_values_slot),
      MakeFrameLayout<ZNLayoutPtn, bfloat16_t>(
          kHead64SelectedTile, current_value));
  auto l1_values_half = l1_values.Slice(
      MakeCoord(selected_begin, 0), MakeShape(32, current_value));
  auto copy_ub_to_l1 = MakeCopy(CopyUB2L1{}, CopyUB2L1TraitDefault{});
  Copy(copy_ub_to_l1, l1_values_half, ub_values);
  head64_aiv_publish_gather_slot(slot);
}

__aicore__ inline void head64_fused_gather_value_fast_slot(
    __gm__ const bfloat16_t* kv_batch,
    __ubuf__ const int32_t* kv_row_offsets,
    __cbuf__ uint8_t* l1_workspace,
    __ubuf__ uint8_t* ub_workspace,
    uint32_t slot,
    int32_t selected_begin,
    int32_t value_start) {
  head64_aiv_wait_gather_slot(slot);
  auto ub_values_slot = reinterpret_cast<__ubuf__ bfloat16_t*>(
      ub_workspace + kHead64FusedUbValuesOffset);
  auto ub_value_staging = reinterpret_cast<__ubuf__ bfloat16_t*>(
      ub_workspace + kHead64FusedUbValueStagingOffset);
  asc_vf_call<head64_fused_value_pack_fast_vf>(
      dim3(kHead64FusedLaunchThreads, 1, 1),
      kv_batch,
      kv_row_offsets,
      ub_value_staging,
      value_start);
  asc_sync_notify(PIPE_V, PIPE_MTE3, EVENT_ID0);
  asc_sync_wait(PIPE_V, PIPE_MTE3, EVENT_ID0);
  auto staged_u16 = reinterpret_cast<__ubuf__ uint16_t*>(ub_value_staging);
  auto packed_u16 = reinterpret_cast<__ubuf__ uint16_t*>(ub_values_slot);
  for (uint32_t row_block = 0; row_block < 2; ++row_block) {
    for (uint32_t dim_block = 0; dim_block < 16; ++dim_block) {
      const uint32_t tile_index = row_block * 16U + dim_block;
      asc_transpose(
          packed_u16 + tile_index * 16U * 16U,
          staged_u16 + tile_index * 16U * 16U);
    }
  }
  asc_sync_notify(PIPE_V, PIPE_MTE3, EVENT_ID0);
  asc_sync_wait(PIPE_V, PIPE_MTE3, EVENT_ID0);
  auto ub_values = MakeTensor(
      MakeMemPtr(ub_values_slot),
      MakeFrameLayout<ZNLayoutPtn, bfloat16_t>(
          32, kHead64FusedCanonicalValueTile));
  auto l1_values_slot = reinterpret_cast<__cbuf__ bfloat16_t*>(
      l1_workspace + kHead64FusedL1PvValuesOffset +
      slot * kHead64FusedL1ValueSlotBytes);
  auto l1_values = MakeTensor(
      MakeMemPtr(l1_values_slot),
      MakeFrameLayout<ZNLayoutPtn, bfloat16_t>(
          kHead64SelectedTile, kHead64FusedCanonicalValueTile));
  auto l1_values_half = l1_values.Slice(
      MakeCoord(selected_begin, 0),
      MakeShape(32, kHead64FusedCanonicalValueTile));
  auto copy_ub_to_l1 = MakeCopy(CopyUB2L1{}, CopyUB2L1TraitDefault{});
  Copy(copy_ub_to_l1, l1_values_half, ub_values);
  head64_aiv_publish_gather_slot(slot);
}

__aicore__ inline void sparse_attention_head64_fused_aiv(
    __gm__ const bfloat16_t* query,
    __gm__ const bfloat16_t* shared_kv,
    __gm__ const int32_t* indices,
    __gm__ float* task_output,
    __gm__ float* partial_lse,
    __gm__ bfloat16_t* output,
    __gm__ float* lse,
    __gm__ const uint8_t* plan_gm,
    int32_t causal) {
  SparseAttentionHead64Plan plan;
  copy_head64_plan(&plan, plan_gm);
  const uint32_t subblock_index = AscendC::GetSubBlockIdx();
  const uint32_t block_id =
      AscendC::GetBlockIdx() / AscendC::GetTaskRatio();
  if (block_id >= static_cast<uint32_t>(plan.used_core_num)) {
    return;
  }
  const bool use_canonical_decode_pack =
      head64_fused_is_canonical_v32_decode(plan, causal);
  const int32_t value_tile = use_canonical_decode_pack
      ? kHead64FusedCanonicalValueTile
      : kHead64FusedGenericValueTile;
  const int32_t head_begin = static_cast<int32_t>(subblock_index) * 32;
  const int32_t selected_begin = static_cast<int32_t>(subblock_index) * 32;
  __cbuf__ uint8_t l1_workspace[kHead64FusedL1Bytes];
  auto l1_query_buf = reinterpret_cast<__cbuf__ bfloat16_t*>(
      l1_workspace + kHead64FusedL1QkQueryOffset);
  auto l1_scores_buf = reinterpret_cast<__cbuf__ float*>(
      l1_workspace + kHead64FusedL1QkScoresOffset);
  auto l1_probabilities_buf = reinterpret_cast<__cbuf__ bfloat16_t*>(
      l1_workspace + kHead64FusedL1PvProbabilitiesOffset);
  auto l1_values_buf = reinterpret_cast<__cbuf__ bfloat16_t*>(
      l1_workspace + kHead64FusedL1PvValuesOffset);
  auto l1_pv_buf = reinterpret_cast<__cbuf__ float*>(
      l1_workspace + kHead64FusedL1PvPvOffset);
  __ubuf__ uint8_t ub_workspace[kHead64FusedUbBytes];
  auto ub_query_buf = reinterpret_cast<__ubuf__ bfloat16_t*>(
      ub_workspace + kHead64FusedUbQueryOffset);
  auto ub_keys_buf = reinterpret_cast<__ubuf__ bfloat16_t*>(
      ub_workspace + kHead64FusedUbKeysOffset);
  auto ub_scores_buf = reinterpret_cast<__ubuf__ float*>(
      ub_workspace + kHead64FusedUbScoresOffset);
  auto ub_probabilities_buf = reinterpret_cast<__ubuf__ bfloat16_t*>(
      ub_workspace + kHead64FusedUbProbabilitiesOffset);
  auto ub_values_buf = reinterpret_cast<__ubuf__ bfloat16_t*>(
      ub_workspace + kHead64FusedUbValuesOffset);
  auto ub_pv_buf = reinterpret_cast<__ubuf__ float*>(
      ub_workspace + kHead64FusedUbPvOffset);
  auto running_max = reinterpret_cast<__ubuf__ float*>(
      ub_workspace + kHead64FusedUbRunningMaxOffset);
  auto running_sum = reinterpret_cast<__ubuf__ float*>(
      ub_workspace + kHead64FusedUbRunningSumOffset);
  auto old_scale = reinterpret_cast<__ubuf__ float*>(
      ub_workspace + kHead64FusedUbOldScaleOffset);
  auto running_output = reinterpret_cast<__ubuf__ float*>(
      ub_workspace + kHead64FusedUbRunningOutputOffset);
  auto kv_row_offsets = reinterpret_cast<__ubuf__ int32_t*>(
      ub_workspace + kHead64FusedUbKvRowOffsetsOffset);
  auto copy_ub_to_l1 = MakeCopy(CopyUB2L1{}, CopyUB2L1TraitDefault{});
  auto l1_probabilities = MakeTensor(
      MakeMemPtr(l1_probabilities_buf),
      MakeFrameLayout<NZLayoutPtn, bfloat16_t>(
          kHead64Tile, kHead64SelectedTile));
  auto l1_probabilities_half = l1_probabilities.Slice(
      MakeCoord(head_begin, 0),
      MakeShape(32, kHead64SelectedTile));
  auto ub_probabilities = MakeTensor(
      MakeMemPtr(ub_probabilities_buf),
      MakeFrameLayout<NZLayoutPtn, bfloat16_t>(
          32, kHead64SelectedTile));
  for (int32_t logical_task = static_cast<int32_t>(block_id);
       logical_task < plan.task_count;
       logical_task += plan.used_core_num) {
    const Head64Task task = decode_head64_task(logical_task, plan);
    const int32_t head_base = task.head_group * kHead64Tile;
    const int32_t partition_begin = head64_partition_begin(task, plan);
    const int32_t partition_end = head64_partition_end(task, plan);
    const int32_t partition_length =
        partition_end > partition_begin ? partition_end - partition_begin : 0;
    asc_vf_call<head64_fused_softmax_init_vf>(
        dim3(kHead64FusedLaunchThreads, 1, 1),
        running_max,
        running_sum,
        old_scale);
    asc_vf_call<head64_fused_output_init_vf>(
        dim3(kHead64FusedLaunchThreads, 1, 1), running_output);
    asc_vf_call<head64_fused_query_pack_vf>(
        dim3(kHead64FusedLaunchThreads, 1, 1),
        query,
        ub_query_buf,
        task.batch_index,
        task.query_token,
        head_base,
        head_begin,
        plan.query_heads,
        plan.query_tokens,
        plan.qk_head_dim);
    asc_sync_notify(PIPE_V, PIPE_MTE3, EVENT_ID0);
    asc_sync_wait(PIPE_V, PIPE_MTE3, EVENT_ID0);
    asc_copy_ub2l1(
        l1_query_buf + subblock_index * 32 * 16,
        ub_query_buf,
        36,
        32,
        0,
        32);
    AscendC::CrossCoreSetFlag<2, PIPE_MTE3>(kAivToAicReady);

    for (int32_t local_selected_start = 0;
         local_selected_start < partition_length;
         local_selected_start += kHead64SelectedTile) {
      const int32_t current_selected =
          partition_length - local_selected_start < kHead64SelectedTile
          ? partition_length - local_selected_start
          : kHead64SelectedTile;
      auto canonical_kv_batch = shared_kv;
      auto canonical_tile_indices = indices;
      if (use_canonical_decode_pack) {
        canonical_kv_batch +=
            static_cast<int64_t>(task.batch_index) * 32768 * 576;
        canonical_tile_indices +=
            (static_cast<int64_t>(task.batch_index) * 2 + task.query_token) *
                2048 +
            partition_begin + local_selected_start + selected_begin;
      }
      for (int32_t k_start = 0, k_tile_index = 0;
           k_start < plan.qk_head_dim;
           k_start += kHead64QkTile, ++k_tile_index) {
        const int32_t current_k =
            plan.qk_head_dim - k_start < kHead64QkTile
            ? plan.qk_head_dim - k_start
            : kHead64QkTile;
        const uint32_t slot = static_cast<uint32_t>(k_tile_index) & 1U;
        head64_aiv_wait_gather_slot(slot);
        if (use_canonical_decode_pack && k_tile_index == 0) {
          asc_vf_call<head64_fused_key_pack_prepare_vf>(
              dim3(kHead64FusedLaunchThreads, 1, 1),
              canonical_kv_batch,
              canonical_tile_indices,
              kv_row_offsets,
              ub_keys_buf);
        } else if (use_canonical_decode_pack) {
          asc_vf_call<head64_fused_key_pack_fast_vf>(
              dim3(kHead64FusedLaunchThreads, 1, 1),
              canonical_kv_batch,
              kv_row_offsets,
              ub_keys_buf,
              k_start);
        } else {
          asc_vf_call<head64_fused_key_pack_vf>(
              dim3(kHead64FusedLaunchThreads, 1, 1),
              shared_kv,
              indices,
              ub_keys_buf,
              task.batch_index,
              task.query_token,
              partition_begin + local_selected_start,
              selected_begin,
              current_selected,
              k_start,
              current_k,
              plan.query_tokens,
              plan.context_tokens,
              plan.selected_tokens,
              plan.qk_head_dim);
        }
        asc_sync_notify(PIPE_V, PIPE_MTE3, EVENT_ID0);
        asc_sync_wait(PIPE_V, PIPE_MTE3, EVENT_ID0);
        auto ub_keys = MakeTensor(
            MakeMemPtr(ub_keys_buf),
            MakeFrameLayout<ZNLayoutPtn, bfloat16_t>(current_k, 32));
        auto l1_keys_slot = reinterpret_cast<__cbuf__ bfloat16_t*>(
            l1_workspace + kHead64FusedL1QkKeysOffset +
            slot * kHead64FusedL1KeySlotBytes);
        auto l1_keys = MakeTensor(
            MakeMemPtr(l1_keys_slot),
            MakeFrameLayout<ZNLayoutPtn, bfloat16_t>(
                current_k, kHead64SelectedTile));
        auto l1_keys_half = l1_keys.Slice(
            MakeCoord(0, selected_begin), MakeShape(current_k, 32));
        Copy(copy_ub_to_l1, l1_keys_half, ub_keys);
        head64_aiv_publish_gather_slot(slot);
      }
      AscendC::CrossCoreWaitFlag<2, PIPE_V>(kAicToAivReady);
      asc_vf_call<head64_fused_softmax_vf>(
          dim3(kHead64FusedLaunchThreads, 1, 1),
          ub_scores_buf,
          ub_probabilities_buf,
          running_max,
          running_sum,
          old_scale,
          indices,
          task.batch_index,
          task.query_token,
          partition_begin,
          local_selected_start,
          current_selected,
          plan.query_tokens,
          plan.context_tokens,
          plan.selected_tokens,
          1.0F / 24.0F,
          causal);
      asc_sync_notify(PIPE_V, PIPE_MTE3, EVENT_ID0);
      asc_sync_wait(PIPE_V, PIPE_MTE3, EVENT_ID0);
      Copy(copy_ub_to_l1, l1_probabilities_half, ub_probabilities);
      AscendC::CrossCoreSetFlag<2, PIPE_MTE3>(kAivToAicReady);
      const int32_t value_tile_count =
          (plan.value_head_dim + value_tile - 1) / value_tile;
      if (value_tile_count > 0) {
        const int32_t first_current_value =
            plan.value_head_dim < value_tile
            ? plan.value_head_dim
            : value_tile;
        if (use_canonical_decode_pack) {
          head64_fused_gather_value_fast_slot(
              canonical_kv_batch,
              kv_row_offsets,
              l1_workspace,
              ub_workspace,
              0,
              selected_begin,
              0);
        } else {
          head64_fused_gather_value_slot(
              shared_kv,
              indices,
              l1_workspace,
              ub_workspace,
              0,
              task.batch_index,
              task.query_token,
              partition_begin,
              local_selected_start,
              selected_begin,
              current_selected,
              0,
              first_current_value,
              plan.query_tokens,
              plan.context_tokens,
              plan.selected_tokens,
              plan.qk_head_dim);
        }
      }
      for (int32_t value_start = 0, value_tile_index = 0;
           value_start < plan.value_head_dim;
           value_start += value_tile, ++value_tile_index) {
        const int32_t current_value =
            plan.value_head_dim - value_start < value_tile
            ? plan.value_head_dim - value_start
            : value_tile;
        if (value_tile_index + 1 < value_tile_count) {
          const uint32_t next_slot =
              (static_cast<uint32_t>(value_tile_index) & 1U) ^ 1U;
          const int32_t next_value_start = value_start + value_tile;
          const int32_t next_current_value =
              plan.value_head_dim - next_value_start < value_tile
              ? plan.value_head_dim - next_value_start
              : value_tile;
          if (use_canonical_decode_pack) {
            head64_fused_gather_value_fast_slot(
                canonical_kv_batch,
                kv_row_offsets,
                l1_workspace,
                ub_workspace,
                next_slot,
                selected_begin,
                next_value_start);
          } else {
            head64_fused_gather_value_slot(
                shared_kv,
                indices,
                l1_workspace,
                ub_workspace,
                next_slot,
                task.batch_index,
                task.query_token,
                partition_begin,
                local_selected_start,
                selected_begin,
                current_selected,
                next_value_start,
                next_current_value,
                plan.query_tokens,
                plan.context_tokens,
                plan.selected_tokens,
                plan.qk_head_dim);
          }
        }
        AscendC::CrossCoreWaitFlag<2, PIPE_V>(kAicToAivReady);
        asc_vf_call<head64_fused_output_update_vf>(
            dim3(kHead64FusedLaunchThreads, 1, 1),
            running_output,
            ub_pv_buf,
            old_scale,
            value_start,
            current_value);
        asc_sync_notify(PIPE_V, PIPE_MTE3, EVENT_ID1);
        asc_sync_wait(PIPE_V, PIPE_MTE3, EVENT_ID1);
        AscendC::CrossCoreSetFlag<2, PIPE_MTE3>(kAivToAicReady);
      }
    }
    asc_vf_call<head64_fused_output_write_vf>(
        dim3(kHead64FusedLaunchThreads, 1, 1),
        task_output,
        partial_lse,
        output,
        lse,
        running_output,
        running_max,
        running_sum,
        logical_task,
        task,
        plan,
        subblock_index);
  }
}

__aicore__ inline void sparse_attention_head64_fused_aic(
    __gm__ const uint8_t* plan_gm,
    int32_t causal) {
  SparseAttentionHead64Plan plan;
  copy_head64_plan(&plan, plan_gm);
  const bool use_canonical_decode_pack =
      head64_fused_is_canonical_v32_decode(plan, causal);
  const int32_t value_tile = use_canonical_decode_pack
      ? kHead64FusedCanonicalValueTile
      : kHead64FusedGenericValueTile;
  const int32_t block_id = static_cast<int32_t>(AscendC::GetBlockIdx());
  if (block_id >= plan.used_core_num) {
    return;
  }
  __cbuf__ uint8_t l1_workspace[kHead64FusedL1Bytes];
  auto l1_query_buf = reinterpret_cast<__cbuf__ bfloat16_t*>(
      l1_workspace + kHead64FusedL1QkQueryOffset);
  auto l1_scores_buf = reinterpret_cast<__cbuf__ float*>(
      l1_workspace + kHead64FusedL1QkScoresOffset);
  auto l1_probabilities_buf = reinterpret_cast<__cbuf__ bfloat16_t*>(
      l1_workspace + kHead64FusedL1PvProbabilitiesOffset);
  auto l1_values_buf = reinterpret_cast<__cbuf__ bfloat16_t*>(
      l1_workspace + kHead64FusedL1PvValuesOffset);
  auto l1_pv_buf = reinterpret_cast<__cbuf__ float*>(
      l1_workspace + kHead64FusedL1PvPvOffset);
  __ubuf__ uint8_t ub_workspace[kHead64FusedUbBytes];
  auto ub_scores_buf = reinterpret_cast<__ubuf__ float*>(
      ub_workspace + kHead64FusedUbScoresOffset);
  auto ub_pv_buf = reinterpret_cast<__ubuf__ float*>(
      ub_workspace + kHead64FusedUbPvOffset);
  __ca__ bfloat16_t l0_query_buf[kHead64Tile * kHead64QkTile];
  __cb__ bfloat16_t l0_keys_buf[kHead64QkTile * kHead64SelectedTile];
  __cc__ float l0_scores_buf[kHead64Tile * kHead64SelectedTile];
  __cb__ bfloat16_t l0_values_buf[
      kHead64SelectedTile * kHead64FusedMaxValueTile];
  __cc__ float l0_pv_buf[
      kHead64Tile * kHead64FusedMaxValueTile];
  auto copy_l1_to_l0a = MakeCopy(CopyL12L0A{}, CopyL12L0ATraitDefault{});
  auto copy_l1_to_l0b = MakeCopy(CopyL12L0B{}, CopyL12L0BTraitDefault{});
  auto mm = MakeMmad(MmadOperation{}, Head64QkMmadTrait{});
  auto pv_mm = MakeMmad(MmadOperation{}, Head64PvMmadTrait{});
  auto l1_query = MakeTensor(
      MakeMemPtr(l1_query_buf),
      MakeFrameLayout<NZLayoutPtn, bfloat16_t>(kHead64Tile, 576));
  asc_sync_notify(PIPE_FIX, PIPE_M, EVENT_ID0);
  asc_sync_notify(PIPE_M, PIPE_MTE1, EVENT_ID1);

  for (int32_t logical_task = block_id;
       logical_task < plan.task_count;
       logical_task += plan.used_core_num) {
    const Head64Task task = decode_head64_task(logical_task, plan);
    const int32_t partition_begin = head64_partition_begin(task, plan);
    const int32_t partition_end = head64_partition_end(task, plan);
    const int32_t partition_length =
        partition_end > partition_begin ? partition_end - partition_begin : 0;
    AscendC::CrossCoreWaitFlag<2, PIPE_MTE1>(kAivToAicReady);
    for (int32_t local_selected_start = 0;
         local_selected_start < partition_length;
         local_selected_start += kHead64SelectedTile) {
      const int32_t current_selected =
          partition_length - local_selected_start < kHead64SelectedTile
          ? partition_length - local_selected_start
          : kHead64SelectedTile;
      auto l0_scores = MakeTensor(
          MakeMemPtr(l0_scores_buf),
          MakeFrameLayout<NZLayoutPtn>(kHead64Tile, current_selected));
      for (int32_t k_start = 0, k_tile_index = 0;
           k_start < plan.qk_head_dim;
           k_start += kHead64QkTile, ++k_tile_index) {
        const int32_t current_k =
            plan.qk_head_dim - k_start < kHead64QkTile
            ? plan.qk_head_dim - k_start
            : kHead64QkTile;
        const uint32_t slot = static_cast<uint32_t>(k_tile_index) & 1U;
        auto l1_query_tile = l1_query.Slice(
            MakeCoord(0, k_start), MakeShape(kHead64Tile, current_k));
        auto l0_query = MakeTensor(
            MakeMemPtr(l0_query_buf),
            MakeFrameLayout<NZLayoutPtn, bfloat16_t>(
                kHead64Tile, current_k));
        asc_sync_wait(PIPE_M, PIPE_MTE1, EVENT_ID1);
        Copy(copy_l1_to_l0a, l0_query, l1_query_tile);
        if (k_tile_index == 0) {
          head64_aic_request_gather_slot(slot);
        }
        head64_aic_wait_gather_slot(slot);
        auto l1_keys_slot = reinterpret_cast<__cbuf__ bfloat16_t*>(
            l1_workspace + kHead64FusedL1QkKeysOffset +
            slot * kHead64FusedL1KeySlotBytes);
        auto l1_keys = MakeTensor(
            MakeMemPtr(l1_keys_slot),
            MakeFrameLayout<ZNLayoutPtn, bfloat16_t>(
                current_k, kHead64SelectedTile));
        auto l0_keys = MakeTensor(
            MakeMemPtr(l0_keys_buf),
            MakeFrameLayout<ZNLayoutPtn, bfloat16_t>(
                current_k, current_selected));
        Copy(copy_l1_to_l0b, l0_keys, l1_keys);
        asc_sync_notify(PIPE_MTE1, PIPE_M, EVENT_ID1);
        if (k_start + current_k < plan.qk_head_dim) {
          const uint32_t next_slot = slot ^ 1U;
          head64_aic_request_gather_slot(next_slot);
        }
        asc_sync_wait(PIPE_MTE1, PIPE_M, EVENT_ID1);
        MmadParams params;
        params.m = 64;
        params.n = current_selected;
        params.k = current_k;
        params.unitFlag = 0;
        params.cmatrixInitVal = k_start == 0;
        if (k_start == 0) {
          asc_sync_wait(PIPE_FIX, PIPE_M, EVENT_ID0);
        }
        Mmad(mm.with(params), l0_scores, l0_query, l0_keys);
        asc_sync_notify(PIPE_M, PIPE_MTE1, EVENT_ID1);
        if (k_start + current_k == plan.qk_head_dim) {
          asc_sync_notify(PIPE_M, PIPE_FIX, EVENT_ID0);
        }
      }
      asc_sync_wait(PIPE_M, PIPE_FIX, EVENT_ID0);
      head64_copy_l0c_to_l1_nz(
          l1_scores_buf,
          l0_scores_buf,
          kHead64SelectedTile,
          kHead64Tile);
      asc_sync_notify(PIPE_FIX, PIPE_M, EVENT_ID0);
      asc_copy_l12ub_sync(
          ub_scores_buf, l1_scores_buf, false, 4, 64, 64, 0);
      asc_copy_l12ub_sync(
          ub_scores_buf,
          l1_scores_buf + 32 * 16,
          true,
          4,
          64,
          64,
          0);
      AscendC::CrossCoreSetFlag<2, PIPE_MTE2>(kAicToAivReady);
      AscendC::CrossCoreWaitFlag<2, PIPE_MTE1>(kAivToAicReady);
      auto l1_probability = MakeTensor(
          MakeMemPtr(l1_probabilities_buf),
          MakeFrameLayout<NZLayoutPtn, bfloat16_t>(
              kHead64Tile, current_selected));
      auto l0_probability = MakeTensor(
          MakeMemPtr(l0_query_buf),
          MakeFrameLayout<NZLayoutPtn, bfloat16_t>(
              kHead64Tile, current_selected));
      asc_sync_wait(PIPE_M, PIPE_MTE1, EVENT_ID1);
      Copy(copy_l1_to_l0a, l0_probability, l1_probability);
      const int32_t value_tile_count =
          (plan.value_head_dim + value_tile - 1) / value_tile;
      if (value_tile_count > 0) {
        head64_aic_request_gather_slot(0);
      }
      for (int32_t value_start = 0, value_tile_index = 0;
           value_start < plan.value_head_dim;
           value_start += value_tile, ++value_tile_index) {
        const int32_t current_value =
            plan.value_head_dim - value_start < value_tile
            ? plan.value_head_dim - value_start
            : value_tile;
        const uint32_t slot =
            static_cast<uint32_t>(value_tile_index) & 1U;
        if (value_start != 0) {
          asc_sync_wait(PIPE_M, PIPE_MTE1, EVENT_ID1);
        }
        head64_aic_wait_gather_slot(slot);
        auto l1_values_slot = reinterpret_cast<__cbuf__ bfloat16_t*>(
            l1_workspace + kHead64FusedL1PvValuesOffset +
            slot * kHead64FusedL1ValueSlotBytes);
        auto l1_values = MakeTensor(
            MakeMemPtr(l1_values_slot),
            MakeFrameLayout<ZNLayoutPtn, bfloat16_t>(
                kHead64SelectedTile, current_value));
        auto l0_values = MakeTensor(
            MakeMemPtr(l0_values_buf),
            MakeFrameLayout<ZNLayoutPtn, bfloat16_t>(
                current_selected, current_value));
        Copy(copy_l1_to_l0b, l0_values, l1_values);
        asc_sync_notify(PIPE_MTE1, PIPE_M, EVENT_ID1);
        if (value_tile_index + 1 < value_tile_count) {
          const uint32_t next_slot = slot ^ 1U;
          head64_aic_request_gather_slot(next_slot);
        }
        asc_sync_wait(PIPE_MTE1, PIPE_M, EVENT_ID1);
        auto l0_pv = MakeTensor(
            MakeMemPtr(l0_pv_buf),
            MakeFrameLayout<NZLayoutPtn>(kHead64Tile, current_value));
        MmadParams pv_params;
        pv_params.m = 64;
        pv_params.n = current_value;
        pv_params.k = current_selected;
        pv_params.unitFlag = 0;
        pv_params.cmatrixInitVal = true;
        asc_sync_wait(PIPE_FIX, PIPE_M, EVENT_ID0);
        Mmad(pv_mm.with(pv_params), l0_pv, l0_probability, l0_values);
        asc_sync_notify(PIPE_M, PIPE_FIX, EVENT_ID0);
        asc_sync_notify(PIPE_M, PIPE_MTE1, EVENT_ID1);
        asc_sync_wait(PIPE_M, PIPE_FIX, EVENT_ID0);
        head64_copy_l0c_to_l1_nz(
            l1_pv_buf,
            l0_pv_buf,
            static_cast<uint16_t>(current_value),
            kHead64Tile);
        asc_sync_notify(PIPE_FIX, PIPE_M, EVENT_ID0);
        const uint16_t value_blocks = static_cast<uint16_t>(
            (current_value + 15) / 16);
        asc_copy_l12ub_sync(
            ub_pv_buf, l1_pv_buf, false, value_blocks, 64, 64, 0);
        asc_copy_l12ub_sync(
            ub_pv_buf,
            l1_pv_buf + 32 * 16,
            true,
            value_blocks,
            64,
            64,
            0);
        AscendC::CrossCoreSetFlag<2, PIPE_MTE2>(kAicToAivReady);
        AscendC::CrossCoreWaitFlag<2, PIPE_MTE1>(kAivToAicReady);
      }
    }
  }
  asc_sync_wait(PIPE_FIX, PIPE_M, EVENT_ID0);
  asc_sync_wait(PIPE_M, PIPE_MTE1, EVENT_ID1);
}

__global__ __aicore__ void sparse_attention_head64_fused_kernel(
    __gm__ bfloat16_t* query,
    __gm__ bfloat16_t* shared_kv,
    __gm__ const int32_t* indices,
    __gm__ float* task_output,
    __gm__ float* partial_lse,
    __gm__ bfloat16_t* output,
    __gm__ float* lse,
    __kfc_workspace__ __gm__ uint8_t* workspace,
    __gm__ const uint8_t* plan_gm,
    int32_t causal) {
  (void)query;
  (void)shared_kv;
  (void)indices;
  (void)workspace;
  KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_MIX_AIC_1_2);
  if ASCEND_IS_AIC {
    sparse_attention_head64_fused_aic(plan_gm, causal);
  } else if ASCEND_IS_AIV {
    sparse_attention_head64_fused_aiv(
        query,
        shared_kv,
        indices,
        task_output,
        partial_lse,
        output,
        lse,
        plan_gm,
        causal);
  }
}

}  // namespace

extern "C" void launch_sparse_attention_head64_fused_hd576_bf16_v2(
    const bfloat16_t* query,
    const bfloat16_t* shared_kv,
    const int32_t* indices,
    float* task_output,
    float* partial_lse,
    bfloat16_t* output,
    float* lse,
    uint8_t* workspace,
    uint8_t* plan_gm,
    bool causal,
    const aten_dsa_sparse_attention_v2::SparseAttentionHead64Plan* plan,
    aclrtStream stream) {
  aclrtMemcpyAsync(
      plan_gm,
      sizeof(*plan),
      plan,
      sizeof(*plan),
      ACL_MEMCPY_HOST_TO_DEVICE,
      stream);
  sparse_attention_head64_fused_kernel
      <<<static_cast<uint32_t>(plan->used_core_num), 0, stream>>>(
          const_cast<bfloat16_t*>(query),
          const_cast<bfloat16_t*>(shared_kv),
          indices,
          task_output,
          partial_lse,
          output,
          lse,
          workspace,
          plan_gm,
          static_cast<int32_t>(causal));
}
