#include <cstdint>
#include <limits>

#include "acl/acl.h"
#include "basic_api/kernel_common.h"
#include "basic_api/kernel_operator_block_sync_intf.h"
#include "c_api/asc_simd.h"
#include "simt_api/asc_bf16.h"
#include "simt_api/asc_simt.h"
#include "tensor_api/tensor.h"

#include "sparse_attention_head64_common.h"
#include "sparse_attention_head64_plan.h"

namespace {

using aten_dsa_sparse_attention::kHead64Tile;
using aten_dsa_sparse_attention::SparseAttentionHead64Plan;
using aten_dsa_sparse_attention::head64::copy_head64_plan;

constexpr uint8_t kAivToAicReady = 8;
constexpr uint8_t kAicToAivReady = 9;

__simt_vf__ __aicore__ __launch_bounds__(1024) inline void
head64_fused_init_vf(
    __gm__ float* task_output,
    __gm__ float* partial_lse,
    int32_t logical_task,
    int32_t value_head_dim,
    uint32_t subblock_index) {
  const uint32_t local_head = threadIdx.x / 32;
  const uint32_t lane = threadIdx.x % 32;
  const int32_t task_head =
      static_cast<int32_t>(subblock_index * 32 + local_head);
  const int64_t output_base =
      (static_cast<int64_t>(logical_task) * kHead64Tile + task_head) *
      value_head_dim;
  for (int32_t dim = static_cast<int32_t>(lane);
       dim < value_head_dim;
       dim += 32) {
    task_output[output_base + dim] = 0.0F;
  }
  if (lane == 0) {
    partial_lse[static_cast<int64_t>(logical_task) * kHead64Tile + task_head] =
        -std::numeric_limits<float>::infinity();
  }
}

__global__ __aicore__ void sparse_attention_head64_fused_kernel(
    __gm__ bfloat16_t* query,
    __gm__ bfloat16_t* shared_kv,
    __gm__ const int32_t* indices,
    __gm__ float* task_output,
    __gm__ float* partial_lse,
    __kfc_workspace__ __gm__ uint8_t* workspace,
    __gm__ const uint8_t* plan_gm,
    int32_t causal) {
  (void)query;
  (void)shared_kv;
  (void)indices;
  (void)workspace;
  (void)causal;
  KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_MIX_AIC_1_2);
  SparseAttentionHead64Plan plan;
  copy_head64_plan(&plan, plan_gm);

  if ASCEND_IS_AIC {
    const int32_t block_id = static_cast<int32_t>(AscendC::GetBlockIdx());
    if (block_id >= plan.used_core_num) {
      return;
    }
    for (int32_t logical_task = block_id;
         logical_task < plan.task_count;
         logical_task += plan.used_core_num) {
      AscendC::CrossCoreWaitFlag<2, PIPE_MTE1>(kAivToAicReady);
      AscendC::CrossCoreSetFlag<2, PIPE_MTE1>(kAicToAivReady);
    }
  } else if ASCEND_IS_AIV {
    const int32_t block_id = static_cast<int32_t>(
        AscendC::GetBlockIdx() / AscendC::GetTaskRatio());
    if (block_id >= plan.used_core_num) {
      return;
    }
    const uint32_t subblock_index = AscendC::GetSubBlockIdx();
    for (int32_t logical_task = block_id;
         logical_task < plan.task_count;
         logical_task += plan.used_core_num) {
      asc_vf_call<head64_fused_init_vf>(
          dim3(1024, 1, 1),
          task_output,
          partial_lse,
          logical_task,
          plan.value_head_dim,
          subblock_index);
      AscendC::CrossCoreSetFlag<2, PIPE_MTE3>(kAivToAicReady);
      AscendC::CrossCoreWaitFlag<2, PIPE_V>(kAicToAivReady);
    }
  }
}

}  // namespace

extern "C" void launch_sparse_attention_head64_fused_hd576_bf16(
    const bfloat16_t* query,
    const bfloat16_t* shared_kv,
    const int32_t* indices,
    float* task_output,
    float* partial_lse,
    uint8_t* workspace,
    uint8_t* plan_gm,
    bool causal,
    const aten_dsa_sparse_attention::SparseAttentionHead64Plan* plan,
    aclrtStream stream) {
  aclrtMemcpyAsync(
      plan_gm,
      sizeof(*plan),
      plan,
      sizeof(*plan),
      ACL_MEMCPY_HOST_TO_DEVICE,
      stream);
  sparse_attention_head64_fused_kernel
      <<<static_cast<uint32_t>(plan->used_core_num), 0, stream>>>(
          const_cast<bfloat16_t*>(query),
          const_cast<bfloat16_t*>(shared_kv),
          indices,
          task_output,
          partial_lse,
          workspace,
          plan_gm,
          static_cast<int32_t>(causal));
}
