std::tuple<at::Tensor, at::Tensor>
sparse_attention_forward_family_hd576_head64(
    const at::Tensor& query,
    const at::Tensor& shared_kv,
    const at::Tensor& indices,
    int64_t value_head_dim,
    bool causal,
    const SparseAttentionHead64Plan& plan) {
  auto task_scores = at::empty(
      {plan.task_count,
       kHead64Tile,
       plan.selected_partition_tile_capacity * plan.selected_tile},
      query.options().dtype(c10::kFloat));
  auto workspace = at::empty(
      {16 * 1024 * 1024},
      query.options().dtype(c10::kByte));
  auto plan_tensor = at::empty(
      {4096},
      query.options().dtype(c10::kByte));
  const auto acl_stream = c10_npu::getCurrentNPUStream().stream(true);
  run_sparse_attention_head64_qk_hd576_bf16(
      query,
      shared_kv,
      indices,
      task_scores,
      workspace,
      plan_tensor,
      plan,
      acl_stream);
  auto task_probabilities = at::empty(
      {plan.task_count,
       plan.selected_partition_tile_capacity,
       kHead64Tile,
       kHead64SelectedTile},
      query.options().dtype(c10::kBFloat16));
  auto task_output = at::empty(
      {plan.task_count, kHead64Tile, plan.value_head_dim},
      query.options().dtype(c10::kFloat));
  auto task_lse = plan.selected_partitions == 1
      ? at::empty(
            {plan.batch_size, plan.query_heads, plan.query_tokens},
            query.options().dtype(c10::kFloat))
      : at::empty(
            {plan.task_count, kHead64Tile},
            query.options().dtype(c10::kFloat));
  run_sparse_attention_head64_pv_hd576_bf16(
      task_scores,
      task_probabilities,
      shared_kv,
      indices,
      task_output,
      task_lse,
      workspace,
      plan_tensor,
      causal,
      plan,
      acl_stream);
  auto output = task_output
      .view({plan.batch_size, plan.query_tokens, plan.query_heads,
             plan.value_head_dim})
      .permute({0, 2, 1, 3})
      .contiguous();
  return {output, task_lse};
}

std::tuple<at::Tensor, at::Tensor> sparse_attention_forward_privateuse1(
    const at::Tensor& query,
    const at::Tensor& shared_kv,
    const at::Tensor& indices,
    int64_t value_head_dim,
    std::string_view phase,
    std::string_view family,
    bool causal,
    int64_t head_tile,
    int64_t selected_partitions) {
  TORCH_CHECK(
      query.device().type() == at::DeviceType::PrivateUse1,
      "expected PrivateUse1/NPU query tensor");
  TORCH_CHECK(
      shared_kv.device().type() == at::DeviceType::PrivateUse1,
      "expected PrivateUse1/NPU shared_kv tensor");
  TORCH_CHECK(
      indices.device().type() == at::DeviceType::PrivateUse1,
      "expected PrivateUse1/NPU indices tensor");
  TORCH_CHECK(query.dim() == 4, "query must have shape [B, Hq, Q, D]");
  TORCH_CHECK(
      shared_kv.dim() == 4,
      "shared_kv must have shape [B, Hkv, C, Dqk]");
  TORCH_CHECK(indices.dim() == 3, "indices must have shape [B, Q, S]");
  TORCH_CHECK(query.size(0) == shared_kv.size(0), "batch sizes must match");
  TORCH_CHECK(query.size(0) == indices.size(0), "batch sizes must match");
  TORCH_CHECK(query.size(2) == indices.size(1), "query token counts must match");
  TORCH_CHECK(
      value_head_dim > 0 && value_head_dim <= shared_kv.size(3),
      "value_head_dim must be in (0, shared_kv.size(3)]");
  TORCH_CHECK(
      query.scalar_type() == at::ScalarType::Float ||
          query.scalar_type() == at::ScalarType::Half ||
          query.scalar_type() == at::ScalarType::BFloat16,
      "sparse_attention custom op supports float32/float16/bfloat16 query");
  TORCH_CHECK(
      shared_kv.scalar_type() == query.scalar_type(),
      "query and shared_kv must use the same dtype");
  TORCH_CHECK(
      indices.scalar_type() == at::ScalarType::Long ||
          indices.scalar_type() == at::ScalarType::Int,
      "indices must use int64 or int32");
  const bool use_head64 =
      head_tile == 64 && is_supported_head64_partitions(selected_partitions);
  TORCH_CHECK(
      use_head64 || (head_tile == 1 && selected_partitions == 1),
      "unsupported sparse_attention tuning");
  SparseAttentionHead64Plan head64_plan{};
  if (use_head64) {
    head64_plan = make_sparse_attention_head64_plan(
        query,
        shared_kv,
        indices,
        value_head_dim,
        phase,
        family,
        head_tile,
        selected_partitions);
  }

  if (query.numel() == 0 || shared_kv.numel() == 0 ||
      indices.numel() == 0) {
    return {
        at::empty(
            {query.size(0), query.size(1), query.size(2), value_head_dim},
            query.options()),
        at::empty(
            {query.size(0), query.size(1), query.size(2)},
            query.options().dtype(c10::kFloat)),
    };
  }

  auto query_bfloat = query.scalar_type() == at::ScalarType::BFloat16
      ? query.contiguous()
      : query.to(c10::kBFloat16).contiguous();
  auto shared_kv_bfloat = shared_kv.scalar_type() == at::ScalarType::BFloat16
      ? shared_kv.contiguous()
      : shared_kv.to(c10::kBFloat16).contiguous();
  auto indices_int = indices.scalar_type() == at::ScalarType::Int
      ? indices.contiguous()
      : indices.to(at::kInt).contiguous();

  if (use_head64) {
    auto result = sparse_attention_forward_family_hd576_head64(
        query_bfloat,
        shared_kv_bfloat,
        indices_int,
        value_head_dim,
        causal,
        head64_plan);
    auto output = query.scalar_type() == at::ScalarType::Float
        ? std::get<0>(result)
        : std::get<0>(result).to(query.scalar_type());
    return {output, std::get<1>(result)};
  }

  at::Tensor output_float;
  at::Tensor lse;
  const bool apply_causal_mask = causal;
  const bool is_wide_family =
      family == "family_hd256" || family == "family_hd512" ||
      family == "family_hd576";

  if (is_wide_family && (phase == "prefill" || phase == "decode")) {
    const int64_t expected_qk_head_dim = family == "family_hd256" ? 256
        : family == "family_hd576" ? 576
                                     : 512;
    const int64_t expected_value_head_dim =
        family == "family_hd576" ? 512 : expected_qk_head_dim;
    TORCH_CHECK(
        query.size(3) == expected_qk_head_dim,
        "wide-head family requires matching query D");
    TORCH_CHECK(shared_kv.size(1) == 1, "wide-head family requires kv_heads == 1");
    TORCH_CHECK(
        shared_kv.size(3) == expected_qk_head_dim,
        "wide-head family requires matching shared-KV D");
    TORCH_CHECK(
        value_head_dim == expected_value_head_dim,
        "wide-head family requires matching value D");
    TORCH_CHECK(
        indices.size(2) <= 2048,
        "wide-head custom op requires selected_tokens <= 2048");
    auto result = phase == "decode"
        ? sparse_attention_forward_family_hd512_decode_fused(
              query_bfloat,
              shared_kv_bfloat,
              shared_kv_bfloat,
              indices_int,
              value_head_dim,
              apply_causal_mask)
        : sparse_attention_forward_family_hd512_hybrid(
              query_bfloat,
              shared_kv_bfloat,
              shared_kv_bfloat,
              indices_int,
              value_head_dim,
              apply_causal_mask);
    output_float = std::get<0>(result);
    lse = std::get<1>(result);
  } else if (
      family == "family_hd128" &&
      (phase == "prefill" || phase == "decode")) {
    TORCH_CHECK(query.size(1) == 128, "family_hd128 requires query_heads == 128");
    TORCH_CHECK(query.size(3) == 128, "family_hd128 requires D == 128");
    TORCH_CHECK(shared_kv.size(1) == 1, "family_hd128 requires kv_heads == 1");
    TORCH_CHECK(shared_kv.size(3) == 128, "family_hd128 requires shared-KV D == 128");
    TORCH_CHECK(value_head_dim == 128, "family_hd128 requires value D == 128");
    TORCH_CHECK(
        indices.size(2) <= 2048,
        "family_hd128 custom op requires selected_tokens <= 2048");
    if (phase == "decode") {
      TORCH_CHECK(query.size(2) == 1, "family_hd128 decode requires query_tokens == 1");
    }
    auto result = phase == "decode"
        ? sparse_attention_forward_family_hd128_decode_fused(
              query_bfloat,
              shared_kv_bfloat,
              shared_kv_bfloat,
              indices_int,
              value_head_dim,
              apply_causal_mask)
        : sparse_attention_forward_family_hd128_hybrid(
              query_bfloat,
              shared_kv_bfloat,
              shared_kv_bfloat,
              indices_int,
              value_head_dim,
              apply_causal_mask);
    output_float = std::get<0>(result);
    lse = std::get<1>(result);
  } else {
    TORCH_CHECK(
        false,
        "sparse_attention custom op supports family_hd128, family_hd256, family_hd512, and family_hd576 in prefill/decode only");
  }

  auto output = query.scalar_type() == at::ScalarType::Float
      ? output_float
      : output_float.to(query.scalar_type());
  return {output, lse};
}

TORCH_LIBRARY_FRAGMENT(aten_dsa_sparse_attention, m) {
  m.def(
      "sparse_attention_forward(Tensor query, Tensor shared_kv, Tensor indices, int value_head_dim, "
      "str phase, str family, bool causal, "
      "int head_tile=1, int selected_partitions=1) -> (Tensor, Tensor)");
}

TORCH_LIBRARY_IMPL(aten_dsa_sparse_attention, PrivateUse1, m) {
  m.impl("sparse_attention_forward", &sparse_attention_forward_privateuse1);
}

} // namespace
} // namespace aten_dsa_sparse_attention
