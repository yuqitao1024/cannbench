void run_sparse_attention_family_hd512_decode_direct_tile(
    const at::Tensor& scores,
    const at::Tensor& values,
    const at::Tensor& indices,
    at::Tensor& output,
    at::Tensor& lse,
    int64_t batch_size,
    int64_t query_heads,
    int64_t current_query,
    int64_t context_tokens,
    int64_t selected_tokens,
    int64_t value_token_stride,
    int64_t indices_query_stride,
    int64_t indices_query_offset,
    int64_t indices_selected_stride,
    int64_t indices_selected_offset,
    int64_t output_query_stride,
    int64_t output_query_offset,
    float score_scale,
    int64_t query_start,
    bool causal,
    aclrtStream acl_stream) {
  auto output_tensor = output;
  auto lse_tensor = lse;
  auto acl_call = [=]() mutable -> int {
    launch_sparse_attention_hd512_postprocess_decode_direct_float(
        scores.const_data_ptr<float>(),
        values.const_data_ptr<at::BFloat16>(),
        indices.const_data_ptr<int32_t>(),
        output_tensor.mutable_data_ptr<float>(),
        lse_tensor.mutable_data_ptr<float>(),
        batch_size,
        query_heads,
        current_query,
        context_tokens,
        selected_tokens,
        value_token_stride,
        indices_query_stride,
        indices_query_offset,
        indices_selected_stride,
        indices_selected_offset,
        output_query_stride,
        output_query_offset,
        score_scale,
        query_start,
        causal,
        acl_stream);
    return 0;
  };
  at_npu::native::OpCommand::RunOpApiV2(
      "aten_dsa_sparse_attention::sparse_attention_forward_family_hd512_decode_direct",
      acl_call);
}

void run_sparse_attention_head64_qk_hd576_bf16(
    const at::Tensor& query,
    const at::Tensor& keys,
    const at::Tensor& indices,
    at::Tensor& scores,
    at::Tensor& workspace,
    at::Tensor& plan_tensor,
    const SparseAttentionHead64Plan& plan,
    aclrtStream acl_stream) {
  auto scores_copy = scores;
  auto workspace_copy = workspace;
  auto plan_tensor_copy = plan_tensor;
  auto plan_copy = plan;
  auto acl_call = [=]() mutable -> int {
    launch_sparse_attention_head64_qk_hd576_bf16(
        query.const_data_ptr<at::BFloat16>(),
        keys.const_data_ptr<at::BFloat16>(),
        indices.const_data_ptr<int32_t>(),
        scores_copy.mutable_data_ptr<float>(),
        workspace_copy.mutable_data_ptr<uint8_t>(),
        plan_tensor_copy.mutable_data_ptr<uint8_t>(),
        &plan_copy,
        acl_stream);
    return 0;
  };
  at_npu::native::OpCommand::RunOpApiV2(
      "aten_dsa_sparse_attention::sparse_attention_head64_qk_hd576_bf16",
      acl_call);
}

void run_sparse_attention_head64_pv_hd576_bf16(
    const at::Tensor& scores,
    at::Tensor& probabilities,
    const at::Tensor& values,
    const at::Tensor& indices,
    at::Tensor& task_output,
    at::Tensor& partial_lse,
    at::Tensor& workspace,
    at::Tensor& plan_tensor,
    bool causal,
    const SparseAttentionHead64Plan& plan,
    aclrtStream acl_stream) {
  auto probabilities_copy = probabilities;
  auto task_output_copy = task_output;
  auto partial_lse_copy = partial_lse;
  auto workspace_copy = workspace;
  auto plan_tensor_copy = plan_tensor;
  auto plan_copy = plan;
  auto acl_call = [=]() mutable -> int {
    launch_sparse_attention_head64_pv_hd576_bf16(
        scores.const_data_ptr<float>(),
        probabilities_copy.mutable_data_ptr<at::BFloat16>(),
        values.const_data_ptr<at::BFloat16>(),
        indices.const_data_ptr<int32_t>(),
        task_output_copy.mutable_data_ptr<float>(),
        partial_lse_copy.mutable_data_ptr<float>(),
        workspace_copy.mutable_data_ptr<uint8_t>(),
        plan_tensor_copy.mutable_data_ptr<uint8_t>(),
        causal,
        &plan_copy,
        acl_stream);
    return 0;
  };
  at_npu::native::OpCommand::RunOpApiV2(
      "aten_dsa_sparse_attention::sparse_attention_head64_pv_hd576_bf16",
      acl_call);
}

void run_sparse_attention_family_hd512_fused_tile(
    const at::Tensor& query,
    const at::Tensor& keys,
    const at::Tensor& values,
    const at::Tensor& indices,
    at::Tensor& output,
    at::Tensor& lse,
    int64_t batch_size,
    int64_t query_heads,
    int64_t query_tokens,
    int64_t selected_tokens,
    int64_t context_tokens,
    int64_t qk_head_dim,
    int64_t value_head_dim,
    int64_t query_query_stride,
    int64_t query_query_offset,
    int64_t indices_query_stride,
    int64_t indices_query_offset,
    int64_t indices_selected_stride,
    int64_t indices_selected_offset,
    int64_t output_query_stride,
    int64_t output_query_offset,
    float score_scale,
    int64_t query_start,
    bool causal,
    aclrtStream acl_stream) {
  auto output_tensor = output;
  auto lse_tensor = lse;
  auto tiling = at::empty({4096}, query.options().dtype(c10::kByte));
  auto acl_call = [=]() mutable -> int {
    launch_sparse_attention_hd512_fused_float(
        query.const_data_ptr<at::BFloat16>(),
        keys.const_data_ptr<at::BFloat16>(),
        values.const_data_ptr<at::BFloat16>(),
        indices.const_data_ptr<int32_t>(),
        output_tensor.mutable_data_ptr<float>(),
        lse_tensor.mutable_data_ptr<float>(),
        tiling.mutable_data_ptr<uint8_t>(),
        batch_size,
        query_heads,
        query_tokens,
        selected_tokens,
        context_tokens,
        qk_head_dim,
        value_head_dim,
        qk_head_dim,
        query_query_stride,
        query_query_offset,
        indices_query_stride,
        indices_query_offset,
        indices_selected_stride,
        indices_selected_offset,
        output_query_stride,
        output_query_offset,
        score_scale,
        query_start,
        causal,
        acl_stream);
    return 0;
  };
  at_npu::native::OpCommand::RunOpApiV2(
      "aten_dsa_sparse_attention::sparse_attention_forward_family_hd512_fused",
      acl_call);
}

