    const at::Tensor& keys,
    const at::Tensor& indices,
    at::Tensor& scores,
    at::Tensor& workspace,
    at::Tensor& tiling,
    int64_t batch_size,
    int64_t query_heads,
    int64_t current_query,
    int64_t current_selected,
    int64_t context_tokens,
    int64_t query_query_stride,
    int64_t query_query_offset,
    int64_t indices_query_stride,
    int64_t indices_query_offset,
    int64_t indices_selected_stride,
    int64_t indices_selected_offset,
    int64_t score_query_stride,
    int64_t score_query_offset,
    int64_t score_stride,
    int64_t score_offset,
    aclrtStream acl_stream) {
  auto score_tensor = scores;
  auto workspace_tensor = workspace;
  auto tiling_tensor = tiling;
  auto acl_call = [=]() mutable -> int {
    launch_sparse_attention_score_gather_hd128_float(
        query_tile.const_data_ptr<at::BFloat16>(),
        keys.const_data_ptr<at::BFloat16>(),
        indices.const_data_ptr<int32_t>(),
        score_tensor.mutable_data_ptr<float>(),
        workspace_tensor.mutable_data_ptr<uint8_t>(),
        tiling_tensor.mutable_data_ptr<uint8_t>(),
        batch_size,
        query_heads,
        current_query,
        current_selected,
        context_tokens,
        query_query_stride,
        query_query_offset,
        indices_query_stride,
        indices_query_offset,
        indices_selected_stride,
        indices_selected_offset,
        score_query_stride,
        score_query_offset,
        score_stride,
        score_offset,
        acl_stream);
    return 0;
  };
  at_npu::native::OpCommand::RunOpApiV2(
      "aten_dsa_sparse_attention::sparse_attention_score_gather_family_hd128",
      acl_call);
}

void run_sparse_attention_query_pack_hd128_tile(
    const at::Tensor& query,
    at::Tensor& query_tile,
    int64_t batch_size,
    int64_t query_heads,
    int64_t current_query,
    int64_t query_query_stride,
    int64_t query_query_offset,
    aclrtStream acl_stream) {
  auto query_tile_tensor = query_tile;
  auto acl_call = [=]() mutable -> int {
    launch_sparse_attention_query_pack_hd128_float(
        query.const_data_ptr<float>(),
        query_tile_tensor.mutable_data_ptr<at::BFloat16>(),
        batch_size,
        query_heads,
        current_query,
        query_query_stride,
        query_query_offset,
        acl_stream);
    return 0;
  };
  at_npu::native::OpCommand::RunOpApiV2(
      "aten_dsa_sparse_attention::sparse_attention_query_pack_hd128",
      acl_call);
}

std::tuple<at::Tensor, at::Tensor> sparse_attention_forward_family_hd512_hybrid(
    const at::Tensor& query,
    const at::Tensor& keys,
    const at::Tensor& values,
    const at::Tensor& indices,
    int64_t value_head_dim,
    bool causal) {
  const auto batch_size = query.size(0);
  const auto query_heads = query.size(1);
  const auto query_tokens = query.size(2);
  const auto context_tokens = keys.size(2);
  const auto selected_tokens = indices.size(2);
  const auto qk_head_dim = query.size(3);

  auto output = at::empty(
      {batch_size, query_heads, query_tokens, value_head_dim},
      query.options().dtype(c10::kFloat));
  auto lse = at::empty(
      {batch_size, query_heads, query_tokens},
      query.options().dtype(c10::kFloat));

  const auto scale = 1.0F / std::sqrt(static_cast<float>(qk_head_dim));
  const auto acl_stream = c10_npu::getCurrentNPUStream().stream(true);

  if (query.scalar_type() == at::ScalarType::BFloat16) {
    run_sparse_attention_family_hd512_fused_tile(
        query,
        keys,
        values,
        indices,
        output,
        lse,
        batch_size,
        query_heads,
        query_tokens,
        selected_tokens,
        context_tokens,
        qk_head_dim,
        value_head_dim,
        query_tokens,
        0,
        query_tokens,
        0,
        selected_tokens,
        0,
        query_tokens,
        0,
        scale,
        context_tokens - query_tokens,
        causal,
        acl_stream);
    return {output, lse};
  }

  for (int64_t query_start = 0; query_start < query_tokens;
       query_start += kFamilyHd512QueryTile) {
    const auto absolute_query_start = context_tokens - query_tokens + query_start;
    const auto current_query =
        std::min<int64_t>(kFamilyHd512QueryTile, query_tokens - query_start);
    auto score_query = at::empty(
        {batch_size, query_heads, current_query, qk_head_dim},
        query.options().dtype(c10::kBFloat16));
    run_sparse_attention_query_pack_hd512_tile(
        query,
        score_query,
        batch_size,
        query_heads,
        current_query,
        query_tokens,
        query_start,
        acl_stream);
    const int64_t score_query_stride = current_query;
    const int64_t score_query_offset = 0;
    auto scores = at::empty(
        {batch_size, query_heads, current_query, selected_tokens},
        query.options().dtype(c10::kFloat));
    for (int64_t selected_start = 0; selected_start < selected_tokens;
         selected_start += kFamilyHd512SelectedTile) {
      const auto current_selected =
          std::min<int64_t>(kFamilyHd512SelectedTile, selected_tokens - selected_start);
      auto score_workspace = at::empty(
          {16 * 1024 * 1024},
          query.options().dtype(c10::kByte));
      auto score_tiling = at::empty(
          {4096},
          query.options().dtype(c10::kByte));
      run_sparse_attention_score_gather_family_hd512_tile(
          score_query,
          keys,
          indices,
          scores,
          score_workspace,
          score_tiling,
          batch_size,
          query_heads,
          current_query,
          current_selected,
          context_tokens,
          score_query_stride,
          score_query_offset,
          query_tokens,
          query_start,
          selected_tokens,
          selected_start,
          selected_tokens,
          selected_start,
          acl_stream);
    }

    run_sparse_attention_family_hd512_decode_direct_tile(
        scores,
        values,
        indices,
        output,
        lse,
        batch_size,
        query_heads,
        current_query,
        context_tokens,
        selected_tokens,
        qk_head_dim,
        query_tokens,
        query_start,
        selected_tokens,
        0,
        query_tokens,
        query_start,
        scale,
        absolute_query_start,
        causal,
        acl_stream);
  }

  return {output, lse};
}

